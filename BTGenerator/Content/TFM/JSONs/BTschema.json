{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/behaviour-tree.schema.json",
  "title": "Behaviour Tree",
  "type": "object",
  "required": ["Blackboard", "Node"],
  "additionalProperties": false,

  "properties": {
    "Blackboard": {
      "type": "array",
      "description": "Blackboard",
      "items": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "enum": ["Bool", "Int", "Float", "Vector", "Object", "String"]
        }
      }
    },

    "Node": {
      "$ref": "#/$defs/TreeNode"
    }
  },

  "$defs": {
    "TreeNodeWrapper": {
      "type": "object",
      "required": ["Node"],
      "additionalProperties": false,
      "properties": {
        "Node": { "$ref": "#/$defs/TreeNode" }
      }
    },

    "TreeNode": {
      "type": "object",
      "required": ["Type", "Nodes"],
      "additionalProperties": false,

      "properties": {
        "Type": {
          "type": "string",
          "enum": ["Selector", "Sequence", "Task", "Parallel"]
        },

        "Decorators": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },

        "Task": {
          "type": "string",
          "description": "Nombre de la tarea"
        },

        "BlackboardEntries": {
          "type": "array",
          "description": "Entradas del Blackboard usadas por el nodo",
          "items": {
            "type": "string"
          }
        },

        "Nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/TreeNodeWrapper" }
        }
      }
    }
  }
}

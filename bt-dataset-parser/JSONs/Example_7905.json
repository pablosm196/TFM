{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes.     If an object is located, then pick it up, check its properties, do a specific task, otherwise search for it.     list of available nodes: <Action ID = PickUpObject    /> <SubTree ID = ObjectProperties    /> <SubTree ID = SpecificTask    /> <Conditional ID = IsObjectLocated    /> <Action ID = SearchForObject    /> <Conditional ID = isObjectMovable    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectLocated": "Boolean"
            },
            {
                "isObjectMovable": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [
                            {
                                "IsObjectLocated?": "IsObjectLocated"
                            }
                        ],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "isObjectMovable?": "isObjectMovable"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "PickUpObject",
                                "Name": "PickUpObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ObjectProperties",
                                "Name": "ObjectProperties"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "SpecificTask",
                                "Name": "SpecificTask"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "SearchForObject",
                        "Name": "SearchForObject"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectLocated? THEN\n\t\t\tSEQUENCE\n\t\t\t\t\tIF isObjectMovable? THEN\n\t\t\t\t\tDO PickUpObject\n\t\t\tELSE\n\t\t\t\tDO ObjectProperties\n\t\t\t\tDO SpecificTask\n\t\t\tEND\n\tELSE\n\t\tDO SearchForObject\n\tEND\n"
}
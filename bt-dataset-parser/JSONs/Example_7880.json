    "code": "\tSEQUENCE\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\t\tDO ApproachObject\n\t\t\tELSE\n\t\t\t\tDO PickUpObject\n\t\t\t\tDO InspectObject\n\t\t\tEND\n\t\t\tDO MoveToNextLocation\n\t\tEND\n\t\tDO PerformTask\n\tEND\n"

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object visible, move towards it, grab it if reachable, check properties, complete specific task; explore if not. list of available nodes: <Action ID = MoveTowardsObject    /> <Action ID = GrabObject    /> <Action ID = ExploreArea    /> <Action ID = CheckObjectProperties    /> <SubTree ID = SpecificTask    />  <Condition ID = IsObjectWithinReach    />  <Condition ID = IsObjectVisible    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectWithinReach": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveTowardsObject",
                            "Name": "MoveTowardsObject"
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectWithinReach?": "IsObjectWithinReach"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "GrabObject",
                                    "Name": "GrabObject"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ExploreArea",
                    "Name": "ExploreArea"
                }
            ]
        }
    }
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If item nearby, take it. If not, move to item. Scan for item. Do task with item. list of available nodes: <Action ID = TakeItem    /> <SubTree ID = ProcessItem    /> <Condition ID = IsItemNearby    /> <Condition ID = IsItemVisible    /> <Action ID = MoveToItem    /> <Action ID = ScanAreaForItem    />",
    "BT": {
        "Blackboard": [
            {
                "IsItemNearby": "Boolean"
            },
            {
                "IsItemVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsItemNearby?": "IsItemNearby"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeItem",
                            "Name": "TakeItem"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessItem",
                            "Name": "ProcessItem"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsItemVisible?": "IsItemVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToItem",
                            "Name": "MoveToItem"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForItem",
                    "Name": "ScanAreaForItem"
                }
            ]
        }
    }
}
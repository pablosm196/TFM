                                "Name": "MoveTowardsObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "GraspObject",
                                "Name": "GraspObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "CheckObjectProperties",
                                "Name": "CheckObjectProperties"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "TaskSpecificSubtree",
                                "Name": "TaskSpecificSubtree"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsAreaScanned?": "IsAreaScanned"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "MoveToNextArea",
                                "Name": "MoveToNextArea"
                            }
                        ]
                    }
                ]
            }
        }

    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectDetected? THEN\n\t\t\t\tDO MoveTowardsObject\n\t\tELSE\n\t\t\tDO GraspObject\n\t\t\tDO CheckObjectProperties\n\t\t\tDO TaskSpecificSubtree\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsAreaScanned? THEN\n\t\t\t\tDO MoveToNextArea\n\t\tEND\n\tEND\n"

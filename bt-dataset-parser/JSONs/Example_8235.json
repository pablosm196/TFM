{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object is seen, search. Or, approach and pickup. In order to process. Move randomly after. Finally, repeat.     list of available nodes: <Action ID = SearchForObject    /> <Action ID = ApproachObject    /> <Action ID = PickupObject    /> <Action ID = MoveToRandomLocation    /> <Condition ID = isObjectLocated    /> <Condition ID = isObjectVisible    /> <SubTree ID = ProcessObjectDelegate    />",
    "BT": {
        "Blackboard": [
            {
                "isObjectLocated": "Boolean"
            },
            {
                "isObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "isObjectLocated?": "isObjectLocated"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PickupObject",
                            "Name": "PickupObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObjectDelegate",
                            "Name": "ProcessObjectDelegate"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "isObjectVisible?": "isObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "SearchForObject",
                            "Name": "SearchForObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToRandomLocation",
                    "Name": "MoveToRandomLocation"
                }
            ]
        }
    }
}
                                        }
                                    ],
                                    "Nodes": [
                                        {
                                            "Type": "Task",
                                            "Decorators": [],
                                            "Nodes": [],
                                            "Task": "TakeObject",
                                            "Name": "TakeObject"
                                        },
                                        {
                                            "Type": "Task",
                                            "Decorators": [],
                                            "Nodes": [],
                                            "Task": "ProcessObject",
                                            "Name": "ProcessObject"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectVisible?": "IsObjectVisible"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "MoveToObject",
                                    "Name": "MoveToObject"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find and grab object. Check properties. Do task if successful. Otherwise, explore area.     list of available nodes: <Action ID = TakeObject    /> <Action ID = PerformTask    /> <Action ID = ExploreArea    /> <Action ID = ProcessObject    /> <Action ID = ApproachObject    /> <Condition ID = isObjectApproached    /> <Condition ID = isObjectVisible    />",
    "BT": {
        "Blackboard": [
            {
                "isObjectApproached": "Boolean"
            },
            {
                "isObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "isObjectApproached?": "isObjectApproached"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "TakeObject",
                                    "Name": "TakeObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "ProcessObject",
                                    "Name": "ProcessObject"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "isObjectVisible?": "isObjectVisible"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "ApproachObject",
                                    "Name": "ApproachObject"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ExploreArea",
                            "Name": "ExploreArea"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "PerformTask",
                    "Name": "PerformTask"
                }
            ]
        }
    }
}
                        "Nodes": [],
                        "Task": "ScanAreaForItem",
                        "Name": "ScanAreaForItem"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsItemApproached? THEN\n\t\t\t\tDO TakeItem\n\t\tELSE\n\t\t\tDO ProcessItem\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsItemVisible? THEN\n\t\t\t\tDO MoveTowardsItem\n\t\tEND\n\t\tDO ScanAreaForItem\n\tEND\n"

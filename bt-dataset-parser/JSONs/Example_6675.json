{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If item seen, approach it. If reached, take it. In order to continue, scan area. list of available nodes: <Action ID = ScanAreaForItem    /> <Condition ID = IsItemVisible    /> <Action ID = TakeItem    /> <SubTree ID = ProcessItem    /> <Action ID = MoveTowardsItem    /> <Condition ID = IsItemApproached    />",
    "BT": {
        "Blackboard": [
            {
                "IsItemVisible": "Boolean"
            },
            {
                "IsItemApproached": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsItemApproached?": "IsItemApproached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeItem",
                            "Name": "TakeItem"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessItem",
                            "Name": "ProcessItem"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsItemVisible?": "IsItemVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveTowardsItem",
                            "Name": "MoveTowardsItem"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForItem",
                    "Name": "ScanAreaForItem"
                }
            ]
        }
    }
}
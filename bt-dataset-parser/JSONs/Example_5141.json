                    "Name": "GrabObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectHeavy?": "IsObjectHeavy"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveObjectToDesignatedLocation",
                            "Name": "MoveObjectToDesignatedLocation"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "DoSpecificTask",
                            "Name": "DoSpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectFragile?": "IsObjectFragile"
                        }
                    ],
                    "Nodes": [],
                    "Task": "InspectObject",
                    "Name": "InspectObject"
                }
            ]
        }
    }

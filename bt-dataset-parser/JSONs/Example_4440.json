{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, approach it, grasp it, check its properties, in order to take it. list of available nodes: <Action ID = ApproachObject    /> <Action ID = GraspObject    /> <Action ID = CheckObjectProperties    /> <Action ID = ScanAreaForObject    /> <Action ID = RandomMovement    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectClose": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [],
                        "Task": "ApproachObject",
                        "Name": "ApproachObject"
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectClose?": "IsObjectClose"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "GraspObject",
                                "Name": "GraspObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "CheckObjectProperties",
                                "Name": "CheckObjectProperties"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectClose? THEN\n\t\t\t\tDO GraspObject\n\t\tELSE\n\t\t\tDO CheckObjectProperties\n\t\tEND\n\tEND\n"
}
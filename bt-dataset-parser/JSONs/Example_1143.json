{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object nearby, move and grab it, then process it. If obstacle, turn and keep moving.     list of available nodes: <Action ID = MoveToObject    /> <Action ID = GrabObject    /> <Action ID = TurnLeft    /> <Action ID = ProcessObject    /> <Condition ID = IsObstacleAhead    /> <Condition ID = IsObjectNearby    /> <Action ID = MoveForward    />",
    "BT": {
        "Blackboard": [
            {
                "IsObstacleAhead": "Boolean"
            },
            {
                "IsObjectNearby": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectNearby?": "IsObjectNearby"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObject",
                            "Name": "ProcessObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObstacleAhead?": "IsObstacleAhead"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TurnLeft",
                            "Name": "TurnLeft"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveForward",
                    "Name": "MoveForward"
                }
            ]
        }
    }
}
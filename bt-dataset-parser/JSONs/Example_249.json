                                }
                            ],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectLost?": "IsObjectLost"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ScanAreaForObjects",
                            "Name": "ScanAreaForObjects"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "PerformTask",
                    "Name": "PerformTask"
                }
            ]
        }
    }

                        "Nodes": [],
                        "Task": "ScanAreaForObject",
                        "Name": "ScanAreaForObject"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO TakeObject\n\t\t\tDO CheckObjectProperty\n\t\t\tDO SpecificTaskSubtree\n\t\t\tDO MoveToDestination\n\t\tEND\n\t\tDO ScanAreaForObject\n\tEND\n"

    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO CheckObjectProperties\n\t\t\tDO TakeObject\n\t\t\tDO TaskSubtree\n\t\tEND\n\t\tDO ScanAreaForObject\n\tEND\n"

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Approach visible object, grab and move to holder. Check properties and release. Scan/wait if necessary.     list of available nodes: <Action ID = ApproachObject    /> <Action ID = MoveToObjectHolder    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectInHolder    /> <Condition ID = IsObjectGrabbed    /> <Action ID = ReleaseObject    /> <Action ID = ScanAreaForObject    /> <Action ID = WaitForNewInput    /> <SubTree ID = CheckObjectProperties    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectInHolder": "Boolean"
            },
            {
                "IsObjectGrabbed": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectGrabbed?": "IsObjectGrabbed"
                        }
                    ],
                    "Nodes": [],

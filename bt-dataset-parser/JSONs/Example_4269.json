    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF CheckBatteryLevel? THEN\n\t\t\t\tDO MoveToChargingStation\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectInFront? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO ProcessObjectProperties\n\t\t\tDO MoveToDestination\n\t\tEND\n\t\tDO ScanEnvironment\n\tEND\n"

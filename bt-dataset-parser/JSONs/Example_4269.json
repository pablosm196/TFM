{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If battery level low, move to charging station. If object nearby, take, process and move. Scan always. list of available nodes: <Action ID = MoveToChargingStation    /> <Action ID = TakeObject    /> <Action ID = MoveToDestination    /> <Action ID = ScanEnvironment    /> <SubTree ID = ProcessObjectProperties    /> <Condition ID = CheckBatteryLevel    /> <Condition ID = IsObjectInFront    />",
    "BT": {
        "Blackboard": [
            {
                "CheckBatteryLevel": "Boolean"
            },
            {
                "IsObjectInFront": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "CheckBatteryLevel?": "CheckBatteryLevel"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToChargingStation",
                            "Name": "MoveToChargingStation"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectInFront?": "IsObjectInFront"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObjectProperties",
                            "Name": "ProcessObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanEnvironment",
                    "Name": "ScanEnvironment"
                }
            ]
        }
    }
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object visible, move to object, take object, then process it. Else, scan object properties.     list of available nodes: <Action ID = IsObjectVisible    /> <Fallback>     <Sequence>              <Condition ID = IsObjectApproached    />         <Action ID = TakeObject    />         <SubTree ID = ProcessObject    />     </Sequence>     <Sequence>         <Action ID = MoveToObject    />         <Action ID = ScanForObjectProperties    />     </Sequence> </Fallback>",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Selector",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectApproached?": "IsObjectApproached"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "TakeObject",
                                    "Name": "TakeObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "ProcessObject",
                                    "Name": "ProcessObject"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "MoveToObject",
                                    "Name": "MoveToObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "ScanForObjectProperties",
                                    "Name": "ScanForObjectProperties"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }
}
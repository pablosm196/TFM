{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes.     If object visible, approach and take it. Otherwise, scan area. Complete task, move to next.     list of available nodes: <Action ID = ApproachObject    /> <Action ID = MoveToNextTask    /> <Action ID = ScanAreaForObjects    /> <Action ID = TakeAndMoveObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsTaskComplete    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsTaskComplete": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectVisible?": "IsObjectVisible"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "ApproachObject",
                                "Name": "ApproachObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "TakeAndMoveObject",
                                "Name": "TakeAndMoveObject"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsTaskComplete?": "IsTaskComplete"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "MoveToNextTask",
                                "Name": "MoveToNextTask"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ScanAreaForObjects",
                        "Name": "ScanAreaForObjects"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO TakeAndMoveObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsTaskComplete? THEN\n\t\t\t\tDO MoveToNextTask\n\t\tEND\n\t\tDO ScanAreaForObjects\n\tEND\n"
}
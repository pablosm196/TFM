{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If object visible, approach and grab it, take and check properties, move to start. list of available nodes: <Action ID = ApproachObject    /> <Action ID = ScanAreaForObject    /> <Condition ID = IsObjectVisible    /> <SubTree ID = GrabAndTakeObject    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = MoveToStartingPosition    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],

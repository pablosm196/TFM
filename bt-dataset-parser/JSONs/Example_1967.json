{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object visible, approach and grab it. Check properties, take it and perform task. Move and scan. list of available nodes: <Action ID = ApproachObject    /> <Action ID = GrabObject    /> <Action ID = TakeObject    /> <Action ID = MoveToNewLocation    /> <Action ID = ScanAreaForObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = isObjectGrabbable    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = PerformTask    />",
    "BT": {
        "Blackboard": [
            {
                "isObjectGrabbable": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "isObjectGrabbable?": "isObjectGrabbable"
                                }
                            ],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PerformTask",
                            "Name": "PerformTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToNewLocation",
                    "Name": "MoveToNewLocation"
                }
            ]
        }
    }
}
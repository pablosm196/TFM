{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If an object is perceived, approach it. If near, take it and execute the task. Otherwise scan.     list of available nodes: <Action ID = GrabObject    /> <Action ID = ApproachObject    /> <Action ID = ScanAreaForObject    /> <Condition ID = IsObjectApproached    /> <Condition ID = IsObjectVisible    /> <Action ID = MoveToTheObject    /> <Action ID = TakeTheObject    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = SpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "isObjectKnown": "Boolean"
            },
            {
                "isObjectNear": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "isObjectKnown?": "isObjectKnown"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToTheObject",
                            "Name": "MoveToTheObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "isObjectNear?": "isObjectNear"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeTheObject",
                            "Name": "TakeTheObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObjects",
                    "Name": "ScanAreaForObjects"
                }
            ]
        }
    }
}
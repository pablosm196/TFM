    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF isObjectKnown? THEN\n\t\t\t\tDO MoveToTheObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF isObjectNear? THEN\n\t\t\t\tDO TakeTheObject\n\t\tELSE\n\t\t\tDO CheckObjectProperties\n\t\t\tDO SpecificTask\n\t\tEND\n\t\tDO ScanAreaForObjects\n\tEND\n"

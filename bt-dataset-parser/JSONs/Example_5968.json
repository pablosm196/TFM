            },
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectHeavy": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {

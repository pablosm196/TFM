{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes.     If object is present, move to target, grab it, and check properties. Otherwise, move left or right.     list of available nodes: <Condition ID = IsObjectPresent    /> <Action ID = MoveToTarget    /> <Action ID = GrabObject    /> <SubTree ID = CheckObjectProperties    /> <Action ID = MoveLeft    /> <Action ID = MoveRight    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectPresent": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [
                            {
                                "IsObjectPresent?": "IsObjectPresent"
                            }
                        ],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "MoveToTarget",
                                "Name": "MoveToTarget"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "GrabObject",
                                "Name": "GrabObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "CheckObjectProperties",
                                "Name": "CheckObjectProperties"
                            }
                        ]
                    },
                    {
                        "Type": "Selector",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "MoveLeft",
                                "Name": "MoveLeft"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "MoveRight",
                                "Name": "MoveRight"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectPresent? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO MoveToTarget\n\t\t\t\tDO GrabObject\n\t\t\t\tDO CheckObjectProperties\n\t\t\tEND\n\tELSE\n\t\tSELECTOR\n\t\t\tDO MoveLeft\n\t\t\tDO MoveRight\n\t\tEND\n\tEND\n"

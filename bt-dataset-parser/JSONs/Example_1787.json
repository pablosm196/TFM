{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object is present, move to target, grab it, and check properties. Otherwise, move left or right.     list of available nodes: <Condition ID = IsObjectPresent    /> <Action ID = MoveToTarget    /> <Action ID = GrabObject    /> <SubTree ID = CheckObjectProperties    /> <Action ID = MoveLeft    /> <Action ID = MoveRight    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectPresent": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectPresent?": "IsObjectPresent"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToTarget",
                            "Name": "MoveToTarget"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        }
                    ]
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveLeft",
                            "Name": "MoveLeft"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveRight",
                            "Name": "MoveRight"
                        }
                    ]
                }
            ]
        }
    }
}
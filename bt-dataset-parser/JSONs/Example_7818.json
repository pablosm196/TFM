{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is approached, take it and check size. If not visible, move closer. Finally, do ProcessObjectTask. list of available nodes: <Action ID = ScanAreaForObject    /> <Condition ID = IsObjectVisible    /> <Action ID = MoveToObject    /> <Action ID = TakeObject    /> <Action ID = CheckObjectSize    /> <SubTree ID = ProcessObjectTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectApproached?": "IsObjectApproached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectSize",
                            "Name": "CheckObjectSize"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanSurroundings",
                    "Name": "ScanSurroundings"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "WaitForSignal",
                    "Name": "WaitForSignal"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ProcessObjectTask",
                    "Name": "ProcessObjectTask"
                }
            ]
        }
    }
}
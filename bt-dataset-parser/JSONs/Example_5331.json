                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "CanRobotPickUpObject?": "CanRobotPickUpObject"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "PickUpObject",
                                    "Name": "PickUpObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "CheckObjectProperties",
                                    "Name": "CheckObjectProperties"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "DropObject",
                                    "Name": "DropObject"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsRobotCloseToTaskLocation?": "IsRobotCloseToTaskLocation"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "CompleteSpecificTask",
                                    "Name": "CompleteSpecificTask"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object nearby, grab it, check it, move to home. If path blocked, replan and follow. Scan area. list of available nodes: <Action ID = GrabObject    /> <Action ID = MoveToHome    /> <Action ID = ReplanPath    /> <Action ID = FollowPath    /> <Action ID = ScanArea    /> <Action ID = ApproachObject    /> <Condition ID = IsObjectNearby    /> <Condition ID = IsPathBlocked    /> <Condition ID = IsObjectVisible    /> <SubTree ID = CheckObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectNearby": "Boolean"
            },
            {
                "IsPathBlocked": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectNearby?": "IsObjectNearby"
                                }
                            ],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObject",
                            "Name": "CheckObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToHome",
                            "Name": "MoveToHome"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsPathBlocked?": "IsPathBlocked"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ReplanPath",
                            "Name": "ReplanPath"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "FollowPath",
                            "Name": "FollowPath"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanArea",
                    "Name": "ScanArea"
                }
            ]
        }
    }
}
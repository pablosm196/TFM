                                    {
                                        "IsTaskSpecific?": "IsTaskSpecific"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "PerformSpecificTask",
                                "Name": "PerformSpecificTask"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "MoveToLocation",
                        "Name": "MoveToLocation"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectApproached? THEN\n\t\t\tDO PickupObject\n\tELSE\n\t\tDO CheckObjectProperties\n\t\tSEQUENCE\n\t\t\t\tIF IsTaskSpecific? THEN\n\t\t\t\tDO PerformSpecificTask\n\t\tEND\n\t\tDO MoveToLocation\n\tEND\n"

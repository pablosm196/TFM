{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. > Find and retrieve object. If visible, approach it, grab it, check properties, move to destination, and retrieve it. list of available nodes: <Action ID = ApproachObject    /> <Action ID = GrabObject    /> <Action ID = CheckObjectProperties    /> <Action ID = MoveToDestination    /> <Action ID = RetrieveObject    /> <Condition ID = IsObjectVisible    /> <SubTree ID = FindAndRetrieveObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToDestination",
                    "Name": "MoveToDestination"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "RetrieveObject",
                    "Name": "RetrieveObject"
                }
            ]
        }
    }
}
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectFound? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO TakeObject\n\t\t\t\tIF isObjectHeavy? THEN\n\t\t\t\tDO MoveObject\n\t\tELSE\n\t\t\tDO TaskSpecific\n\t\tEND\n\t\tDO SearchForObject\n\tEND\n"

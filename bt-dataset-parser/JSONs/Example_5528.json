{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find object, grab it, check properties, move to base and place it. If not visible, approach or scan area.     list of available nodes: <Action ID = ApproachObject    /> <Action ID = ScanAreaForObject    /> <Action ID = IsObjectVisible    /> <Action ID = IsObjectApproached    /> <Action ID = GrabObject    /> <Action ID = MoveToBase    /> <Action ID = PlaceObject    /> <SubTree ID = CheckObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectApproached?": "IsObjectApproached"
                        }
                    ],
                    "Nodes": [],
                    "Task": "GrabObject",
                    "Name": "GrabObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObject",
                    "Name": "CheckObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToBase",
                    "Name": "MoveToBase"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "PlaceObject",
                    "Name": "PlaceObject"
                }
            ]
        }
    }
}
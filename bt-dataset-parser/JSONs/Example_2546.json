{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object is detected, approach, grab and inspect it, move to destination. If path is blocked, avoid and move.     list of available nodes: <Action ID = ApproachObject    /> <Action ID = GrabObject    /> <SubTree ID = InspectObject    /> <Action ID = MoveToDestination    /> <Condition ID = IsObjectDetected    /> <Condition ID = IsPathBlocked    /> <Action ID = AvoidObstacles    />",
    "BT": {
        "Blackboard": [
            {
                "IsPathBlocked": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectDetected?": "IsObjectDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "InspectObject",
                            "Name": "InspectObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsPathBlocked?": "IsPathBlocked"
                                }
                            ],
                            "Nodes": [],
                            "Task": "AvoidObstacles",
                            "Name": "AvoidObstacles"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        }
                    ]
                }
            ]
        }
    }
}
                            "Task": "ProcessObject",
                            "Name": "ProcessObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTaskVisible?": "IsTaskVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachTask",
                            "Name": "ApproachTask"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTaskReady?": "IsTaskReady"
                                }
                            ],
                            "Nodes": [],
                            "Task": "CompleteTask",
                            "Name": "CompleteTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObject",
                    "Name": "ScanAreaForObject"
                }
            ]

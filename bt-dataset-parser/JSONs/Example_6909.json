{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find and take object if it's visible and within reach. Check properties and do task, then scan again. list of available nodes: <Action ID = PickUpObject    /> <Action ID = ScanEnvironment    /> <Action ID = CheckObjectProperties    /> <Action ID = DoSpecificTask    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectInReach    /> <SubTree ID = FindAndTakeObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectInReach": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectInReach?": "IsObjectInReach"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "PickUpObject",
                                    "Name": "PickUpObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "CheckObjectProperties",
                                    "Name": "CheckObjectProperties"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "DoSpecificTask",
                            "Name": "DoSpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanEnvironment",
                    "Name": "ScanEnvironment"
                }
            ]
        }
    }
}
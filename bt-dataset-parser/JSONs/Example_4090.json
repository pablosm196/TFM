{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object found, approach, take, check properties, do task, return. Else, explore area! list of available nodes: <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = SpecificTask    /> <Action ID = ReturnObject    /> <Condition ID = IsObjectVisible    /> <Action ID = ExploreArea    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",

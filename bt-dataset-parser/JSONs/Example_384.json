                        "Nodes": [],
                        "Task": "SpecificTask",
                        "Name": "SpecificTask"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\t\tIF IsObjectReached? THEN\n\t\t\tDO PickupObject\n\tELSE\n\t\tDO CheckObjectWeight\n\t\tDO MoveToDestination\n\t\tDO SpecificTask\n\tEND\n"

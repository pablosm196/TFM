                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "RotateRobot",
                            "Name": "RotateRobot"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveRobotForward",
                            "Name": "MoveRobotForward"
                        }
                    ]
                }
            ]
        }

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object in range, grab and inspect it, if obstacle detected then avoid, move to target. list of available nodes: <Action ID = GrabObject    /> <Action ID = InspectObjectTask    /> <Action ID = AvoidObstacle    /> <Action ID = SearchForObject    /> <Action ID = MoveToTarget    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectInRange": "Boolean"
            },
            {
                "IsObstacleDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectInRange?": "IsObjectInRange"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "GrabObject",
                                    "Name": "GrabObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "InspectObjectTask",
                                    "Name": "InspectObjectTask"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObstacleDetected?": "IsObstacleDetected"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "AvoidObstacle",
                                    "Name": "AvoidObstacle"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SearchForObject",
                            "Name": "SearchForObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToTarget",
                    "Name": "MoveToTarget"
                }
            ]
        }
    }
}
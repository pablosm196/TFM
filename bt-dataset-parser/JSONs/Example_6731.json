                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectInView? THEN\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectReachable? THEN\n\t\t\t\t\tDO MoveToPosition\n\t\t\tELSE\n\t\t\t\tDO TakeObject\n\t\t\t\tDO CheckObjectProperties\n\t\t\tEND\n\tEND\n"

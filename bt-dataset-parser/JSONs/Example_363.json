{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object seen, approach it, if can grab it then grab, if not, scan. Check object properties, move to location.     list of available nodes: <Action ID = ApproachObject    /> <Condition ID = IsObjectVisible    /> <SubTree ID = CheckObjectProperties    /> <Action ID = MoveToLocation    /> <Sequence>     <Condition ID = IsObjectGrabbable    />     <Action ID = GrabObject    /> </Sequence> <SubTree ID = MoveToLocation    /> <Action ID = ScanAreaForObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectGrabbable": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectGrabbable?": "IsObjectGrabbable"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "GrabObject",
                                    "Name": "GrabObject"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanAreaForObject",
                            "Name": "ScanAreaForObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToLocation",
                    "Name": "MoveToLocation"
                }
            ]
        }
    }
}
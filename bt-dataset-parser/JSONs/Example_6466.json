{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, approach it, grab it and move it. If special, perform task, if not found patrol area. list of available nodes: <Action ID = ApproachObject    /> <Action ID = GrabObject    /> <Action ID = MoveObject    /> <Action ID = ScanAreaForObject    /> <SubTree ID = PatrolArea    /> <SubTree ID = PerformSpecialTask    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectGrabbable    /> <Condition ID = IsObjectHeavy    /> <Condition ID = IsObjectSpecial    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectSpecial": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectGrabbable": "Boolean"
            },
            {
                "IsObjectHeavy": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectGrabbable?": "IsObjectGrabbable"
                        }
                    ],
                    "Nodes": [],
                    "Task": "GrabObject",
                    "Name": "GrabObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectHeavy?": "IsObjectHeavy"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveObject",
                    "Name": "MoveObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectSpecial?": "IsObjectSpecial"
                        }
                    ],
                    "Nodes": [],
                    "Task": "PerformSpecialTask",
                    "Name": "PerformSpecialTask"
                }
            ]
        }
    }
}
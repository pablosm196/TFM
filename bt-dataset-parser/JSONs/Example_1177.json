{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If assigned a task, move to location, if object nearby then pick it up, scan surroundings.     list of available nodes: <Action ID = ScanSurroundings    /> <Action ID = PickUpObject    /> <Action ID = MoveToTaskLocation    /> <Action ID = ProcessTask    /> <Condition ID = IsTaskAssigned    /> <Condition ID = IsObjectNearby    />",
    "BT": {
        "Blackboard": [
            {
                "IsTaskAssigned": "Boolean"
            },
            {
                "IsObjectNearby": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTaskAssigned?": "IsTaskAssigned"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToTaskLocation",
                            "Name": "MoveToTaskLocation"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessTask",
                            "Name": "ProcessTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectNearby?": "IsObjectNearby"
                                }
                            ],
                            "Nodes": [],
                            "Task": "PickUpObject",
                            "Name": "PickUpObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanSurroundings",
                    "Name": "ScanSurroundings"
                }
            ]
        }
    }
}
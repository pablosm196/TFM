{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object is found, take it, check color, and complete task. Then move or scan area.     list of available nodes: <Action ID = FindObject    /> <Action ID = TakeObject    /> <Action ID = CheckColor    /> <Action ID = MoveToLocation    /> <Action ID = ScanArea    /> <Condition ID = IsTaskComplete    /> <SubTree ID = SpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsTaskComplete": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "FindObject",
                            "Name": "FindObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckColor",
                            "Name": "CheckColor"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTaskComplete?": "IsTaskComplete"
                                }
                            ],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToLocation",
                            "Name": "MoveToLocation"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanArea",
                    "Name": "ScanArea"
                }
            ]
        }
    }
}
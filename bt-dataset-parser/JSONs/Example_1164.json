    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\tDO FindObject\n\t\t\tDO TakeObject\n\t\t\tDO CheckColor\n\t\t\t\tIF IsTaskComplete? THEN\n\t\t\t\tDO SpecificTask\n\t\tELSE\n\t\t\tDO MoveToLocation\n\t\tEND\n\t\tDO ScanArea\n\tEND\n"

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find object, move or approach it, take it, check properties, do specific task.     list of available nodes: <Action ID = FindObject    /> <Action ID = TakeObject    /> <Action ID = CheckObjectProperties    /> <Action ID = MoveToObject    /> <Condition ID = IsObjectApproached    /> <Condition ID = IsObjectVisible    /> <Action ID = ScanAreaForObject    /> <SubTree ID = DoSpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "FindObject",
                    "Name": "FindObject"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectApproached?": "IsObjectApproached"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "TakeObject",
                                    "Name": "TakeObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "CheckObjectProperties",
                                    "Name": "CheckObjectProperties"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "MoveToObject",
                                    "Name": "MoveToObject"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanAreaForObject",
                            "Name": "ScanAreaForObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "DoSpecificTask",
                    "Name": "DoSpecificTask"
                }
            ]
        }
    }
}
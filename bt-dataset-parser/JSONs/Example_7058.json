                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "isObjectDetected?": "isObjectDetected"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "MoveToObject",
                                    "Name": "MoveToObject"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanArea",
                            "Name": "ScanArea"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SpecificTask",
                    "Name": "SpecificTask"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "RechargeBattery",
                    "Name": "RechargeBattery"
                }
            ]
        }
    }

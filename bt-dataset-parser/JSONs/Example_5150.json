{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is detected, move towards and grab it. Check properties and perform specific task. If not, scan area. list of available nodes: <Action ID = MoveTowardsObject    /> <Action ID = GrabObject    /> <SubTree ID = CheckObjectProperties    /> <Condition ID = IsObjectDetected    /> <SubTree ID = SpecificTask    /> <Action ID = MoveTowardsUndetectedArea    /> <Action ID = ScanArea    /> <Condition ID = IsAreaScanned    />",
    "BT": {
        "Blackboard": [
            {
                "IsAreaScanned": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectDetected?": "IsObjectDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveTowardsObject",
                            "Name": "MoveTowardsObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsAreaScanned?": "IsAreaScanned"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveTowardsUndetectedArea",
                            "Name": "MoveTowardsUndetectedArea"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanArea",
                            "Name": "ScanArea"
                        }
                    ]
                }
            ]
        }
    }
}
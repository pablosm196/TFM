    "code": "\tSEQUENCE\n\t\tDO ScanAreaForObject\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\t\tDO ApproachObject\n\t\t\tELSE\n\t\t\t\tDO GrabObject\n\t\t\t\tDO CheckObjectProperties\n\t\t\tEND\n\t\t\tDO MoveToNextLocation\n\t\tEND\n\tEND\n"

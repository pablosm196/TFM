{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object detected, move towards and grab it, then check properties and do task. If safe, move to random location. Scan for object.     list of available nodes: <Action ID = MoveTowardObject    /> <Action ID = GrabObject    /> <Action ID = CheckObject    /> <Action ID = DoTask    /> <Action ID = MoveToRandomLocation    /> <Action ID = ScanForObject    /> <Condition ID = IsObjectDetected    /> <Condition ID = IsSafeToMove    />",
    "BT": {
        "Blackboard": [
            {
                "IsSafeToMove": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectDetected?": "IsObjectDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveTowardObject",
                            "Name": "MoveTowardObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObject",
                            "Name": "CheckObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "DoTask",
                            "Name": "DoTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsSafeToMove?": "IsSafeToMove"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToRandomLocation",
                            "Name": "MoveToRandomLocation"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanForObject",
                    "Name": "ScanForObject"
                }
            ]
        }
    }
}
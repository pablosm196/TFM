{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, approach, take and move the object, check its properties. list of available nodes: <Action ID = ApproachObject    /> <SubTree ID = TakeObjectAndMove    /> <Action ID = CheckObjectProperties    /> <Condition ID = IsObjectVisible    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "TakeObjectAndMove",
                    "Name": "TakeObjectAndMove"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                }
            ]
        }
    }
}
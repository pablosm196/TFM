{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find object, approach and grab it. If heavy, move to delivery point, deliver. If not, scan.     list of available nodes: <Condition ID = IsObjectApproached    /> <Action ID = GrabObject    /> <Action ID = MoveToDeliveryPoint    /> <Condition ID = IsDeliveryPointReached    /> <Action ID = DeliverObject    /> <Condition ID = IsObjectVisible    /> <Action ID = ApproachObject    /> <Action ID = ScanAreaForObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectHeavy": "Boolean"
            },
            {
                "IsDeliveryPointReached": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectApproached?": "IsObjectApproached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectHeavy?": "IsObjectHeavy"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToDeliveryPoint",
                            "Name": "MoveToDeliveryPoint"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsDeliveryPointReached?": "IsDeliveryPointReached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "DeliverObject",
                            "Name": "DeliverObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObject",
                    "Name": "ScanAreaForObject"
                }
            ]
        }
    }
}
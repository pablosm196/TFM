                                "Decorators": [
                                    {
                                        "IsDeliveryPointReached?": "IsDeliveryPointReached"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "DeliverObject",
                                "Name": "DeliverObject"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",

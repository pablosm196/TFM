                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "InspectObjectProperties",
                    "Name": "InspectObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "PerformTask",
                    "Name": "PerformTask"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ReleaseObject",
                    "Name": "ReleaseObject"
                }
            ]
        }
    }

    "code": "\tSEQUENCE\n\t\tDO ScanAreaForObject\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO ApproachObject\n\t\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\t\tDO PickUpObject\n\t\t\tELSE\n\t\t\t\t\tIF IsObjectRed? THEN\n\t\t\t\t\tDO SortObjectToRedZone\n\t\t\tEND\n\tEND\n"

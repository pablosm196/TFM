{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find and approach the object, take it if close and move if heavy. Do task if specified, otherwise scan area. list of available nodes: <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <Action ID = MoveObject    /> <Action ID = ScanArea    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsCloseToObject    /> <Condition ID = isObjectHeavy    /> <SubTree ID = Task    />",
    "BT": {
        "Blackboard": [
            {
                "isObjectHeavy": "Boolean"
            },
            {
                "IsCloseToObject": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsCloseToObject?": "IsCloseToObject"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "isObjectHeavy?": "isObjectHeavy"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveObject",
                            "Name": "MoveObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "Task",
                            "Name": "Task"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanArea",
                    "Name": "ScanArea"
                }
            ]
        }
    }
}
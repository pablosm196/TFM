    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectFound? THEN\n\t\t\t\tDO MoveToObject\n\t\tELSE\n\t\t\tDO CheckObjectProperties\n\t\t\tDO TakeObject\n\t\t\tDO SpecificTask\n\t\tEND\n\t\tDO ScanAreaForObject\n\t\tDO MoveAround\n\tEND\n"

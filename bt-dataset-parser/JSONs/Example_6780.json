{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find object, take it, check properties; If at task location, perform task. If not, move. list of available nodes: <Action ID = TakeObject    /> <Action ID = ApproachObject    /> <SubTree ID = CheckObjectProperties    /> <Action ID = PerformTask    /> <Action ID = MoveToObject    /> <Condition ID = IsObjectApproached    /> <Condition ID = IsAtTaskLocation    /> <Condition ID = CanMoveToObject    /> <Action ID = ScanAreaForObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "CanMoveToObject": "Boolean"
            },
            {
                "IsAtTaskLocation": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectApproached?": "IsObjectApproached"
                        }
                    ],
                    "Nodes": [],
                    "Task": "TakeObject",
                    "Name": "TakeObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsAtTaskLocation?": "IsAtTaskLocation"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "PerformTask",
                                    "Name": "PerformTask"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "CanMoveToObject?": "CanMoveToObject"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "MoveToObject",
                                    "Name": "MoveToObject"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }
}
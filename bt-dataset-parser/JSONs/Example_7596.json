                        "Decorators": [],
                        "Nodes": [],
                        "Task": "PerformSpecificTask",
                        "Name": "PerformSpecificTask"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "MoveToStartPosition",
                        "Name": "MoveToStartPosition"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\t\tIF IsObjectGrabbable? THEN\n\t\t\tDO GrabObject\n\tELSE\n\t\tDO CheckObjectProperties\n\t\tDO PerformSpecificTask\n\t\tDO MoveToStartPosition\n\tEND\n"

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If an object is near, take, move and check it. If not, find and approach it. Finally, complete task. list of available nodes: <Condition ID = IsObjectApproached    /> <Action ID = TakeObject    /> <Action ID = MoveToDestination    /> <Action ID = CheckObjectProperties    /> <Condition ID = IsDestinationVisible    /> <Action ID = ApproachDestination    /> <Action ID = ScanAreaForObject    /> <SubTree ID = PerformTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsDestinationVisible": "Boolean"
            },
            {
                "IsObjectApproached": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectApproached?": "IsObjectApproached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsDestinationVisible?": "IsDestinationVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachDestination",
                            "Name": "ApproachDestination"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObject",
                    "Name": "ScanAreaForObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "PerformTask",
                    "Name": "PerformTask"
                }
            ]
        }
    }
}
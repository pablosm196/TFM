{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is approached, pick up it and check properties, then move to destination. If obstacle detected, avoid it. list of available nodes: <Action ID = PickUpObject    /> <Action ID = MoveToDestination    /> <Action ID = PutDownObject    /> <Action ID = AvoidObstacle    /> <Action ID = ScanAreaForObjects    /> <Condition ID = IsObjectApproached    /> <Condition ID = IsObstacleDetected    /> <SubTree ID = CheckObjectProperties    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectApproached?": "IsObjectApproached"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PickUpObject",
                            "Name": "PickUpObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PutDownObject",
                            "Name": "PutDownObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        }
                    ]
                }
            ]
        }
    }
}
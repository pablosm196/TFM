{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object visible, robot approaches it. Then, if at station, moves to next one. Finally, scans area for objects. list of available nodes: <Action ID = ScanAreaForObjects    /> <Action ID = IsRobotAtStation    /> <Action ID = MoveToNextStation    /> <Action ID = TakeObjectTask    /> <Action ID = ApproachObject    /> <SubTree ID = TakeObjectTask    />  <Condition ID = IsObjectVisible    />",
    "BT": {
        "Blackboard": [
            {
                "IsRobotAtStation": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObjectTask",
                            "Name": "TakeObjectTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsRobotAtStation?": "IsRobotAtStation"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToNextStation",
                            "Name": "MoveToNextStation"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObjects",
                    "Name": "ScanAreaForObjects"
                }
            ]
        }
    }
}
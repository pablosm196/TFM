    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO TakeObjectTask\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsRobotAtStation? THEN\n\t\t\t\tDO MoveToNextStation\n\t\tEND\n\t\tDO ScanAreaForObjects\n\tEND\n"

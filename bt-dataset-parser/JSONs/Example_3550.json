{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object detected, move to it, take it, then scan surroundings. If path clear, move forward.     list of available nodes: <Action ID = MoveForward    /> <Action ID = MoveToObject    /> <Action ID = ScanSurroundings    /> <SubTree ID = TakeObject    /> <Condition ID = IsObjectDetected    /> <Condition ID = IsPathClear    />",
    "BT": {
        "Blackboard": [
            {
                "IsPathClear": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectDetected?": "IsObjectDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsPathClear?": "IsPathClear"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveForward",
                            "Name": "MoveForward"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanSurroundings",
                    "Name": "ScanSurroundings"
                }
            ]
        }
    }
}
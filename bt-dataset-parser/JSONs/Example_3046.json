            {
                "IsItemApproached": "Boolean"
            },
            {
                "IsItemVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsItemApproached?": "IsItemApproached"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "RetrieveItem",
                                "Name": "RetrieveItem"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "CheckItemProperties",
                                "Name": "CheckItemProperties"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsItemVisible?": "IsItemVisible"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "MoveToItem",
                                "Name": "MoveToItem"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ScanAreaForItem",
                        "Name": "ScanAreaForItem"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsItemApproached? THEN\n\t\t\t\tDO RetrieveItem\n\t\tELSE\n\t\t\tDO CheckItemProperties\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsItemVisible? THEN\n\t\t\t\tDO MoveToItem\n\t\tEND\n\t\tDO ScanAreaForItem\n\tEND\n"

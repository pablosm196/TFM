{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is approached, take it, otherwise if obstacle exists move around. Scan for object. list of available nodes: <Condition ID = IsObjectApproached    /> <Condition ID = IsObstacleInFront    /> <Action ID = GrabObject    /> <Action ID = TakeObject    /> <Action ID = ScanAreaForObject    /> <Action ID = MoveAroundObstacle    /> <SubTree ID = ProcessObject    /> <SubTree ID = ProcessObjectSpecTask    /> <Action ID = ApproachObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObstacleInFront": "Boolean"
            },
            {
                "IsObjectApproached": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectApproached?": "IsObjectApproached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObjectSpecTask",
                            "Name": "ProcessObjectSpecTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObstacleInFront?": "IsObstacleInFront"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveAroundObstacle",
                            "Name": "MoveAroundObstacle"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObject",
                    "Name": "ScanAreaForObject"
                }
            ]
        }
    }
}
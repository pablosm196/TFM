{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Approach, take, check properties, move, then do specific task. Finally, scan area.     list of available nodes: <Action ID = ScanArea    /> <Action ID = TakeObject    /> <Action ID = MoveToDestination    /> <SubTree ID = SpecificTaskSubTree    /> <Condition ID = IsObjectVisible    /> <Sequence>     <Condition ID = IsObjectApproached    />     <Action ID = TakeObject    />     <SubTree ID = CheckObjectProperties    /> </Sequence>",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectApproached?": "IsObjectApproached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToDestination",
                    "Name": "MoveToDestination"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SpecificTaskSubTree",
                    "Name": "SpecificTaskSubTree"
                }
            ]
        }
    }
}
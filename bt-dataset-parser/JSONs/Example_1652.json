                                "Decorators": [
                                    {
                                        "IsObjectInReach?": "IsObjectInReach"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "GrabObject",
                                "Name": "GrabObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "CheckObject",
                                "Name": "CheckObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "MoveToDestination",
                                "Name": "MoveToDestination"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectInReach? THEN\n\t\t\t\tDO GrabObject\n\t\tELSE\n\t\t\tDO CheckObject\n\t\t\tDO MoveToDestination\n\t\tEND\n\tEND\n"

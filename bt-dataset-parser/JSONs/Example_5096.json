{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find and grab object. If not, scan area. Check properties, do specific task if possible. Move if needed.     list of available nodes: <Action ID = TakeObject    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = DoSpecificTask    /> <Action ID = MoveRobot    /> <Condition ID = IsObjectApproached    /> <Condition ID = IsMoveNeeded    /> <Action ID = ScanAreaForObjects    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsMoveNeeded": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],

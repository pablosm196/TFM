                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "ObjectHasKey?": "ObjectHasKey"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "PerformTask",
                                "Name": "PerformTask"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSELECTOR\n\t\t\t\tSEQUENCE\n\t\t\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\t\t\tDO TakeObject\n\t\t\t\tEND\n\t\t\t\tDO MoveToObject\n\t\t\t\t\tIF ObjectHasKey? THEN\n\t\t\t\t\tDO PerformTask\n\t\t\tEND\n\tEND\n"

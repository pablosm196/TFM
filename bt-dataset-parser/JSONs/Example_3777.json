    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectDetected? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO CheckObjectProperties\n\t\t\tDO PickUpObject\n\t\t\tDO PerformTask\n\t\t\tDO DropObject\n\t\tEND\n\t\tDO MoveToFrontOfShelf\n\t\tDO CheckShelf\n\tEND\n"

    "code": "\tSEQUENCE\n\t\t\tIF IsObjectFound? THEN\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\t\tDO GrabObject\n\t\t\tELSE\n\t\t\t\tDO CheckObjectProperties\n\t\t\t\tDO DoSpecificTask\n\t\t\tEND\n\tELSE\n\t\tSEQUENCE\n\t\t\tDO MoveToNewLocation\n\t\t\tDO ScanAreaForObject\n\t\tEND\n\tEND\n"

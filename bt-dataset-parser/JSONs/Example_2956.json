{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. Robot finds object, approaches, takes it. If object properties acceptable, performs task. Else, moves to next object. list of available nodes: <Action ID = ApproachObject    /> <Condition ID = HasReachedObject    /> <SubTree ID = CheckObjectProperties    /> <Action ID = TakeObject    /> <Action ID = MoveToNextObject    /> <Action ID = PerformSpecificTask    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "HasReachedObject": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [],
                        "Task": "ApproachObject",
                        "Name": "ApproachObject"
                    },
                    {
                        "Type": "Selector",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Sequence",
                                "Decorators": [],
                                "Nodes": [
                                    {
                                        "Type": "Task",
                                        "Decorators": [
                                            {
                                                "HasReachedObject?": "HasReachedObject"
                                            }
                                        ],
                                        "Nodes": [],
                                        "Task": "TakeObject",
                                        "Name": "TakeObject"
                                    }
                                ]
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "MoveToNextObject",
                                "Name": "MoveToNextObject"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "CheckObjectProperties",
                        "Name": "CheckObjectProperties"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "PerformSpecificTask",
                        "Name": "PerformSpecificTask"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF HasReachedObject? THEN\n\t\t\t\t\tDO TakeObject\n\t\t\tEND\n\t\t\tDO MoveToNextObject\n\t\tEND\n\t\tDO CheckObjectProperties\n\t\tDO PerformSpecificTask\n\tEND\n"
}
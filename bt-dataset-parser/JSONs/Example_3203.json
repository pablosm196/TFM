{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find object and grab it. Check properties. If not found, scan area or wander around.     list of available nodes: <Action ID = MoveToTarget    /> <Action ID = GrabObject    /> <SubTree ID = CheckObjectProperties    /> <Condition ID = IsObjectDetected    /> <Condition ID = IsObjectReachable    /> <Action ID = ScanAreaForObject    /> <Action ID = WanderAround    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectReachable": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectDetected?": "IsObjectDetected"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectReachable?": "IsObjectReachable"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToTarget",
                            "Name": "MoveToTarget"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        }
                    ]
                }
            ]
        }
    }
}
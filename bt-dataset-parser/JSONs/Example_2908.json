{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is found, take/move it. If not, then check properties or do specific task. list of available nodes: <Action ID = TakeObject    /> <Action ID = MoveToLocation    /> <Condition ID = IsObjectFound    /> <Action ID = CheckObjectProperties    /> <SubTree ID = SpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectFound": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Selector",
                    "Decorators": [
                        {
                            "IsObjectFound?": "IsObjectFound"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "TakeObject",
                                    "Name": "TakeObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "MoveToLocation",
                                    "Name": "MoveToLocation"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "CheckObjectProperties",
                                    "Name": "CheckObjectProperties"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "SpecificTask",
                                    "Name": "SpecificTask"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }
}
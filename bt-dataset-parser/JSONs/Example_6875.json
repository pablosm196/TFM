                        "Task": "GrabObject",
                        "Name": "GrabObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsObjectInGrip?": "IsObjectInGrip"
                            }
                        ],
                        "Nodes": [],
                        "Task": "MoveToDestination",
                        "Name": "MoveToDestination"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "CheckObjectProperties",
                        "Name": "CheckObjectProperties"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "SpecificTask",
                        "Name": "SpecificTask"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\tDO GrabObject\n\t\t\tIF IsObjectInGrip? THEN\n\t\t\tDO MoveToDestination\n\tELSE\n\t\tDO CheckObjectProperties\n\t\tDO SpecificTask\n\tEND\n"

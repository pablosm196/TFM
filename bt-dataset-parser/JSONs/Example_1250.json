                    "Decorators": [
                        {
                            "IsObjectGrabbed?": "IsObjectGrabbed"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToDestination",
                    "Name": "MoveToDestination"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsDestinationReached?": "IsDestinationReached"
                        }
                    ],
                    "Nodes": [],
                    "Task": "DropObject",
                    "Name": "DropObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "PerformSpecificTask",
                    "Name": "PerformSpecificTask"
                }
            ]
        }
    }

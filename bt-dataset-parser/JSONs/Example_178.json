    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO ProcessObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\tDO MoveToSearchArea\n\t\t\tDO ScanAreaForObject\n\t\tEND\n\t\tDO MoveToNextSearchArea\n\tEND\n"

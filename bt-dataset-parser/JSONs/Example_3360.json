    "code": "\tSEQUENCE\n\t\tDO FindObject\n\t\tSEQUENCE\n\t\t\tDO ApproachObject\n\t\t\t\tIF IsObjectTouchable? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\t\tIF IsObjectHeavy? THEN\n\t\t\t\tDO MoveObject\n\t\tEND\n\t\tSELECTOR\n\t\t\t\tIF IsObjectFragile? THEN\n\t\t\t\tDO InspectObject\n\t\tELSE\n\t\t\tDO PerformTask\n\t\tEND\n\tEND\n"

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object found, take it, check its properties, do specific task. If not found, move to location. list of available nodes: <Action ID = TakeObject    /> <Condition ID = ObjectFound    /> <SubTree ID = DoSpecificTask    /> <Action ID = MoveToLocation    /> <Action ID = TakeObject    /> <SubTree ID = CheckObjectProperties    /> <Condition ID = ObjectLocated    />",
    "BT": {
        "Blackboard": [
            {
                "ObjectFound": "Boolean"
            },
            {
                "ObjectLocated": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "ObjectFound?": "ObjectFound"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "DoSpecificTask",
                            "Name": "DoSpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "ObjectLocated?": "ObjectLocated"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToLocation",
                            "Name": "MoveToLocation"
                        }
                    ]
                }
            ]
        }
    }
}
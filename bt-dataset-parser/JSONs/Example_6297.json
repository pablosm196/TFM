{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find object, move to it, take & check it, perform specific task if needed, else scan area. list of available nodes: <Action ID = ScanAreaForObject    /> <Action ID = MoveToFindObject    /> <Action ID = TakeObject    /> <Condition ID = IsObjectFound    /> <Condition ID = IsObjectInRange    /> <Action ID = CheckObjectProperties    /> <SubTree ID = PerformSpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectInRange": "Boolean"
            },
            {
                "IsObjectFound": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectFound?": "IsObjectFound"
                        }
                    ],
                    "Nodes": [
                        {

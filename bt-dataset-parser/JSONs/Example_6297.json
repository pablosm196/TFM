                        "Task": "MoveToFindObject",
                        "Name": "MoveToFindObject"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectFound? THEN\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectInRange? THEN\n\t\t\t\t\tDO TakeObject\n\t\t\tELSE\n\t\t\t\tDO CheckObjectProperties\n\t\t\t\tDO PerformSpecificTask\n\t\t\tEND\n\tELSE\n\t\tDO MoveToFindObject\n\tEND\n"

{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes.     If object seen, approach and take it, then process object and return. If not, scan or move.     list of available nodes: <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <Action ID = ReturnObject    /> <Action ID = ScanAreaForObject    /> <Action ID = MoveToNewLocation    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectInReach    /> <SubTree ID = ProcessObject    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectInReach": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [],
                        "Task": "ApproachObject",
                        "Name": "ApproachObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsObjectInReach?": "IsObjectInReach"
                            }
                        ],
                        "Nodes": [],
                        "Task": "TakeObject",
                        "Name": "TakeObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ProcessObject",
                        "Name": "ProcessObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ReturnObject",
                        "Name": "ReturnObject"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\t\tIF IsObjectInReach? THEN\n\t\t\tDO TakeObject\n\tELSE\n\t\tDO ProcessObject\n\t\tDO ReturnObject\n\tEND\n"
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If task started, find and grab object. Move to destination, check properties and place it. Finally, scan for more.     list of available nodes: <Action ID = ScanAreaForObjects    /> <SubTree ID = FindAndGrabObject    /> <Condition ID = IsTaskStarted    /> <Action ID = PlaceObject    /> <Action ID = MoveToDestination    /> <SubTree ID = CheckObjectProperties    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectHeld": "Boolean"
            },
            {
                "IsTaskStarted": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTaskStarted?": "IsTaskStarted"
                                }
                            ],
                            "Nodes": [],
                            "Task": "FindAndGrabObject",
                            "Name": "FindAndGrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectHeld?": "IsObjectHeld"
                                }
                            ],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PlaceObject",
                            "Name": "PlaceObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObjects",
                    "Name": "ScanAreaForObjects"
                }
            ]
        }
    }
}
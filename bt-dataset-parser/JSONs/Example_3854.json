    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsRobotApproachingObject? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO ProcessObjectTask\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectDetected? THEN\n\t\t\t\tDO MoveTowardsObject\n\t\tEND\n\t\tDO ScanAreaForObject\n\tEND\n"

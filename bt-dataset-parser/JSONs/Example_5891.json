{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object is approached then grab it, check its properties, and perform task.  If not, move towards object. Scan area.     list of available nodes: <Action ID = GrabObject    /> <SubTree ID = ProcessObject>     <Sequence>         <Action ID = CheckObjectColor    />         <Action ID = CheckObjectShape    />     </Sequence> </SubTree> <Condition ID = IsObjectApproached    /> <Action ID = MoveTowardsObject    /> <Sequence>     <Condition ID = IsObjectVisible    />     <Action ID = ScanArea    /> </Sequence>",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],

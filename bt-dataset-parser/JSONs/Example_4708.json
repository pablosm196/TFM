{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is near, then grab it or move towards it. Check properties, perform specific task. list of available nodes: <Action ID = GrabObject    /> <Action ID = MoveToObject    /> <Action ID = CheckObjectProperties    /> <SubTree ID = SpecificTask    /> <Condition ID = isObjectDetected    /> <Condition ID = isObjectWithinReach    /> <Condition ID = isObjectNear    />",
    "BT": {
        "Blackboard": [
            {
                "isObjectWithinReach": "Boolean"
            },
            {
                "isObjectDetected": "Boolean"
            },
            {
                "isObjectNear": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Sequence",
                                    "Decorators": [
                                        {
                                            "isObjectNear?": "isObjectNear"
                                        }
                                    ],
                                    "Nodes": [
                                        {
                                            "Type": "Task",
                                            "Decorators": [
                                                {
                                                    "isObjectWithinReach?": "isObjectWithinReach"
                                                }
                                            ],
                                            "Nodes": [],
                                            "Task": "GrabObject",
                                            "Name": "GrabObject"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "isObjectDetected?": "isObjectDetected"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "MoveToObject",
                                    "Name": "MoveToObject"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SpecificTask",
                    "Name": "SpecificTask"
                }
            ]
        }
    }
}
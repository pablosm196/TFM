    "code": "\tSEQUENCE\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF isObjectNear? THEN\n\t\t\t\t\tSEQUENCE\n\t\t\t\t\t\t\tIF isObjectWithinReach? THEN\n\t\t\t\t\t\t\tDO GrabObject\n\t\t\t\t\tEND\n\t\t\tEND\n\t\t\tSEQUENCE\n\t\t\t\t\tIF isObjectDetected? THEN\n\t\t\t\t\tDO MoveToObject\n\t\t\tEND\n\t\tEND\n\t\tDO CheckObjectProperties\n\t\tDO SpecificTask\n\tEND\n"

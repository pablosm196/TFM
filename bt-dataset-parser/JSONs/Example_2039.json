{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If an object is visible, approach and grasp it. Check properties and do specific task, else scan or move randomly. list of available nodes: <Action ID = ApproachObject    /> <Action ID = GraspObject    /> <Action ID = CheckObjectProperties    /> <Action ID = DoSpecificTask    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectGraspable    /> <Action ID = ScanAreaForObject    /> <Action ID = MoveToRandomLocation    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectGraspable": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectGraspable?": "IsObjectGraspable"
                        }
                    ],
                    "Nodes": [],
                    "Task": "GraspObject",
                    "Name": "GraspObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "DoSpecificTask",
                    "Name": "DoSpecificTask"
                }
            ]
        }
    }
}
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectFound? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO DoTask\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectInView? THEN\n\t\t\t\tDO ApproachObject\n\t\tEND\n\t\tDO ScanArea\n\tEND\n"

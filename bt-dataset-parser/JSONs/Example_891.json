    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO TakeObject\n\t\t\tDO CheckObjectProperties\n\t\t\tDO SpecificTask\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsAreaSafe? THEN\n\t\t\t\tDO MoveToNextLocation\n\t\tELSE\n\t\t\tDO ScanAreaForObjects\n\t\tEND\n\tEND\n"

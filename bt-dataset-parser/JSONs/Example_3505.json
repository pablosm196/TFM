    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO PerformObjectCheck\n\t\t\tDO MoveToLocation\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsLocationKnown? THEN\n\t\t\t\tDO MoveToLocation\n\t\tEND\n\t\tDO ScanAreaForObject\n\tEND\n"

                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectSeen? THEN\n\t\t\t\tDO ApproachObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsAtObject? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO CheckObjectProperties\n\t\t\tDO SpecificTask\n\t\tEND\n\t\tDO MoveToNewLocation\n\tEND\n"

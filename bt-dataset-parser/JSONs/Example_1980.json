{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object found, move to it, take it, check if valid, do task. Scan or move. list of available nodes: <Action ID = IsObjectFound    /> <Action ID = MoveToObject    /> <Action ID = TakeObject    /> <Condition ID = IsObjectValid    /> <SubTree ID = DoSpecificTask    /> <Action ID = ScanAreaForObjects    /> <Action ID = MoveToAnotherArea    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectFound": "Boolean"
            },
            {
                "IsObjectValid": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectFound?": "IsObjectFound"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToObject",
                    "Name": "MoveToObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "TakeObject",
                    "Name": "TakeObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectValid?": "IsObjectValid"
                        }
                    ],
                    "Nodes": [],
                    "Task": "DoSpecificTask",
                    "Name": "DoSpecificTask"
                }
            ]
        }
    }
}
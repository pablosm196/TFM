    "code": "\tSEQUENCE\n\t\t\tIF IsObjectDetected? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO ApproachObject\n\t\t\t\tDO GrabObject\n\t\t\t\tDO InspectObject\n\t\t\t\tDO MoveToObjectStorage\n\t\t\t\tDO ReleaseObject\n\t\t\tEND\n\tELSE\n\t\tDO ScanArea\n\tEND\n"

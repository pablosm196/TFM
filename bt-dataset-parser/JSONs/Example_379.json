{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find, approach, take and inspect object. Then, perform specific task based on object properties.     list of available nodes: <Action ID = FindObject    /> <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <Condition ID = isObjectHeavy    /> <Action ID = CallForHelp    /> <Condition ID = isObjectFragile    /> <Action ID = HandleObjectCarefully    /> <Action ID = InspectObject    /> <SubTree ID = PerformSpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "isObjectHeavy": "Boolean"
            },
            {
                "isObjectFragile": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "FindObject",
                    "Name": "FindObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "TakeObject",
                    "Name": "TakeObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "isObjectHeavy?": "isObjectHeavy"
                                }
                            ],
                            "Nodes": [],
                            "Task": "CallForHelp",
                            "Name": "CallForHelp"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "isObjectFragile?": "isObjectFragile"
                                }
                            ],
                            "Nodes": [],
                            "Task": "HandleObjectCarefully",
                            "Name": "HandleObjectCarefully"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "InspectObject",
                    "Name": "InspectObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "PerformSpecificTask",
                    "Name": "PerformSpecificTask"
                }
            ]
        }
    }
}
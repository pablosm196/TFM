    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO ApproachObject\n\t\t\tEND\n\tELSE\n\t\tSEQUENCE\n\t\t\tDO GrabObject\n\t\t\tDO CheckObjectProperties\n\t\t\tDO PerformSpecificTask\n\t\t\tDO MoveToDestination\n\t\tEND\n\tEND\n"

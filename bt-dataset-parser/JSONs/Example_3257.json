{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, approach it. If within range, pick it up, process it, or scan properties. list of available nodes: <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectWithinRange    /> <Action ID = ApproachObject    /> <Action ID = PickUpObject    /> <Action ID = ScanObjectProperties    /> <SubTree ID = ProcessObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectWithinRange": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Selector",
                                    "Decorators": [
                                        {
                                            "IsObjectWithinRange?": "IsObjectWithinRange"
                                        }
                                    ],
                                    "Nodes": [
                                        {
                                            "Type": "Sequence",
                                            "Decorators": [],
                                            "Nodes": [
                                                {
                                                    "Type": "Task",
                                                    "Decorators": [],
                                                    "Nodes": [],
                                                    "Task": "PickUpObject",
                                                    "Name": "PickUpObject"
                                                },
                                                {
                                                    "Type": "Task",
                                                    "Decorators": [],
                                                    "Nodes": [],
                                                    "Task": "ProcessObject",
                                                    "Name": "ProcessObject"
                                                }
                                            ]
                                        },
                                        {
                                            "Type": "Task",
                                            "Decorators": [],
                                            "Nodes": [],
                                            "Task": "ScanObjectProperties",
                                            "Name": "ScanObjectProperties"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }
}
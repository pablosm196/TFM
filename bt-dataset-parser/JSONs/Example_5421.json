    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO MoveToObject\n\t\tELSE\n\t\t\tDO CheckObjectProperties\n\t\t\tDO TakeObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsAtSpecificLocation? THEN\n\t\t\t\tDO SpecificTask\n\t\tEND\n\t\tDO ScanArea\n\tEND\n"

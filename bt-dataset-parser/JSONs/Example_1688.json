{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Move to find an object. Take it, process its properties, and do a specific task. list of available nodes: <Action ID = MoveToFindObject    /> <Action ID = TakeObject    /> <SubTree ID = ProcessObjectProperties    /> <Action ID = DoSpecificTask    /> <Action ID = ScanAreaForObjects    /> <Condition ID = IsObjectInReach    /> <Action ID = MoveToFindObject    /> <Action ID = IsObjectVisible    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectInReach": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToFindObject",
                    "Name": "MoveToFindObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectInReach?": "IsObjectInReach"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObjectProperties",
                            "Name": "ProcessObjectProperties"
                        },
                        {
                            "Type": "Selector",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "DoSpecificTask",
                                    "Name": "DoSpecificTask"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "ScanAreaForObjects",
                                    "Name": "ScanAreaForObjects"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }
}
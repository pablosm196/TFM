{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Move to object, take it and move it to destination. If path blocked, find alternate route. Finally, idle. list of available nodes: <Action ID = ApproachObject    /> <Condition ID = IsObjectVisible    /> <Action ID = TakeObject    /> <Condition ID = IsObjectHeavy    /> <Action ID = MoveObjectToDestination    /> <Sequence>     <Condition ID = IsPathBlocked    />     <Action ID = FindAlternateRoute    />     <Action ID = MoveToDestination    /> </Sequence> <Action ID = Idle    />",
    "BT": {
        "Blackboard": [
            {
                "IsPathBlocked": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectHeavy": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectHeavy?": "IsObjectHeavy"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveObjectToDestination",
                            "Name": "MoveObjectToDestination"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsPathBlocked?": "IsPathBlocked"
                                }
                            ],
                            "Nodes": [],
                            "Task": "FindAlternateRoute",
                            "Name": "FindAlternateRoute"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "Idle",
                    "Name": "Idle"
                }
            ]
        }
    }
}
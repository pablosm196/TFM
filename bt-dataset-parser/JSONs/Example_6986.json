{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find and take object. Check it. Execute task from subtree. Move, avoid obstacles, turn around. list of available nodes: <Action ID = MoveToObject    /> <Action ID = TakeObject    /> <Action ID = CheckObjectProperties    /> <SubTree ID = PerformTask    /> <Condition ID = IsObjectFound    /> <Condition ID = IsPathClear    /> <Action ID = MoveForward    /> <Action ID = TurnAround    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectFound": "Boolean"
            },
            {
                "IsPathClear": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectFound?": "IsObjectFound"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PerformTask",
                            "Name": "PerformTask"
                        }
                    ]
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsPathClear?": "IsPathClear"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "MoveForward",
                                    "Name": "MoveForward"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TurnAround",
                            "Name": "TurnAround"
                        }
                    ]
                }
            ]
        }
    }
}
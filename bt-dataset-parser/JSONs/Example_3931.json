{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. Approach object and grab it if close. If not, inspect object or move to the next location. list of available nodes: <Action ID = TakeObject    /> <Action ID = InspectObject    /> <Action ID = MoveToNextLocation    /> <Condition ID = IsObjectApproached    /> <Condition ID = DoesObjectMeetRequirements    /> <SubTree ID = MobileRoboTasks    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "DoesObjectMeetRequirements": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectApproached?": "IsObjectApproached"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "TakeObject",
                                "Name": "TakeObject"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "DoesObjectMeetRequirements?": "DoesObjectMeetRequirements"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "InspectObject",
                                "Name": "InspectObject"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "MoveToNextLocation",
                        "Name": "MoveToNextLocation"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\tDO TakeObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF DoesObjectMeetRequirements? THEN\n\t\t\t\tDO InspectObject\n\t\tEND\n\t\tDO MoveToNextLocation\n\tEND\n"
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If the object is approached, take it, move to destination and execute task. Else, approach and scan task properties or explore area. list of available nodes: <Action ID = TakeObject    /> <Action ID = MoveToDestination    /> <SubTree ID = ExecuteTask    /> <Condition ID = IsObjectApproached    /> <Condition ID = IsTaskVisible    /> <Action ID = ApproachTask    /> <Action ID = ScanTaskProperties    /> <Action ID = ExploreAreaForTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsTaskVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectApproached?": "IsObjectApproached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ExecuteTask",
                            "Name": "ExecuteTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTaskVisible?": "IsTaskVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachTask",
                            "Name": "ApproachTask"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanTaskProperties",
                            "Name": "ScanTaskProperties"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ExploreAreaForTask",
                    "Name": "ExploreAreaForTask"
                }
            ]
        }
    }
}
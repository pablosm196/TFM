    "code": "\tSEQUENCE\n\t\t\tIF IsObjectFound? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO TakeObject\n\t\t\t\tDO MoveToDestination\n\t\t\t\tDO CheckObjectProperties\n\t\t\tEND\n\tELSE\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\tDO ScanAreaForObjects\n\t\t\t\tDO MoveToNextScanningPoint\n\t\t\tEND\n\t\t\tDO DoNothing\n\t\tEND\n\tEND\n"

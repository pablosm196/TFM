{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find an object, pick it up, check it, move it, or avoid obstacles if needed.     list of available nodes: <Action ID = ApproachToObject    /> <Action ID = PickUpObject    /> <Action ID = CheckObjectProperties    /> <Action ID = MoveObjectToLocation    /> <Action ID = AvoidObstacle    /> <SubTree ID = MobileRobotTask    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObstacleDetected    /> <Action ID = ScanAreaForObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObstacleDetected": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachToObject",
                            "Name": "ApproachToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PickUpObject",
                            "Name": "PickUpObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveObjectToLocation",
                            "Name": "MoveObjectToLocation"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObstacleDetected?": "IsObstacleDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "AvoidObstacle",
                            "Name": "AvoidObstacle"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObject",
                    "Name": "ScanAreaForObject"
                }
            ]
        }
    }
}
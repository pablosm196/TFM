{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object visible, approach and take it. If not, perform task 1 or 2. Finally, move. list of available nodes: <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <Action ID = PerformTask1    /> <Action ID = PerformTask2    /> <Action ID = Move    /> <Condition ID = IsObjectVisible    /> <SubTree ID = MobileRobotTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsTask1": "Boolean"
            },
            {
                "IsTask2": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTask1?": "IsTask1"
                                }
                            ],
                            "Nodes": [],
                            "Task": "PerformTask1",
                            "Name": "PerformTask1"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTask2?": "IsTask2"
                                }
                            ],
                            "Nodes": [],
                            "Task": "PerformTask2",
                            "Name": "PerformTask2"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "Move",
                    "Name": "Move"
                }
            ]
        }
    }
}
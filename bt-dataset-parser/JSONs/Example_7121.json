{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find and grab object. If nearby, approach and take. If not visible, move closer. Finally, scan area for objects.     list of available nodes: <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <Action ID = MoveToVisibleObject    /> <Action ID = ScanAreaForObjects    /> <Condition ID = IsObjectNearby    /> <Condition ID = IsObjectVisible    /> <SubTree ID = FindObjectAndTake    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectNearby": "Boolean"
            }
        ],
        "Node": {

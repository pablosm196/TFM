{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. Find and take object if it is visible. Approach it, move, release, process it. If not, scan the area. list of available nodes: <Action ID = ApproachObject    /> <Action ID = MoveToNextSearchArea    /> <Action ID = ScanArea    /> <Action ID = MoveToDestination    /> <Action ID = ReleaseObject    /> <Action ID = ProcessObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectGrabbed    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectGrabbed": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [],
                        "Task": "ApproachObject",
                        "Name": "ApproachObject"
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectGrabbed?": "IsObjectGrabbed"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "MoveToDestination",
                                "Name": "MoveToDestination"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ReleaseObject",
                                "Name": "ReleaseObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ProcessObject",
                                "Name": "ProcessObject"
                            }
                        ]
                    },
                    {
                        "Type": "Selector",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "MoveToNextSearchArea",
                                "Name": "MoveToNextSearchArea"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ScanArea",
                                "Name": "ScanArea"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectGrabbed? THEN\n\t\t\t\tDO MoveToDestination\n\t\tELSE\n\t\t\tDO ReleaseObject\n\t\t\tDO ProcessObject\n\t\tEND\n\t\tSELECTOR\n\t\t\tDO MoveToNextSearchArea\n\t\t\tDO ScanArea\n\t\tEND\n\tEND\n"
}
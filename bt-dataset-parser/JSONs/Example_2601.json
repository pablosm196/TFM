{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is seen, approach, take and process it. Otherwise, move randomly and scan. list of available nodes: <Action ID = ApproachToObject    /> <Action ID = TakeObject    /> <Action ID = ProcessObject    /> <Action ID = MoveToRandomPosition    /> <Action ID = ScanForObjects    /> <Condition ID = ObjectIsVisible    /> <SubTree ID = FindTakeAndProcessObject    />",
    "BT": {
        "Blackboard": [
            {
                "ObjectIsVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "ObjectIsVisible?": "ObjectIsVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachToObject",
                            "Name": "ApproachToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObject",
                            "Name": "ProcessObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToRandomPosition",
                            "Name": "MoveToRandomPosition"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanForObjects",
                            "Name": "ScanForObjects"
                        }
                    ]
                }
            ]
        }
    }
}
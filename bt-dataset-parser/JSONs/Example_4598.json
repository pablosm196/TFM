{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If object is reached, pick it up. If not, move to object, inspect it and perform task. list of available nodes: <Action ID = PickUpObject    /> <Action ID = MoveToObject    /> <Condition ID = IsDestinationReached    /> <Condition ID = IsObjectInReach    /> <Condition ID = IsObjectColorRed    /> <Action ID = InspectObject    /> <Action ID = PerformTask    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsDestinationReached": "Boolean"
            },
            {
                "IsObjectInReach": "Boolean"
            },
            {
                "IsObjectColorRed": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsDestinationReached?": "IsDestinationReached"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "PickUpObject",
                                "Name": "PickUpObject"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "MoveToObject",
                                "Name": "MoveToObject"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectColorRed?": "IsObjectColorRed"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "InspectObject",
                                "Name": "InspectObject"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "PerformTask",
                        "Name": "PerformTask"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsDestinationReached? THEN\n\t\t\t\tDO PickUpObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\tDO MoveToObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectColorRed? THEN\n\t\t\t\tDO InspectObject\n\t\tEND\n\t\tDO PerformTask\n\tEND\n"
}
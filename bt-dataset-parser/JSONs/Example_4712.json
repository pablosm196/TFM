    "code": "\tSEQUENCE\n\t\t\tIF IsObjectApproached? THEN\n\t\t\tDO TakeObject\n\tELSE\n\t\tDO ProcessObjectProperties\n\t\tDO MoveToLocation\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsTaskComplete? THEN\n\t\t\t\t\tDO SpecificTask\n\t\t\tEND\n\t\t\tDO ScanAreaForObjects\n\t\tEND\n\tEND\n"

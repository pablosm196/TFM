    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\t\tIF IsObjectGrabbed? THEN\n\t\t\t\tDO MoveToObjectStorage\n\t\tELSE\n\t\t\tDO ProcessObjectProperties\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObstacleDetected? THEN\n\t\t\t\tDO AvoidObstacle\n\t\tEND\n\t\tDO RandomMovement\n\tEND\n"

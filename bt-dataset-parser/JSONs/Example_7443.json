{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Search & take object, check it, do task. If object out of reach, then approach. Finally, scan area.     list of available nodes: <Action ID = SearchForObject    /> <Condition ID = IsObjectVisible    /> <Action ID = ApproachObject    /> <Condition ID = IsObjectApproached    /> <Action ID = TakeObject    /> <Action ID = MoveToDestination    /> <Condition ID = IsObjectChecked    /> <SubTree ID = DoSpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectChecked": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SearchForObject",
                            "Name": "SearchForObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectApproached?": "IsObjectApproached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectChecked?": "IsObjectChecked"
                                }
                            ],
                            "Nodes": [],
                            "Task": "DoSpecificTask",
                            "Name": "DoSpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        }
                    ]
                }
            ]
        }
    }
}
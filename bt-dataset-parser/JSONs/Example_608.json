{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If an object is approached, grab it, move to destination, check properties, and do a specific task. If not visible, scan area.     list of available nodes: <Action ID = GrabObject    /> <Action ID = MoveToDestination    /> <Action ID = ScanAreaForObject    /> <Action ID = ApproachObject    /> <Action ID = CheckObjectProperties    /> <Action ID = SpecificTask    /> <Condition ID = IsObjectApproached    /> <Condition ID = IsObjectVisible    /> <SubTree ID = ProcessObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "HasObjectInGripper": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectApproached?": "IsObjectApproached"
                        }
                    ],
                    "Nodes": [],
                    "Task": "GrabObject",
                    "Name": "GrabObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "HasObjectInGripper?": "HasObjectInGripper"
                                }
                            ],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SpecificTask",
                    "Name": "SpecificTask"
                }
            ]
        }
    }
}
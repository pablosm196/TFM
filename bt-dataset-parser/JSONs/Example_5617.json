{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If object found, then approach and take it, process properties, do a task and move to target, otherwise explore area. list of available nodes: <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <SubTree ID = ProcessObjectProperties    /> <Action ID = SpecificTask    /> <Action ID = MoveToTarget    /> <Condition ID = IsObjectFound    /> <Action ID = ExploreArea    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectFound": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],

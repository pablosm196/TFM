                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectFound?": "IsObjectFound"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "ApproachObject",
                                "Name": "ApproachObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "TakeObject",
                                "Name": "TakeObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ProcessObjectProperties",
                                "Name": "ProcessObjectProperties"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "SpecificTask",
                                "Name": "SpecificTask"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "MoveToTarget",
                                "Name": "MoveToTarget"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ExploreArea",
                        "Name": "ExploreArea"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectFound? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO TakeObject\n\t\t\tDO ProcessObjectProperties\n\t\t\tDO SpecificTask\n\t\t\tDO MoveToTarget\n\t\tEND\n\t\tDO ExploreArea\n\tEND\n"

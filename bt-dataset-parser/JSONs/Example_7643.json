    "code": "\tSEQUENCE\n\t\t\tIF IsObjectFound? THEN\n\t\t\tSELECTOR\n\t\t\t\tSEQUENCE\n\t\t\t\t\tDO ApproachObject\n\t\t\t\t\tDO PickUpObject\n\t\t\t\t\t\tIF IsObjectHeld? THEN\n\t\t\t\t\t\tDO UseObject\n\t\t\t\tEND\n\t\t\t\tDO ScanArea\n\t\t\t\tDO MoveToNextArea\n\t\t\tEND\n\tEND\n"

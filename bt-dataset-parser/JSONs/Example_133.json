{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object found, move to it, check its properties, then take or scan again, and perform task. list of available nodes: <Action ID = MoveToObject    /> <Action ID = CheckProperties    /> <Action ID = TakeObject    /> <SubTree ID = TaskSubTree    /> <Action ID = ScanForObjectAgain    /> <Action ID = MoveToNextObject    /> <Condition ID = ObjectFound    />",
    "BT": {
        "Blackboard": [
            {
                "ObjectFound": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "ObjectFound?": "ObjectFound"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckProperties",
                            "Name": "CheckProperties"
                        },
                        {
                            "Type": "Selector",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Sequence",
                                    "Decorators": [],
                                    "Nodes": [
                                        {
                                            "Type": "Task",
                                            "Decorators": [],
                                            "Nodes": [],
                                            "Task": "TakeObject",
                                            "Name": "TakeObject"
                                        },
                                        {
                                            "Type": "Task",
                                            "Decorators": [],
                                            "Nodes": [],
                                            "Task": "TaskSubTree",
                                            "Name": "TaskSubTree"
                                        }
                                    ]
                                },
                                {
                                    "Type": "Sequence",
                                    "Decorators": [],
                                    "Nodes": [
                                        {
                                            "Type": "Task",
                                            "Decorators": [],
                                            "Nodes": [],
                                            "Task": "ScanForObjectAgain",
                                            "Name": "ScanForObjectAgain"
                                        },
                                        {
                                            "Type": "Task",
                                            "Decorators": [],
                                            "Nodes": [],
                                            "Task": "MoveToNextObject",
                                            "Name": "MoveToNextObject"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If an object is visible, approach it. Then, take, process it and move on. If not, scan area.     list of available nodes: <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <SubTree ID = ProcessObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectApproached    /> <Action ID = ScanAreaForObjects    /> <Action ID = MoveToSelectedLocation    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectVisible?": "IsObjectVisible"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "ApproachObject",
                                    "Name": "ApproachObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectApproached?": "IsObjectApproached"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "TakeObject",
                                    "Name": "TakeObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "ProcessObject",
                                    "Name": "ProcessObject"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanAreaForObjects",
                            "Name": "ScanAreaForObjects"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToSelectedLocation",
                    "Name": "MoveToSelectedLocation"
                }
            ]
        }
    }
}
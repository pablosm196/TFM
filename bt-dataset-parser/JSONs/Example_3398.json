{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find, approach, and check objects. Then grab, move, analyze, and perform specific task.     list of available nodes: <Action ID = GrabObject    /> <Action ID = DropObject    /> <Action ID = MoveToDestination    /> <Action ID = ApproachObject    /> <Action ID = ScanAreaForObject    /> <SubTree ID = ProcessObject    /> <SubTree ID = CheckObjectProperties    /> <Condition ID = IsObjectApproached    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsDestinationReached    />",
    "BT": {
        "Blackboard": [
            {
                "IsDestinationReached": "Boolean"
            },
            {
                "IsObjectApproached": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectApproached?": "IsObjectApproached"
                        }
                    ],
                    "Nodes": [],
                    "Task": "GrabObject",
                    "Name": "GrabObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ProcessObject",
                    "Name": "ProcessObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToDestination",
                    "Name": "MoveToDestination"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsDestinationReached?": "IsDestinationReached"
                        }
                    ],
                    "Nodes": [],
                    "Task": "DropObject",
                    "Name": "DropObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "DoSpecificTask",
                    "Name": "DoSpecificTask"
                }
            ]
        }
    }
}
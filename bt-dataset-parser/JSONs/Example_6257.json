{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is approached, else take and move it or notify operator, in order to complete mobile robot task. list of available nodes: <Action ID = TakeObject    /> <Action ID = NotifyOperator    /> <Action ID = MoveToDestination    /> <Condition ID = IsObjectHeavy    /> <Condition ID = IsObjectApproached    /> <SubTree ID = MobileRobotTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectHeavy": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Selector",
                    "Decorators": [
                        {
                            "IsObjectApproached?": "IsObjectApproached"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "TakeObject",
                                    "Name": "TakeObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "MoveToDestination",
                                    "Name": "MoveToDestination"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectHeavy?": "IsObjectHeavy"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "NotifyOperator",
                                    "Name": "NotifyOperator"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }
}
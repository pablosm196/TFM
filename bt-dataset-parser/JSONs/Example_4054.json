                                "Task": "SortObject",
                                "Name": "SortObject"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "MoveToLocationB",
                        "Name": "MoveToLocationB"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectInRange? THEN\n\t\t\t\tDO GrabObject\n\t\tELSE\n\t\t\tDO SortObject\n\t\tEND\n\t\tDO MoveToLocationB\n\tEND\n"

    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectLocated? THEN\n\t\t\t\tDO PickupObject\n\t\tELSE\n\t\t\tDO ProcessObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tEND\n\t\tDO ScanAreaForObject\n\tEND\n"

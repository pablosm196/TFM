{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find object, take it, check properties, put in storage. Move to destination, stop. Scan if necessary. list of available nodes: <Action ID = TakeObject    /> <SubTree ID = ProcessObjectProperties    /> <Action ID = PutObjectInStorage    /> <Action ID = MoveToDestination    /> <Condition ID = IsDestinationReached    /> <Action ID = StopMoving    /> <Action ID = ScanForObjects    /> <Condition ID = IsObjectFound    />",
    "BT": {
        "Blackboard": [
            {
                "IsDestinationReached": "Boolean"
            },
            {
                "IsObjectFound": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectFound?": "IsObjectFound"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObjectProperties",
                            "Name": "ProcessObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PutObjectInStorage",
                            "Name": "PutObjectInStorage"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsDestinationReached?": "IsDestinationReached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "StopMoving",
                            "Name": "StopMoving"
                        }
                    ]
                }
            ]
        }
    }
}
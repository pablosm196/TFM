{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If an object is visible, move to it, take it, check and perform task. Else, scan and move to new area. list of available nodes: <Action ID = MoveToObject    /> <Action ID = TakeObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectWithinReach    /> <Action ID = CallForAssistance    /> <SubTree ID = ProcessObjectProperties    /> <Action ID = PerformSpecificTask    /> <Action ID = ScanAreaForObjects    /> <Action ID = MoveToNewArea    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectWithinReach": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectHeavy": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToObject",
                    "Name": "MoveToObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectWithinReach?": "IsObjectWithinReach"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectHeavy?": "IsObjectHeavy"
                                }
                            ],
                            "Nodes": [],
                            "Task": "CallForAssistance",
                            "Name": "CallForAssistance"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ProcessObjectProperties",
                    "Name": "ProcessObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "PerformSpecificTask",
                    "Name": "PerformSpecificTask"
                }
            ]
        }
    }
}
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\t\tIF IsObjectGrabbed? THEN\n\t\t\t\tDO Move\n\t\tELSE\n\t\t\t\tIF ObjectQualityCheck? THEN\n\t\t\t\tDO ObjectTask\n\t\tEND\n\t\tDO ScanAreaForObjects\n\tEND\n"

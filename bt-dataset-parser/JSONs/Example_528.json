{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, approach and grab it, move and check quality, do task, or scan area. list of available nodes: <Action ID = ApproachObject    /> <Action ID = Move    /> <Action ID = ObjectQualityCheck    /> <Action ID = ScanAreaForObjects    /> <Action ID = ObjectTask    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectGrabbed    />",
    "BT": {
        "Blackboard": [
            {
                "ObjectQualityCheck": "Boolean"
            },
            {
                "IsObjectGrabbed": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectGrabbed?": "IsObjectGrabbed"
                                }
                            ],
                            "Nodes": [],
                            "Task": "Move",
                            "Name": "Move"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "ObjectQualityCheck?": "ObjectQualityCheck"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ObjectTask",
                            "Name": "ObjectTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObjects",
                    "Name": "ScanAreaForObjects"
                }
            ]
        }
    }
}
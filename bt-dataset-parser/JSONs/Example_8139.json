{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If item is detected, move, take, check properties and process. Otherwise, scan areas. Do it now.     list of available nodes: <Action ID = CheckItemProperties    /> <Action ID = TakeItem    /> <SubTree ID = ProcessItem    /> <Action ID = MoveToItem    /> <Action ID = MoveToNextArea    /> <Action ID = ScanArea    /> <Condition ID = IsItemDetected    /> <Condition ID = IsAreaScanned    />",
    "BT": {
        "Blackboard": [
            {
                "IsAreaScanned": "Boolean"
            },
            {
                "IsItemDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsItemDetected?": "IsItemDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToItem",
                            "Name": "MoveToItem"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeItem",
                            "Name": "TakeItem"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckItemProperties",
                            "Name": "CheckItemProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessItem",
                            "Name": "ProcessItem"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsAreaScanned?": "IsAreaScanned"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToNextArea",
                            "Name": "MoveToNextArea"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanArea",
                    "Name": "ScanArea"
                }
            ]
        }
    }
}
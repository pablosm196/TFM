{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is approached, then take it, check it, and do specific task. Or approach it or scan area. list of available nodes: <Action ID = TakeObject    /> <Condition ID = IsObjectApproached    /> <Action ID = ApproachObject    /> <Sequence>     <Action ID = ScanAreaForObject    /> </Sequence> <Action ID = GrabObject    /> <SubTree ID = CheckObjectProperties    /> <Fallback>     <Sequence>         <Condition ID = IsObjectApproached    />         <Action ID = TakeObject    />         <SubTree ID = CheckObjectProperties    />     </Sequence>     <Sequence>         <Condition ID = IsObjectVisible    />         <Action ID = ApproachObject    />     </Sequence>     <Action ID = ScanAreaForObject    /> </Fallback> <SubTree ID = DoSpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectApproached?": "IsObjectApproached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObject",
                    "Name": "ScanAreaForObject"
                }
            ]
        }
    }
}
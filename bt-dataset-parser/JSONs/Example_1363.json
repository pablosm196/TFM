    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF isObjectDetected? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO TakeObject\n\t\t\tDO InspectObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\tDO MoveForward\n\t\tEND\n\t\tDO ScanArea\n\tEND\n"

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object in sight then approach, grab and carry it, check properties and deliver. Otherwise, avoid obstacles and scan environment. list of available nodes: <Action ID = ApproachObject    /> <Action ID = GrabObject    /> <Action ID = CarryObjectToDestination    /> <Action ID = AvoidObstacle    /> <Action ID = ScanEnvironment    /> <Condition ID = IsObjectInSight    /> <Condition ID = IsObjectGrabbable    /> <Condition ID = IsObstacleInPath    /> <SubTree ID = ObjectPropertiesTask    /> <SubTree ID = SpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectGrabbable": "Boolean"
            },
            {
                "IsObjectInSight": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectInSight?": "IsObjectInSight"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectGrabbable?": "IsObjectGrabbable"
                                }
                            ],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ObjectPropertiesTask",
                            "Name": "ObjectPropertiesTask"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CarryObjectToDestination",
                            "Name": "CarryObjectToDestination"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SpecificTask",
                    "Name": "SpecificTask"
                }
            ]
        }
    }
}
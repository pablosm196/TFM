    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO MoveToObject\n\t\tELSE\n\t\t\tDO GrabObject\n\t\t\tDO CheckObjectProperties\n\t\t\tDO DoTask\n\t\t\tDO ReleaseObject\n\t\tEND\n\t\tDO ExploreEnvironment\n\tEND\n"

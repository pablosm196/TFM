{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If no object found, scan. If object visible, approach, else search. Then grab object, move and process. list of available nodes: <Action ID = ScanArea    /> <Action ID = ApproachObject    /> <Action ID = SearchForObjects    /> <Action ID = IsObjectVisible    /> <Action ID = MoveObjectToLocation    /> <SubTree ID = ProcessObject    /> <Condition ID = IsObjectGrabbed    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectGrabbed": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanArea",
                    "Name": "ScanArea"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectVisible?": "IsObjectVisible"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "ApproachObject",
                                    "Name": "ApproachObject"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SearchForObjects",
                            "Name": "SearchForObjects"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectGrabbed?": "IsObjectGrabbed"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveObjectToLocation",
                            "Name": "MoveObjectToLocation"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObject",
                            "Name": "ProcessObject"
                        }
                    ]
                }
            ]
        }
    }
}
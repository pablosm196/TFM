                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTargetObjectInRange?": "IsTargetObjectInRange"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachTargetObject",
                            "Name": "ApproachTargetObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabTargetObject",
                            "Name": "GrabTargetObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTargetObjectDetected?": "IsTargetObjectDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ScanTargetObjectProperties",
                            "Name": "ScanTargetObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PerformSpecificTask",
                            "Name": "PerformSpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToNewLocation",
                    "Name": "MoveToNewLocation"
                }
            ]
        }
    }
}
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectFound? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO MoveToObj\n\t\t\t\tDO TakeObj\n\t\t\t\tDO CheckObjColor\n\t\t\t\tDO SpecificTask\n\t\t\tEND\n\tELSE\n\t\tDO ScanArea\n\tEND\n"

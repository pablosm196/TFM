{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If a visible object, then move to it, check it, take it or do a specific task. list of available nodes: <Action ID = MoveToObject    /> <Action ID = CheckObjectProperties    /> <Action ID = TakeObject    /> <SubTree ID = SpecificTask    /> <Condition ID = IsObjectVisible    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "MoveToObject",
                                "Name": "MoveToObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "CheckObjectProperties",
                                "Name": "CheckObjectProperties"
                            },
                            {
                                "Type": "Selector",
                                "Decorators": [],
                                "Nodes": [
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "TakeObject",
                                        "Name": "TakeObject"
                                    },
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "SpecificTask",
                                        "Name": "SpecificTask"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO MoveToObject\n\t\t\t\tDO CheckObjectProperties\n\t\t\t\tSELECTOR\n\t\t\t\t\tDO TakeObject\n\t\t\t\t\tDO SpecificTask\n\t\t\t\tEND\n\t\t\tEND\n\tEND\n"
}
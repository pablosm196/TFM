                                "Task": "AnalyzeObject",
                                "Name": "AnalyzeObject"
                            },
                            {
                                "Type": "Sequence",
                                "Decorators": [],
                                "Nodes": [
                                    {
                                        "Type": "Task",
                                        "Decorators": [
                                            {
                                                "IsPathClear?": "IsPathClear"

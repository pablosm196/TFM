                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [
                                {
                                    "IsObjectWithinReach?": "IsObjectWithinReach"
                                }
                            ],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "TakeObject",
                                    "Name": "TakeObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "CheckObjectProperties",
                                    "Name": "CheckObjectProperties"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "CompleteSpecificTask",
                                    "Name": "CompleteSpecificTask"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanArea",
                    "Name": "ScanArea"
                }
            ]
        }
    }
}
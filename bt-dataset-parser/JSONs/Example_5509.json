    "code": "\tSEQUENCE\n\t\t\tIF IsObjectSensed? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO MoveToTargetObject\n\t\t\t\tDO PickUpObject\n\t\t\t\tDO CheckObjectProperties\n\t\t\t\tDO SpecificTask\n\t\t\tEND\n\tELSE\n\t\tSELECTOR\n\t\t\tDO ScanForObject\n\t\t\tDO MoveToNextLocation\n\t\tEND\n\tEND\n"

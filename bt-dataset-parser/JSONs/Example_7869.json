{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object detected, then move to it, grab and inspect it, put down, perform specific task. Or avoid obstacles and explore. list of available nodes: <Action ID = MoveToObject    /> <Action ID = GrabAndInspectObject    /> <Action ID = PutDownObject    /> <Action ID = SpecificTask    /> <Action ID = AvoidObstacle    /> <Action ID = ExploreEnvironment    /> <Condition ID = IsObjectDetected    /> <Condition ID = IsObstacleInFront    />",
    "BT": {
        "Blackboard": [
            {
                "IsObstacleInFront": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectDetected?": "IsObjectDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabAndInspectObject",
                            "Name": "GrabAndInspectObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PutDownObject",
                            "Name": "PutDownObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObstacleInFront?": "IsObstacleInFront"
                                }
                            ],
                            "Nodes": [],
                            "Task": "AvoidObstacle",
                            "Name": "AvoidObstacle"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ExploreEnvironment",
                    "Name": "ExploreEnvironment"
                }
            ]
        }
    }

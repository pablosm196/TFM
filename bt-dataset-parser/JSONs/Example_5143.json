                        "Nodes": [],
                        "Task": "CheckObjectProperties",
                        "Name": "CheckObjectProperties"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "MoveObjectToDesignatedArea",
                        "Name": "MoveObjectToDesignatedArea"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO ApproachObject\n\t\t\t\t\tIF IsObjectWithinGrasp? THEN\n\t\t\t\t\tDO GrabObject\n\t\t\tEND\n\tELSE\n\t\tDO CheckObjectProperties\n\t\tDO MoveObjectToDesignatedArea\n\tEND\n"

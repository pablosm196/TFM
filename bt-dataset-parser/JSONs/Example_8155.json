                                "Decorators": [
                                    {
                                        "IsObjectWithinRange?": "IsObjectWithinRange"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "PickUpObject",
                                "Name": "PickUpObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ProcessObject",
                                "Name": "ProcessObject"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "MoveToDestination",
                        "Name": "MoveToDestination"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectWithinRange? THEN\n\t\t\t\tDO PickUpObject\n\t\tELSE\n\t\t\tDO ProcessObject\n\t\tEND\n\t\tDO MoveToDestination\n\tEND\n"

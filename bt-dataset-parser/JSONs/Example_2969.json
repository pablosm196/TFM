{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Move to and pick up object. If round, rotate. If square, inspect. Return object.     list of available nodes: <Action ID = MoveTowardsObject    /> <Action ID = PickUpObject    /> <Condition ID = IsObjectCloseEnough    /> <Action ID = StartRotatingObject    /> <Action ID = StartInspectingObject    /> <Action ID = ReturnObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectCloseEnough": "Boolean"
            },
            {
                "IsObjectSquare": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectRound": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveTowardsObject",
                    "Name": "MoveTowardsObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectCloseEnough?": "IsObjectCloseEnough"
                        }
                    ],
                    "Nodes": [],
                    "Task": "PickUpObject",
                    "Name": "PickUpObject"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectRound?": "IsObjectRound"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "StartRotatingObject",
                                    "Name": "StartRotatingObject"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectSquare?": "IsObjectSquare"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "StartInspectingObject",
                                    "Name": "StartInspectingObject"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ReturnObject",
                            "Name": "ReturnObject"
                        }
                    ]
                }
            ]
        }
    }
}
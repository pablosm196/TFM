{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find and grab object, check properties, move and do task. If stuck, call for assistance. Execute.     list of available nodes: <Action ID = GrabObject    /> <Action ID = MoveToDesignatedLocation    /> <Action ID = CallAssistance    /> <Action ID = ProcessObjectFeatures    /> <Condition ID = IsObjectWithinReach    /> <Condition ID = IsObjectHeavy    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectWithinReach": "Boolean"
            },
            {
                "IsObjectHeavy": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectWithinReach?": "IsObjectWithinReach"
                        }
                    ],
                    "Nodes": [],
                    "Task": "GrabObject",
                    "Name": "GrabObject"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectHeavy?": "IsObjectHeavy"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "CallAssistance",
                                    "Name": "CallAssistance"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObjectFeatures",
                            "Name": "ProcessObjectFeatures"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToDesignatedLocation",
                    "Name": "MoveToDesignatedLocation"
                }
            ]
        }
    }
}
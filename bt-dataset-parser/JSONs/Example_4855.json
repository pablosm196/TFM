{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object detected, move and take it, check properties, perform task. Otherwise, scan area. list of available nodes: <Action ID = ScanForObjects    /> <Action ID = MoveToObject    /> <Action ID = TakeObject    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = SpecificTask    /> <Condition ID = IsObjectDetected    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],

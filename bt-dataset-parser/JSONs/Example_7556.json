{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If an object is detected, move to it, check properties, grab it, then do specific task. Or move to new location. list of available nodes: <Action ID = MoveToObject    /> <Action ID = CheckObjectProperties    /> <Action ID = GrabObject    /> <SubTree ID = SpecificTask    /> <Condition ID = IsObjectDetected    /> <Sequence/> <Action ID = MoveToNewLocation    /> <Condition ID = IsPathClear    />",
    "BT": {
        "Blackboard": [
            {
                "IsPathClear": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectDetected?": "IsObjectDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsPathClear?": "IsPathClear"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToNewLocation",
                            "Name": "MoveToNewLocation"
                        }
                    ]
                }
            ]
        }
    }
}
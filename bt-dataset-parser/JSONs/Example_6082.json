{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find, grab, and deliver object. If object located, then move to it. In order to process it, move to delivery point. list of available nodes: <Action ID = ScanAreaForObject    /> <Action ID = IsObjectHeavy    /> <Action ID = GrabObject    /> <Action ID = MoveToDeliveryPoint    /> <Action ID = MoveToObject    /> <Action ID = IsObjectLocated    /> <SubTree ID = ProcessObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectLocated": "Boolean"
            },
            {
                "IsObjectHeavy": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectLocated?": "IsObjectLocated"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectHeavy?": "IsObjectHeavy"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToDeliveryPoint",
                            "Name": "MoveToDeliveryPoint"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObject",
                            "Name": "ProcessObject"
                        }
                    ]
                }
            ]
        }
    }
}
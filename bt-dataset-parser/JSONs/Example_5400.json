{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, then navigate, grab, check, carry and drop it. Otherwise, scan. list of available nodes: <Action ID = ScanAreaForObject    /> <Action ID = IsObjectVisible    /> <Action ID = NavigateToObject    /> <Action ID = GrabObject    /> <Action ID = CheckObjectProperties    /> <Action ID = CarryObjectToDestination    /> <Action ID = DropObject    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [],
                        "Task": "NavigateToObject",
                        "Name": "NavigateToObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "GrabObject",
                        "Name": "GrabObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "CheckObjectProperties",
                        "Name": "CheckObjectProperties"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "CarryObjectToDestination",
                        "Name": "CarryObjectToDestination"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "DropObject",
                        "Name": "DropObject"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO NavigateToObject\n\tELSE\n\t\tDO GrabObject\n\t\tDO CheckObjectProperties\n\t\tDO CarryObjectToDestination\n\t\tDO DropObject\n\tEND\n"
}
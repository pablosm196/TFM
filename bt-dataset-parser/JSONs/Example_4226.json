{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes.     If object located then move and grab, check properties if grabbed. If not, scan area.     list of available nodes: <Action ID = CheckObjectProperties    /> <Action ID = GrabObject    /> <Action ID = IsNewObjectLocated    /> <Action ID = IsObjectGrabbable    /> <Action ID = IsObjectLocated    /> <Action ID = MoveToObject    /> <Action ID = ScanArea    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectLocated": "Boolean"
            },
            {
                "IsNewObjectLocated": "Boolean"
            },
            {
                "IsObjectGrabbable": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectLocated?": "IsObjectLocated"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "MoveToObject",
                                "Name": "MoveToObject"
                            },
                            {
                                "Type": "Sequence",
                                "Decorators": [],
                                "Nodes": [
                                    {
                                        "Type": "Task",
                                        "Decorators": [
                                            {
                                                "IsObjectGrabbable?": "IsObjectGrabbable"
                                            }
                                        ],
                                        "Nodes": [],
                                        "Task": "GrabObject",
                                        "Name": "GrabObject"
                                    },
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "CheckObjectProperties",
                                        "Name": "CheckObjectProperties"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ScanArea",
                                "Name": "ScanArea"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsNewObjectLocated?": "IsNewObjectLocated"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "MoveToObject",
                                "Name": "MoveToObject"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectLocated? THEN\n\t\t\t\tDO MoveToObject\n\t\tELSE\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectGrabbable? THEN\n\t\t\t\t\tDO GrabObject\n\t\t\tELSE\n\t\t\t\tDO CheckObjectProperties\n\t\t\tEND\n\t\tEND\n\t\tSEQUENCE\n\t\t\tDO ScanArea\n\t\t\t\tIF IsNewObjectLocated? THEN\n\t\t\t\tDO MoveToObject\n\t\tEND\n\tEND\n"
}
{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If item visible, then: move and pick it up, check item properties. Otherwise, scan area or rotate. list of available nodes: <Action ID = IsItemVisible    /> <Condition ID = IsRobotApproachedToItem    /> <Action ID = PickUpItem    /> <SubTree ID = CheckItemProperty    /> <Action ID = MoveToItem    /> <Action ID = ScanArea    /> <Action ID = RotateRobot    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsRobotApproachedToItem": "Boolean"
            },
            {
                "IsItemVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [
                            {
                                "IsItemVisible?": "IsItemVisible"
                            }
                        ],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsRobotApproachedToItem?": "IsRobotApproachedToItem"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "PickUpItem",
                                "Name": "PickUpItem"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "CheckItemProperty",
                                "Name": "CheckItemProperty"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "MoveToItem",
                        "Name": "MoveToItem"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsItemVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsRobotApproachedToItem? THEN\n\t\t\t\t\tDO PickUpItem\n\t\t\tELSE\n\t\t\t\tDO CheckItemProperty\n\t\t\tEND\n\tELSE\n\t\tDO MoveToItem\n\tEND\n"
}
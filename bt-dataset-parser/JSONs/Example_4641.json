{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object visible, approach and grab it. If not, scan area. Check battery and stop moving.     list of available nodes: <Action ID = ApproachObject    /> <Action ID = GrabObject    /> <Action ID = CheckRobotBattery    /> <Action ID = StopRobot    /> <Action ID = ScanArea    /> <SubTree ID = ProcessObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectGrabbable    /> <Condition ID = IsRobotMoving    />",
    "BT": {
        "Blackboard": [
            {
                "IsRobotMoving": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectGrabbable": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectGrabbable?": "IsObjectGrabbable"
                                }
                            ],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObject",
                            "Name": "ProcessObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsRobotMoving?": "IsRobotMoving"
                                }
                            ],
                            "Nodes": [],
                            "Task": "StopRobot",
                            "Name": "StopRobot"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanArea",
                            "Name": "ScanArea"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckRobotBattery",
                    "Name": "CheckRobotBattery"
                }
            ]
        }
    }
}
                                "Name": "MoveToLocation"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\tDO TakeObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsMoving? THEN\n\t\t\t\tDO Stop\n\t\tEND\n\t\tSELECTOR\n\t\t\tDO FindObject\n\t\t\tDO MoveToLocation\n\t\tEND\n\tEND\n"

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Search and retrieve object. If visible, approach, grab, inspect, and deliver. If not, scan area.     list of available nodes: <Action ID = ApproachTarget    /> <Action ID = GrabTarget    /> <Action ID = DeliverTarget    /> <Condition ID = IsTargetVisible    /> <Action ID = InspectTarget    /> <Action ID = ScanAreaForTarget    />",
    "BT": {
        "Blackboard": [
            {
                "IsTargetVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTargetVisible?": "IsTargetVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachTarget",
                            "Name": "ApproachTarget"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabTarget",
                            "Name": "GrabTarget"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "InspectTarget",
                            "Name": "InspectTarget"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "DeliverTarget",
                            "Name": "DeliverTarget"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForTarget",
                    "Name": "ScanAreaForTarget"
                }
            ]
        }
    }
}
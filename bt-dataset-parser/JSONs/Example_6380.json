{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object detected, move to it, check properties, then take it or perform task, if not, scan area. list of available nodes: <Action ID = ScanArea    /> <Condition ID = IsAreaClear    /> <Action ID = CheckObjectProperties    /> <Action ID = TakeObject    /> <SubTree ID = TaskSpecificSubTree    /> <Action ID = MoveToObject    /> <Condition ID = IsObjectDetected    />",
    "BT": {
        "Blackboard": [
            {
                "IsAreaClear": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [
                                {
                                    "IsObjectDetected?": "IsObjectDetected"
                                }
                            ],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "MoveToObject",
                                    "Name": "MoveToObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "CheckObjectProperties",
                                    "Name": "CheckObjectProperties"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "TakeObject",
                                    "Name": "TakeObject"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TaskSpecificSubTree",
                            "Name": "TaskSpecificSubTree"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsAreaClear?": "IsAreaClear"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ScanArea",
                            "Name": "ScanArea"
                        }
                    ]
                }
            ]
        }
    }
}
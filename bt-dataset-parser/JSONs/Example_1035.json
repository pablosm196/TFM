{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes.     If object visible: approach, take, do task. Then check if done, return. If not visible, scan/move.     list of available nodes: <Action ID = TakeObject    /> <Action ID = ApproachObject    /> <Action ID = ReturnObject    /> <Action ID = ScanForObjects    /> <Action ID = MoveToNewLocation    /> <SubTree ID = TaskSubtree    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsTaskCompleted    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsTaskCompleted": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectVisible?": "IsObjectVisible"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "ApproachObject",
                                "Name": "ApproachObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "TakeObject",
                                "Name": "TakeObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "TaskSubtree",
                                "Name": "TaskSubtree"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsTaskCompleted?": "IsTaskCompleted"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "ReturnObject",
                                "Name": "ReturnObject"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ScanForObjects",
                        "Name": "ScanForObjects"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "MoveToNewLocation",
                        "Name": "MoveToNewLocation"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO TakeObject\n\t\t\tDO TaskSubtree\n\t\t\t\tIF IsTaskCompleted? THEN\n\t\t\t\tDO ReturnObject\n\t\tEND\n\t\tDO ScanForObjects\n\t\tDO MoveToNewLocation\n\tEND\n"
}
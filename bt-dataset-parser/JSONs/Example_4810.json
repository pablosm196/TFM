    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\t\tDO TakeObject\n\t\t\tELSE\n\t\t\t\tDO CheckColor\n\t\t\t\tDO CheckShape\n\t\t\t\tDO PerformTask\n\t\t\t\tDO ReturnObject\n\t\t\tEND\n\tELSE\n\t\tDO MoveToNextLocation\n\tEND\n"

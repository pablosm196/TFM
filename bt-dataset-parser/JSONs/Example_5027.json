{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If object visible, approach & take it, process it, else move to next area. list of available nodes: <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <Condition ID = IsObjectInRange    /> <Condition ID = IsObjectVisible    /> <SubTree ID = ProcessObject    /> <Action ID = MoveToNextArea    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectInRange": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectVisible?": "IsObjectVisible"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "ApproachObject",
                                "Name": "ApproachObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectInRange?": "IsObjectInRange"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "TakeObject",
                                "Name": "TakeObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ProcessObject",
                                "Name": "ProcessObject"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "MoveToNextArea",
                                "Name": "MoveToNextArea"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\t\tIF IsObjectInRange? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO ProcessObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\tDO MoveToNextArea\n\t\tEND\n\tEND\n"
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find object, move to it, take it, check and do specific task. If heavy, put down or scan for new object; if small, rotate.     list of available nodes: <Action ID = FindObject    />  <Action ID = MoveToObject    />  <Action ID = TakeObject    />  <Action ID = IsObjectHeavy    />  <Action ID = PutObjectDown    />  <Action ID = ScanForNewObject    />  <Action ID = IsObjectSmall    />  <Action ID = RotateObject    />  <SubTree ID = SubtreeForSpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectSmall": "Boolean"
            },
            {
                "IsObjectHeavy": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "FindObject",
                    "Name": "FindObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToObject",
                    "Name": "MoveToObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "TakeObject",
                    "Name": "TakeObject"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectHeavy?": "IsObjectHeavy"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "PutObjectDown",
                                    "Name": "PutObjectDown"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "ScanForNewObject",
                                    "Name": "ScanForNewObject"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectSmall?": "IsObjectSmall"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "RotateObject",
                                    "Name": "RotateObject"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SubtreeForSpecificTask",
                            "Name": "SubtreeForSpecificTask"
                        }
                    ]
                }
            ]
        }
    }
}
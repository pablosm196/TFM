{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find, approach, take object and do specific task. Scan for object properties if needed. list of available nodes: <Action ID = MoveToTaskLocation    /> <Action ID = ScanForObjectProperties    /> <Condition ID = IsObjectVisible    /> <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <SubTree ID = SpecificTask    /> <Condition ID = IsTaskStarted    />",
    "BT": {
        "Blackboard": [
            {
                "IsTaskStarted": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTaskStarted?": "IsTaskStarted"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToTaskLocation",
                            "Name": "MoveToTaskLocation"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanForObjectProperties",
                    "Name": "ScanForObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SpecificTask",
                    "Name": "SpecificTask"
                }
            ]
        }
    }
}
{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes.     Find the object. If found, move to it, take and check. If not, scan or move. Repeat.     list of available nodes: <Condition ID = IsObjectFound    /> <Condition ID = IsLocationReached    /> <SubTree ID = ObjectPropertiesCheck    /> <Action ID = ScanArea    /> <Action ID = MoveToRandomLocation    /> <Action ID = TakeObject    /> <Action ID = MoveToObject    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectFound": "Boolean"
            },
            {
                "IsLocationReached": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectFound?": "IsObjectFound"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "MoveToObject",
                                "Name": "MoveToObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "TakeObject",
                                "Name": "TakeObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ObjectPropertiesCheck",
                                "Name": "ObjectPropertiesCheck"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsLocationReached?": "IsLocationReached"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "ScanArea",
                                "Name": "ScanArea"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "MoveToRandomLocation",
                        "Name": "MoveToRandomLocation"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectFound? THEN\n\t\t\t\tDO MoveToObject\n\t\tELSE\n\t\t\tDO TakeObject\n\t\t\tDO ObjectPropertiesCheck\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsLocationReached? THEN\n\t\t\t\tDO ScanArea\n\t\tEND\n\t\tDO MoveToRandomLocation\n\tEND\n"
}
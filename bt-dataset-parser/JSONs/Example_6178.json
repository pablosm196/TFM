{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, move to it, approach and take it, check properties, or scan area. list of available nodes: <Action ID = ScanAreaForObject    /> <SubTree ID = CheckObjectProperties    /> <Action ID = MoveToObject    /> <Action ID = TakeObject    /> <Sequence><Condition ID = IsObjectVisible    /><Action ID = MoveToObject    /></Sequence> <Sequence><Condition ID = IsObjectApproached    /><Action ID = TakeObject    /><SubTree ID = CheckObjectProperties    /></Sequence> <Fallback><Sequence/><Sequence/></Fallback>",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {

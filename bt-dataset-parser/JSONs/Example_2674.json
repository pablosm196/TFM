{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object found, take it, check its properties and perform task. Otherwise, move to find it. list of available nodes: <Action ID = TakeObject    /> <Action ID = PerformSpecificTask    /> <Action ID = MoveToFindObject    /> <SubTree ID = CheckObjectProperties    /> <Condition ID = IsObjectFound    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectFound": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectFound?": "IsObjectFound"
                                        }
                                    ],
                                    "Nodes": [],

    "code": "\tSEQUENCE\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectFound? THEN\n\t\t\t\t\tDO TakeObject\n\t\t\tELSE\n\t\t\t\tDO CheckObjectProperties\n\t\t\t\tDO PerformSpecificTask\n\t\t\tEND\n\t\t\tDO MoveToFindObject\n\t\tEND\n\tEND\n"

    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO MoveToLocation\n\t\t\t\tDO TakeObject\n\t\t\t\tDO CheckObjectProperties\n\t\t\t\tDO MoveToDesignatedPlace\n\t\t\t\tDO SpecificTask\n\t\t\tEND\n\tELSE\n\t\tDO Scan Area for Object\n\tEND\n"

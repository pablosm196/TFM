{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is visible and approached, pick it up, process data, move to base; scan area. Else bypass obstacle, random move. list of available nodes: <Condition ID = IsObjectVisible    />  <Condition ID = IsObjectApproached    />  <Condition ID = IsObstacleDetected    />  <Action ID = PickUpObject    />  <Action ID = MoveToBase    />  <Action ID = ScanArea    />  <Action ID = BypassObstacle    />  <Action ID = RandomMove    />  <SubTree ID = ProcessObjectData    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectApproached?": "IsObjectApproached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "PickUpObject",
                            "Name": "PickUpObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObjectData",
                            "Name": "ProcessObjectData"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToBase",
                            "Name": "MoveToBase"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanArea",
                    "Name": "ScanArea"
                }
            ]
        }
    }
}
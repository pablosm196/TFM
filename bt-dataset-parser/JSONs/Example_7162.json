{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object visible, approach, take, check properties. Move to destination, do specific task. Else, scan or wait. list of available nodes: <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <Action ID = MoveToDestination    /> <Action ID = ScanAreaForObject    /> <Action ID = WaitForCommand    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectReached    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = SpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectReached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectReached?": "IsObjectReached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToDestination",
                    "Name": "MoveToDestination"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SpecificTask",
                    "Name": "SpecificTask"
                }
            ]
        }
    }
}
{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If object is found, pick it up, then move to destination. Otherwise, approach visible object and inspect it. list of available nodes: <Action ID = MoveToDestination    /> <Condition ID = IsObjectFound    /> <Action ID = PickUpObject    /> <Action ID = DropOffObject    /> <Condition ID = IsDestinationReached    /> <Action ID = ScanAreaForObjects    /> <Action ID = ApproachObject    /> <Action ID = InspectObject    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectFound": "Boolean"
            },
            {
                "IsDestinationReached": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsObjectFound?": "IsObjectFound"
                            }
                        ],
                        "Nodes": [],
                        "Task": "PickUpObject",
                        "Name": "PickUpObject"
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsDestinationReached?": "IsDestinationReached"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "DropOffObject",
                                "Name": "DropOffObject"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "MoveToDestination",
                        "Name": "MoveToDestination"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectFound? THEN\n\t\t\tDO PickUpObject\n\tELSE\n\t\tSEQUENCE\n\t\t\t\tIF IsDestinationReached? THEN\n\t\t\t\tDO DropOffObject\n\t\tEND\n\t\tDO MoveToDestination\n\tEND\n"
}
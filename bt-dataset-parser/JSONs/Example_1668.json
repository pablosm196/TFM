    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectNearby? THEN\n\t\t\t\tDO MoveToObject\n\t\tELSE\n\t\t\tDO InspectObject\n\t\t\tDO TakeObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectNotNearby? THEN\n\t\t\t\tDO ScanAreaForObjects\n\t\tEND\n\t\tDO MoveToRandomSpot\n\tEND\n"

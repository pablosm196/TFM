{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object is nearby, move to it, inspect it, take it. If not, scan or move to random spot.     list of available nodes: <Action ID = MoveToObject    /> <Action ID = InspectObject    /> <Action ID = TakeObject    /> <Condition ID = IsObjectNearby    /> <Action ID = ScanAreaForObjects    /> <Action ID = MoveToRandomSpot    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectNotNearby": "Boolean"
            },
            {
                "IsObjectNearby": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectNearby?": "IsObjectNearby"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "InspectObject",
                            "Name": "InspectObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectNotNearby?": "IsObjectNotNearby"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ScanAreaForObjects",
                            "Name": "ScanAreaForObjects"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToRandomSpot",
                    "Name": "MoveToRandomSpot"
                }
            ]
        }
    }
}
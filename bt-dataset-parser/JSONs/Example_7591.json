{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. Find and grab an object, check its properties and do a task. If not visible, move to find it. list of available nodes: <Action ID = IsObjectVisible    /> <Condition ID = IsObjectInReach    /> <Action ID = GrabObject    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = DoSpecificTask    /> <Action ID = MoveToFindObject    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectInReach": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Selector",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [
                            {
                                "Type": "Sequence",
                                "Decorators": [],
                                "Nodes": [
                                    {
                                        "Type": "Task",
                                        "Decorators": [
                                            {
                                                "IsObjectInReach?": "IsObjectInReach"
                                            }
                                        ],
                                        "Nodes": [],
                                        "Task": "GrabObject",
                                        "Name": "GrabObject"
                                    },
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "CheckObjectProperties",
                                        "Name": "CheckObjectProperties"
                                    },
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "DoSpecificTask",
                                        "Name": "DoSpecificTask"
                                    }
                                ]
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "MoveToFindObject",
                                "Name": "MoveToFindObject"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSELECTOR\n\t\t\t\tSEQUENCE\n\t\t\t\t\t\tIF IsObjectInReach? THEN\n\t\t\t\t\t\tDO GrabObject\n\t\t\t\tELSE\n\t\t\t\t\tDO CheckObjectProperties\n\t\t\t\t\tDO DoSpecificTask\n\t\t\t\tEND\n\t\t\t\tDO MoveToFindObject\n\t\t\tEND\n\tEND\n"
}
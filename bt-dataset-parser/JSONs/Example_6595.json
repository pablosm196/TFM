{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes.     Find and grab object. Check it. Move to specific location. Release object. Otherwise, scan area.     list of available nodes: <Action ID = ApproachToObject    /> <Action ID = GrabObject    /> <SubTree ID = CheckObject    /> <Action ID = MoveToSpecificLocation    /> <Action ID = ReleaseObject    /> <Action ID = ScanAreaForObject    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ApproachToObject",
                                "Name": "ApproachToObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "GrabObject",
                                "Name": "GrabObject"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "CheckObject",
                        "Name": "CheckObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "MoveToSpecificLocation",
                        "Name": "MoveToSpecificLocation"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ReleaseObject",
                        "Name": "ReleaseObject"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO ApproachToObject\n\t\t\t\tDO GrabObject\n\t\t\tEND\n\tELSE\n\t\tDO CheckObject\n\t\tDO MoveToSpecificLocation\n\t\tDO ReleaseObject\n\tEND\n"
}
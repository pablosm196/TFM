{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If item visible, move to and pick up item. Inspect it if picked up successfully, otherwise scan area. list of available nodes: <Action ID = IsItemVisible    /> <Action ID = ScanAreaForItem    /> <Action ID = MoveToItem    /> <Action ID = IsItemClose    /> <Action ID = PickUpItem    /> <SubTree ID = InspectItem    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsItemVisible": "Boolean"
            },
            {
                "IsItemClose": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsItemVisible?": "IsItemVisible"
                            }
                        ],
                        "Nodes": [],
                        "Task": "MoveToItem",
                        "Name": "MoveToItem"
                    },
                    {
                        "Type": "Selector",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Sequence",
                                "Decorators": [],
                                "Nodes": [
                                    {
                                        "Type": "Task",
                                        "Decorators": [
                                            {
                                                "IsItemClose?": "IsItemClose"
                                            }
                                        ],
                                        "Nodes": [],
                                        "Task": "PickUpItem",
                                        "Name": "PickUpItem"
                                    },
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "InspectItem",
                                        "Name": "InspectItem"
                                    }
                                ]
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ScanAreaForItem",
                                "Name": "ScanAreaForItem"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsItemVisible? THEN\n\t\t\tDO MoveToItem\n\tELSE\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsItemClose? THEN\n\t\t\t\t\tDO PickUpItem\n\t\t\tELSE\n\t\t\t\tDO InspectItem\n\t\t\tEND\n\t\t\tDO ScanAreaForItem\n\t\tEND\n\tEND\n"
}
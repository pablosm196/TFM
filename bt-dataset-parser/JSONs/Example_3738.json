                        "Nodes": [],
                        "Task": "ScanEnvironment",
                        "Name": "ScanEnvironment"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectDetected? THEN\n\t\t\t\tDO MoveToObject\n\t\tELSE\n\t\t\tDO GrabObject\n\t\t\tDO CheckObjectProperties\n\t\tEND\n\t\tDO ScanEnvironment\n\tEND\n"

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object approached, take, move, and check properties. Do task. If not, approach or scan area. list of available nodes: <Action ID = TakeObject    /> <Action ID = MoveToDesignatedArea    /> <Action ID = CheckObjectProperties    /> <Action ID = SpecificTask    /> <Condition ID = IsObjectApproached    /> <Action ID = ApproachObject    /> <Condition ID = IsObjectVisible    /> <Action ID = ScanAreaForObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],

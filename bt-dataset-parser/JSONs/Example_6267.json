{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, move and grab it, check properties, perform task, move to drop zone. list of available nodes: <Action ID = MoveToObject    /> <Action ID = GrabObject    /> <Action ID = CheckObjectProperties    /> <Action ID = PerformTask1    /> <Action ID = PerformTask2    /> <Action ID = MoveToDropZone    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsTask1Possible    /> <Condition ID = IsTask2Possible    />",
    "BT": {
        "Blackboard": [
            {
                "IsTask1Possible": "Boolean"
            },
            {
                "IsTask2Possible": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToObject",
                    "Name": "MoveToObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "GrabObject",
                    "Name": "GrabObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsTask1Possible?": "IsTask1Possible"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "PerformTask1",
                                    "Name": "PerformTask1"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsTask2Possible?": "IsTask2Possible"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "PerformTask2",
                                    "Name": "PerformTask2"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }
}
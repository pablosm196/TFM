                                "Nodes": [],
                                "Task": "ScanAreaForTarget",
                                "Name": "ScanAreaForTarget"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsTargetFound? THEN\n\t\t\t\tDO MoveToTarget\n\t\tELSE\n\t\t\tDO TakeTarget\n\t\t\tDO CheckTargetProperties\n\t\tEND\n\t\tSEQUENCE\n\t\t\tDO ScanAreaForTarget\n\t\tEND\n\tEND\n"

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If target found, then move and take it. Check target properties. Else, scan the area. list of available nodes: <Action ID = MoveToTarget    /> <Action ID = TakeTarget    /> <SubTree ID = CheckTargetProperties    /> <Condition ID = IsTargetFound    /> <Action ID = ScanAreaForTarget    />",
    "BT": {
        "Blackboard": [
            {
                "IsTargetFound": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTargetFound?": "IsTargetFound"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToTarget",
                            "Name": "MoveToTarget"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeTarget",
                            "Name": "TakeTarget"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckTargetProperties",
                            "Name": "CheckTargetProperties"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanAreaForTarget",
                            "Name": "ScanAreaForTarget"
                        }
                    ]
                }
            ]
        }
    }
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object found take it, move to destination, process its properties. If not, scan area for safety. Wait for command. list of available nodes: <Action ID = TakeObject    /> <Action ID = MoveToDestination    /> <SubTree ID = ProcessObjectProperties    /> <Condition ID = IsObjectFound    /> <Sequence>     <Action ID = WaitForCommand    /> </Sequence> <Action ID = ScanForObject    /> <Condition ID = IsAreaSafe    /> <Action ID = MoveToScanArea    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectFound": "Boolean"
            },
            {
                "IsAreaSafe": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectFound?": "IsObjectFound"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObjectProperties",
                            "Name": "ProcessObjectProperties"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsAreaSafe?": "IsAreaSafe"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToScanArea",
                            "Name": "MoveToScanArea"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanForObject",
                            "Name": "ScanForObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "WaitForCommand",
                    "Name": "WaitForCommand"
                }
            ]
        }
    }
}
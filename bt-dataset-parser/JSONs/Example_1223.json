{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object detected, move and grasp object. In order to check its properties. Then complete task. Else scan area or wait. list of available nodes: <Action ID = MoveTowardsObject    /> <Action ID = GraspObject    /> <Condition ID = IsObjectDetected    /> <Action ID = ScanAreaForObjects    /> <SubTree ID = CheckObjectProperties    /> <Action ID = CompleteTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],

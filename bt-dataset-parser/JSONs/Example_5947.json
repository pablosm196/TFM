{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If an object is detected, approach it, take it, check its properties, and do a task. Else, move forward or scan surroundings. list of available nodes: <Action ID = MoveForward    /> <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <SubTree ID = DoTask    /> <Condition ID = ObjectDetected    /> <Condition ID = IsPathClear    /> <Condition ID = ObjectHasProperty    /> <Action ID = ScanArea    />",
    "BT": {
        "Blackboard": [
            {
                "ObjectHasProperty": "Boolean"
            },
            {
                "ObjectDetected": "Boolean"
            },
            {
                "IsPathClear": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "ObjectDetected?": "ObjectDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "ObjectHasProperty?": "ObjectHasProperty"
                                }
                            ],
                            "Nodes": [],
                            "Task": "DoTask",
                            "Name": "DoTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsPathClear?": "IsPathClear"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveForward",
                            "Name": "MoveForward"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanArea",
                    "Name": "ScanArea"
                }
            ]
        }
    }
}
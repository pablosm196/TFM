    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO MoveCloserToObject\n\t\t\t\t\tIF IsObjectWithinRange? THEN\n\t\t\t\t\tSELECTOR\n\t\t\t\t\t\tDO TakeObject\n\t\t\t\t\t\tDO CheckObjectProperties\n\t\t\t\t\tEND\n\t\t\tEND\n\tELSE\n\t\tDO SpecificTask\n\tEND\n"

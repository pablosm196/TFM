{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If the object is visible, approach and take it, inspect it, move to the destination, perform a task; otherwise scan the area. list of available nodes: <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <Condition ID = IsObjectVisible    /> <Action ID = MoveToDestination    /> <SubTree ID = InspectObject    /> <SubTree ID = SpecificTask    /> <Action ID = ScanAreaForObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "InspectObject",
                            "Name": "InspectObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObject",
                    "Name": "ScanAreaForObject"
                }
            ]
        }
    }
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Search object, approach if visible, take it, if not found scan, then check properties. list of available nodes: <Action ID = TakeObject    /> <Action ID = ScanAreaForObject    /> <SubTree ID = CheckObjectProperties    /> <Action ID = MoveToSearchPosition    /> <Action ID = ApproachObject    /> <Condition ID = IsObjectVisible    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],

    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO MoveToObject\n\t\tELSE\n\t\t\tDO CheckObjectProperties\n\t\t\tDO TakeObject\n\t\tEND\n\t\tDO ScanArea\n\t\tSEQUENCE\n\t\t\t\tIF OnSpecificLocation? THEN\n\t\t\t\tDO DoSpecificTask\n\t\tEND\n\t\tDO MoveToNextLocation\n\tEND\n"

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find, approach and pick up object. Perform task or avoid obstacles. Explore, then rest.     list of available nodes: <Action ID = ApproachObject    /> <Action ID = PickUpObject    /> <Condition ID = ObjectWeight    /> <SubTree ID = PerformTask    /> <Condition ID = IsObstacle    /> <Action ID = AvoidObstacle    /> <Action ID = ScanForObjects    /> <SubTree ID = ExploreArea    /> <Action ID = Rest    />",
    "BT": {
        "Blackboard": [
            {
                "ObjectWeight": "Boolean"
            },
            {
                "ObjectFound": "Boolean"
            },
            {
                "IsObstacle": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "ObjectFound?": "ObjectFound"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PickUpObject",
                            "Name": "PickUpObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "ObjectWeight?": "ObjectWeight"
                                }
                            ],
                            "Nodes": [],
                            "Task": "PerformTask",
                            "Name": "PerformTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObstacle?": "IsObstacle"
                        }
                    ],
                    "Nodes": [],
                    "Task": "AvoidObstacle",
                    "Name": "AvoidObstacle"
                }
            ]
        }
    }

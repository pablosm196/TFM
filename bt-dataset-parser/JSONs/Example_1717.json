    "code": "\tSEQUENCE\n\t\tDO ScanAreaForTargetObject\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\tDO ApproachObject\n\t\t\t\t\tIF IsObjectInRange? THEN\n\t\t\t\t\tDO TakeObject\n\t\t\tELSE\n\t\t\t\tDO ProcessObject\n\t\t\tEND\n\t\t\tDO MoveToNextLocation\n\t\tEND\n\tEND\n"

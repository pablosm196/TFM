            {
                "IsObjectAtReach": "Boolean"
            },
            {
                "IsObjectIdentified": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],

{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes.     If object found, approach, grab it. If not, scan area. If dropped off, do specific task.     list of available nodes: <Action ID = FindObject    /> <Action ID = ApproachObject    /> <Condition ID = IsObjectGrabbed    /> <Action ID = ScanArea    /> <Condition ID = IsObjectDroppedOff    /> <SubTree ID = SpecificTask    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectDroppedOff": "Boolean"
            },
            {
                "IsObjectGrabbed": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "FindObject",
                                "Name": "FindObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ApproachObject",
                                "Name": "ApproachObject"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ScanArea",
                        "Name": "ScanArea"
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectDroppedOff?": "IsObjectDroppedOff"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "SpecificTask",
                                "Name": "SpecificTask"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\tDO FindObject\n\t\t\tDO ApproachObject\n\t\tEND\n\t\tDO ScanArea\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectDroppedOff? THEN\n\t\t\t\tDO SpecificTask\n\t\tEND\n\tEND\n"
}
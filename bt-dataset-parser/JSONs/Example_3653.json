                        "Nodes": [],
                        "Task": "MoveToNewLocation",
                        "Name": "MoveToNewLocation"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO TakeObject\n\t\t\t\tIF CheckObjectWeight? THEN\n\t\t\t\tDO Task\n\t\tEND\n\t\tDO MoveToNewLocation\n\tEND\n"

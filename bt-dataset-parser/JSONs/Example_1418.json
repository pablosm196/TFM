{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If an object is detected, then approach, grab, check and perform a task or move to another visible object. list of available nodes: <Action ID = MoveTowardObject    /> <Action ID = GrabObject    /> <Action ID = CheckObjectWeight    /> <SubTree ID = SpecificTask    /> <Action ID = MoveToVisibleObject    /> <Condition ID = IsObjectDetected    /> <Condition ID = IsObjectInReach    /> <Condition ID = IsObjectVisible    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectInReach": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Selector",
                    "Decorators": [

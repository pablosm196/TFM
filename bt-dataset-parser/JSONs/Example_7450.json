{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is detected, move to it, take it, check its weight, perform specific task. Otherwise, move safely. list of available nodes: <Condition ID = IsObjectDetected    /> <Action ID = MoveToObject    /> <Action ID = TakeObject    /> <Action ID = CheckObjectWeight    /> <SubTree ID = SpecificTask    /> <Condition ID = IsAreaSafe    /> <Action ID = MoveToArea    />",
    "BT": {
        "Blackboard": [
            {
                "IsAreaSafe": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectDetected?": "IsObjectDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectWeight",
                            "Name": "CheckObjectWeight"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsAreaSafe?": "IsAreaSafe"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToArea",
                            "Name": "MoveToArea"
                        }
                    ]
                }
            ]
        }
    }
}
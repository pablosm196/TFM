{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Search for the target. If visible, move and pick it up, then analyze it. Else, move closer, finally, scan. list of available nodes: <Action ID = ApproachTarget    /> <Action ID = PickUpTarget     /> <SubTree ID = AnalyseTarget     /> <Condition ID = IsTargetVisible     /> <Condition ID = IsTargetNearby     /> <Action ID = MoveToTarget     /> <Action ID = ScanAreaForTarget     />",
    "BT": {
        "Blackboard": [
            {
                "IsTargetNearby": "Boolean"
            },
            {
                "IsTargetVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTargetVisible?": "IsTargetVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachTarget",
                            "Name": "ApproachTarget"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PickUpTarget",
                            "Name": "PickUpTarget"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "AnalyseTarget",
                            "Name": "AnalyseTarget"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTargetNearby?": "IsTargetNearby"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToTarget",
                            "Name": "MoveToTarget"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForTarget",
                    "Name": "ScanAreaForTarget"
                }
            ]
        }
    }
}
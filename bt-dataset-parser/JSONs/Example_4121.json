                        "Nodes": [],
                        "Task": "DoTask",
                        "Name": "DoTask"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO MoveToPosition\n\tELSE\n\t\tDO GrabObject\n\t\tDO CheckObjectProperties\n\t\tDO MoveToSpecificLocation\n\t\tDO DoTask\n\tEND\n"

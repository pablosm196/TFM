{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, move to and grab it, then process it. Otherwise, scan area for it. list of available nodes: <Action ID = IsObjectVisible    /> <Action ID = IsCloseToTheObject    /> <Action ID = GrabObject    /> <Action ID = ProcessObject    /> <Action ID = MoveToObjectOfType    /> <Action ID = ScanArea    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsCloseToTheObject": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsCloseToTheObject?": "IsCloseToTheObject"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "GrabObject",
                                "Name": "GrabObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ProcessObject",
                                "Name": "ProcessObject"
                            }
                        ]
                    },
                    {
                        "Type": "Selector",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "MoveToObjectOfType",
                                "Name": "MoveToObjectOfType"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ScanArea",
                                "Name": "ScanArea"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsCloseToTheObject? THEN\n\t\t\t\t\tDO GrabObject\n\t\t\tELSE\n\t\t\t\tDO ProcessObject\n\t\t\tEND\n\tELSE\n\t\tSELECTOR\n\t\t\tDO MoveToObjectOfType\n\t\t\tDO ScanArea\n\t\tEND\n\tEND\n"
}
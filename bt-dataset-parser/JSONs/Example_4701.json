{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object seen, go to it and check its properties. Take it then avoid obstacles. list of available nodes: <Action ID = GoToObject    /> <Action ID = TakeObject    /> <Action ID = AvoidObstacle    /> <Action ID = ExploreEnvironment    /> <Condition ID = IsObjectInSight    /> <Condition ID = IsObstacleInWay    /> <SubTree ID = CheckObjectProperties    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectInSight": "Boolean"
            },
            {
                "IsObstacleInWay": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectInSight?": "IsObjectInSight"
                                }
                            ],
                            "Nodes": [],
                            "Task": "GoToObject",
                            "Name": "GoToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObstacleInWay?": "IsObstacleInWay"
                                }
                            ],
                            "Nodes": [],
                            "Task": "AvoidObstacle",
                            "Name": "AvoidObstacle"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ExploreEnvironment",
                    "Name": "ExploreEnvironment"
                }
            ]
        }
    }
}
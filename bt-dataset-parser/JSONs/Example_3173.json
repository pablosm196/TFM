{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object found, approach, take, check properties and complete specific task. Otherwise, scan area or move randomly.     list of available nodes: <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <Action ID = ObjectProperties    /> <Action ID = SpecificTask    /> <Action ID = ScanAreaForObject    /> <Action ID = MoveToRandomLocation    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectFound": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectFound?": "IsObjectFound"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ObjectProperties",
                            "Name": "ObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObject",
                    "Name": "ScanAreaForObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToRandomLocation",
                    "Name": "MoveToRandomLocation"
                }
            ]
        }
    }
}
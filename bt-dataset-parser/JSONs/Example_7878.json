    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO GrabObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectHeld? THEN\n\t\t\t\tDO ProcessObjectProperties\n\t\tELSE\n\t\t\tDO TakeObjectToDestination\n\t\tEND\n\t\tDO SearchForObject\n\tEND\n"

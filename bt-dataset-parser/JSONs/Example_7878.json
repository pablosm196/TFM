{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find object, grab it if visible, check properties, take it to destination. Search if lost.     list of available nodes: <Action ID = ApproachObject    /> <Action ID = GrabObject    /> <Action ID = TakeObjectToDestination    /> <Action ID = SearchForObject    />  <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectHeld    /> <SubTree ID = ProcessObjectProperties    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectHeld": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectHeld?": "IsObjectHeld"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ProcessObjectProperties",
                            "Name": "ProcessObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObjectToDestination",
                            "Name": "TakeObjectToDestination"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SearchForObject",
                    "Name": "SearchForObject"
                }
            ]
        }
    }
}
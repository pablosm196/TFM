{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object found, approach and pick it up. If heavy, move to destination. If light, inspect it. list of available nodes: <Action ID = ApproachObject    /> <Action ID = PickUpObject    /> <Action ID = MoveObjectToDestination    /> <Action ID = InspectObject    /> <Condition ID = IsObjectFound    /> <Condition ID = IsObjectHeavy    /> <Condition ID = IsObjectLight    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectLight": "Boolean"
            },
            {
                "IsObjectFound": "Boolean"
            },
            {
                "IsObjectHeavy": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectFound?": "IsObjectFound"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "PickUpObject",
                    "Name": "PickUpObject"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectHeavy?": "IsObjectHeavy"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "MoveObjectToDestination",
                                    "Name": "MoveObjectToDestination"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectLight?": "IsObjectLight"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "InspectObject",
                                    "Name": "InspectObject"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }
}
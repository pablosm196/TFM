{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. Find an object, grab it, process it, move to dropzone and place it. If not found, explore. list of available nodes: <Action ID = ScanAreaForObject    /> <Action ID = IsObjectVisible    /> <Action ID = MoveToNextArea    /> <Action ID = ProcessObject    /> <Action ID = IsObjectApproached    /> <Action ID = GrabObject    /> <Action ID = PlaceObject    /> <Action ID = ApproachObject    /> <Action ID = MoveToDropZone    /> <SubTree ID = MobileRobotTask    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsDropZoneVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsObjectApproached?": "IsObjectApproached"
                            }
                        ],
                        "Nodes": [],
                        "Task": "GrabObject",
                        "Name": "GrabObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ProcessObject",
                        "Name": "ProcessObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "MoveToDropZone",
                        "Name": "MoveToDropZone"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsDropZoneVisible?": "IsDropZoneVisible"
                            }
                        ],
                        "Nodes": [],
                        "Task": "PlaceObject",
                        "Name": "PlaceObject"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectApproached? THEN\n\t\t\tDO GrabObject\n\tELSE\n\t\tDO ProcessObject\n\t\tDO MoveToDropZone\n\t\t\tIF IsDropZoneVisible? THEN\n\t\t\tDO PlaceObject\n\tEND\n"
}
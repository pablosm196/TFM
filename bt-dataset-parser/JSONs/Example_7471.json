{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. When an object is visible, approach, take it, and process it. Otherwise, scan the area. list of available nodes: <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <Action ID = ScanAreaForObject    /> <Condition ID = IsObjectVisible    /> <SubTree ID = ProcessObject    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectVisible?": "IsObjectVisible"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "ApproachObject",
                                "Name": "ApproachObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "TakeObject",
                                "Name": "TakeObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ProcessObject",
                                "Name": "ProcessObject"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ScanAreaForObject",
                        "Name": "ScanAreaForObject"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO TakeObject\n\t\t\tDO ProcessObject\n\t\tEND\n\t\tDO ScanAreaForObject\n\tEND\n"
}
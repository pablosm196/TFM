    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsTargetDetected? THEN\n\t\t\t\tDO MoveTowardsTarget\n\t\tELSE\n\t\t\tDO PickUpTarget\n\t\t\tDO CheckTargetProperties\n\t\t\tDO PerformSpecificTask\n\t\tEND\n\t\tDO ScanAreaForTarget\n\tEND\n"

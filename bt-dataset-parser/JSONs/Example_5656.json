            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectVisible?": "IsObjectVisible"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "ApproachObject",
                                "Name": "ApproachObject"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectApproached?": "IsObjectApproached"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "ScanObjectProperties",
                                "Name": "ScanObjectProperties"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "DoSpecificTask",
                                "Name": "DoSpecificTask"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "MoveToLocation",
                                "Name": "MoveToLocation"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ScanAreaForObject",
                        "Name": "ScanAreaForObject"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\tDO ScanObjectProperties\n\t\tELSE\n\t\t\tDO DoSpecificTask\n\t\t\tDO MoveToLocation\n\t\tEND\n\t\tDO ScanAreaForObject\n\tEND\n"

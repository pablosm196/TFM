{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object seen, approach, take if close, process, move to target zone, and finally place. If not seen, scan.     list of available nodes: <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <Action ID = ProcessObject    /> <Action ID = MoveToTargetZone    /> <Action ID = PlaceObject    /> <Action ID = ScanAreaForObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectClose    /> <Condition ID = IsTaskCompleted    /> <Condition ID = IsScanCompleted    />",
    "BT": {
        "Blackboard": [
            {
                "IsScanCompleted": "Boolean"
            },
            {
                "IsObjectClose": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsTaskCompleted": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectClose?": "IsObjectClose"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObject",
                            "Name": "ProcessObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToTargetZone",
                            "Name": "MoveToTargetZone"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PlaceObject",
                            "Name": "PlaceObject"
                        }
                    ]
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanAreaForObject",
                            "Name": "ScanAreaForObject"
                        }
                    ]
                }
            ]
        }
    }
}
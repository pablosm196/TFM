{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If an object is visible, approach it. If reached, pick up and move it. Finally, do specific task or scan area.     list of available nodes: <Action ID = ApproachObject    /> <Action ID = PickUpObject    /> <Action ID = MoveObjectToLocation    /> <Condition ID = IsObjectVisible    /> <Condition ID = isObjectReached    /> <Condition ID = isObjectHeavy    /> <Action ID = ScanAreaForObject    /> <SubTree ID = SpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "isObjectReached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "isObjectHeavy": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],

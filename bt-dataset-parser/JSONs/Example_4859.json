                                ]
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ScanForObject",
                                "Name": "ScanForObject"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\tDO MoveToStartLocation\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\t\tDO MoveToObject\n\t\t\tELSE\n\t\t\t\tDO TakeObject\n\t\t\t\tDO ProcessObject\n\t\t\tEND\n\t\t\tDO ScanForObject\n\t\tEND\n\tEND\n"

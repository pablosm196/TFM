{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is detected, approach and retrieve it; otherwise scan for objects. list of available nodes: <Action ID = ScanForObjects    /> <Action ID = ApproachObject    /> <Action ID = RetrieveObject    /> <Condition ID = IsObjectDetected    /> <Condition ID = IsObjectInGrasp    /> <SubTree ID = FindAndRetrieveObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectInGrasp": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [
                                {
                                    "IsObjectDetected?": "IsObjectDetected"
                                }
                            ],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "ApproachObject",
                                    "Name": "ApproachObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectInGrasp?": "IsObjectInGrasp"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "RetrieveObject",
                                    "Name": "RetrieveObject"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanForObjects",
                    "Name": "ScanForObjects"
                }
            ]
        }
    }
}
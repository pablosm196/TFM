                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectDetected? THEN\n\t\t\t\tSEQUENCE\n\t\t\t\t\tDO ApproachObject\n\t\t\t\t\t\tIF IsObjectInGrasp? THEN\n\t\t\t\t\t\tDO RetrieveObject\n\t\t\t\tEND\n\t\tEND\n\t\tDO ScanForObjects\n\tEND\n"

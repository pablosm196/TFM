{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object detected, move and grab it, handle it, then move and store. Else scan and obey manual. list of available nodes: <Action ID = MoveToObject    /> <Action ID = GrabObject    /> <Action ID = HandleObject    /> <Action ID = MoveToObjectStorage    /> <Action ID = ReleaseObject    /> <Condition ID = IsObjectDetected    /> <Condition ID = IsObjectGrabbable    /> <Condition ID = IsManualOverride    /> <Action ID = FollowManualInstructions    /> <Action ID = ScanArea    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectGrabbable": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectDetected?": "IsObjectDetected"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToObject",
                    "Name": "MoveToObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectGrabbable?": "IsObjectGrabbable"
                                }
                            ],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "HandleObject",
                            "Name": "HandleObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToObjectStorage",
                    "Name": "MoveToObjectStorage"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ReleaseObject",
                    "Name": "ReleaseObject"
                }
            ]
        }
    }
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If found object then approach it, take it, check its properties. If destination reached then move to it, otherwise scan the area. list of available nodes: <Condition ID = IsObjectFound    /> <Condition ID = IsDestinationReached    /> <Condition ID = IsObjectVisible    /> <Action ID = TakeObject    /> <Action ID = ApproachObject    /> <Action ID = ScanAreaForObjects    /> <Action ID = MoveToDestination    /> <SubTree ID = CheckObjectProperties    />",
    "BT": {
        "Blackboard": [
            {
                "IsDestinationReached": "Boolean"
            },
            {
                "IsObjectFound": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectFound?": "IsObjectFound"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsDestinationReached?": "IsDestinationReached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObjects",
                    "Name": "ScanAreaForObjects"
                }
            ]
        }
    }
}
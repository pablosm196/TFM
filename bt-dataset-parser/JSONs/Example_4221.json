{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. Find and grab object, then process it. Move to destination, perform task. If not visible, scan area. list of available nodes: <Action ID = GrabObject    /> <Action ID = ProcessObject    /> <Action ID = MoveToDestination    /> <Action ID = PerformTask    /> <Condition ID = IsObjectApproached    /> <Condition ID = ObjectPropertiesChecked    /> <Condition ID = IsObjectVisible    /> <Action ID = ApproachObject    /> <Action ID = ScanAreaForObject    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "ObjectPropertiesChecked": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsObjectApproached?": "IsObjectApproached"
                            }
                        ],
                        "Nodes": [],
                        "Task": "GrabObject",
                        "Name": "GrabObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ProcessObject",
                        "Name": "ProcessObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "MoveToDestination",
                        "Name": "MoveToDestination"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "ObjectPropertiesChecked?": "ObjectPropertiesChecked"
                            }
                        ],
                        "Nodes": [],
                        "Task": "PerformTask",
                        "Name": "PerformTask"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectApproached? THEN\n\t\t\tDO GrabObject\n\tELSE\n\t\tDO ProcessObject\n\t\tDO MoveToDestination\n\t\t\tIF ObjectPropertiesChecked? THEN\n\t\t\tDO PerformTask\n\tEND\n"
}
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsItemNearby? THEN\n\t\t\t\tDO PickUpItem\n\t\tELSE\n\t\t\tDO InspectItem\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsItemVisible? THEN\n\t\t\t\tDO MoveTowardsItem\n\t\tEND\n\t\tDO ScanAreaForItem\n\tEND\n"

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If item is nearby, pick it up, inspect it. If visible, move towards it. Otherwise, scan the area.     list of available nodes: <Action ID = ApproachObject    /> <Action ID = ScanAreaForItem    /> <Action ID = GrabObject    /> <Action ID = MoveTowardsItem    /> <Action ID = PickUpItem    /> <SubTree ID = ProcessObject    /> <SubTree ID = InspectItem    /> <Condition ID = IsItemNearby    /> <Condition ID = IsItemVisible    /> <Condition ID = IsObjectApproached    />  <Condition ID = IsObjectVisible    />",
    "BT": {
        "Blackboard": [
            {
                "IsItemNearby": "Boolean"
            },
            {
                "IsItemVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsItemNearby?": "IsItemNearby"
                                }
                            ],
                            "Nodes": [],
                            "Task": "PickUpItem",
                            "Name": "PickUpItem"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "InspectItem",
                            "Name": "InspectItem"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsItemVisible?": "IsItemVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveTowardsItem",
                            "Name": "MoveTowardsItem"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForItem",
                    "Name": "ScanAreaForItem"
                }
            ]
        }
    }
}
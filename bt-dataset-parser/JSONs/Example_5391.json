    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectDetected? THEN\n\t\t\t\tDO MoveToLocation\n\t\tELSE\n\t\t\tDO GrabObject\n\t\t\tDO CheckObjectProperties\n\t\t\tDO PerformTask\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsNavigablePathAvailable? THEN\n\t\t\t\tDO NavigateToLocation\n\t\tEND\n\t\tDO ScanAreaForObjects\n\tEND\n"

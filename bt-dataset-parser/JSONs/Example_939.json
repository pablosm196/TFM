{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object is in range, move to it, check properties, take it. If blocked, find new path. Perform specific task.     list of available nodes: <SubTree ID = CheckObjectProperties    /> <SubTree ID = PerformSpecificTask    /> <Action ID = MoveToObject    /> <Action ID = TakeObject    /> <Action ID = FindNewPath    /> <Condition ID = IsObjectWithinRange    /> <Condition ID = IsPathBlocked    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectWithinRange": "Boolean"
            },
            {
                "IsPathBlocked": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectWithinRange?": "IsObjectWithinRange"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsPathBlocked?": "IsPathBlocked"
                                }
                            ],
                            "Nodes": [],
                            "Task": "FindNewPath",
                            "Name": "FindNewPath"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "PerformSpecificTask",
                    "Name": "PerformSpecificTask"
                }
            ]
        }
    }
}
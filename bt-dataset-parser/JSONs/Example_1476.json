{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is near, then grab it, move to position, scan properties, and perform task. Else scan area. list of available nodes: <Action ID = GrabObject    /> <Action ID = MoveToObjectLocation    /> <Action ID = ScanObjectProperties    /> <Action ID = PerformTask    /> <Action ID = ApproachObject    /> <Action ID = ScanAreaForObject    /> <Condition ID = IsObjectApproached    /> <Condition ID = CanMoveToObjectLocation    /> <Condition ID = IsObjectVisible    /> <SubTree ID = MobileRobotTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "CanMoveToObjectLocation": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectApproached?": "IsObjectApproached"
                        }
                    ],
                    "Nodes": [],
                    "Task": "GrabObject",
                    "Name": "GrabObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "CanMoveToObjectLocation?": "CanMoveToObjectLocation"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToObjectLocation",
                    "Name": "MoveToObjectLocation"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanObjectProperties",
                    "Name": "ScanObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "PerformTask",
                    "Name": "PerformTask"
                }
            ]
        }
    }
}
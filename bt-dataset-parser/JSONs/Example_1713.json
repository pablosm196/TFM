                                "Task": "ScanForObjects",
                                "Name": "ScanForObjects"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectFound? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO ProcessObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\tDO MoveToArea\n\t\t\tDO ScanForObjects\n\t\tEND\n\tEND\n"

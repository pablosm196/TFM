    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO MoveToTarget\n\t\t\t\tDO TakeObject\n\t\t\t\t\tIF IsObjectHeavy? THEN\n\t\t\t\t\tDO MoveObjectToLocation\n\t\t\tELSE\n\t\t\t\tDO SpecificTask\n\t\t\tEND\n\tELSE\n\t\tDO ScanAreaForObject\n\tEND\n"

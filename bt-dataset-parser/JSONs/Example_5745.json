    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectLocated? THEN\n\t\t\t\tDO MoveToObject\n\t\tELSE\n\t\t\tSEQUENCE\n\t\t\t\t\tIF CanTakeObject? THEN\n\t\t\t\t\tDO TakeObject\n\t\t\tEND\n\t\t\tDO CheckObjectProperties\n\t\t\tDO PerformTask\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tEND\n\t\tDO ScanAreaForObject\n\tEND\n"

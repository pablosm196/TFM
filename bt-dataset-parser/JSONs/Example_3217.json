            {
                "IsObjectApproached": "Boolean"
            },
            {
                "CheckObjectProperties": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],

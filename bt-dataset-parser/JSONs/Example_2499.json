{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object in range, retrieve and inspect it. Then perform task. If obstacle, try moving or rotating. list of available nodes: <Action ID = RetrieveObject    /> <Action ID = InspectObjectProperties    /> <Action ID = PerformTask    /> <Condition ID = IsObjectInRange    /> <Action ID = MoveForward    /> <Action ID = RotateToFindPath    />  <Condition ID = IsPathClear    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectInRange": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectInRange?": "IsObjectInRange"
                        }
                    ],
                    "Nodes": [],
                    "Task": "RetrieveObject",
                    "Name": "RetrieveObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "InspectObjectProperties",
                    "Name": "InspectObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "PerformTask",
                    "Name": "PerformTask"
                }
            ]
        }
    }
}
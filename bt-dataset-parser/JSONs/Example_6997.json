{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is in sight, move to it, grab it, check its properties, perform task. Else scan for object. list of available nodes: <Action ID = MoveToTarget    /> <Action ID = GrabTarget    /> <Condition ID = IsObjectInSight    /> <Action ID = ScanEnvironment    /> <Condition ID = IsTargetDetected    /> <Action ID = CheckTargetProperties    /> <SubTree ID = PerformSpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsTargetDetected": "Boolean"
            },
            {
                "IsObjectInSight": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectInSight?": "IsObjectInSight"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToTarget",
                            "Name": "MoveToTarget"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabTarget",
                            "Name": "GrabTarget"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckTargetProperties",
                            "Name": "CheckTargetProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PerformSpecificTask",
                            "Name": "PerformSpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanEnvironment",
                            "Name": "ScanEnvironment"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTargetDetected?": "IsTargetDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToTarget",
                            "Name": "MoveToTarget"
                        }
                    ]
                }
            ]
        }
    }
}
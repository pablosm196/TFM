{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If item is nearby, move, take and process it, then perform a task. Else, if visible, approach it, else scan for it. list of available nodes: <Action ID = MoveToItem    /> <Action ID = TakeItem    /> <Action ID = PerformTask    /> <Action ID = ApproachItem    /> <Action ID = ScanAreaForItem    /> <SubTree ID = ProcessItemProperties    />  <Condition ID = IsItemNearby    />  <Condition ID = IsItemVisible    />",
    "BT": {
        "Blackboard": [
            {
                "IsItemNearby": "Boolean"
            },
            {
                "IsItemVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsItemNearby?": "IsItemNearby"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToItem",
                            "Name": "MoveToItem"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeItem",
                            "Name": "TakeItem"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessItemProperties",
                            "Name": "ProcessItemProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PerformTask",
                            "Name": "PerformTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsItemVisible?": "IsItemVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachItem",
                            "Name": "ApproachItem"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForItem",
                    "Name": "ScanAreaForItem"
                }
            ]
        }
    }
}
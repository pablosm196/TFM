                                    {
                                        "Type": "Task",
                                        "Decorators": [
                                            {
                                                "IsTask1Enabled?": "IsTask1Enabled"
                                            }
                                        ],
                                        "Nodes": [],
                                        "Task": "Task1",
                                        "Name": "Task1"
                                    }
                                ]
                            },
                            {
                                "Type": "Sequence",
                                "Decorators": [],
                                "Nodes": [
                                    {

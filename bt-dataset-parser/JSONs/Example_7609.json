{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object found, take it, check its properties. Move to destination. Scan for objects. list of available nodes: <Action ID = TakeObject    /> <SubTree ID = CheckObjectProperties    /> <Condition ID = ObjectFound    /> <Action ID = MoveToDestination    /> <Action ID = ScanForObjects    />",
    "BT": {
        "Blackboard": [
            {
                "PathToDestinationKnown": "Boolean"
            },
            {
                "ObjectFound": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "ObjectFound?": "ObjectFound"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "PathToDestinationKnown?": "PathToDestinationKnown"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanForObjects",
                    "Name": "ScanForObjects"
                }
            ]
        }
    }
}
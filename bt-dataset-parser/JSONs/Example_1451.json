{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, move towards it, grab it, check properties, do task, move on. list of available nodes: <Action ID = ScanAreaForObject    /> <Action ID = MoveToNextArea    /> <Action ID = ExamineObjectProperties    /> <Action ID = GrabObject    /> <Action ID = MoveTowardsObject    /> <Condition ID = IsObjectVisible    /> <SubTree ID = ExecuteSubTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObject",
                    "Name": "ScanAreaForObject"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],

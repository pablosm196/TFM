{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object visible, approach, take it, check properties or do task, move, else, scan area.     list of available nodes: <Action ID = GrabObject    /> <Action ID = ScanAreaForObject    /> <Action ID = MoveToNewLocation    /> <Action ID = TakeObject    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = SpecificTask    /> <Action ID = ApproachObject    /> <Condition ID = IsRobotCloseEnough    /> <Condition ID = IsObjectVisible    />",
    "BT": {
        "Blackboard": [
            {
                "IsRobotCloseEnough": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",

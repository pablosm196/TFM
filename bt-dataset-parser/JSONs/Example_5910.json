                                "Name": "TakeObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ProcessObject",
                                "Name": "ProcessObject"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",

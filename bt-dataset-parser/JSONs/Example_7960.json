{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is approached, then take it and process. If path is clear, move and scan. Check properties. list of available nodes: <Action ID = TakeObject    /> <SubTree ID = ProcessObject    /> <Condition ID = IsObjectApproached    /> <Condition ID = IsPathClear    /> <Action ID = MoveToNewLocation    /> <Action ID = ScanAreaForObjects    /> <Action ID = CheckObjectProperties    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsPathClear": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectApproached?": "IsObjectApproached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObject",
                            "Name": "ProcessObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsPathClear?": "IsPathClear"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToNewLocation",
                            "Name": "MoveToNewLocation"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObjects",
                    "Name": "ScanAreaForObjects"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                }
            ]
        }
    }
}
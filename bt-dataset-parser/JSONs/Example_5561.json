{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object visible, approach, move, take and check properties, then process it. Otherwise, scan. list of available nodes: <Action ID = TakeObject    /> <Action ID = MoveToLocation    /> <SubTree ID = ProcessObject    /> <Condition ID = IsObjectValid    /> <Condition ID = IsObjectVisible    /> <Action ID = ScanArea    /> <Action ID = ApproachObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectValid": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToLocation",
                            "Name": "MoveToLocation"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectValid?": "IsObjectValid"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ProcessObject",
                            "Name": "ProcessObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanArea",
                    "Name": "ScanArea"
                }
            ]
        }
    }
}
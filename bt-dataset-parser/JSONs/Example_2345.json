{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find object, move, take object, check properties, perform task or wander around to detect new targets. list of available nodes: <Action ID = MoveToTarget    /> <Action ID = PickUpObject    /> <Action ID = ScanForNewTarget    /> <Action ID = WanderAround    /> <Condition ID = IsObjectDetected    /> <Condition ID = IsObjectWithinReach    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = PerformSpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectWithinReach": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectDetected?": "IsObjectDetected"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToTarget",
                    "Name": "MoveToTarget"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectWithinReach?": "IsObjectWithinReach"
                                }
                            ],
                            "Nodes": [],
                            "Task": "PickUpObject",
                            "Name": "PickUpObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PerformSpecificTask",
                            "Name": "PerformSpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanForNewTarget",
                            "Name": "ScanForNewTarget"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "WanderAround",
                            "Name": "WanderAround"
                        }
                    ]
                }
            ]
        }
    }
}
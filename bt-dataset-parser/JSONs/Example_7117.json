{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object approached, grab and move it to destination. If heavy, perform task. Else, approach object. list of available nodes: <Action ID = TakeObject    /> <Action ID = MoveObjectToDestination    /> <Action ID = ApproachObject    /> <SubTree ID = DoTask    /> <Condition ID = IsObjectHeavy    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectApproached    /> <Action ID = ScanAreaForObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsTaskComplete": "Boolean"
            },
            {
                "IsObjectHeavy": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectApproached?": "IsObjectApproached"
                        }
                    ],
                    "Nodes": [],
                    "Task": "TakeObject",
                    "Name": "TakeObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectHeavy?": "IsObjectHeavy"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveObjectToDestination",
                    "Name": "MoveObjectToDestination"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsTaskComplete?": "IsTaskComplete"
                        }
                    ],
                    "Nodes": [],
                    "Task": "DoTask",
                    "Name": "DoTask"
                }
            ]
        }
    }
}
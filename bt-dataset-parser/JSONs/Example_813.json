    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSELECTOR\n\t\t\t\tSEQUENCE\n\t\t\t\t\t\tIF IsObjectReachable? THEN\n\t\t\t\t\t\tDO MoveToObject\n\t\t\t\tELSE\n\t\t\t\t\tDO GrabObject\n\t\t\t\t\tDO CheckObjectProperties\n\t\t\t\tEND\n\t\t\t\tDO ScanArea\n\t\t\tEND\n\tEND\n"

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is visible: approach and grab it, check weight, move to destination, do specific task. Else: scan area, move. list of available nodes: <Action ID = ApproachObject    /> <Action ID = GrabObject    /> <Action ID = CheckObjectWeight    /> <Action ID = MoveObjectToDestination    /> <Action ID = SpecificTask    /> <Action ID = ScanAreaForObject    /> <Action ID = MoveToNextArea    /> <Condition ID = IsObjectVisible    /> <Condition ID = CanGrabObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "CanGrabObject": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "CanGrabObject?": "CanGrabObject"
                                }
                            ],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectWeight",
                            "Name": "CheckObjectWeight"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveObjectToDestination",
                            "Name": "MoveObjectToDestination"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SpecificTask",
                    "Name": "SpecificTask"
                }
            ]
        }
    }
}
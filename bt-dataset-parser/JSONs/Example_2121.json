    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tEND\n\t\tDO SearchForObject\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectReached? THEN\n\t\t\t\tDO PickUpObject\n\t\tEND\n\t\tDO CheckObjectProperties\n\t\tDO MoveToLocation\n\t\tDO SpecificTask\n\tEND\n"

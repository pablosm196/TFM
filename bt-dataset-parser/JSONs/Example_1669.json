                                "Task": "DepositObject",
                                "Name": "DepositObject"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "SearchForObject",
                        "Name": "SearchForObject"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsAtObject? THEN\n\t\t\t\t\tDO PickupObject\n\t\t\tELSE\n\t\t\t\tDO ProcessObjectProperties\n\t\t\t\tDO DepositObject\n\t\t\tEND\n\tELSE\n\t\tDO SearchForObject\n\tEND\n"

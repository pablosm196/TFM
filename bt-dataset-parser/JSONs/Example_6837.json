{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object visible, approach and grab. Then, if object in gripper, move and process. Finally, scan area. list of available nodes: <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectInGripper    /> <Action ID = ApproachObject    /> <Action ID = GrabObject    /> <Action ID = MoveToSpecificLocation    /> <Action ID = ScanAreaForObject    /> <SubTree ID = ProcessObjectTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectInGripper": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectInGripper?": "IsObjectInGripper"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToSpecificLocation",
                            "Name": "MoveToSpecificLocation"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObjectTask",
                            "Name": "ProcessObjectTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObject",
                    "Name": "ScanAreaForObject"
                }
            ]
        }
    }
}
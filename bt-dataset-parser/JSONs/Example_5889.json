{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If an object is visible then approach, take and inspect it. Otherwise, scan the area. list of available nodes: <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <SubTree ID = InspectObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectReachable    /> <Action ID = ScanArea    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectReachable": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectReachable?": "IsObjectReachable"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "InspectObject",
                            "Name": "InspectObject"
                        }
                    ]
                }
            ]
        }
    }
}
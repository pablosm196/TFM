    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectDetected? THEN\n\t\t\t\tSEQUENCE\n\t\t\t\t\tDO ApproachObject\n\t\t\t\t\tDO TakeObject\n\t\t\t\t\tDO CheckObjectProperties\n\t\t\t\t\tDO DoSpecificTask\n\t\t\t\tEND\n\t\tEND\n\t\tDO MoveToNextArea\n\tEND\n"

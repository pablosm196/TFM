                        "Name": "DoSpecificTask"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO MoveToObject\n\tELSE\n\t\t\tIF IsObjectGrabbed? THEN\n\t\t\tDO MoveObjectToDesignatedArea\n\tELSE\n\t\tDO CheckObjectProperties\n\t\tDO DoSpecificTask\n\tEND\n"

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object found, move to object, take object, check object, do specific task; if obstacle, avoid; scan area.     list of available nodes: <Action ID = MoveToObject    /> <Action ID = TakeObject    /> <Action ID = CheckObjectProperties    /> <SubTree ID = SpecificTask    /> <Condition ID = IsObjectFound    /> <Condition ID = IsObstacleDetected    /> <Action ID = AvoidObstacle    /> <Action ID = ScanAreaForObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectFound": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectFound?": "IsObjectFound"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                }
            ]
        }
    }
}
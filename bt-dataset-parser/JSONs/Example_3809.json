    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO ObjectProperties\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsPathClear? THEN\n\t\t\t\tDO MoveToLocation\n\t\tELSE\n\t\t\tDO CheckLocation\n\t\tEND\n\t\tDO ScanForObjects\n\tEND\n"

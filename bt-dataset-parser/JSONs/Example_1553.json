                            }
                        ],
                        "Nodes": [],
                        "Task": "RetrieveObject",
                        "Name": "RetrieveObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "CheckObjectProperties",
                        "Name": "CheckObjectProperties"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "SpecificTask",
                        "Name": "SpecificTask"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\t\tIF IsObjectInRange? THEN\n\t\t\tDO RetrieveObject\n\tELSE\n\t\tDO CheckObjectProperties\n\t\tDO SpecificTask\n\tEND\n"
}
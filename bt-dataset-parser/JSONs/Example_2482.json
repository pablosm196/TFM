    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsTaskComplete? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO MoveToObject\n\t\t\tDO ProcessObjectTask\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tEND\n\t\tDO ScanAreaForObject\n\tEND\n"

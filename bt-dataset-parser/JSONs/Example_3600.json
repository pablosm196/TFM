{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is found, then move to its location, grab it, inspect it and finish. list of available nodes: <Action ID = MoveToObjectsLocation    /> <Condition ID = IsObjectLocated    />  <Action ID = GrabObject    />  <SubTree ID = InspectObject    />  <Action ID = SearchAreaForObject    />  <Condition ID = IsObjectGrabbable    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectLocated": "Boolean"
            },
            {
                "IsObjectGrabbable": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectLocated?": "IsObjectLocated"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObjectsLocation",
                            "Name": "MoveToObjectsLocation"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectGrabbable?": "IsObjectGrabbable"
                                }
                            ],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "InspectObject",
                            "Name": "InspectObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SearchAreaForObject",
                    "Name": "SearchAreaForObject"
                }
            ]
        }
    }
}
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsLocationReached? THEN\n\t\t\t\tDO ScanForObjects\n\t\tELSE\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\t\tDO PickUpObject\n\t\t\tELSE\n\t\t\t\tDO ProcessObject\n\t\t\tEND\n\t\t\tDO MoveToDestination\n\t\tEND\n\t\tDO ScanForDestination\n\tEND\n"

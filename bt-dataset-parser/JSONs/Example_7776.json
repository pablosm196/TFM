{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is detected, move to it, grasp it, check it, perform task. Otherwise scan area, avoid obstacles. list of available nodes: <Condition ID = IsObjectDetected    /> <SubTree ID = MoveToObject    /> <Condition ID = IsObjectWithinReach    /> <Action ID = GraspObject    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = PerformTask    /> <SubTree ID = ScanArea    /> <Condition ID = IsObstacleDetected    /> <Action ID = AvoidObstacle    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectWithinReach": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectDetected?": "IsObjectDetected"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToObject",
                    "Name": "MoveToObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectWithinReach?": "IsObjectWithinReach"
                        }
                    ],
                    "Nodes": [],
                    "Task": "GraspObject",
                    "Name": "GraspObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "PerformTask",
                    "Name": "PerformTask"
                }
            ]
        }
    }
}
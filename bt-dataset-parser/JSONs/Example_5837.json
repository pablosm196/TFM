{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If object is nearby, then grab it and check properties. Otherwise, move towards object or scan area. list of available nodes: <Action ID = GrabObject    /> <SubTree ID = CheckObjectProperties    /> <Condition ID = IsObjectNearby    /> <Action ID = MoveTowardsObject    /> <Condition ID = IsPathClear    /> <Action ID = ScanArea    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsPathClear": "Boolean"
            },
            {
                "IsObjectNearby": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectNearby?": "IsObjectNearby"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "GrabObject",
                                "Name": "GrabObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "CheckObjectProperties",
                                "Name": "CheckObjectProperties"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsPathClear?": "IsPathClear"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "MoveTowardsObject",
                                "Name": "MoveTowardsObject"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ScanArea",
                        "Name": "ScanArea"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectNearby? THEN\n\t\t\t\tDO GrabObject\n\t\tELSE\n\t\t\tDO CheckObjectProperties\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsPathClear? THEN\n\t\t\t\tDO MoveTowardsObject\n\t\tEND\n\t\tDO ScanArea\n\tEND\n"
}
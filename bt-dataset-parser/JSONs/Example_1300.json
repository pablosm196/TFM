{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If object is visible then approach and take it, check properties, if not move; repeat. list of available nodes: <Action ID = ApproachToObject    /> <Action ID = TakeObject    /> <SubTree ID = CheckObjectProperties    /> <Action ID = TurnLeft    /> <Action ID = TurnRight    /> <Action ID = MoveForward    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [],
                        "Task": "ApproachToObject",
                        "Name": "ApproachToObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "TakeObject",
                        "Name": "TakeObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "CheckObjectProperties",
                        "Name": "CheckObjectProperties"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachToObject\n\tELSE\n\t\tDO TakeObject\n\t\tDO CheckObjectProperties\n\tEND\n"
}
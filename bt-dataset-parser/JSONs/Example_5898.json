{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Approach, take and check object properties, move or wait for clearance, then approach another. list of available nodes: <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <SubTree ID = CheckObjectProperties    /> <Condition ID = IsTaskComplete    /> <Condition ID = IsAreaClear    /> <Action ID = MoveToNewLocation    />",
    "BT": {
        "Blackboard": [
            {
                "IsAreaClear": "Boolean"
            },
            {
                "IsTaskComplete": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsAreaClear?": "IsAreaClear"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToNewLocation",
                            "Name": "MoveToNewLocation"
                        }
                    ]
                }
            ]
        }
    }
}
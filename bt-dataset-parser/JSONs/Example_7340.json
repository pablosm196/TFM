                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Selector",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Sequence",
                                "Decorators": [],
                                "Nodes": [
                                    {

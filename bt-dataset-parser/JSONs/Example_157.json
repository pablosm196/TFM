                                "Name": "TakeObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "TaskSubtree",
                                "Name": "TaskSubtree"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",

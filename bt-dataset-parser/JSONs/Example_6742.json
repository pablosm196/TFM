{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find object, approach, grab it, check properties, move to destination, if not found scan area or do something else. list of available nodes: <Action ID = MoveToItem    /> <Condition ID = IsObjectVisible    /> <Sequence ID = MainSequence>     <Action ID = MoveToItem    />     <Condition ID = IsItemGrabbable    />     <Action ID = GrabItem    />     <SubTree ID = CheckObjectProperties    />     <Action ID = MoveToDestination    /> </Sequence> <Action ID = ScanAreaForObject    /> <SubTree ID = DoSomethingElse    />",
    "BT": {
        "Blackboard": [
            {
                "IsItemGrabbable": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToItem",
                            "Name": "MoveToItem"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsItemGrabbable?": "IsItemGrabbable"
                                }
                            ],
                            "Nodes": [],
                            "Task": "GrabItem",
                            "Name": "GrabItem"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        }
                    ]
                }
            ]
        }
    }
}
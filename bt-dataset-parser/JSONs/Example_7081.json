{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object visible, approach it. If picked, move to drop-off point and complete task. Or, scan area and avoid obstacles. list of available nodes: <Action ID = ApproachObject    /> <Action ID = MoveToObjectDropOffPoint    /> <Action ID = CompleteTask    /> <Action ID = ScanAreaForObjects    /> <Action ID = AvoidObstacles    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectPicked    /> <Condition ID = IsObstaclesInPath    /> <SubTree ID = ProcessObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObstaclesInPath": "Boolean"
            },
            {
                "IsObjectPicked": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectPicked?": "IsObjectPicked"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObjectDropOffPoint",
                            "Name": "MoveToObjectDropOffPoint"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObject",
                            "Name": "ProcessObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CompleteTask",
                            "Name": "CompleteTask"
                        }
                    ]
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanAreaForObjects",
                            "Name": "ScanAreaForObjects"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObstaclesInPath?": "IsObstaclesInPath"
                                }
                            ],
                            "Nodes": [],
                            "Task": "AvoidObstacles",
                            "Name": "AvoidObstacles"
                        }
                    ]
                }
            ]
        }
    }
}
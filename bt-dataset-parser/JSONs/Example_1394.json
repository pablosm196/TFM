{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If an object is visible, approach it. If not, search for it. Pick it up and perform task.     list of available nodes: <Action ID = ApproachItem    /> <Action ID = SearchForItem    /> <Condition ID = IsItemVisible    /> <Condition ID = IsItemWithinReach    /> <Action ID = PickUpItem    /> <SubTree ID = ProcessItemProperties    /> <SubTree ID = PerformSpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsItemVisible": "Boolean"
            },
            {
                "IsItemWithinReach": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsItemVisible?": "IsItemVisible"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "ApproachItem",
                                    "Name": "ApproachItem"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SearchForItem",
                            "Name": "SearchForItem"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsItemWithinReach?": "IsItemWithinReach"
                                }
                            ],
                            "Nodes": [],
                            "Task": "PickUpItem",
                            "Name": "PickUpItem"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessItemProperties",
                            "Name": "ProcessItemProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PerformSpecificTask",
                            "Name": "PerformSpecificTask"
                        }
                    ]
                }
            ]
        }
    }
}
                    "Name": "GrabObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToObjectHandlingArea",
                    "Name": "MoveToObjectHandlingArea"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "HandleObject",
                    "Name": "HandleObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectIncomplete?": "IsObjectIncomplete"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToRepairStation",
                    "Name": "MoveToRepairStation"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "RepairObject",
                    "Name": "RepairObject"
                }
            ]
        }
    }

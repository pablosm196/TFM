    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF isObjectApproached? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO GetObjectInfo\n\t\t\tDO ProcessObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF isObjectVisible? THEN\n\t\t\t\tDO MoveToTarget\n\t\tEND\n\t\tDO ScanForObject\n\tEND\n"

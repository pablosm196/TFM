{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find object, move to it, grab or take it, complete task if object has required properties.     list of available nodes: <Action ID = MoveToObject    /> <Action ID = TakeObject    /> <Action ID = CheckObjectPropertiesTask1    /> <Action ID = CompleteTask1    /> <Action ID = CheckObjectPropertiesTask2    /> <Action ID = CompleteTask2    /> <Condition ID = IsObjectGrabbed    /> <SubTree ID = FindObjectAndCompleteTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectGrabbed": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToObject",
                    "Name": "MoveToObject"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectGrabbed?": "IsObjectGrabbed"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "CheckObjectPropertiesTask1",
                                    "Name": "CheckObjectPropertiesTask1"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "CompleteTask1",
                                    "Name": "CompleteTask1"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "TakeObject",
                                    "Name": "TakeObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "CheckObjectPropertiesTask2",
                                    "Name": "CheckObjectPropertiesTask2"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "CompleteTask2",
                                    "Name": "CompleteTask2"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }
}
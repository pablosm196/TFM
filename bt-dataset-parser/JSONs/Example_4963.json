{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object not approached, approach it, grab it, move it, perform the task, else scan. list of available nodes: <Action ID = GrabObject    /> <Action ID = MoveObject    /> <Action ID = CheckObjectTemperature    /> <Action ID = ApproachObject    /> <Action ID = ScanAreaForObject    /> <Condition ID = IsObjectApproached    /> <Condition ID = isObjectHeavy    /> <Condition ID = IsObjectVisible    /> <SubTree ID = SpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "isObjectHeavy": "Boolean"
            },
            {
                "IsObjectApproached": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectApproached?": "IsObjectApproached"
                        }
                    ],
                    "Nodes": [],
                    "Task": "GrabObject",
                    "Name": "GrabObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "isObjectHeavy?": "isObjectHeavy"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveObject",
                    "Name": "MoveObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectTemperature",
                    "Name": "CheckObjectTemperature"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SpecificTask",
                    "Name": "SpecificTask"
                }
            ]
        }
    }
}
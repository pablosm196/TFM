    "code": "\tSELECTOR\n\t\t\tIF IsObjectFound? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO MoveToTarget\n\t\t\t\tDO TakeObject\n\t\t\t\tDO CheckObjectProperties\n\t\t\t\tDO DoSpecificTask\n\t\t\tEND\n\tELSE\n\t\tSEQUENCE\n\t\t\tDO ScanForObjects\n\t\t\tDO MoveToNextArea\n\t\tEND\n\tEND\n"

                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObstacleDetected?": "IsObstacleDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveAroundObstacle",
                            "Name": "MoveAroundObstacle"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],

                        "Nodes": [],
                        "Task": "MoveToRandomLocation",
                        "Name": "MoveToRandomLocation"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO PickUpObject\n\t\t\tDO MoveToObjectHolder\n\t\t\tDO PutObjectInHolder\n\t\t\tDO CheckObjectProperties\n\t\tEND\n\t\tDO MoveToRandomLocation\n\tEND\n"

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object nearby, pick it up and inspect it. If at target location, move there. Scan area.     list of available nodes: <Action ID = PickUpObject    /> <Action ID = MoveToLocation    /> <Condition ID = IsAtTargetLocation    /> <Condition ID = IsObjectNearby    /> <Action ID = ScanArea    /> <SubTree ID = InspectObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsAtTargetLocation": "Boolean"
            },
            {
                "IsObjectNearby": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectNearby?": "IsObjectNearby"
                                }
                            ],
                            "Nodes": [],
                            "Task": "PickUpObject",
                            "Name": "PickUpObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "InspectObject",
                            "Name": "InspectObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsAtTargetLocation?": "IsAtTargetLocation"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToLocation",
                            "Name": "MoveToLocation"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanArea",
                    "Name": "ScanArea"
                }
            ]
        }
    }
}
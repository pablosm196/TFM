{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, approach and grab. Check properties, move to destination and do specific task. Otherwise, scan. list of available nodes: <Action ID = ApproachObject    /> <Action ID = GrabObject    /> <Action ID = MoveToDestination    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectNear    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = DoSpecificTask    /> <Action ID = ScanForObjects    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectNear": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectNear?": "IsObjectNear"
                                }
                            ],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "DoSpecificTask",
                            "Name": "DoSpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanForObjects",
                    "Name": "ScanForObjects"
                }
            ]
        }
    }
}
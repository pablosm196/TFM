                "IsObjectWithinArmDistance": "Boolean"
            },
            {
                "IsRobotAtOriginalPosition": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [

                        "Nodes": [],
                        "Task": "MoveToNextDestination",
                        "Name": "MoveToNextDestination"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectApproached? THEN\n\t\t\tDO GrabObject\n\tELSE\n\t\tDO ProcessObject\n\t\t\tIF IsDestinationReached? THEN\n\t\t\tDO PutObjectDown\n\tELSE\n\t\tDO CheckObjectProperties\n\t\tDO MoveToNextDestination\n\tEND\n"

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, then move to object and grab it. If heavy, call for help. list of available nodes: <Action ID = MoveToObj    /> <Action ID = GrabObj    /> <Action ID = IsObjLightweight    /> <Action ID = MoveToDestination    /> <Action ID = CallForHelp    /> <Condition ID = IsObjectVisible    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjHeavy": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjLightweight": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToObj",
                    "Name": "MoveToObj"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "GrabObj",
                    "Name": "GrabObj"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjLightweight?": "IsObjLightweight"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "MoveToDestination",
                                    "Name": "MoveToDestination"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjHeavy?": "IsObjHeavy"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "CallForHelp",
                                    "Name": "CallForHelp"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }
}
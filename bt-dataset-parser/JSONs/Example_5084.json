{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find object, approach, check properties. If grabbed, move and subtree task. Otherwise, take or move to zone.     list of available nodes: <Action ID = FindObject    /> <Action ID = ApproachObject    /> <Action ID = CheckObjectProperties    /> <Condition ID = IsObjectGrabbed    /> <Action ID = MoveWithObject    /> <SubTree ID = PerformTask    /> <Action ID = TakeObject    /> <Action ID = MoveToZone    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectGrabbed": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "FindObject",
                    "Name": "FindObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectGrabbed?": "IsObjectGrabbed"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "MoveWithObject",
                                    "Name": "MoveWithObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "PerformTask",
                                    "Name": "PerformTask"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToZone",
                            "Name": "MoveToZone"
                        }
                    ]
                }
            ]
        }
    }
}
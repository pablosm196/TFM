                        "Nodes": [],
                        "Task": "ProcessObject",
                        "Name": "ProcessObject"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectApproached? THEN\n\t\t\tDO GrabObject\n\tELSE\n\t\tSEQUENCE\n\t\t\tDO CheckObjectWeight\n\t\t\tDO CheckObjectColor\n\t\tEND\n\t\tDO ProcessObject\n\tEND\n"

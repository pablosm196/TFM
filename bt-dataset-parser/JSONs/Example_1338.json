                                    }
                                ],
                                "Nodes": [],
                                "Task": "ApproachItem",
                                "Name": "ApproachItem"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ScanAreaForItems",
                        "Name": "ScanAreaForItems"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsItemApproached? THEN\n\t\t\t\tDO TakeItem\n\t\tELSE\n\t\t\tDO ProcessItem\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsItemVisible? THEN\n\t\t\t\tDO ApproachItem\n\t\tEND\n\t\tDO ScanAreaForItems\n\tEND\n"

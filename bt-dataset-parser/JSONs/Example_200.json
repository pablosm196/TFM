                                        "Name": "MoveToObjectStorage"
                                    },
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "StoreObject",
                                        "Name": "StoreObject"
                                    }
                                ]
                            },
                            {
                                "Type": "Task",

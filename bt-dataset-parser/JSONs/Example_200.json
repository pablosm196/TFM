                                "Nodes": [],
                                "Task": "SpecificTask",
                                "Name": "SpecificTask"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO MoveToObject\n\tELSE\n\t\tDO TakeObject\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF DoesObjectFit? THEN\n\t\t\t\t\tDO MoveToObjectStorage\n\t\t\tELSE\n\t\t\t\tDO StoreObject\n\t\t\tEND\n\t\t\tDO SpecificTask\n\t\tEND\n\tEND\n"

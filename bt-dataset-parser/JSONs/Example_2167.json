                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "CheckObjectWeight",
                                    "Name": "CheckObjectWeight"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "ProcessObjectTask",
                                    "Name": "ProcessObjectTask"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanForObject",
                            "Name": "ScanForObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToRandomLocation",
                            "Name": "MoveToRandomLocation"
                        }
                    ]
                }
            ]
        }
    }

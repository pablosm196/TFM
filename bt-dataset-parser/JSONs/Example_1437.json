{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If object detected: approach, pick up, check, perform task. Else: move around, scan. list of available nodes: <Action ID = ApproachObject    /> <Action ID = PickUpObject    /> <SubTree ID = CheckObjectProperties    /> <Condition ID = IsObjectDetected    /> <Action ID = MoveAround    /> <Action ID = ScanArea    /> <Condition ID = IsTaskNeeded    /> <SubTree ID = PerformTask    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsTaskNeeded": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsObjectDetected?": "IsObjectDetected"
                            }
                        ],
                        "Nodes": [],
                        "Task": "ApproachObject",
                        "Name": "ApproachObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "PickUpObject",
                        "Name": "PickUpObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "CheckObjectProperties",
                        "Name": "CheckObjectProperties"
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsTaskNeeded?": "IsTaskNeeded"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "PerformTask",
                                "Name": "PerformTask"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectDetected? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\tDO PickUpObject\n\t\tDO CheckObjectProperties\n\t\tSEQUENCE\n\t\t\t\tIF IsTaskNeeded? THEN\n\t\t\t\tDO PerformTask\n\t\tEND\n\tEND\n"

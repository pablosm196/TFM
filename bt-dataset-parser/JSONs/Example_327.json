{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, approach and take it, else move and scan area. list of available nodes: <Action ID = MoveToNextLocation    /> <Action ID = ScanAreaForObject    /> <Condition ID = IsObjectVisible    /> <Sequence>     <Action ID = ApproachObject    />     <Condition ID = IsObjectApproached    />     <Sequence>         <Action ID = TakeObject    />         <SubTree ID = ProcessObject    />     </Sequence> </Sequence>",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [
                                {
                                    "IsObjectApproached?": "IsObjectApproached"
                                }
                            ],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "TakeObject",
                                    "Name": "TakeObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "ProcessObject",
                                    "Name": "ProcessObject"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToNextLocation",
                            "Name": "MoveToNextLocation"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanAreaForObject",
                            "Name": "ScanAreaForObject"
                        }
                    ]
                }
            ]
        }
    }
}
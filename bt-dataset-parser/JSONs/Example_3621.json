{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find and grab an object. Identify it, move, and perform a task. Or approach and grab it. list of available nodes: <Action ID = IsObjectDetected    /> <Action ID = IsObjectWithinReach    /> <Action ID = IdentificationTask    /> <Action ID = MoveToDestination    /> <Action ID = GrabObject    /> <Action ID = ReleaseObject    /> <Action ID = IsObjectVisible    /> <Action ID = ApproachObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectWithinReach": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [
                                {
                                    "IsObjectDetected?": "IsObjectDetected"
                                }
                            ],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectWithinReach?": "IsObjectWithinReach"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "GrabObject",
                                    "Name": "GrabObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "IdentificationTask",
                                    "Name": "IdentificationTask"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ReleaseObject",
                            "Name": "ReleaseObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        }
                    ]
                }
            ]
        }
    }
}
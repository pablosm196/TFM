{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find small object, take it, move to similar objects, perform task, or move toward visible object. list of available nodes: <Action ID = ScanAreaForObjects    /> <Action ID = MoveToObject    /> <Action ID = TakeObject    /> <Condition ID = IsObjectFound    /> <Condition ID = IsObjectSmall    /> <Condition ID = IsObjectVisible    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = PerformSpecificTask    /> <Action ID = MoveToVisibleObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectSmall": "Boolean"
            },
            {
                "IsObjectFound": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectFound?": "IsObjectFound"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectSmall?": "IsObjectSmall"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToObject",
                    "Name": "MoveToObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "PerformSpecificTask",
                    "Name": "PerformSpecificTask"
                }
            ]
        }
    }
}
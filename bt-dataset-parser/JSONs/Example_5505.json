{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find, approach, take and process object then return it; navigate, scan, move to the next location. list of available nodes: <Action ID = TakeObject    /> <Action ID = ReturnObject    /> <Action ID = MoveRobot    /> <Action ID = ScanForObjects    /> <Condition ID = IsNavigationEnabled    /> <Condition ID = IsObjectApproached    /> <SubTree ID = ProcessObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsNavigationEnabled": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectApproached?": "IsObjectApproached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObject",
                            "Name": "ProcessObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ReturnObject",
                            "Name": "ReturnObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsNavigationEnabled?": "IsNavigationEnabled"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveRobot",
                            "Name": "MoveRobot"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanForObjects",
                    "Name": "ScanForObjects"
                }
            ]
        }
    }
}
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\t\tIF IsObjectGrabbed? THEN\n\t\t\t\tDO MoveToDestination\n\t\tELSE\n\t\t\t\tIF IsAtTaskLocation? THEN\n\t\t\t\tDO PerformTask\n\t\tEND\n\t\tDO ScanEnvironment\n\tEND\n"

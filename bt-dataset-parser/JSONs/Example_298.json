{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is seen, move, grasp, check its properties, do specific task; otherwise, avoid obstacles, explore. list of available nodes: <Action ID = MoveToObject    /> <Action ID = TakeObject    /> <Action ID = CheckObjectWeight    /> <Action ID = SpecificTask    /> <Action ID = AvoidObstacle    /> <Action ID = ExploreEnvironment    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectGraspable    /> <Condition ID = IsObstacleAhead    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectGraspable": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToObject",
                    "Name": "MoveToObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectGraspable?": "IsObjectGraspable"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectWeight",
                    "Name": "CheckObjectWeight"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SpecificTask",
                    "Name": "SpecificTask"
                }
            ]
        }
    }
}
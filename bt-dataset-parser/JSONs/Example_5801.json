                                "Task": "ApproachItem",
                                "Name": "ApproachItem"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "GrabItem",
                                "Name": "GrabItem"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "CheckItemProperties",
                                "Name": "CheckItemProperties"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "SpecificTask",
                        "Name": "SpecificTask"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsItemVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO ApproachItem\n\t\t\t\tDO GrabItem\n\t\t\t\tDO CheckItemProperties\n\t\t\tEND\n\tELSE\n\t\tDO SpecificTask\n\tEND\n"
}
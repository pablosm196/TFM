{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. Find and collect item - if visible, move to, if approached, take and process item. list of available nodes: <Action ID = IsItemVisible    /> <Action ID = MoveToItem    /> <Condition ID = IsItemApproached    /> <Action ID = TakeItem    /> <SubTree ID = ProcessItem    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsItemApproached": "Boolean"
            },
            {
                "IsItemVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Selector",
                        "Decorators": [
                            {
                                "IsItemVisible?": "IsItemVisible"
                            }
                        ],
                        "Nodes": [
                            {
                                "Type": "Sequence",
                                "Decorators": [],
                                "Nodes": [
                                    {
                                        "Type": "Sequence",
                                        "Decorators": [
                                            {
                                                "IsItemApproached?": "IsItemApproached"
                                            }
                                        ],
                                        "Nodes": [
                                            {
                                                "Type": "Task",
                                                "Decorators": [],
                                                "Nodes": [],
                                                "Task": "TakeItem",
                                                "Name": "TakeItem"
                                            },
                                            {
                                                "Type": "Task",
                                                "Decorators": [],
                                                "Nodes": [],
                                                "Task": "ProcessItem",
                                                "Name": "ProcessItem"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "Type": "Sequence",
                                "Decorators": [],
                                "Nodes": [
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "MoveToItem",
                                        "Name": "MoveToItem"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsItemVisible? THEN\n\t\t\tSELECTOR\n\t\t\t\tSEQUENCE\n\t\t\t\t\t\tIF IsItemApproached? THEN\n\t\t\t\t\t\tSEQUENCE\n\t\t\t\t\t\t\tDO TakeItem\n\t\t\t\t\t\t\tDO ProcessItem\n\t\t\t\t\t\tEND\n\t\t\t\tEND\n\t\t\t\tSEQUENCE\n\t\t\t\t\tDO MoveToItem\n\t\t\t\tEND\n\t\t\tEND\n\tEND\n"
}
                    "Name": "CheckObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToDesignatedArea",
                    "Name": "MoveToDesignatedArea"
                },
                {
                    "Type": "Task",

    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectFound? THEN\n\t\t\t\tSEQUENCE\n\t\t\t\t\tDO ApproachObject\n\t\t\t\t\tDO TakeObject\n\t\t\t\tEND\n\t\tELSE\n\t\t\tDO CheckObjectProperties\n\t\tEND\n\t\tDO ScanAreaForObject\n\tEND\n"

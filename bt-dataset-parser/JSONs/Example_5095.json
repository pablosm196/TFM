{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find and grab the object. If visible, collect it. Process it in order to complete the task. list of available nodes: <Action ID = NavigateToSearchArea    /> <Action ID = LookForItem    /> <Action ID = IsItemVisible    /> <Action ID = CollectItem    /> <SubTree ID = ProcessItem    />",
    "BT": {
        "Blackboard": [
            {
                "IsItemVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "NavigateToSearchArea",
                    "Name": "NavigateToSearchArea"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsItemVisible?": "IsItemVisible"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "CollectItem",
                                    "Name": "CollectItem"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "ProcessItem",
                                    "Name": "ProcessItem"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "LookForItem",
                                    "Name": "LookForItem"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }
}
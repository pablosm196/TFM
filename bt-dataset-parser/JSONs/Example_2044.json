{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find and Grab Object    : If object visible then approach, take, and process it, otherwise scan area. list of available nodes: <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <Action ID = ScanArea    /> <Action ID = PerformTask    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectInRange    /> <SubTree ID = CheckObjectProperties    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectInRange": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectInRange?": "IsObjectInRange"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PerformTask",
                            "Name": "PerformTask"
                        }
                    ]
                }
            ]
        }
    }
}
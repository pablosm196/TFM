{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find, approach and grab object. Then, check obj. properties. Move obj. to destination or do specific task in order. list of available nodes: <Action ID = FindObject    /> <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <Condition ID = isObjectHeavy    /> <Action ID = MoveObjectToDestination    /> <Condition ID = isObjectFragile    /> <Action ID = CheckObjectProperties    /> <SubTree ID = SpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "isObjectHeavy": "Boolean"
            },
            {
                "isObjectFragile": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "FindObject",
                    "Name": "FindObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "TakeObject",
                    "Name": "TakeObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "isObjectHeavy?": "isObjectHeavy"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveObjectToDestination",
                    "Name": "MoveObjectToDestination"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "isObjectFragile?": "isObjectFragile"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "CheckObjectProperties",
                                    "Name": "CheckObjectProperties"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                }
            ]
        }
    }

                        "Task": "MoveToLocation",
                        "Name": "MoveToLocation"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "CheckObjectProperties?": "CheckObjectProperties"
                            }
                        ],
                        "Nodes": [],
                        "Task": "SpecificTask",
                        "Name": "SpecificTask"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectApproached? THEN\n\t\t\tDO TakeObject\n\tELSE\n\t\tDO MoveToLocation\n\t\t\tIF CheckObjectProperties? THEN\n\t\t\tDO SpecificTask\n\tEND\n"

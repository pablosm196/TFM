    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO ProcessObjectProperties\n\t\tEND\n\t\tSEQUENCE\n\t\t\tDO MoveForward\n\t\tEND\n\t\tDO ScanAreaForObject\n\t\tDO SpecificTask\n\tEND\n"

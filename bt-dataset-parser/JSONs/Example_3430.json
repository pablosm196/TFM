{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object is found, take it, check its properties, do task, if lost, search for it, scan area.     list of available nodes: <Action ID = TakeObject    /> <Action ID = DoSpecificTask    /> <Condition ID = IsObjectInReach    /> <Action ID = MoveToLastKnownLocation    /> <Action ID = ScanArea    /> <Condition ID = IsObjectLost    /> <Action ID = SearchForObject    /> <SubTree ID = CheckObjectProp    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectInReach": "Boolean"
            },
            {
                "IsObjectLost": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectInReach?": "IsObjectInReach"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProp",
                            "Name": "CheckObjectProp"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "DoSpecificTask",
                            "Name": "DoSpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectLost?": "IsObjectLost"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToLastKnownLocation",
                            "Name": "MoveToLastKnownLocation"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanArea",
                            "Name": "ScanArea"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SearchForObject",
                    "Name": "SearchForObject"
                }
            ]
        }
    }
}
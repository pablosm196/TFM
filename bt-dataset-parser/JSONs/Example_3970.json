{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes.     Find object, approach, inspect and move it to destination. Repeat until successful. If necessary, scan area.     list of available nodes: <Action ID = GrabObject    /> <Action ID = MoveToDestination    /> <Action ID = InspectObject    /> <Action ID = ScanAreaForObject    /> <Action ID = ApproachObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectApproached    /> <Condition ID = IsDestinationReached    /> <SubTree ID = PerformTask    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsDestinationReached": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsObjectApproached?": "IsObjectApproached"
                            }
                        ],
                        "Nodes": [],
                        "Task": "GrabObject",
                        "Name": "GrabObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "MoveToDestination",
                        "Name": "MoveToDestination"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsDestinationReached?": "IsDestinationReached"
                            }
                        ],
                        "Nodes": [],
                        "Task": "InspectObject",
                        "Name": "InspectObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "PerformTask",
                        "Name": "PerformTask"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectApproached? THEN\n\t\t\tDO GrabObject\n\tELSE\n\t\tDO MoveToDestination\n\t\t\tIF IsDestinationReached? THEN\n\t\t\tDO InspectObject\n\tELSE\n\t\tDO PerformTask\n\tEND\n"
}
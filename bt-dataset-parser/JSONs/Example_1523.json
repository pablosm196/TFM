{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If object is close: grab it and check its properties, then move to another object or perform task. list of available nodes: <Action ID = GrabObject    /> <Action ID = MoveToNextObjectLocation    /> <Condition ID = IsObjectApproached    /> <Action ID = PerformSpecificTask    /> <SubTree ID = CheckObjectProperties    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Selector",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Sequence",
                                "Decorators": [
                                    {
                                        "IsObjectApproached?": "IsObjectApproached"
                                    }
                                ],
                                "Nodes": [
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "GrabObject",
                                        "Name": "GrabObject"
                                    },
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "CheckObjectProperties",
                                        "Name": "CheckObjectProperties"
                                    }
                                ]
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "MoveToNextObjectLocation",
                                "Name": "MoveToNextObjectLocation"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "PerformSpecificTask",
                        "Name": "PerformSpecificTask"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\tSELECTOR\n\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\tSEQUENCE\n\t\t\t\t\tDO GrabObject\n\t\t\t\t\tDO CheckObjectProperties\n\t\t\t\tEND\n\t\tELSE\n\t\t\tDO MoveToNextObjectLocation\n\t\tEND\n\t\tDO PerformSpecificTask\n\tEND\n"
}
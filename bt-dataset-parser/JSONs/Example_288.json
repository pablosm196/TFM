    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectNear? THEN\n\t\t\t\tDO GrabObject\n\t\tELSE\n\t\t\tDO CheckObjectProperties\n\t\tEND\n\t\tSEQUENCE\n\t\t\tDO MoveToTarget\n\t\tEND\n\t\tDO ScanForObjects\n\tEND\n"

                                        "Decorators": [
                                            {
                                                "IsObjectApproached?": "IsObjectApproached"
                                            }
                                        ],
                                        "Nodes": [],
                                        "Task": "TakeObject",
                                        "Name": "TakeObject"
                                    },
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "ProcessObjectProperties",
                                        "Name": "ProcessObjectProperties"
                                    },
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "SpecificTask",
                                        "Name": "SpecificTask"
                                    }
                                ]
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ApproachObject",
                                "Name": "ApproachObject"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "MoveToLocation",
                        "Name": "MoveToLocation"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSELECTOR\n\t\t\t\tSEQUENCE\n\t\t\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\t\t\tDO TakeObject\n\t\t\t\tELSE\n\t\t\t\t\tDO ProcessObjectProperties\n\t\t\t\t\tDO SpecificTask\n\t\t\t\tEND\n\t\t\t\tDO ApproachObject\n\t\t\tEND\n\tELSE\n\t\tDO MoveToLocation\n\tEND\n"
}
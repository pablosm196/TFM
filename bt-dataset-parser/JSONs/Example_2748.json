                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Selector",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [
                            {
                                "Type": "Sequence",
                                "Decorators": [],

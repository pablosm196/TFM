{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, move to it, grab it, inspect it, perform task; else move to destination. list of available nodes: <Action ID = MoveToGetObject    /> <Action ID = GrabObject    /> <Action ID = InspectObjectForProperties    /> <SubTree ID = PerformSpecificTask    /> <Action ID = IsPathClear    /> <Action ID = MoveToDestination    /> <Condition ID = IsObjectVisible    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsPathClear": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectVisible?": "IsObjectVisible"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "MoveToGetObject",
                                "Name": "MoveToGetObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "GrabObject",
                                "Name": "GrabObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "InspectObjectForProperties",
                                "Name": "InspectObjectForProperties"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "PerformSpecificTask",
                                "Name": "PerformSpecificTask"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsPathClear?": "IsPathClear"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "MoveToDestination",
                                "Name": "MoveToDestination"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO MoveToGetObject\n\t\tELSE\n\t\t\tDO GrabObject\n\t\t\tDO InspectObjectForProperties\n\t\t\tDO PerformSpecificTask\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsPathClear? THEN\n\t\t\t\tDO MoveToDestination\n\t\tEND\n\tEND\n"

    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\t\tSEQUENCE\n\t\t\t\t\t\tDO TakeObject\n\t\t\t\t\t\tDO MoveToObjectStorage\n\t\t\t\t\t\tDO CheckAndLabelObject\n\t\t\t\t\tEND\n\t\t\tEND\n\tELSE\n\t\tDO SearchForObject\n\tEND\n"

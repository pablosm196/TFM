    "code": "\tSEQUENCE\n\t\t\tIF IsObjectApproached? THEN\n\t\t\tSELECTOR\n\t\t\t\tSEQUENCE\n\t\t\t\t\tDO TakeObject\n\t\t\t\t\tDO CheckObjectProperties\n\t\t\t\t\tDO MoveToLocation\n\t\t\t\t\tDO SpecificTask\n\t\t\t\tEND\n\t\t\t\tDO ScanAreaForObject\n\t\t\tEND\n\tEND\n"

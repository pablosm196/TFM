    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectFound? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO CheckObjectProperties\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsInTaskLocation? THEN\n\t\t\t\tDO MoveToLocation\n\t\tEND\n\t\tDO ScanAreaForObjects\n\tEND\n"

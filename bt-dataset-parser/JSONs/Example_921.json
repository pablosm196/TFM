{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find object, approach it, take it, check its property, perform task, return. list of available nodes: <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <Action ID = CheckObjectProperty    /> <Action ID = ReturnToStartingPoint    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectWithinReach    /> <Condition ID = DoesObjectHaveProperty    /> <SubTree ID = PerformTask    />",
    "BT": {
        "Blackboard": [
            {
                "DoesObjectHaveProperty": "Boolean"
            },
            {
                "IsObjectWithinReach": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectWithinReach?": "IsObjectWithinReach"
                        }
                    ],
                    "Nodes": [],
                    "Task": "TakeObject",
                    "Name": "TakeObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "DoesObjectHaveProperty?": "DoesObjectHaveProperty"
                                }
                            ],
                            "Nodes": [],
                            "Task": "CheckObjectProperty",
                            "Name": "CheckObjectProperty"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PerformTask",
                            "Name": "PerformTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ReturnToStartingPoint",
                    "Name": "ReturnToStartingPoint"
                }
            ]
        }
    }
}
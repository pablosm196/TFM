                                "Task": "ProcessObject",
                                "Name": "ProcessObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "DropObject",
                                "Name": "DropObject"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectApproached? THEN\n\t\t\tDO GrabObject\n\tELSE\n\t\t\tIF IsObjectHeavy? THEN\n\t\t\tDO MoveWithObject\n\tELSE\n\t\t\tIF IsNearTargetLocation? THEN\n\t\t\tSELECTOR\n\t\t\t\tDO ProcessObject\n\t\t\t\tDO DropObject\n\t\t\tEND\n\tEND\n"

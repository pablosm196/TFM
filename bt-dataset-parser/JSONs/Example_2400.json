{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, approach and grab it, perform task, move and check completion. Else scan and move on. list of available nodes: <Action ID = ApproachObject    /> <Action ID = GrabObject    /> <Action ID = MoveToDestination    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsTaskCompleted    /> <SubTree ID = ObjectTask    /> <Action ID = ScanAreaForObject    /> <Action ID = MoveToNextLocation    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsTaskCompleted": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ApproachObject",
                                "Name": "ApproachObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "GrabObject",
                                "Name": "GrabObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ObjectTask",
                                "Name": "ObjectTask"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "MoveToDestination",
                                "Name": "MoveToDestination"
                            }
                        ]
                    },
                    {
                        "Type": "Selector",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ScanAreaForObject",
                                "Name": "ScanAreaForObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "MoveToNextLocation",
                                "Name": "MoveToNextLocation"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO ApproachObject\n\t\t\t\tDO GrabObject\n\t\t\t\tDO ObjectTask\n\t\t\t\tDO MoveToDestination\n\t\t\tEND\n\tELSE\n\t\tSELECTOR\n\t\t\tDO ScanAreaForObject\n\t\t\tDO MoveToNextLocation\n\t\tEND\n\tEND\n"
}
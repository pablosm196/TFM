                    "Decorators": [
                        {
                            "ObjectFound?": "ObjectFound"
                        }
                    ],
                    "Nodes": [],
                    "Task": "TakeObject",
                    "Name": "TakeObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "ObjectProperty2Check?": "ObjectProperty2Check"
                                }
                            ],
                            "Nodes": [],

{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, approach it, detect its properties and take if criteria meet. Otherwise, scan area, move randomly or perform specific task. list of available nodes: <Action ID = ApproachObject    /> <Action ID = DetectObjectProperty    /> <Condition ID = DoesObjectMeetCriteria    /> <Action ID = TakeObject    /> <Action ID = ScanAreaForObject    /> <Action ID = RandomMovement    /> <SubTree ID = PerformSpecificTask    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "DoesObjectMeetCriteria": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectVisible?": "IsObjectVisible"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "ApproachObject",
                                "Name": "ApproachObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "DetectObjectProperty",
                                "Name": "DetectObjectProperty"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "DoesObjectMeetCriteria?": "DoesObjectMeetCriteria"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "TakeObject",
                                "Name": "TakeObject"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ScanAreaForObject",
                        "Name": "ScanAreaForObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "RandomMovement",
                        "Name": "RandomMovement"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "PerformSpecificTask",
                        "Name": "PerformSpecificTask"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO DetectObjectProperty\n\t\t\t\tIF DoesObjectMeetCriteria? THEN\n\t\t\t\tDO TakeObject\n\t\tEND\n\t\tDO ScanAreaForObject\n\t\tDO RandomMovement\n\t\tDO PerformSpecificTask\n\tEND\n"

                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObj",
                            "Name": "ProcessObj"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ReturnObj",
                            "Name": "ReturnObj"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],

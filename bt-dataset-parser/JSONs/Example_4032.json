    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO MoveToTheObject\n\tELSE\n\t\tSEQUENCE\n\t\t\tDO CheckObjectProperties\n\t\t\tSELECTOR\n\t\t\t\tDO GrabObject\n\t\t\t\tDO ScanAreaForObject\n\t\t\tEND\n\t\tEND\n\t\tDO SpecificTask\n\tEND\n"

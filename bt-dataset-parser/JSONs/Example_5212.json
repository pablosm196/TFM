{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object visible, move close, pick up, check properties, do task. If not, approach or scan. list of available nodes: <Action ID = MoveToObject    /> <Action ID = PickupObject    /> <Condition ID = IsObjectInReach    /> <Condition ID = IsObjectVisible    /> <Condition ID = isObjectPickable    /> <Action ID = ApproachObject    /> <Action ID = ScanAreaForObject    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = DoSomeTask    />",
    "BT": {
        "Blackboard": [
            {
                "isObjectPickable": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToObject",
                    "Name": "MoveToObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "isObjectPickable?": "isObjectPickable"
                        }
                    ],
                    "Nodes": [],
                    "Task": "PickupObject",
                    "Name": "PickupObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "DoSomeTask",
                    "Name": "DoSomeTask"
                }
            ]
        }
    }
}
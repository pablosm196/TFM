{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object is near, take it and check properties, then do specific task. Else, move towards object, or scan area.     list of available nodes: <Action ID = TakeObject    /> <Action ID = ScanArea    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = MoveToObject    /> <Sequence>     <Condition ID = IsObjectApproached    />     <Action ID = TakeObject    />     <SubTree ID = CheckObjectProperties    />     <SubTree ID = DoSpecificTask    /> </Sequence> <Sequence>     <Condition ID = IsObjectVisible    />     <SubTree ID = MoveToObject    /> </Sequence> <Action ID = ScanArea    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectApproached?": "IsObjectApproached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "DoSpecificTask",
                            "Name": "DoSpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanArea",
                    "Name": "ScanArea"
                }
            ]
        }
    }
}
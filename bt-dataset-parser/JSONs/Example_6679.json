{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object detected, then approach and take it. If missing, then scan area for objects. Move to next location.     list of available nodes: <Action ID = ApproachAndTakeObject    /> <Action ID = ScanAreaForObjects    /> <Action ID = MoveToNextLocation    /> <Condition ID = IsObjectDetected    />  <Condition ID = IsObjectMissing    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectMissing": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectDetected?": "IsObjectDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachAndTakeObject",
                            "Name": "ApproachAndTakeObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectMissing?": "IsObjectMissing"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ScanAreaForObjects",
                            "Name": "ScanAreaForObjects"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToNextLocation",
                    "Name": "MoveToNextLocation"
                }
            ]
        }
    }
}
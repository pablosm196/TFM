{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find object, grab it, move it and check properties. If can't see object, approach it, then scan area.     list of available nodes: <Action ID = GrabObject    /> <Action ID = MoveObjectToDesignatedSpot    /> <Action ID = ScanObjectProperties    /> <Action ID = SpecificSubTree    /> <Action ID = ApproachObject    /> <Action ID = IsObjectVisible    /> <Action ID = IsObjectApproached    /> <Action ID = ScanAreaForObject    /> <Action ID = isObjectHeavy    />",
    "BT": {
        "Blackboard": [
            {
                "isObjectHeavy": "Boolean"
            },
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectApproached?": "IsObjectApproached"
                        }
                    ],
                    "Nodes": [],
                    "Task": "GrabObject",
                    "Name": "GrabObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "isObjectHeavy?": "isObjectHeavy"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveObjectToDesignatedSpot",
                            "Name": "MoveObjectToDesignatedSpot"
                        }
                    ]
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectVisible?": "IsObjectVisible"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "ApproachObject",
                                    "Name": "ApproachObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "ScanObjectProperties",
                                    "Name": "ScanObjectProperties"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "SpecificSubTree",
                                    "Name": "SpecificSubTree"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanAreaForObject",
                            "Name": "ScanAreaForObject"
                        }
                    ]
                }
            ]
        }
    }
}
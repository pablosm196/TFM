{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find an object, move and take it. If grasped, process it. If not, scan for new object. list of available nodes: <Action ID = FindObject    /> <Action ID = ApproachObject    /> <Action ID = ScanForNewObject    /> <Condition ID = IsObjectGraspable    /> <Action ID = TakeObject    /> <SubTree ID = ProcessObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectGraspable": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "FindObject",
                    "Name": "FindObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectGraspable?": "IsObjectGraspable"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "TakeObject",
                                    "Name": "TakeObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "ProcessObject",
                                    "Name": "ProcessObject"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanForNewObject",
                            "Name": "ScanForNewObject"
                        }
                    ]
                }
            ]
        }
    }
}
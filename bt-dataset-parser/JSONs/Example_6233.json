    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO TakeObject\n\t\t\t\tIF ObjectPropertyCheck? THEN\n\t\t\t\tDO SpecificTask\n\t\tEND\n\t\tSEQUENCE\n\t\t\tDO MoveToRandomLocation\n\t\t\tDO ScanForObject\n\t\tEND\n\tEND\n"

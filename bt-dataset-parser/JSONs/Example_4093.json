{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object visible, approach and take, check if valid, move to destination, do task, else scan and approach random object. list of available nodes: <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <Action ID = MoveToDestination    /> <Condition ID = isObjectValid    /> <SubTree ID = SpecificTask    /> <Action ID = ScanAreaForObjects    /> <Condition ID = AreThereObjects    /> <Action ID = ApproachRandomObject    />",
    "BT": {
        "Blackboard": [
            {
                "isObjectValid": "Boolean"
            },
            {
                "AreThereObjects": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "isObjectValid?": "isObjectValid"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanAreaForObjects",
                            "Name": "ScanAreaForObjects"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "AreThereObjects?": "AreThereObjects"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachRandomObject",
                            "Name": "ApproachRandomObject"
                        }
                    ]
                }
            ]
        }
    }
}
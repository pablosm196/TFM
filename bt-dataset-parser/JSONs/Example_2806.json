{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. Find, approach, take and process object. If object is not found, scan area and move on. list of available nodes: <Action ID = ScanAreaForObject    /> <Condition ID = IsObjectVisible    /> <SubTree ID = ProcessObject    /> <Condition ID = IsObjectGrabbed    /> <Action ID = MoveToProcessingArea    /> <Action ID = NoObjectFoundBehavior    /> <Action ID = ApproachObject    /> <Action ID = MoveToNextArea    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectGrabbed": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ApproachObject",
                                "Name": "ApproachObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectGrabbed?": "IsObjectGrabbed"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "MoveToProcessingArea",
                                "Name": "MoveToProcessingArea"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ProcessObject",
                                "Name": "ProcessObject"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO ApproachObject\n\t\t\t\t\tIF IsObjectGrabbed? THEN\n\t\t\t\t\tDO MoveToProcessingArea\n\t\t\tELSE\n\t\t\t\tDO ProcessObject\n\t\t\tEND\n\tEND\n"
}
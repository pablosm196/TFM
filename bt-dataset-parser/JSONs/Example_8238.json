{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. Find visible object, approach it; if close enough take it, process it, else move to it. list of available nodes: <Action ID = IsObjectVisible    /> <Sequence>     <Condition ID = IsObjectApproached    />     <Sequence>         <Action ID = TakeObject    />         <SubTree ID = ProcessObject    />     </Sequence> </Sequence> <Action ID = MoveToObject    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Selector",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [
                            {
                                "Type": "Sequence",
                                "Decorators": [],
                                "Nodes": [
                                    {
                                        "Type": "Sequence",
                                        "Decorators": [
                                            {
                                                "IsObjectApproached?": "IsObjectApproached"
                                            }
                                        ],
                                        "Nodes": [
                                            {
                                                "Type": "Task",
                                                "Decorators": [],
                                                "Nodes": [],
                                                "Task": "TakeObject",
                                                "Name": "TakeObject"
                                            },
                                            {
                                                "Type": "Task",
                                                "Decorators": [],
                                                "Nodes": [],
                                                "Task": "ProcessObject",
                                                "Name": "ProcessObject"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "MoveToObject",
                                "Name": "MoveToObject"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSELECTOR\n\t\t\t\tSEQUENCE\n\t\t\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\t\t\tSEQUENCE\n\t\t\t\t\t\t\tDO TakeObject\n\t\t\t\t\t\t\tDO ProcessObject\n\t\t\t\t\t\tEND\n\t\t\t\tEND\n\t\t\t\tDO MoveToObject\n\t\t\tEND\n\tEND\n"
}
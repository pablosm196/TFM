{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object visible, approach and take. If task assigned, process. Scan area for objects. list of available nodes: <Action ID = ScanAreaForObjects    /> <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <Action ID = MoveToObjectStorage    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsTaskAssigned    /> <SubTree ID = ProcessAssignedTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsTaskAssigned": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToObjectStorage",
                            "Name": "MoveToObjectStorage"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTaskAssigned?": "IsTaskAssigned"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ProcessAssignedTask",
                            "Name": "ProcessAssignedTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObjects",
                    "Name": "ScanAreaForObjects"
                }
            ]
        }
    }
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object detected, move, take, process in order, put back. If no object, scan area. list of available nodes: <Action ID = TakeObject    /> <Action ID = PutObjectBack    /> <Action ID = ScanAreaForObject    /> <Action ID = MoveToApproachObject    /> <Action ID = MoveToScanArea    /> <Action ID = ProcessObject    /> <Condition ID = IsObjectDetected    /> <Condition ID = IsPathClear    />",
    "BT": {
        "Blackboard": [
            {
                "IsPathClear": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectDetected?": "IsObjectDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToApproachObject",
                            "Name": "MoveToApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObject",
                            "Name": "ProcessObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PutObjectBack",
                            "Name": "PutObjectBack"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsPathClear?": "IsPathClear"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToScanArea",
                            "Name": "MoveToScanArea"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanAreaForObject",
                            "Name": "ScanAreaForObject"
                        }
                    ]
                }
            ]
        }
    }
}
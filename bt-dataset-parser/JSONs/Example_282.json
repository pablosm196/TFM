{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object found, move to it, take and check it, perform task. Otherwise scan and avoid obstacles. list of available nodes: <Action ID = MoveToObject    /> <Action ID = TakeObject    /> <Action ID = ScanEnvironment    /> <Condition ID = IsObjectLocated    /> <Condition ID = IsObstacleInPath    /> <Action ID = AvoidObstacle    /> <SubTree ID = PerformSpecificTask    /> <SubTree ID = CheckObjectProperties    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectLocated": "Boolean"
            },
            {
                "IsObstacleInPath": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],

    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO MoveToObj\n\tELSE\n\t\tDO GrabObj\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjHeavy? THEN\n\t\t\t\t\tDO MoveObjToLocation\n\t\t\tEND\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjLight? THEN\n\t\t\t\t\tDO InspectObj\n\t\t\tEND\n\t\tEND\n\tEND\n"

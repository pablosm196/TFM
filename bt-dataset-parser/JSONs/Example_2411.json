    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO ApproachObject\n\t\t\t\t\tIF IsObjectClose? THEN\n\t\t\t\t\tDO TakeObject\n\t\t\tEND\n\tELSE\n\t\tDO CheckObjectProperties\n\t\tDO SpecificSubtree\n\t\tDO MoveToDestination\n\tEND\n"

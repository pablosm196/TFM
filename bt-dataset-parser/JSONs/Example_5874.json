{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If found object, approach, take, and process it; else continue scanning. list of available nodes: <Action ID = ScanArea    /> <Condition ID = IsObjectVisible    /> <Action ID = ApproachObject    /> <Condition ID = IsObjectInRange    /> <Action ID = TakeObject    /> <SubTree ID = ProcessObject    /> <Action ID = ContinueSearching    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectInRange": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanArea",
                    "Name": "ScanArea"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectVisible?": "IsObjectVisible"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "ApproachObject",
                                    "Name": "ApproachObject"
                                },
                                {
                                    "Type": "Sequence",
                                    "Decorators": [],
                                    "Nodes": [
                                        {
                                            "Type": "Task",
                                            "Decorators": [
                                                {
                                                    "IsObjectInRange?": "IsObjectInRange"
                                                }
                                            ],
                                            "Nodes": [],
                                            "Task": "TakeObject",
                                            "Name": "TakeObject"
                                        },
                                        {
                                            "Type": "Task",
                                            "Decorators": [],
                                            "Nodes": [],
                                            "Task": "ProcessObject",
                                            "Name": "ProcessObject"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ContinueSearching",
                            "Name": "ContinueSearching"
                        }
                    ]
                }
            ]
        }
    }
}
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectFound? THEN\n\t\t\t\tDO PickupObject\n\t\tELSE\n\t\t\tDO ProcessObjectTask\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsDestinationReached? THEN\n\t\t\t\tDO MoveTowardsDestination\n\t\tEND\n\t\tDO ScanAreaForObjects\n\tEND\n"

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If there is an object in front of you, then pick it up and check it. If not, move towards the given location while avoiding obstacles. Finally, scan the area for objects. list of available nodes: <Action ID = PickUpObject    /> <Action ID = MoveToLocation    /> <SubTree ID = CheckObject    /> <Condition ID = IsObjectInFront    /> <Condition ID = IsPathClear    /> <Action ID = ScanForObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectInFront": "Boolean"
            },
            {
                "IsPathClear": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectInFront?": "IsObjectInFront"
                                }
                            ],
                            "Nodes": [],
                            "Task": "PickUpObject",
                            "Name": "PickUpObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObject",
                            "Name": "CheckObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsPathClear?": "IsPathClear"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToLocation",
                            "Name": "MoveToLocation"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanForObject",
                    "Name": "ScanForObject"
                }
            ]
        }
    }
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find & grab object, approach, move to destination, check safety, do task. Scan if necessary.     list of available nodes: <SubTree ID = ProcessObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = isObjectGrabbed    /> <Condition ID = IsObjectSafe    /> <Action ID = ApproachObject    /> <Action ID = MoveToDestination    /> <Action ID = ScanAreaForObject    />",
    "BT": {
        "Blackboard": [
            {
                "isObjectGrabbed": "Boolean"
            },
            {
                "IsObjectSafe": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "isObjectGrabbed?": "isObjectGrabbed"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "MoveToDestination",
                                    "Name": "MoveToDestination"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectSafe?": "IsObjectSafe"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "ProcessObject",
                                    "Name": "ProcessObject"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObject",
                    "Name": "ScanAreaForObject"
                }
            ]
        }
    }
}
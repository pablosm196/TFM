    "BT": {
        "Blackboard": [
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectDetected?": "IsObjectDetected"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToObject",
                    "Name": "MoveToObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "GrabObject",
                    "Name": "GrabObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SpecificTask",
                    "Name": "SpecificTask"
                }
            ]
        }
    }
}
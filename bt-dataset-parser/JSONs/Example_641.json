{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If task approached, take it, move, check task properties, perform task. If not, scan area or approach visible object. list of available nodes: <Action ID = TakeTask    /> <Action ID = MoveToTaskLocation    /> <Action ID = ApproachObject    /> <Action ID = ScanAreaForObject    /> <Action ID = CheckTaskProperties    /> <SubTree ID = PerformTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsTaskApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTaskApproached?": "IsTaskApproached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeTask",
                            "Name": "TakeTask"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToTaskLocation",
                            "Name": "MoveToTaskLocation"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckTaskProperties",
                            "Name": "CheckTaskProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PerformTask",
                            "Name": "PerformTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObject",
                    "Name": "ScanAreaForObject"
                }
            ]
        }
    }
}
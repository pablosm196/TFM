    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO PickUpItem\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectInHand? THEN\n\t\t\t\tDO MoveToDestination\n\t\tELSE\n\t\t\tDO CheckObjectProperties\n\t\tEND\n\t\tDO SpecificTask\n\t\tDO ReturnToStartingPoint\n\tEND\n"

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object visible then move and grab. Check properties. If heavy, move to destination. Else, scan area and move randomly. list of available nodes: <Action ID = IsObjectVisible    /> <Action ID = MoveToTarget    /> <Action ID = GrabObject    /> <Condition ID = IsObjectHeavy    /> <Action ID = MoveToDestination    /> <Action ID = CheckObjectProperties    /> <Action ID = RandomMove    /> <Action ID = MoveToNextTarget    /> <Action ID = ScanAreaForObjects    /> <Condition ID = IsAnotherObjectVisible    /> <SubTree ID = SpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectHeavy": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToTarget",
                    "Name": "MoveToTarget"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "GrabObject",
                    "Name": "GrabObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectHeavy?": "IsObjectHeavy"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToDestination",
                    "Name": "MoveToDestination"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SpecificTask",
                    "Name": "SpecificTask"
                }
            ]
        }
    }
}
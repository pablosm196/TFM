    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO TakeObject\n\t\t\t\tIF IsObjectHeavy? THEN\n\t\t\t\tDO MoveObjectToLocation\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF HasTaskAssigned? THEN\n\t\t\t\tDO TaskSubtree\n\t\tEND\n\tEND\n"

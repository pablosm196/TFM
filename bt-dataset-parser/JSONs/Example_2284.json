{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find, move, take object - if approached, take object, check properties, then do specific task. Else approach object. Finally find object. list of available nodes: <Action ID = TakeObject    /> <Action ID = CheckObjectProperties    /> <Action ID = SpecificTask    /> <Action ID = FindObject    /> <SubTree ID = ApproachObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectApproached    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {

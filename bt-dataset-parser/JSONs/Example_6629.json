                                "Task": "SpecificTask",
                                "Name": "SpecificTask"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "SearchForObject",
                        "Name": "SearchForObject"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectFound? THEN\n\t\t\t\tDO MoveToTarget\n\t\tELSE\n\t\t\tDO TakeObject\n\t\t\tDO ObjectPropertiesCheck\n\t\t\tDO SpecificTask\n\t\tEND\n\t\tDO SearchForObject\n\tEND\n"

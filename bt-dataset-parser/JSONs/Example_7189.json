{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Approach and take object if found, scan area otherwise. list of available nodes: <Action ID = ScanArea    /> <Action ID = ApproachObject    /> <Action ID = CheckAndTakeObject    /> <Action ID = MoveToDestination    /> <Condition ID = IsObjectFound    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectFound": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectFound?": "IsObjectFound"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckAndTakeObject",
                            "Name": "CheckAndTakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanArea",
                            "Name": "ScanArea"
                        }
                    ]
                }
            ]
        }
    }
}
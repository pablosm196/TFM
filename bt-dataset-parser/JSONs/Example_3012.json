{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, move to it, grab it, and do task; otherwise, find unblocked path. list of available nodes: <Action ID = MoveToObject    /> <Action ID = CheckObject    /> <Action ID = GrabObject    /> <Action ID = FindAlternativeRoute    /> <Action ID = DoTask    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsPathBlocked    /> <SubTree ID = DoTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsPathBlocked": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectVisible?": "IsObjectVisible"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "MoveToObject",
                                    "Name": "MoveToObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "CheckObject",
                                    "Name": "CheckObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "GrabObject",
                                    "Name": "GrabObject"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsPathBlocked?": "IsPathBlocked"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "FindAlternativeRoute",
                                    "Name": "FindAlternativeRoute"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "DoTask",
                    "Name": "DoTask"
                }
            ]
        }
    }
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object seen then approach, take, and perform specific task, else move and scan. list of available nodes: <Action ID = ScanAreaForObject    /> <Action ID = CheckObjectVisible    /> <Action ID = TakeObject    /> <Action ID = SpecificTask    /> <Action ID = IsObjectApproached    /> <Action ID = MoveToLocation    /> <SubTree ID = MobileRobotTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "CheckObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Selector",
                    "Decorators": [
                        {
                            "CheckObjectVisible?": "CheckObjectVisible"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectApproached?": "IsObjectApproached"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "TakeObject",
                                    "Name": "TakeObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "SpecificTask",
                                    "Name": "SpecificTask"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "MoveToLocation",
                                    "Name": "MoveToLocation"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "ScanAreaForObject",
                                    "Name": "ScanAreaForObject"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }
}
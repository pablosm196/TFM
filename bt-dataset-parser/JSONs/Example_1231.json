                                            "Name": "ApproachObject"
                                        },
                                        {
                                            "Type": "Task",
                                            "Decorators": [
                                                {
                                                    "isObjectWithinReach?": "isObjectWithinReach"
                                                }
                                            ],
                                            "Nodes": [],
                                            "Task": "GrabObject",
                                            "Name": "GrabObject"
                                        },
                                        {
                                            "Type": "Task",
                                            "Decorators": [],
                                            "Nodes": [],
                                            "Task": "CheckObjectProperties",
                                            "Name": "CheckObjectProperties"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToNextSearchArea",
                            "Name": "MoveToNextSearchArea"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "TaskSpecificBehavior",
                    "Name": "TaskSpecificBehavior"
                }
            ]
        }
    }

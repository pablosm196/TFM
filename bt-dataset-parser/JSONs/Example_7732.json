                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectFeature1?": "IsObjectFeature1"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "DoFeature1Task",
                                    "Name": "DoFeature1Task"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectFeature2?": "IsObjectFeature2"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "DoFeature2Task",
                                    "Name": "DoFeature2Task"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanObject",
                            "Name": "ScanObject"
                        }
                    ]
                }
            ]
        }
    }

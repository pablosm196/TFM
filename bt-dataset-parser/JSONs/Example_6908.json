                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "DoTask",
                        "Name": "DoTask"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO ApproachObject\n\t\t\t\tDO TakeObject\n\t\t\tEND\n\tELSE\n\t\tDO CheckObject\n\t\tDO MoveToTaskLocation\n\t\tDO DoTask\n\tEND\n"

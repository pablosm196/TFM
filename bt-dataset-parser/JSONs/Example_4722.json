                                "Nodes": [],
                                "Task": "ProcessObject",
                                "Name": "ProcessObject"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO MoveToTarget\n\t\t\t\t\tIF IsObjectGrabbable? THEN\n\t\t\t\t\tDO GrabObject\n\t\t\tELSE\n\t\t\t\tDO ProcessObject\n\t\t\tEND\n\tEND\n"

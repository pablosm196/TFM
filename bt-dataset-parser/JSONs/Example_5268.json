                        "Nodes": [],
                        "Task": "SpecificTask",
                        "Name": "SpecificTask"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\t\tIF IsObjectReached? THEN\n\t\t\tDO TakeObject\n\tELSE\n\t\tDO CheckObjectProperties\n\t\tDO MoveToDestination\n\t\tDO SpecificTask\n\tEND\n"

    "code": "\tSEQUENCE\n\t\t\tIF IsObjectDetected? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO MoveToTheObject\n\t\t\t\tDO TakeObject\n\t\t\t\t\tIF IsObjectHeavy? THEN\n\t\t\t\t\tDO PlaceObjectOnPlatform\n\t\t\tELSE\n\t\t\t\tDO InspectObject\n\t\t\tEND\n\tELSE\n\t\tSELECTOR\n\t\t\tDO ScanForObject\n\t\t\tDO SpecificTask\n\t\tEND\n\tEND\n"

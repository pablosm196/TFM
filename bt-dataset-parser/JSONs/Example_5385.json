{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes.     Find object, move to it, take it, check properties, execute task. If object not found, scan area.     list of available nodes: <Action ID = MoveToObject    /> <Action ID = TakeObject    /> <Condition ID = IsObjectGrabbable    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = ExecuteTask    /> <Action ID = ScanArea    /> <Action ID = ApproachObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectApproached    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectGrabbable": "Boolean"
            }
        ],
        "Root": {

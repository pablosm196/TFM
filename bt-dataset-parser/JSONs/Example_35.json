{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes.     Find and collect visible object. Approach it, take it and process its properties. Move to next area.     list of available nodes: <Action ID = IsObjectVisible    /> <Action ID = IsObjectApproached    /> <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <SubTree ID = ProcessObjectProperties    /> <Action ID = MoveToNextArea    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Selector",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [
                            {
                                "Type": "Sequence",
                                "Decorators": [],
                                "Nodes": [
                                    {
                                        "Type": "Sequence",
                                        "Decorators": [
                                            {
                                                "IsObjectApproached?": "IsObjectApproached"
                                            }
                                        ],
                                        "Nodes": [
                                            {
                                                "Type": "Task",
                                                "Decorators": [],
                                                "Nodes": [],
                                                "Task": "TakeObject",
                                                "Name": "TakeObject"
                                            },
                                            {
                                                "Type": "Task",
                                                "Decorators": [],
                                                "Nodes": [],
                                                "Task": "ProcessObjectProperties",
                                                "Name": "ProcessObjectProperties"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ApproachObject",
                                "Name": "ApproachObject"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "MoveToNextArea",
                        "Name": "MoveToNextArea"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSELECTOR\n\t\t\t\tSEQUENCE\n\t\t\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\t\t\tSEQUENCE\n\t\t\t\t\t\t\tDO TakeObject\n\t\t\t\t\t\t\tDO ProcessObjectProperties\n\t\t\t\t\t\tEND\n\t\t\t\tEND\n\t\t\t\tDO ApproachObject\n\t\t\tEND\n\tELSE\n\t\tDO MoveToNextArea\n\tEND\n"
}
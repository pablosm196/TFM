{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If an object is detected, move and reach it. Then take and check it. Finally, do a task or scan area. list of available nodes: <Action ID = MoveToTarget    />  <Action ID = TakeObject    />  <Action ID = CheckObjectWeight    />  <Action ID = CheckObjectSize    />  <Action ID = ScanArea    />  <Condition ID = IsObjectDetected    />  <Condition ID = IsObjectReachable    />  <SubTree ID = ProcessObjectSpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectReachable": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectDetected?": "IsObjectDetected"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToTarget",
                    "Name": "MoveToTarget"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectReachable?": "IsObjectReachable"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectWeight",
                            "Name": "CheckObjectWeight"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectSize",
                            "Name": "CheckObjectSize"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObjectSpecificTask",
                            "Name": "ProcessObjectSpecificTask"
                        }
                    ]
                }
            ]
        }
    }
}
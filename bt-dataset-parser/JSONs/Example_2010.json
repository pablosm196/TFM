                            {
                                "isObjectHeavy?": "isObjectHeavy"
                            }
                        ],
                        "Nodes": [],
                        "Task": "MoveToDestination",
                        "Name": "MoveToDestination"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "SpecificTask",
                        "Name": "SpecificTask"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\tDO TakeObject\n\t\t\tIF isObjectHeavy? THEN\n\t\t\tDO MoveToDestination\n\tELSE\n\t\tDO SpecificTask\n\tEND\n"

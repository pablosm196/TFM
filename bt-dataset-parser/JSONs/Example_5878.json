{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object nearby, take it and process it. If not, move to random location and scan for objects. list of available nodes: <Action ID = TakeObject    /> <SubTree ID = ProcessObject    /> <Condition ID = IsObjectNearby    /> <Action ID = MoveToRandomLocation    /> <Condition ID = IsPathClear    /> <Action ID = ScanForObjects    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectNearby": "Boolean"
            },
            {
                "IsPathClear": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectNearby?": "IsObjectNearby"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObject",
                            "Name": "ProcessObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsPathClear?": "IsPathClear"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToRandomLocation",
                            "Name": "MoveToRandomLocation"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanForObjects",
                    "Name": "ScanForObjects"
                }
            ]
        }
    }
}
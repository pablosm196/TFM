{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Scan area for objects, grab and check them. If not visible, move to next area.     list of available nodes: <Action ID = ScanAreaForObjects    /> <Action ID = GrabObject    /> <Action ID = CheckObjectProperties    /> <SubTree ID = DoSpecificTask    /> <Action ID = MoveToObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectApproached    /> <Action ID = MoveToNextArea    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObjects",
                    "Name": "ScanAreaForObjects"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectApproached?": "IsObjectApproached"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "GrabObject",
                                    "Name": "GrabObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "CheckObjectProperties",
                                    "Name": "CheckObjectProperties"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "DoSpecificTask",
                                    "Name": "DoSpecificTask"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "MoveToObject",
                                    "Name": "MoveToObject"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToNextArea",
                            "Name": "MoveToNextArea"
                        }
                    ]
                }
            ]
        }
    }
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object is visible, approach, grab and process it. Otherwise, avoid obstacles and move.     list of available nodes: <Action ID = ApproachObject    /> <Action ID = GrabObject    /> <Action ID = ProcessObjectProperties    /> <Action ID = IsObjectVisible    /> <Action ID = AvoidObstacle    /> <Action ID = MoveToNextLocation    /> <Condition ID = IsObstacleDetected    />",
    "BT": {
        "Blackboard": [
            {
                "IsObstacleDetected": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObjectProperties",
                            "Name": "ProcessObjectProperties"
                        }
                    ]
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObstacleDetected?": "IsObstacleDetected"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "AvoidObstacle",
                                    "Name": "AvoidObstacle"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToNextLocation",
                            "Name": "MoveToNextLocation"
                        }
                    ]
                }
            ]
        }
    }
}
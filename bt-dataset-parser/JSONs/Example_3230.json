{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If assigned a task, move there and perform it. If object in sight, move, check properties, then take it. list of available nodes: <Action ID = MoveToTaskLocation    /> <Action ID = IsTaskAssigned    /> <SubTree ID = PerformTask    /> <Condition ID = IsObjectInSight    /> <Action ID = MoveToObject    /> <SubTree ID = CheckObjectProperties    /> <Action ID = TakeObject    /> <Action ID = ScanAreaForObjects    />",
    "BT": {
        "Blackboard": [
            {
                "IsTaskAssigned": "Boolean"
            },
            {
                "IsObjectInSight": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTaskAssigned?": "IsTaskAssigned"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToTaskLocation",
                            "Name": "MoveToTaskLocation"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PerformTask",
                            "Name": "PerformTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectInSight?": "IsObjectInSight"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObjects",
                    "Name": "ScanAreaForObjects"
                }
            ]
        }
    }
}
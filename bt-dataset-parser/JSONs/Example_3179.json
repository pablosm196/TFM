{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find and take item. If approach item, take it. If not visible, move to it, then take it. list of available nodes: <Action ID = TakeItem    /> <Action ID = MoveToItem    /> <Action ID = ScanAreaForItems    /> <Action ID = CheckItemProperties    /> <Condition ID = IsItemApproached    /> <Condition ID = IsItemVisible    /> <SubTree ID = FindAndTakeItem    />",
    "BT": {
        "Blackboard": [
            {
                "IsItemVisible": "Boolean"
            },
            {
                "IsItemApproached": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsItemApproached?": "IsItemApproached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeItem",
                            "Name": "TakeItem"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckItemProperties",
                            "Name": "CheckItemProperties"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsItemVisible?": "IsItemVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToItem",
                            "Name": "MoveToItem"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForItems",
                    "Name": "ScanAreaForItems"
                }
            ]
        }
    }
}
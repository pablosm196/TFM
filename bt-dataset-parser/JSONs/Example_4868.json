{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find and grab object. If task is near, do it. Scan area. list of available nodes: <Action ID = DoTask    /> <Action ID = ApproachObject    /> <Action ID = ScanAreaForTask    /> <Action ID = GrabObject    /> <SubTree ID = ProcessTask    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsTaskApproached    /> <Action ID = ProcessObject    /> <Action ID = IsObjectApproached    /> <Action ID = ApproachTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsTaskApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectNear": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTaskApproached?": "IsTaskApproached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "DoTask",
                            "Name": "DoTask"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessTask",
                            "Name": "ProcessTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectNear?": "IsObjectNear"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "GrabObject",
                                    "Name": "GrabObject"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForTask",
                    "Name": "ScanAreaForTask"
                }
            ]
        }
    }
}
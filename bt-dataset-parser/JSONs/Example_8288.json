{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object is seen, grab it. Move to new location. If object is visible, check it. Then do specific task.     list of available nodes: <Action ID = GrabObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectInSight    />   <SubTree ID = SpecificTask    /> <Action ID = CheckObjectProperties    />   <Action ID = MoveToNewLocation    />   <Action ID = IsObjectInReach    />   <Action ID = ApproachObject    />   <Action ID = ScanAreaForObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectInReach": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectInSight": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectInReach?": "IsObjectInReach"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "GrabObject",
                                    "Name": "GrabObject"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToNewLocation",
                    "Name": "MoveToNewLocation"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectInSight?": "IsObjectInSight"
                                }
                            ],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SpecificTask",
                    "Name": "SpecificTask"
                }
            ]
        }
    }
}
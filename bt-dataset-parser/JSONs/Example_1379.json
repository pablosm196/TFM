{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, move to it. If close, check properties, take and perform task. Otherwise, scan. list of available nodes: <Action ID = MoveToObject    /> <Action ID = ScanForObjectAgain    /> <Action ID = CheckObjectProperties    /> <Action ID = TakeObject    /> <Action ID = PerformTask    />  <Condition ID = IsObjectVisible    />  <Condition ID = CanTakeObject    />",
    "BT": {
        "Blackboard": [
            {
                "CanTakeObject": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Selector",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Sequence",
                                    "Decorators": [],
                                    "Nodes": [
                                        {
                                            "Type": "Task",
                                            "Decorators": [
                                                {
                                                    "CanTakeObject?": "CanTakeObject"
                                                }
                                            ],
                                            "Nodes": [],
                                            "Task": "TakeObject",
                                            "Name": "TakeObject"
                                        },
                                        {
                                            "Type": "Task",
                                            "Decorators": [],
                                            "Nodes": [],
                                            "Task": "CheckObjectProperties",
                                            "Name": "CheckObjectProperties"
                                        },
                                        {
                                            "Type": "Task",
                                            "Decorators": [],
                                            "Nodes": [],
                                            "Task": "PerformTask",
                                            "Name": "PerformTask"
                                        }
                                    ]
                                },
                                {
                                    "Type": "Sequence",
                                    "Decorators": [],
                                    "Nodes": [
                                        {
                                            "Type": "Task",
                                            "Decorators": [],
                                            "Nodes": [],
                                            "Task": "ScanForObjectAgain",
                                            "Name": "ScanForObjectAgain"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }
}
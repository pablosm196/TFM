{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If an object is visible, approach and take it, process it, then move to/check location properties. list of available nodes: <Action ID = ScanForObject    /> <Action ID = IsObjectVisible    /> <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <Action ID = ProcessObject    /> <Action ID = MoveToLocation    /> <Action ID = CheckLocationProperties    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanForObject",
                            "Name": "ScanForObject"
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "ApproachObject",
                                    "Name": "ApproachObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "TakeObject",
                                    "Name": "TakeObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "ProcessObject",
                                    "Name": "ProcessObject"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToLocation",
                            "Name": "MoveToLocation"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckLocationProperties",
                            "Name": "CheckLocationProperties"
                        }
                    ]
                }
            ]
        }
    }
}
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\tDO ScanForObject\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tSEQUENCE\n\t\t\t\t\tDO ApproachObject\n\t\t\t\t\tDO TakeObject\n\t\t\t\t\tDO ProcessObject\n\t\t\t\tEND\n\t\tEND\n\t\tSEQUENCE\n\t\t\tDO MoveToLocation\n\t\t\tDO CheckLocationProperties\n\t\tEND\n\tEND\n"

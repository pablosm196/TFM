    "code": "\tSEQUENCE\n\t\t\tIF IsObjectFound? THEN\n\t\t\tDO ApproachObjectAndCheckProperties\n\tELSE\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\tDO TakeObject\n\t\t\t\tDO SpecificTask\n\t\t\tEND\n\t\t\tDO ScanAreaForObject\n\t\tEND\n\tEND\n"

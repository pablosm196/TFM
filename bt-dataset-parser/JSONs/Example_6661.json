                                    "Type": "Sequence",
                                    "Decorators": [
                                        {
                                            "IsObjectApproached?": "IsObjectApproached"
                                        }
                                    ],
                                    "Nodes": [
                                        {
                                            "Type": "Task",
                                            "Decorators": [],
                                            "Nodes": [],
                                            "Task": "TakeObject",
                                            "Name": "TakeObject"
                                        },
                                        {
                                            "Type": "Task",
                                            "Decorators": [],
                                            "Nodes": [],
                                            "Task": "ProcessObjectProperties",
                                            "Name": "ProcessObjectProperties"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SpecificTask",
                    "Name": "SpecificTask"
                }
            ]
        }
    }
}
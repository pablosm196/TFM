{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object visible, then approach, take, process properties. If not visible, move to specific task.     list of available nodes: <Action ID = IsObjectVisible    /> <Action ID = IsObjectApproached    /> <Action ID = TakeObject    /> <Action ID = MoveToObject    /> <Action ID = ProcessObjectProperties    /> <SubTree ID = SpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Selector",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],

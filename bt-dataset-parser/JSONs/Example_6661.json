    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSELECTOR\n\t\t\t\tSEQUENCE\n\t\t\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\t\t\tSEQUENCE\n\t\t\t\t\t\t\tDO TakeObject\n\t\t\t\t\t\t\tDO ProcessObjectProperties\n\t\t\t\t\t\tEND\n\t\t\t\tEND\n\t\t\t\tDO MoveToObject\n\t\t\tEND\n\tELSE\n\t\tDO SpecificTask\n\tEND\n"

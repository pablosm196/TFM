{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object detected, move and pick it up. Check its properties, do specific task, otherwise search for object. list of available nodes: <Action ID = MoveToTheObject    /> <Action ID = PickUpObject    /> <Action ID = ScanForObjectAgain    /> <Action ID = LookForAnotherObject    /> <Condition ID = IsObjectDetected    /> <Condition ID = CanPickUpObject    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = SpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "CanPickUpObject": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectDetected?": "IsObjectDetected"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToTheObject",
                    "Name": "MoveToTheObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "CanPickUpObject?": "CanPickUpObject"
                                }
                            ],
                            "Nodes": [],
                            "Task": "PickUpObject",
                            "Name": "PickUpObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanForObjectAgain",
                            "Name": "ScanForObjectAgain"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "LookForAnotherObject",
                            "Name": "LookForAnotherObject"
                        }
                    ]
                }
            ]
        }
    }
}
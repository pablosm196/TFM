{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object is visible, approach it, take it, check properties and perform task, otherwise scan area.     list of available nodes: <Action ID = ApproachObject    />  <Action ID = TakeObject    />  <SubTree ID = CheckObjectProperties    />  <Action ID = MoveToDestination    />  <SubTree ID = PerformSpecificTask    />  <Condition ID = IsObjectVisible    />  <Action ID = ScanArea    />  <Condition ID = IsObjectApproached    />  <Action ID = GrabObject    />  <SubTree ID = ProcessObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],

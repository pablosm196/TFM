                            {
                                "Type": "Sequence",
                                "Decorators": [],
                                "Nodes": [
                                    {
                                        "Type": "Task",
                                        "Decorators": [
                                            {
                                                "IsObjectGrabbable?": "IsObjectGrabbable"
                                            }
                                        ],
                                        "Nodes": [],
                                        "Task": "GrabObject",
                                        "Name": "GrabObject"
                                    },
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "PerformTask",
                                        "Name": "PerformTask"
                                    }
                                ]
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ScanAreaForObject",
                                "Name": "ScanAreaForObject"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectGrabbable? THEN\n\t\t\t\t\tDO GrabObject\n\t\t\tELSE\n\t\t\t\tDO PerformTask\n\t\t\tEND\n\t\t\tDO ScanAreaForObject\n\t\tEND\n\tEND\n"

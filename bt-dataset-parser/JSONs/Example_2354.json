    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO TakeObject\n\t\t\t\tIF IsObjectHeavy? THEN\n\t\t\t\tDO MoveObjectToAnotherLocation\n\t\tELSE\n\t\t\tDO SpecificTask\n\t\tEND\n\t\tDO ScanArea\n\tEND\n"

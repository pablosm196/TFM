                "isObjectHeavy": "Boolean"
            },
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsLocationReached": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [

{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes.     If object visible, move to it, grab it, check weight, move it to destination, process it; otherwise scan or move randomly.     list of available nodes: <Action ID = MoveToObject    /> <Condition ID = IsObjectVisible    /> <Action ID = RandomlyMove    /> <Action ID = MoveToDestination    /> <SubTree ID = ProcessObjectTask    /> <Action ID = CheckObjectWeight    /> <Action ID = ScanAreaForObjects    /> <Action ID = GrabObject    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [],
                        "Task": "MoveToObject",
                        "Name": "MoveToObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "GrabObject",
                        "Name": "GrabObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "CheckObjectWeight",
                        "Name": "CheckObjectWeight"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "MoveToDestination",
                        "Name": "MoveToDestination"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ProcessObjectTask",
                        "Name": "ProcessObjectTask"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO MoveToObject\n\tELSE\n\t\tDO GrabObject\n\t\tDO CheckObjectWeight\n\t\tDO MoveToDestination\n\t\tDO ProcessObjectTask\n\tEND\n"
}
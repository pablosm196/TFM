{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, move and check object properties. Take object and complete specific task. Otherwise, scan area or move to new location. list of available nodes: <Action ID = ScanAreaForObject    /> <Action ID = MoveToObject    /> <Action ID = MoveToNewLocation    /> <Action ID = TakeObject    /> <Condition ID = IsObjectVisible    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = DoSpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "DoSpecificTask",
                            "Name": "DoSpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObject",
                    "Name": "ScanAreaForObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToNewLocation",
                    "Name": "MoveToNewLocation"
                }
            ]
        }
    }
}
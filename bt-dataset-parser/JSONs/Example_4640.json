{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find object, move to it, grab it, confirm properties, process it, or scan area. list of available nodes: <Action ID = MoveToObject    /> <Action ID = GrabObject    /> <Action ID = ProcessObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectGrabbable    /> <SubTree ID = FindTakeAndProcessObject    /> <Action ID = MoveToArea    /> <Action ID = ScanArea    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectGrabbable": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToArea",
                    "Name": "MoveToArea"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectVisible?": "IsObjectVisible"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "MoveToObject",
                                    "Name": "MoveToObject"
                                },
                                {
                                    "Type": "Sequence",
                                    "Decorators": [],
                                    "Nodes": [
                                        {
                                            "Type": "Task",
                                            "Decorators": [
                                                {
                                                    "IsObjectGrabbable?": "IsObjectGrabbable"
                                                }
                                            ],
                                            "Nodes": [],
                                            "Task": "GrabObject",
                                            "Name": "GrabObject"
                                        },
                                        {
                                            "Type": "Task",
                                            "Decorators": [],
                                            "Nodes": [],
                                            "Task": "ProcessObject",
                                            "Name": "ProcessObject"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanArea",
                            "Name": "ScanArea"
                        }
                    ]
                }
            ]
        }
    }
}
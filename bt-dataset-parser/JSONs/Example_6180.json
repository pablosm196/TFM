{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is detected, approach, take and inspect it, otherwise search for the object. list of available nodes: <Action ID = IsObjectDetected    /> <Action ID = IsObjectWithinRange    /> <Action ID = ApproachObject    /> <Action ID = IsObjectDetected    /> <Action ID = TakeObject    /> <SubTree ID = InspectObject    /> <Action ID = SearchForObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectWithinRange": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [
                                {
                                    "IsObjectDetected?": "IsObjectDetected"
                                }
                            ],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "ApproachObject",
                                    "Name": "ApproachObject"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "InspectObject",
                            "Name": "InspectObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SearchForObject",
                    "Name": "SearchForObject"
                }
            ]
        }
    }
}
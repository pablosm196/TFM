                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObstacleDetected?": "IsObstacleDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "AvoidObstacle",
                            "Name": "AvoidObstacle"
                        }
                    ]
                },
                {
                    "Type": "Task",

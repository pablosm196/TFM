    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO TakeObject\n\t\t\tDO ObjectPropertiesTask\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsAtStartPoint? THEN\n\t\t\t\tDO MoveToRandomLocation\n\t\tEND\n\t\tDO ScanAreaForObjects\n\tEND\n"

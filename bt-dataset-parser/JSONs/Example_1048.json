{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object detected, move to it, grasp it, inspect it, process it, return it. Then idle. list of available nodes: <Condition ID = IsObjectDetected    /> <Action ID = MoveToObject    /> <Action ID = GraspObject    /> <Condition ID = IsObjectInHand    /> <Action ID = InspectObject    /> <SubTree ID = ProcessObjectTask    /> <Action ID = ReturnObject    /> <Action ID = Idle    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectInHand": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectDetected?": "IsObjectDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GraspObject",
                            "Name": "GraspObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectInHand?": "IsObjectInHand"
                                }
                            ],
                            "Nodes": [],
                            "Task": "InspectObject",
                            "Name": "InspectObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ProcessObjectTask",
                    "Name": "ProcessObjectTask"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ReturnObject",
                    "Name": "ReturnObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "Idle",
                    "Name": "Idle"
                }
            ]
        }
    }
}
                                "Task": "CheckObjectProperties",
                                "Name": "CheckObjectProperties"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "SearchForObjectInArea",
                        "Name": "SearchForObjectInArea"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "SpecificTask",
                        "Name": "SpecificTask"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "MoveToBase",
                        "Name": "MoveToBase"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO TakeObject\n\t\t\tDO CheckObjectProperties\n\t\tEND\n\t\tDO SearchForObjectInArea\n\t\tDO SpecificTask\n\t\tDO MoveToBase\n\tEND\n"

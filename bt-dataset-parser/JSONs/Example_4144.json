{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes.     If object approached, take it, check properties, perform specific task. If not, move to it or scan area.     list of available nodes: <Action ID = TakeObject    /> <SubTree ID = ObjectPropertiesCheck    /> <SubTree ID = SpecificTask    /> <Condition ID = IsObjectVisible    /> <Action ID = MoveToObject    /> <Action ID = ScanArea    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectApproached?": "IsObjectApproached"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "TakeObject",
                                "Name": "TakeObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ObjectPropertiesCheck",
                                "Name": "ObjectPropertiesCheck"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "SpecificTask",
                                "Name": "SpecificTask"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectVisible?": "IsObjectVisible"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "MoveToObject",
                                "Name": "MoveToObject"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ScanArea",
                        "Name": "ScanArea"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO ObjectPropertiesCheck\n\t\t\tDO SpecificTask\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO MoveToObject\n\t\tEND\n\t\tDO ScanArea\n\tEND\n"
}
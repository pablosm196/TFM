{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object visible, approach and take it, then process object, or scan surroundings. list of available nodes: <Action ID = ScanSurroundings    /> <Action ID = IsObjectVisible    /> <Action ID = ApproachObject    /> <Action ID = IsObjectGrabbed    /> <Action ID = MoveToDestination    /> <Action ID = TakeObject    /> <SubTree ID = ProcessObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectGrabbed": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectGrabbed?": "IsObjectGrabbed"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "TakeObject",
                    "Name": "TakeObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ProcessObject",
                    "Name": "ProcessObject"
                }
            ]
        }
    }
}
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectDetected? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO ApproachObject\n\t\t\t\t\tIF IsObjectWithinRange? THEN\n\t\t\t\t\tDO PickUpObject\n\t\t\tELSE\n\t\t\t\tDO VerifyObjectProperties\n\t\t\t\tDO PerformSpecificTask\n\t\t\tEND\n\tELSE\n\t\tDO SearchForObject\n\tEND\n"

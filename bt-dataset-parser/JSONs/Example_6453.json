                        "Task": "MoveToDestination",
                        "Name": "MoveToDestination"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsDestinationReached?": "IsDestinationReached"
                            }
                        ],
                        "Nodes": [],
                        "Task": "InspectObject",
                        "Name": "InspectObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "PerformTask",
                        "Name": "PerformTask"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectApproached? THEN\n\t\t\tDO TakeObject\n\tELSE\n\t\tDO MoveToDestination\n\t\t\tIF IsDestinationReached? THEN\n\t\t\tDO InspectObject\n\tELSE\n\t\tDO PerformTask\n\tEND\n"

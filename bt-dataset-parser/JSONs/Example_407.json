    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectNear? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO CheckObjectProperties\n\t\t\tDO DoSpecificTask\n\t\t\tDO MoveToDropOffLocation\n\t\t\tDO DropObject\n\t\tEND\n\t\tSELECTOR\n\t\t\tDO ScanAreaForObject\n\t\t\tDO MoveToRandomLocation\n\t\tEND\n\tEND\n"

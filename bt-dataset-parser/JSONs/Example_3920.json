{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If an object is visible, move to it. If within range, grab it. In order to perform a specific task, check object properties. list of available nodes: <Action ID = MoveToClosestObject    /> <Action ID = TakeObject    /> <Action ID = DoSpecificTask    /> <Action ID = ScanAreaForObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectWithinRange    /> <SubTree ID = CheckObjectProperties    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectWithinRange": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [],
                        "Task": "MoveToClosestObject",
                        "Name": "MoveToClosestObject"
                    },
                    {
                        "Type": "Selector",
                        "Decorators": [
                            {
                                "IsObjectWithinRange?": "IsObjectWithinRange"
                            }
                        ],
                        "Nodes": [
                            {
                                "Type": "Sequence",
                                "Decorators": [],
                                "Nodes": [
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "TakeObject",
                                        "Name": "TakeObject"
                                    },
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "CheckObjectProperties",
                                        "Name": "CheckObjectProperties"
                                    },
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "DoSpecificTask",
                                        "Name": "DoSpecificTask"
                                    }
                                ]
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ScanAreaForObject",
                                "Name": "ScanAreaForObject"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO MoveToClosestObject\n\tELSE\n\t\t\tIF IsObjectWithinRange? THEN\n\t\t\tSELECTOR\n\t\t\t\tSEQUENCE\n\t\t\t\t\tDO TakeObject\n\t\t\t\t\tDO CheckObjectProperties\n\t\t\t\t\tDO DoSpecificTask\n\t\t\t\tEND\n\t\t\t\tDO ScanAreaForObject\n\t\t\tEND\n\tEND\n"
}
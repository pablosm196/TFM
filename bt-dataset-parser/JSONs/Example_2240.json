    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectDetected? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO TakeObject\n\t\t\tDO CheckObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsAreaClear? THEN\n\t\t\t\tDO MoveToLocation\n\t\tELSE\n\t\t\tDO ScanArea\n\t\tEND\n\tEND\n"

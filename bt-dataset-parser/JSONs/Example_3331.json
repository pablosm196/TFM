    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF HasObject? THEN\n\t\t\t\t\tDO MoveToObject\n\t\t\tELSE\n\t\t\t\tDO TakeObject\n\t\t\t\tDO ObjectPropertiesCheck\n\t\t\t\tDO PerformSpecificTask\n\t\t\tEND\n\t\t\tDO ScanArea\n\t\tEND\n\tEND\n"

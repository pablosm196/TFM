{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. Robot approaches and takes nearby object if detected, stops moving if it is on the way, and scans area continuously. list of available nodes: <Action ID = TakeObject    /> <Action ID = StopMoving    /> <Action ID = ApproachObject    /> <Action ID = ScanAreaForObject    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsMoving": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectApproached?": "IsObjectApproached"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "TakeObject",
                                "Name": "TakeObject"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsMoving?": "IsMoving"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "StopMoving",
                                "Name": "StopMoving"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectDetected?": "IsObjectDetected"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "ApproachObject",
                                "Name": "ApproachObject"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ScanAreaForObject",
                        "Name": "ScanAreaForObject"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\tDO TakeObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsMoving? THEN\n\t\t\t\tDO StopMoving\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectDetected? THEN\n\t\t\t\tDO ApproachObject\n\t\tEND\n\t\tDO ScanAreaForObject\n\tEND\n"
}
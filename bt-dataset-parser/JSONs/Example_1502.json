{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find, approach and grab object, move it to destination, check properties and deliver it. list of available nodes: <Action ID = ApproachObject     /> <Action ID = ScanAreaForObject     /> <Action ID = MoveToDestination     /> <Action ID = DeliverObject     /> <Condition ID = IsObjectVisible     /> <Condition ID = IsObjectInGripper     /> <SubTree ID = CheckObjectProperties     />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectInGripper": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],

    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO ApproachObject\n\t\t\t\tDO GrabObject\n\t\t\t\tDO CheckObjectProperties\n\t\t\tEND\n\tELSE\n\t\tSEQUENCE\n\t\t\tDO MoveToTaskLocation\n\t\t\tDO PerformTask\n\t\tEND\n\tEND\n"

    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO TakeObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectTaken? THEN\n\t\t\t\tDO MoveToDestination\n\t\tEND\n\t\tDO CheckObjectProperties\n\t\tDO PerformTask\n\tEND\n"

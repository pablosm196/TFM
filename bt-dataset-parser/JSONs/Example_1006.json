{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. Find visible item, approach and pick it up. Check its properties, do specific task. If no item found, scan area for items. list of available nodes: <Action ID = ApproachItem    /> <Action ID = PickUpItem    /> <SubTree ID = CheckItemProperties    /> <SubTree ID = DoSpecificTask    /> <Action ID = ScanAreaForItems    /> <Condition ID = IsItemVisible    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsItemVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsItemVisible?": "IsItemVisible"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "ApproachItem",
                                "Name": "ApproachItem"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "PickUpItem",
                                "Name": "PickUpItem"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "CheckItemProperties",
                                "Name": "CheckItemProperties"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "DoSpecificTask",
                                "Name": "DoSpecificTask"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ScanAreaForItems",
                        "Name": "ScanAreaForItems"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsItemVisible? THEN\n\t\t\t\tDO ApproachItem\n\t\tELSE\n\t\t\tDO PickUpItem\n\t\t\tDO CheckItemProperties\n\t\t\tDO DoSpecificTask\n\t\tEND\n\t\tDO ScanAreaForItems\n\tEND\n"
}
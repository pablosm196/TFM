{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object is close, take it and check properties. If not, approach or scan area. Repeat.     list of available nodes: <Action ID = FindObject    /> <Condition ID = IsObjectCloseEnough    /> <Action ID = TakeObject    /> <Action ID = CheckObjectProperties    /> <SubTree ID = DoSpecificTask    /> <Condition ID = IsObjectVisible    /> <Action ID = ApproachObject    /> <Action ID = MoveToNextLocation    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectCloseEnough": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "FindObject",
                    "Name": "FindObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [
                                {
                                    "IsObjectCloseEnough?": "IsObjectCloseEnough"
                                }
                            ],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "TakeObject",
                                    "Name": "TakeObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "CheckObjectProperties",
                                    "Name": "CheckObjectProperties"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "DoSpecificTask",
                                    "Name": "DoSpecificTask"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToNextLocation",
                    "Name": "MoveToNextLocation"
                }
            ]
        }
    }
}
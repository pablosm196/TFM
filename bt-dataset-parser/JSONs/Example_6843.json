{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object detected, approach within range, take, process properties, move, do task. Otherwise, scan area. list of available nodes: <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <Action ID = MoveToDestination    /> <Condition ID = IsObjectDetected    /> <Condition ID = IsObjectWithinRange    /> <Action ID = ScanForObjects    /> <SubTree ID = ProcessObjectProperties    /> <SubTree ID = SpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectWithinRange": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectDetected?": "IsObjectDetected"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectWithinRange?": "IsObjectWithinRange"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObjectProperties",
                            "Name": "ProcessObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                }
            ]
        }
    }
}
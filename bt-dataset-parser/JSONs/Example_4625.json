{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is found, approach, grab, check props, do specific task. Otherwise, if path is clear, move. list of available nodes: <Condition ID = IsObjectFound    /> <Condition ID = IsPathClear    /> <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <SubTree ID = CheckObjectProps    /> <SubTree ID = SpecificTask    /> <Action ID = MoveToNextLocation    /> <Action ID = ScanArea    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectFound": "Boolean"
            },
            {
                "IsPathClear": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectFound?": "IsObjectFound"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProps",
                            "Name": "CheckObjectProps"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsPathClear?": "IsPathClear"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToNextLocation",
                            "Name": "MoveToNextLocation"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanArea",
                    "Name": "ScanArea"
                }
            ]
        }
    }
}
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\t\tDO TakeObject\n\t\t\tELSE\n\t\t\t\tDO CheckObjectWeight\n\t\t\t\tDO PerformSpecificTask\n\t\t\tEND\n\tELSE\n\t\tDO MoveToNextLocation\n\tEND\n"

                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectWithinReach?": "IsObjectWithinReach"
                        }
                    ],
                    "Nodes": [],
                    "Task": "PickUpObject",
                    "Name": "PickUpObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "DoesObjectHaveProperty?": "DoesObjectHaveProperty"
                        }
                    ],
                    "Nodes": [],
                    "Task": "DoTaskWithObject",
                    "Name": "DoTaskWithObject"
                }
            ]
        }
    }

                                "Name": "PickUpItem"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "InspectItem",
                                "Name": "InspectItem"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "StoreItem",
                                "Name": "StoreItem"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsItemVisible?": "IsItemVisible"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "MoveTowardsItem",
                                "Name": "MoveTowardsItem"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "SearchForItem",
                        "Name": "SearchForItem"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsItemNearby? THEN\n\t\t\t\tDO PickUpItem\n\t\tELSE\n\t\t\tDO InspectItem\n\t\t\tDO StoreItem\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsItemVisible? THEN\n\t\t\t\tDO MoveTowardsItem\n\t\tEND\n\t\tDO SearchForItem\n\tEND\n"

                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "InspectItem",
                            "Name": "InspectItem"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "StoreItem",
                            "Name": "StoreItem"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsItemVisible?": "IsItemVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveTowardsItem",
                            "Name": "MoveTowardsItem"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SearchForItem",
                    "Name": "SearchForItem"
                }
            ]
        }
    }

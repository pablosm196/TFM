                                        "Name": "ApproachObject"
                                    },
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "PickUpObject",
                                        "Name": "PickUpObject"
                                    }
                                ]
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],

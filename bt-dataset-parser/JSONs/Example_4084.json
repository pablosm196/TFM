{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Approach, grab, and inspect object if nearby. Move to object if available, scan area. list of available nodes: <Action ID = GrabObject    /> <Action ID = InspectObject    />  <Action ID = MoveToObject    />  <Action ID = ScanArea    />  <Condition ID = IsObjectAvailable    />  <Condition ID = IsObjectApproached    />  <Condition ID = IsObjectVisible    />  <SubTree ID = InspectObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectAvailable": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectApproached?": "IsObjectApproached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "InspectObject",
                            "Name": "InspectObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectAvailable?": "IsObjectAvailable"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanArea",
                    "Name": "ScanArea"
                }
            ]
        }
    }
}
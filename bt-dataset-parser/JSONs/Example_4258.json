{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object is detected, move, take it, check it and do specific task. Otherwise, scan area.     list of available nodes: <Action ID = MoveToObject    /> <Action ID = TakeObject    /> <Action ID = CheckObjectProperties    /> <Action ID = SpecificTask    /> <Action ID = ScanAreaForObjects    /> <Condition ID = ObjectDetected    /> <Condition ID = IsAtTargetLocation    />",
    "BT": {
        "Blackboard": [
            {
                "IsAtTargetLocation": "Boolean"
            },
            {
                "ObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "ObjectDetected?": "ObjectDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsAtTargetLocation?": "IsAtTargetLocation"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ScanAreaForObjects",
                            "Name": "ScanAreaForObjects"
                        }
                    ]
                }
            ]
        }
    }
}
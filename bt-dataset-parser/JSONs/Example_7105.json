{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. Find object, grab it if near, move to sorting area, check properties, sort it. If lost, scan or move randomly. list of available nodes: <Action ID = IsObjectVisible    /> <Condition ID = IsObjectApproached    /> <Action ID = GrabObject    /> <Action ID = MoveToObjectSortingArea    /> <SubTree ID = CheckObjectProperties    /> <Action ID = SortObject    /> <Action ID = ScanForObjects    /> <Action ID = MoveRandomly    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectApproached?": "IsObjectApproached"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "GrabObject",
                                "Name": "GrabObject"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "MoveToObjectSortingArea",
                        "Name": "MoveToObjectSortingArea"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "CheckObjectProperties",
                        "Name": "CheckObjectProperties"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "SortObject",
                        "Name": "SortObject"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\t\tDO GrabObject\n\t\t\tEND\n\tELSE\n\t\tDO MoveToObjectSortingArea\n\t\tDO CheckObjectProperties\n\t\tDO SortObject\n\tEND\n"
}
                            "Decorators": [
                                {
                                    "IsObjectHeavy?": "IsObjectHeavy"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveSlowly",
                            "Name": "MoveSlowly"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectFragile?": "IsObjectFragile"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveCarefully",
                            "Name": "MoveCarefully"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "PerformTask",
                    "Name": "PerformTask"
                }
            ]
        }
    }

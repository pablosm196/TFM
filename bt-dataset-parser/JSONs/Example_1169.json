{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find and grab object. If grabbed, check properties. Move to delivery location, perform specific task. If not found, scan and move. list of available nodes: <Action ID = ScanForObjects    /> <Action ID = MoveToNextLocation    /> <Action ID = IsObjectVisible    /> <SubTree ID = CheckObjectProperties    /> <Action ID = MoveToDeliveryLocation    /> <Action ID = PerformSpecificTask    /> <Condition ID = IsObjectApproached    /> <Action ID = TakeObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectApproached?": "IsObjectApproached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToDeliveryLocation",
                    "Name": "MoveToDeliveryLocation"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "PerformSpecificTask",
                    "Name": "PerformSpecificTask"
                }
            ]
        }
    }
}
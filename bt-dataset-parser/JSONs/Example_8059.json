    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO ApproachObject\n\t\t\t\t\tIF IsObjectReached? THEN\n\t\t\t\t\tDO PickUpObject\n\t\t\tELSE\n\t\t\t\tDO ProcessObject\n\t\t\t\t\tIF IsTargetLocationVisible? THEN\n\t\t\t\t\tDO MoveToTargetLocation\n\t\t\tELSE\n\t\t\t\tDO SpecificTask\n\t\t\tEND\n\tEND\n"

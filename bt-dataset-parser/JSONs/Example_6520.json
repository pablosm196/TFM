                        "Name": "TakeObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "MoveToLocation",
                        "Name": "MoveToLocation"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "isObjectSpecial?": "isObjectSpecial"
                            }
                        ],
                        "Nodes": [],
                        "Task": "SpecialTask",
                        "Name": "SpecialTask"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectApproached? THEN\n\t\t\tDO TakeObject\n\tELSE\n\t\tDO MoveToLocation\n\t\t\tIF isObjectSpecial? THEN\n\t\t\tDO SpecialTask\n\tEND\n"

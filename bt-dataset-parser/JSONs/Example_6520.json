                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsObjectApproached?": "IsObjectApproached"
                            }
                        ],
                        "Nodes": [],

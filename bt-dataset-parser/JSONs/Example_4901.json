{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object is detected, move, pick up (if weight is ok), move to destination, do specific task. Else, scan environment.     list of available nodes: <Action ID = MoveToObj    /> <Action ID = PickUpObj    /> <Action ID = ObjWeightIsOk    /> <Action ID = MoveToDestination    /> <Action ID = DoSpecificTask    /> <Action ID = ScanEnvironment    />",
    "BT": {
        "Blackboard": [
            {
                "ObjWeightIsOk": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectDetected?": "IsObjectDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObj",
                            "Name": "MoveToObj"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PickUpObj",
                            "Name": "PickUpObj"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "ObjWeightIsOk?": "ObjWeightIsOk"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "DoSpecificTask",
                            "Name": "DoSpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanEnvironment",
                    "Name": "ScanEnvironment"
                }
            ]
        }
    }
}
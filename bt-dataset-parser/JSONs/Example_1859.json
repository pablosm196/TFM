                        "Task": "MoveToTargetLocation",
                        "Name": "MoveToTargetLocation"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectDetected? THEN\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectInReach? THEN\n\t\t\t\t\tDO GrabObject\n\t\t\tELSE\n\t\t\t\tDO InspectObject\n\t\t\tEND\n\tELSE\n\t\tDO MoveToTargetLocation\n\tEND\n"

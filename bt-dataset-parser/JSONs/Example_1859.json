{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is detected, grab and inspect it. Then move to goal. Otherwise, scan area. list of available nodes: <Action ID = IsObjectDetected    /> <Action ID = GrabObject    /> <Action ID = InspectObject    /> <Action ID = MoveToTargetLocation    /> <Condition ID = IsObjectInReach    /> <Action ID = ScanAreaForObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectInReach": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectDetected?": "IsObjectDetected"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectInReach?": "IsObjectInReach"
                                }
                            ],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "InspectObject",
                            "Name": "InspectObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToTargetLocation",
                    "Name": "MoveToTargetLocation"
                }
            ]
        }
    }
}
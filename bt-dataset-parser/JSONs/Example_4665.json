{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, approach and grab it, and move to destination. Otherwise, scan area. list of available nodes: <Action ID = ApproachObject    /> <Action ID = GrabObject    /> <Action ID = MoveToObjectDestination    /> <Action ID = ScanAreaForObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectGrabbable    /> <Condition ID = IsObjectDestinationReachable    /> <SubTree ID = ProcessObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectDestinationReachable": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectGrabbable": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectGrabbable?": "IsObjectGrabbable"
                        }
                    ],
                    "Nodes": [],
                    "Task": "GrabObject",
                    "Name": "GrabObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectDestinationReachable?": "IsObjectDestinationReachable"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToObjectDestination",
                    "Name": "MoveToObjectDestination"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ProcessObject",
                    "Name": "ProcessObject"
                }
            ]
        }
    }
}
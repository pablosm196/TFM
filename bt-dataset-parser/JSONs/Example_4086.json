{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object detected, then pick it up, check properties, move to destination, avoid obstacles, or scan area. list of available nodes: <Action ID = PickUpObject    /> <Action ID = AvoidObstacles    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = MoveToDestination    /> <Condition ID = IsObjectWithinReach    /> <Condition ID = IsObjectDetected    /> <SubTree ID = ScanAreaForObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectWithinReach": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectDetected?": "IsObjectDetected"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectWithinReach?": "IsObjectWithinReach"
                                }
                            ],
                            "Nodes": [],
                            "Task": "PickUpObject",
                            "Name": "PickUpObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToDestination",
                    "Name": "MoveToDestination"
                }
            ]
        }
    }
}
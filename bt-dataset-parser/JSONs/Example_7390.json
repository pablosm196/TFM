            {
                "IsObjectGrabbed": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "MoveToObject",
                                "Name": "MoveToObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "CheckObjectProperties",
                                "Name": "CheckObjectProperties"
                            },
                            {
                                "Type": "Selector",
                                "Decorators": [],
                                "Nodes": [
                                    {
                                        "Type": "Sequence",
                                        "Decorators": [],
                                        "Nodes": [
                                            {
                                                "Type": "Task",
                                                "Decorators": [
                                                    {
                                                        "IsObjectGrabbed?": "IsObjectGrabbed"
                                                    }
                                                ],
                                                "Nodes": [],
                                                "Task": "DoSomethingWithObject",
                                                "Name": "DoSomethingWithObject"
                                            }
                                        ]
                                    },
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "GrabObject",
                                        "Name": "GrabObject"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO MoveToObject\n\t\t\t\tDO CheckObjectProperties\n\t\t\t\tSELECTOR\n\t\t\t\t\tSEQUENCE\n\t\t\t\t\t\t\tIF IsObjectGrabbed? THEN\n\t\t\t\t\t\t\tDO DoSomethingWithObject\n\t\t\t\t\tEND\n\t\t\t\t\tDO GrabObject\n\t\t\t\tEND\n\t\t\tEND\n\tEND\n"

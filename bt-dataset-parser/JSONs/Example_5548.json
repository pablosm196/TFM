{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, approach it. Scan properties, take it. Move to next area. list of available nodes: <Action ID = ApproachObject    /> <Action ID = ScanObjectProperties    /> <Action ID = ArePropertiesSatisfied    /> <Action ID = TakeObject    /> <Action ID = MoveToNextArea    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "ArePropertiesSatisfied": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectVisible?": "IsObjectVisible"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "ApproachObject",
                                "Name": "ApproachObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ScanObjectProperties",
                                "Name": "ScanObjectProperties"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "ArePropertiesSatisfied?": "ArePropertiesSatisfied"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "TakeObject",
                                "Name": "TakeObject"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "MoveToNextArea",
                        "Name": "MoveToNextArea"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO ScanObjectProperties\n\t\t\t\tIF ArePropertiesSatisfied? THEN\n\t\t\t\tDO TakeObject\n\t\tEND\n\t\tDO MoveToNextArea\n\tEND\n"
}
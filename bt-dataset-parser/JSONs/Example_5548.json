{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, approach it. Scan properties, take it. Move to next area. list of available nodes: <Action ID = ApproachObject    /> <Action ID = ScanObjectProperties    /> <Action ID = ArePropertiesSatisfied    /> <Action ID = TakeObject    /> <Action ID = MoveToNextArea    />",
    "BT": {
        "Blackboard": [
            {
                "ArePropertiesSatisfied": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanObjectProperties",
                            "Name": "ScanObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "ArePropertiesSatisfied?": "ArePropertiesSatisfied"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToNextArea",
                    "Name": "MoveToNextArea"
                }
            ]
        }
    }
}
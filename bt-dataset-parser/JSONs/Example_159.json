                        "Nodes": [],
                        "Task": "PerformTask",
                        "Name": "PerformTask"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\t\tIF IsObjectWithinRange? THEN\n\t\t\tDO TakeObject\n\tELSE\n\t\tDO CheckObject\n\t\tDO PerformTask\n\tEND\n"

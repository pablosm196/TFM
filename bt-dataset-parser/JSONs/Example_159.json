                        "Name": "TakeObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "CheckObject",
                        "Name": "CheckObject"
                    },
                    {
                        "Type": "Task",

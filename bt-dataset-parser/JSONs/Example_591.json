                                "Name": "SpecificTask"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO CheckObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO MoveToObject\n\t\tEND\n\t\tDO ScanArea\n\t\tSEQUENCE\n\t\t\t\tIF IsTaskCompleted? THEN\n\t\t\t\tDO SpecificTask\n\t\tEND\n\tEND\n"

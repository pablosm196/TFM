            },
            {
                "IsObjectGrabbed": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [],
                        "Task": "ApproachObject",
                        "Name": "ApproachObject"
                    },
                    {
                        "Type": "Selector",
                        "Decorators": [],

                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CarryObjectToOriginalLocation",
                            "Name": "CarryObjectToOriginalLocation"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PlaceObjectDown",
                            "Name": "PlaceObjectDown"

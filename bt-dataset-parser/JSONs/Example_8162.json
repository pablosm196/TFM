{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object detected, approach, grab, and process properties. If area not scanned, move and scan. list of available nodes: <Action ID = ApproachObject    /> <Action ID = GrabObject    /> <Condition ID = IsObjectDetected    /> <SubTree ID = ProcessObjectProperties    /> <Action ID = TaskSpecificAction    /> <Condition ID = IsAreaScanned    /> <Action ID = MoveToScannedArea    /> <Action ID = ScanArea    />",
    "BT": {
        "Blackboard": [
            {
                "IsAreaScanned": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectDetected?": "IsObjectDetected"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "ApproachObject",
                                    "Name": "ApproachObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "GrabObject",
                                    "Name": "GrabObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "ProcessObjectProperties",
                                    "Name": "ProcessObjectProperties"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "TaskSpecificAction",
                                    "Name": "TaskSpecificAction"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsAreaScanned?": "IsAreaScanned"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "MoveToScannedArea",
                                    "Name": "MoveToScannedArea"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "ScanArea",
                                    "Name": "ScanArea"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }
}
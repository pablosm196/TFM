                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "isObjectBig?": "isObjectBig"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObjectDestination",
                            "Name": "MoveToObjectDestination"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ReturnObjectToBase",
                    "Name": "ReturnObjectToBase"
                }
            ]
        }
    }

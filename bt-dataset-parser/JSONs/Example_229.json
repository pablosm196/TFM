    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO PickUpObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsEmptyHand? THEN\n\t\t\t\tDO MoveToLocation\n\t\tEND\n\t\tDO ScanArea\n\tEND\n"

                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "FindTargetObject",
                            "Name": "FindTargetObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ApproachTargetObject",
                            "Name": "ApproachTargetObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanObjectProperties",
                            "Name": "ScanObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObjectTask",
                            "Name": "ProcessObjectTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {

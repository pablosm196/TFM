                                "Name": "TakeObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "PerformObjectTask",
                                "Name": "PerformObjectTask"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",

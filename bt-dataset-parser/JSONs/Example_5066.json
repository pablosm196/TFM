                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsRoomExplored?": "IsRoomExplored"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "MoveToUnexploredArea",
                                "Name": "MoveToUnexploredArea"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ScanAreaForObjects",
                        "Name": "ScanAreaForObjects"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO PerformObjectTask\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsRoomExplored? THEN\n\t\t\t\tDO MoveToUnexploredArea\n\t\tEND\n\t\tDO ScanAreaForObjects\n\tEND\n"

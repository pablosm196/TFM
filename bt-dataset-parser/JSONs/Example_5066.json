{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Robot searches for object, takes and performs task on it. Explores unexplored area if needed. list of available nodes: <Action ID = TakeObject    /> <Action ID = PerformObjectTask    /> <Condition ID = IsObjectApproached    /> <Action ID = MoveToUnexploredArea    /> <Condition ID = IsRoomExplored    /> <Action ID = ScanAreaForObjects    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsRoomExplored": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectApproached?": "IsObjectApproached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PerformObjectTask",
                            "Name": "PerformObjectTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsRoomExplored?": "IsRoomExplored"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToUnexploredArea",
                            "Name": "MoveToUnexploredArea"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObjects",
                    "Name": "ScanAreaForObjects"
                }
            ]
        }
    }
}
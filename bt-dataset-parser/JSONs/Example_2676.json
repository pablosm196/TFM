    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO ApproachObject\n\t\t\t\tDO PickUpObject\n\t\t\t\t\tIF IsObjectValid? THEN\n\t\t\t\t\tDO ProcessObject\n\t\t\tEND\n\tELSE\n\t\tSELECTOR\n\t\t\tDO ScanArea\n\t\t\tDO MoveToRandomLocation\n\t\tEND\n\tEND\n"

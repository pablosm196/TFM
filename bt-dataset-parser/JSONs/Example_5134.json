                                "Task": "MoveToStorage",
                                "Name": "MoveToStorage"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "PutObjectInStorage",
                                "Name": "PutObjectInStorage"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectApproached? THEN\n\t\t\tDO PickUpObject\n\tELSE\n\t\t\tIF ObjectIsHeavy? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO MoveToStorage\n\t\t\t\tDO PutObjectInStorage\n\t\t\tEND\n\tEND\n"

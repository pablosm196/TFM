                        "Name": "MoveToNextLocation"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsNewObjectApproached? THEN\n\t\t\tDO CheckObjectColor\n\tELSE\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectTakeable? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO TaskSpecificAction\n\t\tEND\n\t\tDO MoveToNextLocation\n\tEND\n"

                                            }
                                        ],
                                        "Nodes": [],
                                        "Task": "TakeObject",
                                        "Name": "TakeObject"
                                    },
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "ProcessObject",
                                        "Name": "ProcessObject"
                                    }
                                ]
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ApproachObject",
                                "Name": "ApproachObject"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSELECTOR\n\t\t\t\tSEQUENCE\n\t\t\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\t\t\tDO TakeObject\n\t\t\t\tELSE\n\t\t\t\t\tDO ProcessObject\n\t\t\t\tEND\n\t\t\t\tDO ApproachObject\n\t\t\tEND\n\tEND\n"

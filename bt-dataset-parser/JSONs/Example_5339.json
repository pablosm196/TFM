    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsTargetApproached? THEN\n\t\t\t\tDO GrabTarget\n\t\tELSE\n\t\t\tDO CheckTargetProperties\n\t\t\tDO ExecuteSpecificTask\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsTargetVisible? THEN\n\t\t\t\tDO MoveToTarget\n\t\tEND\n\t\tDO ScanAreaForTargets\n\tEND\n"

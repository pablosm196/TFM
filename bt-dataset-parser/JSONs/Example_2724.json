{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is approached, move, grab, check properties, do specific task. Else, scan. list of available nodes: <Action ID = MoveToGrabLocation    /> <Action ID = GrabObject    /> <Action ID = ExamineObjectProperty1    /> <Action ID = ExamineObjectProperty2    /> <Condition ID = IsGoodQualityObject    /> <Condition ID = IsObjectApproached    /> <SubTree ID = SpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsGoodQualityObject": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectApproached?": "IsObjectApproached"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToGrabLocation",
                    "Name": "MoveToGrabLocation"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "GrabObject",
                    "Name": "GrabObject"
                },
                {
                    "Type": "Selector",
                    "Decorators": [
                        {
                            "IsGoodQualityObject?": "IsGoodQualityObject"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ExamineObjectProperty1",
                            "Name": "ExamineObjectProperty1"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ExamineObjectProperty2",
                            "Name": "ExamineObjectProperty2"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SpecificTask",
                    "Name": "SpecificTask"
                }
            ]
        }
    }
}
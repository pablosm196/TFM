{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find and grab object. Then move and take it. Finally, perform a task or scan area.     list of available nodes: <Action ID = GrabObject    /> <Action ID = TakeObject    /> <Action ID = MoveToObject    /> <Action ID = ScanAreaForObjects    /> <Action ID = MoveToNewLocation    /> <Condition ID = ObjectFound    /> <Condition ID = ObjectPropertiesChecked    /> <SubTree ID = SpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "ObjectFound": "Boolean"
            },
            {
                "ObjectPropertiesChecked": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "ObjectFound?": "ObjectFound"
                        }
                    ],
                    "Nodes": [],
                    "Task": "GrabObject",
                    "Name": "GrabObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "ObjectPropertiesChecked?": "ObjectPropertiesChecked"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObjects",
                    "Name": "ScanAreaForObjects"
                }
            ]
        }
    }
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Approach and take object, check color, perform task, move to base; if fails, wander around. list of available nodes: <Action ID = TakeObject    /> <Action ID = CheckObjectColor    /> <Action ID = MoveToBase    /> <Action ID = ApproachObject    /> <Action ID = ScanObjectProperties    /> <Action ID = WanderAround    /> <SubTree ID = PerformObjectTask    /> <Condition ID = IsObjectWithinReach    /> <Condition ID = IsObjectDetected    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectWithinReach": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectDetected?": "IsObjectDetected"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectWithinReach?": "IsObjectWithinReach"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectColor",
                            "Name": "CheckObjectColor"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "PerformObjectTask",
                    "Name": "PerformObjectTask"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToBase",
                    "Name": "MoveToBase"
                }
            ]
        }
    }
}
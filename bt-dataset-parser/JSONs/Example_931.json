{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If the object is approached, take it, if its color is red, perform a task, then return it. list of available nodes: <Action ID = TakeObject    /> <Action ID = ReturnObject    /> <Action ID = MoveToDestination    /> <Action ID = StopMoving    /> <Condition ID = IsObjectApproached    /> <Condition ID = ObjectColorIsRed    /> <Condition ID = IsDestinationReached    /> <SubTree ID = PerformTask    />",
    "BT": {
        "Blackboard": [
            {
                "ObjectColorIsRed": "Boolean"
            },
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsDestinationReached": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectApproached?": "IsObjectApproached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "ObjectColorIsRed?": "ObjectColorIsRed"
                                }
                            ],
                            "Nodes": [],
                            "Task": "PerformTask",
                            "Name": "PerformTask"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ReturnObject",
                            "Name": "ReturnObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsDestinationReached?": "IsDestinationReached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "StopMoving",
                            "Name": "StopMoving"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToDestination",
                    "Name": "MoveToDestination"
                }
            ]
        }
    }

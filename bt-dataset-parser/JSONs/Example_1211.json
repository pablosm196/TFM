{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes.     Find and grab object. If visible, approach and check properties. Otherwise, scan. Process the object.     list of available nodes: <Action ID = ApproachItem    /> <Action ID = CheckItemProperties    /> <Action ID = PickUpItem    /> <Action ID = ScanAreaForItem    /> <SubTree ID = ProcessItem    /> <Condition ID = IsItemVisible    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsItemVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [
                            {
                                "IsItemVisible?": "IsItemVisible"
                            }
                        ],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ApproachItem",
                                "Name": "ApproachItem"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "CheckItemProperties",
                                "Name": "CheckItemProperties"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "PickUpItem",
                                "Name": "PickUpItem"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ProcessItem",
                                "Name": "ProcessItem"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ScanAreaForItem",
                        "Name": "ScanAreaForItem"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsItemVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO ApproachItem\n\t\t\t\tDO CheckItemProperties\n\t\t\t\tDO PickUpItem\n\t\t\t\tDO ProcessItem\n\t\t\tEND\n\tELSE\n\t\tDO ScanAreaForItem\n\tEND\n"
}
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO PerceiveObjectProperties\n\t\t\tDO DecideWhatToDo\n\t\t\tDO PerformTask\n\t\t\tDO ReturnToBase\n\t\tEND\n\t\tDO ExploreArea\n\tEND\n"

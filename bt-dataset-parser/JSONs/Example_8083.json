                                "Name": "TakeObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ProcessObjectProperties",
                                "Name": "ProcessObjectProperties"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "PerformSpecificTask",
                                "Name": "PerformSpecificTask"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ScanAreaForObjects",
                        "Name": "ScanAreaForObjects"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectDetected? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO TakeObject\n\t\t\tDO ProcessObjectProperties\n\t\t\tDO PerformSpecificTask\n\t\tEND\n\t\tDO ScanAreaForObjects\n\tEND\n"

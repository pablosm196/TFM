    "code": "\tSEQUENCE\n\t\tDO FindObject\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectNear? THEN\n\t\t\t\t\tDO TakeObject\n\t\t\tEND\n\t\t\tDO MoveToObject\n\t\tEND\n\t\tDO CheckObjectProperties\n\t\tDO SpecificTask\n\tEND\n"

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find and take object, move it to destination, perform task, move to next location; if stuck, explore. list of available nodes: <Action ID = GrabObject    /> <Action ID = MoveToObject    /> <Condition ID = ObjectFound    /> <Action ID = MoveToDestination    /> <SubTree ID = ObjectTask    /> <Action ID = MoveToNextLocation    /> <Action ID = ExploreEnvironment    /> <Condition ID = IsStuck    /> <Action ID = BackUp    /> <Action ID = ScanAreaForObject    /> <Condition ID = ObjectGrabbed    />",
    "BT": {
        "Blackboard": [
            {
                "ObjectGrabbed": "Boolean"
            },
            {
                "ObjectFound": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "ObjectFound?": "ObjectFound"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToObject",
                    "Name": "MoveToObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "ObjectGrabbed?": "ObjectGrabbed"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ObjectTask",
                            "Name": "ObjectTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToNextLocation",
                    "Name": "MoveToNextLocation"
                }
            ]
        }
    }
}
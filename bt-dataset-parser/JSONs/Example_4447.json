                                    "Task": "ScanObjectProperties",
                                    "Name": "ScanObjectProperties"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificObjectTask",
                            "Name": "SpecificObjectTask"
                        }
                    ]
                }
            ]
        }
    }

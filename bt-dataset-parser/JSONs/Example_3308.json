{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object visible, move to target; grab, process; if task complete, move to base and deposit. Else scan or move. list of available nodes: <Condition ID = IsObjectVisible    /> <Condition ID = IsTaskComplete    /> <Condition ID = IsObjectApproached    /> <Action ID = ScanArea    /> <Action ID = MoveToNewArea    /> <Action ID = MoveToTarget    /> <Action ID = GrabObject    /> <Action ID = MoveToBase    /> <Action ID = DepositObject    /> <SubTree ID = ProcessObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsTaskComplete": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToTarget",
                            "Name": "MoveToTarget"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObject",
                            "Name": "ProcessObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTaskComplete?": "IsTaskComplete"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToBase",
                            "Name": "MoveToBase"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "DepositObject",
                            "Name": "DepositObject"
                        }
                    ]
                }
            ]
        }
    }
}
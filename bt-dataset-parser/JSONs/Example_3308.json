    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO MoveToTarget\n\t\t\t\tDO GrabObject\n\t\t\t\tDO ProcessObject\n\t\t\t\t\tIF IsTaskComplete? THEN\n\t\t\t\t\tDO MoveToBase\n\t\t\tELSE\n\t\t\t\tDO DepositObject\n\t\t\tEND\n\tEND\n"

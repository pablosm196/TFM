                                "Name": "DoSpecificTask"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "MoveToRandomLocation",
                                "Name": "MoveToRandomLocation"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachToObject\n\t\tELSE\n\t\t\tDO CheckObjectProperties\n\t\t\tDO PickUpObject\n\t\t\tDO DoSpecificTask\n\t\tEND\n\t\tSEQUENCE\n\t\t\tDO MoveToRandomLocation\n\t\tEND\n\tEND\n"

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If there is an object: approach it, check properties, pick it up, perform task. Move randomly otherwise. list of available nodes: <Action ID = ApproachToObject    /> <SubTree ID = CheckObjectProperties    /> <Action ID = PickUpObject    /> <SubTree ID = DoSpecificTask    /> <Action ID = MoveToRandomLocation    /> <Condition ID = IsObjectVisible    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachToObject",
                            "Name": "ApproachToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PickUpObject",
                            "Name": "PickUpObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "DoSpecificTask",
                            "Name": "DoSpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToRandomLocation",
                            "Name": "MoveToRandomLocation"
                        }
                    ]
                }
            ]
        }
    }
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object detected, move to object and check object properties. Take object and perform specific task. Finally, scan area for object. list of available nodes: <Action ID = MoveToObject    /> <Action ID = CheckObjectProperties    /> <Action ID = TakeObject    /> <Action ID = SpecificTask    /> <Action ID = ScanAreaForObject    /> <SubTree ID = SpecificTask    /> <Condition ID = isObjectDetected    />",
    "BT": {
        "Blackboard": [
            {
                "isObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "isObjectDetected?": "isObjectDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObject",
                    "Name": "ScanAreaForObject"
                }
            ]
        }
    }
}
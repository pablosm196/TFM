{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object visible, move and take it. If heavy, store object. Do task. Else scan or move randomly.     list of available nodes: <Action ID = ApproachObject    /> <Action ID = GrabObject    /> <Action ID = MoveToObject    /> <Action ID = MoveToObjectStorage    /> <Action ID = ScanAreaForObject    /> <Action ID = StoreObject    /> <Action ID = MoveToRandomLocation    /> <Condition ID = IsObjectApproached    /> <Condition ID = IsObjectHeavy    /> <Condition ID = IsObjectVisible    /> <SubTree ID = SpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectHeavy": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToObject",
                    "Name": "MoveToObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "GrabObject",
                    "Name": "GrabObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectHeavy?": "IsObjectHeavy"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToObjectStorage",
                    "Name": "MoveToObjectStorage"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "StoreObject",
                    "Name": "StoreObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SpecificTask",
                    "Name": "SpecificTask"
                }
            ]
        }
    }
}
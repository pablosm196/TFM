{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find object. Take it. Analyze it. Move to the specific location. Else, scan or move.     list of available nodes: <Action ID = TakeObject    /> <Action ID = AnalyzeObject    /> <SubTree ID = FindTakeAndAnalyze    /> <Condition ID = IsObjectVisible    /> <Action ID = MoveToTarget    /> <Action ID = IsAnalysisComplete    /> <Action ID = MoveToSpecificLocation    /> <Action ID = ScanAreaForObject    /> <Action ID = RandomlyMoveAround    />",
    "BT": {
        "Blackboard": [
            {
                "IsAnalysisComplete": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToTarget",
                            "Name": "MoveToTarget"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "AnalyzeObject",
                            "Name": "AnalyzeObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsAnalysisComplete?": "IsAnalysisComplete"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToSpecificLocation",
                    "Name": "MoveToSpecificLocation"
                }
            ]
        }
    }
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object approached, take it. Then process it. If not, scan surroundings. Finally stop moving. list of available nodes: <Action ID = TakeObject    /> <SubTree ID = ProcessObject> <Condition ID = IsObjectProcessed    /> <Action ID = TaskCompleted    /> <Action ID = StopMoving    /> <Action ID = ScanSurroundings    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectProcessed": "Boolean"
            },
            {
                "IsMoving": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectApproached?": "IsObjectApproached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectProcessed?": "IsObjectProcessed"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "TaskCompleted",
                                    "Name": "TaskCompleted"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsMoving?": "IsMoving"
                                }
                            ],
                            "Nodes": [],
                            "Task": "StopMoving",
                            "Name": "StopMoving"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanSurroundings",
                    "Name": "ScanSurroundings"
                }
            ]
        }
    }
}
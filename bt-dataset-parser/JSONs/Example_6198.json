    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectProcessed? THEN\n\t\t\t\t\tDO TaskCompleted\n\t\t\tEND\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsMoving? THEN\n\t\t\t\tDO StopMoving\n\t\tEND\n\t\tDO ScanSurroundings\n\tEND\n"

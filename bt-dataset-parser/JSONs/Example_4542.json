{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object found, pick it up, move, drop-off, process properties, and perform specific task. Otherwise, approach or scan.     list of available nodes: <Condition ID = IsObjectFound    /> <Action ID = PickupObject    /> <Condition ID = IsPathClear    /> <Action ID = MoveToDropOff    /> <SubTree ID = ProcessObjectProperties    /> <Action ID = PerformSpecificTask    /> <Condition ID = IsObjectVisible    /> <Action ID = ApproachObject    /> <Action ID = ScanAreaForObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectFound": "Boolean"
            },
            {
                "IsPathClear": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectFound?": "IsObjectFound"
                        }
                    ],
                    "Nodes": [],
                    "Task": "PickupObject",
                    "Name": "PickupObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsPathClear?": "IsPathClear"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToDropOff",
                            "Name": "MoveToDropOff"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObjectProperties",
                            "Name": "ProcessObjectProperties"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "PerformSpecificTask",
                    "Name": "PerformSpecificTask"
                }
            ]
        }
    }
}
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectFound? THEN\n\t\t\t\tDO ApproachObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectGrabbed? THEN\n\t\t\t\tDO ProcessObject\n\t\tELSE\n\t\t\tDO MoveToDesignatedArea\n\t\tEND\n\t\tDO ScanAreaForObject\n\tEND\n"

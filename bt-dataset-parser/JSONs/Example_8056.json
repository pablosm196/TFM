                                "Name": "CompleteTask"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectDetected? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO MoveToTarget\n\t\t\t\tDO GrabObject\n\t\t\t\tDO CheckObject\n\t\t\t\tDO CompleteTask\n\t\t\tEND\n\tEND\n"

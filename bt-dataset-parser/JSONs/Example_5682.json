{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object detected, approach, grab, check properties, move, complete task. Otherwise scan area.     list of available nodes: <Action ID = ApproachObject    /> <Action ID = GrabObject    /> <SubTree ID = CheckObject    /> <SubTree ID = MoveToObject    /> <Action ID = CompleteTask    /> <Condition ID = IsObjectDetected    /> <Action ID = ScanAreaForObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],

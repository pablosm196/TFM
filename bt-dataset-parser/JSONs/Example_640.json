{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is near, take and store it. Then inspect and return to start position. list of available nodes: <Action ID = FindObject    /> <Action ID = TakeObject    /> <Action ID = MoveToStorage    /> <Condition ID = IsStorageEmpty    /> <SubTree ID = InspectObject    /> <Action ID = PlaceObject    /> <Action ID = ReturnToStartPosition    /> <Condition ID = IsObjectWithinReach    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectWithinReach": "Boolean"
            },
            {
                "IsStorageEmpty": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "FindObject",
                    "Name": "FindObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectWithinReach?": "IsObjectWithinReach"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToStorage",
                            "Name": "MoveToStorage"
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [
                                {
                                    "IsStorageEmpty?": "IsStorageEmpty"
                                }
                            ],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "PlaceObject",
                                    "Name": "PlaceObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "InspectObject",
                                    "Name": "InspectObject"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ReturnToStartPosition",
                    "Name": "ReturnToStartPosition"
                }
            ]
        }
    }
}
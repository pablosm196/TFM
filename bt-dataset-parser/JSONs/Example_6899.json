{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes.     Find and take object if visible and within reach. Check properties. Move or scan otherwise.     list of available nodes: <Action ID = ApproachObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectWithinReach    /> <Action ID = PickUpObject    /> <SubTree ID = CheckObjectProperties    /> <Action ID = MoveToTargetLocation    /> <Action ID = ScanAreaForObject    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectWithinReach": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectVisible?": "IsObjectVisible"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "ApproachObject",
                                "Name": "ApproachObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectWithinReach?": "IsObjectWithinReach"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "PickUpObject",
                                "Name": "PickUpObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "CheckObjectProperties",
                                "Name": "CheckObjectProperties"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "MoveToTargetLocation",
                                "Name": "MoveToTargetLocation"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ScanAreaForObject",
                                "Name": "ScanAreaForObject"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\t\tIF IsObjectWithinReach? THEN\n\t\t\t\tDO PickUpObject\n\t\tELSE\n\t\t\tDO CheckObjectProperties\n\t\tEND\n\t\tSEQUENCE\n\t\t\tDO MoveToTargetLocation\n\t\t\tDO ScanAreaForObject\n\t\tEND\n\tEND\n"
}
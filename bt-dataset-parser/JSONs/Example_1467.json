    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO MoveToObject\n\tELSE\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectGrabbed? THEN\n\t\t\t\t\tDO CheckProperties\n\t\t\tELSE\n\t\t\t\tDO SpecificTask\n\t\t\tEND\n\t\t\tDO GrabObject\n\t\tEND\n\tEND\n"

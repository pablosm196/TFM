{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find object. If near, grab. If far, approach, take, or scan. Then process.     list of available nodes: <Action ID = ScanArea    /> <Action ID = ApproachObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsAtObject    /> <Action ID = TakeObject    /> <Action ID = GrabObject    /> <SubTree ID = ProcessObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsAtObject": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectNear": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanArea",
                    "Name": "ScanArea"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectVisible?": "IsObjectVisible"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "ApproachObject",
                                    "Name": "ApproachObject"
                                },
                                {
                                    "Type": "Sequence",
                                    "Decorators": [],
                                    "Nodes": [
                                        {
                                            "Type": "Task",
                                            "Decorators": [
                                                {
                                                    "IsAtObject?": "IsAtObject"
                                                }
                                            ],
                                            "Nodes": [],
                                            "Task": "TakeObject",
                                            "Name": "TakeObject"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectNear?": "IsObjectNear"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "GrabObject",
                                    "Name": "GrabObject"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ProcessObject",
                    "Name": "ProcessObject"
                }
            ]
        }
    }
}
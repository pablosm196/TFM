    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectFound? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO CheckObjectProperties\n\t\t\tDO MoveToObjectDestination\n\t\t\tDO DoSpecificTask\n\t\tEND\n\t\tDO SearchForObject\n\tEND\n"

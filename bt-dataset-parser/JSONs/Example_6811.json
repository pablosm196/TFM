                                        "IsAreaExplored?": "IsAreaExplored"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "ExploreArea",
                                "Name": "ExploreArea"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "CheckBattery",
                        "Name": "CheckBattery"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectDetected? THEN\n\t\t\t\tDO MoveToObject\n\t\tELSE\n\t\t\tDO GrabObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsAreaExplored? THEN\n\t\t\t\tDO ExploreArea\n\t\tEND\n\t\tDO CheckBattery\n\tEND\n"

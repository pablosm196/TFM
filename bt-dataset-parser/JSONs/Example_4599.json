{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find object, approach it, perform task, check it, then grab it. Or scan and locate to move close.     list of available nodes: <Action ID = ApproachObject    /> <Action ID = CheckObjectProperties    /> <Action ID = PerformSpecificTask    /> <Action ID = GrabObject    /> <Action ID = MoveToObjectLocation    /> <Action ID = ScanForObjects    /> <Condition ID = IsObjectDetected    /> <Condition ID = IsObjectLocated    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectLocated": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectDetected?": "IsObjectDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PerformSpecificTask",
                            "Name": "PerformSpecificTask"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectLocated?": "IsObjectLocated"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObjectLocation",
                            "Name": "MoveToObjectLocation"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanForObjects",
                    "Name": "ScanForObjects"
                }
            ]
        }
    }
}
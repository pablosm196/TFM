{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object visible, approach, pick up, check, move to task or scan area.     list of available nodes: <Action ID = ApproachObject    /> <Action ID = PickUpObject    /> <Condition ID = IsObjectVisible    /> <SubTree ID = CheckObjectProperties    /> <Action ID = MoveToDestination    /> <Condition ID = IsObjectReached    /> <SubTree ID = SpecificTask    /> <Action ID = ScanEnvironment    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectReached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectReached?": "IsObjectReached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "PickUpObject",
                            "Name": "PickUpObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanEnvironment",
                    "Name": "ScanEnvironment"
                }
            ]
        }
    }
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object detected, move to position, take object, scan properties, explore area. list of available nodes: <Action ID = MoveToPosition    /> <SubTree ID = TakeObject    /> <Condition ID = IsObjectDetected    /> <Action ID = ScanObjectProperties    /> <Action ID = ExploreArea    />",
    "BT": {
        "Blackboard": [
            {
                "IsLocationReached": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectDetected?": "IsObjectDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToPosition",
                            "Name": "MoveToPosition"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsLocationReached?": "IsLocationReached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ScanObjectProperties",
                            "Name": "ScanObjectProperties"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ExploreArea",
                    "Name": "ExploreArea"
                }
            ]
        }
    }
}
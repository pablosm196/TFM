    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tSEQUENCE\n\t\t\t\t\tDO ApproachObject\n\t\t\t\t\tDO CheckObjectProperties\n\t\t\t\t\tDO SpecificTask\n\t\t\t\t\tDO TakeObject\n\t\t\t\tEND\n\t\tEND\n\t\tDO MoveToAnotherLocation\n\tEND\n"

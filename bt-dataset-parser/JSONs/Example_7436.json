    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO CheckObjectProperties\n\t\t\tDO GrabObject\n\t\t\tDO SpecificTask\n\t\tEND\n\t\tDO MoveToRandomLocation\n\tEND\n"

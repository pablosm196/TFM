    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF isObjectDetected? THEN\n\t\t\t\tDO MoveToObject\n\t\tELSE\n\t\t\tDO GraspObject\n\t\t\tDO CheckObjectProperties\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF isObjectLost? THEN\n\t\t\t\tDO ScanArea\n\t\tELSE\n\t\t\tDO MoveToRandomLocation\n\t\tEND\n\t\tDO DoNothing\n\tEND\n"

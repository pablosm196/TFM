{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object in view, approach and grab it, check properties and take it in order to perform specific task. Otherwise, move around. list of available nodes: <Action ID = TakeObject    /> <Action ID = MoveAround    /> <Action ID = CheckObjectProperties    /> <Action ID = ApproachObject    /> <Condition ID = IsObjectInView    /> <Condition ID = NoObjectsInView    /> <SubTree ID = SpecificTask    /> <Action ID = GrabObject    />",
    "BT": {
        "Blackboard": [
            {
                "NoObjectsInView": "Boolean"
            },
            {
                "IsObjectInView": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectInView?": "IsObjectInView"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "NoObjectsInView?": "NoObjectsInView"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveAround",
                            "Name": "MoveAround"
                        }
                    ]
                }
            ]
        }
    }
}
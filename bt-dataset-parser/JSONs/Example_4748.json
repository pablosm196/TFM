{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is found, approach it and take it, then check its properties. If not visible, move to it. list of available nodes: <Action ID = ApproachObject    /> <Action ID = MoveToObject    /> <Action ID = TakeObjectAndCheckProperties    /> <Condition ID = IsObjectFound    /> <Condition ID = IsObjectVisible    /> <Action ID = ScanAreaForObjects    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectFound": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectFound?": "IsObjectFound"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObjectAndCheckProperties",
                            "Name": "TakeObjectAndCheckProperties"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObjects",
                    "Name": "ScanAreaForObjects"
                }
            ]
        }
    }
}
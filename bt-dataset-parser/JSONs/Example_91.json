    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectDetected? THEN\n\t\t\t\tDO MoveToObject\n\t\tELSE\n\t\t\tDO GrabAndInspectObject\n\t\t\tDO MoveToDestination\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsDestinationReached? THEN\n\t\t\t\tDO PerformTask\n\t\tEND\n\t\tDO ScanArea\n\tEND\n"

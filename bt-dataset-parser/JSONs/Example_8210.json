{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If Object is visible, Approach it, then Grab it, Check its properties, Finally do Specific Task. If not found, Scan area. list of available nodes: <Action ID = ScanAreaForObject    /> <Action ID = IsObjectVisible    /> <Action ID = ApproachObject    /> <SubTree ID = GrabObject    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = SpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {

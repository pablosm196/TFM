    "code": "\tSEQUENCE\n\t\tDO MoveToSearchArea\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectDetected? THEN\n\t\t\t\t\tDO GrabObject\n\t\t\tELSE\n\t\t\t\tDO InspectObject\n\t\t\tEND\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\t\tDO MoveToObject\n\t\t\tEND\n\t\t\tDO ScanArea\n\t\tEND\n\tEND\n"

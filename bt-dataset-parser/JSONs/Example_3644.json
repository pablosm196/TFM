{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Approach object, take it, move to location, inspect object, or complete specific task. list of available nodes: <Action ID = TakeObject    /> <Action ID = MoveToLocation    /> <Action ID = InspectObject    /> <Action ID = IsObjectPropertyMet    /> <Action ID = IsObjectApproached    /> <Action ID = ApproachObject    /> <SubTree ID = SpecificTask    /> <Condition ID = IsLocationReached    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsLocationReached": "Boolean"
            },
            {
                "IsObjectPropertyMet": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectApproached?": "IsObjectApproached"
                        }
                    ],
                    "Nodes": [],
                    "Task": "TakeObject",
                    "Name": "TakeObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsLocationReached?": "IsLocationReached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToLocation",
                            "Name": "MoveToLocation"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Selector",
                            "Decorators": [
                                {
                                    "IsObjectPropertyMet?": "IsObjectPropertyMet"
                                }
                            ],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "InspectObject",
                                    "Name": "InspectObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "SpecificTask",
                                    "Name": "SpecificTask"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object is visible, approach it, take it, check its properties, move to task location, and do the task. Otherwise, scan for object.     list of available nodes: <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <SubTree ID = CheckObjectProperties    /> <Action ID = MoveToTaskLocation    /> <SubTree ID = DoTask    /> <Action ID = ScanForObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectInReach    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectInReach": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectInReach?": "IsObjectInReach"
                        }
                    ],
                    "Nodes": [],
                    "Task": "TakeObject",
                    "Name": "TakeObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToTaskLocation",
                    "Name": "MoveToTaskLocation"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "DoTask",
                    "Name": "DoTask"
                }
            ]
        }
    }
}
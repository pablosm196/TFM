                        "Nodes": [],
                        "Task": "MoveToDestination",
                        "Name": "MoveToDestination"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectReached? THEN\n\t\t\t\tDO CheckObjectProperties\n\t\tELSE\n\t\t\tSELECTOR\n\t\t\t\tDO TakeObject\n\t\t\t\tDO SpecificTask\n\t\t\tEND\n\t\tEND\n\t\tDO MoveToDestination\n\tEND\n"

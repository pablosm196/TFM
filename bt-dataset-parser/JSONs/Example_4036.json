                                        "Nodes": [],
                                        "Task": "TakeObject",
                                        "Name": "TakeObject"
                                    },
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "SpecificTask",
                                        "Name": "SpecificTask"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "Type": "Task",

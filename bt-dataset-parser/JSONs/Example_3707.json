                                "Name": "MoveToObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "PickUpObject",
                                "Name": "PickUpObject"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ScanArea",
                                "Name": "ScanArea"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "ObjectDetected?": "ObjectDetected"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "MoveToObject",
                                "Name": "MoveToObject"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "WanderAround",
                        "Name": "WanderAround"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF CheckForObject? THEN\n\t\t\t\tDO MoveToObject\n\t\tELSE\n\t\t\tDO PickUpObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\tDO ScanArea\n\t\t\t\tIF ObjectDetected? THEN\n\t\t\t\tDO MoveToObject\n\t\tEND\n\t\tDO WanderAround\n\tEND\n"

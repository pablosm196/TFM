{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find and grab object: If object approached, then grab and process it. Else, approach object or scan area. list of available nodes: <Action ID = TakeObject    /> <Action ID = ApproachObject    /> <Condition ID = IsObjectVisible    /> <SubTree ID = ProcessObjectProperties    /> <Sequence> <Action ID = ScanAreaForObject    /> <Sequence> <Condition ID = IsObjectApproached    /> <Action ID = TakeObject    /> <SubTree ID = ProcessObjectProperties    /> </Sequence> <Sequence> <Condition ID = IsObjectVisible    /> <Action ID = ApproachObject    /> </Sequence> </Sequence>",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectApproached?": "IsObjectApproached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObjectProperties",
                            "Name": "ProcessObjectProperties"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObject",
                    "Name": "ScanAreaForObject"
                }
            ]
        }
    }
}
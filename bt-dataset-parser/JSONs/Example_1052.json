{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If an object is visible, approach it. Take it and process it. Otherwise, move and scan. list of available nodes: <Action ID = IsObjectVisible    /> <Action ID = TakeObject    /> <Action ID = ProcessObject    /> <Action ID = IsObjectApproached    /> <Action ID = MoveToLocation    /> <Action ID = ScanAreaForObject    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Selector",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [
                            {
                                "Type": "Sequence",
                                "Decorators": [],
                                "Nodes": [
                                    {
                                        "Type": "Task",
                                        "Decorators": [
                                            {
                                                "IsObjectApproached?": "IsObjectApproached"
                                            }
                                        ],
                                        "Nodes": [],
                                        "Task": "TakeObject",
                                        "Name": "TakeObject"
                                    },
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "ProcessObject",
                                        "Name": "ProcessObject"
                                    }
                                ]
                            },
                            {
                                "Type": "Sequence",
                                "Decorators": [],
                                "Nodes": [
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "MoveToLocation",
                                        "Name": "MoveToLocation"
                                    },
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "ScanAreaForObject",
                                        "Name": "ScanAreaForObject"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSELECTOR\n\t\t\t\tSEQUENCE\n\t\t\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\t\t\tDO TakeObject\n\t\t\t\tELSE\n\t\t\t\t\tDO ProcessObject\n\t\t\t\tEND\n\t\t\t\tSEQUENCE\n\t\t\t\t\tDO MoveToLocation\n\t\t\t\t\tDO ScanAreaForObject\n\t\t\t\tEND\n\t\t\tEND\n\tEND\n"
}
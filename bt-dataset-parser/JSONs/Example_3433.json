                                    "Decorators": [
                                        {
                                            "IsTargetReached?": "IsTargetReached"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "DropOffObject",
                                    "Name": "DropOffObject"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [

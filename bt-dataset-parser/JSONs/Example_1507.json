{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. Approach object if visible. Take it, and process it. Otherwise, scan the area. list of available nodes: <Action ID = ApproachObject     /> <Action ID = TakeObject     /> <SubTree ID = ProcessObject     /> <Condition ID = IsObjectVisible     /> <Condition ID = IsObjectGrabbed     /> <Action ID = ScanAreaForObject     />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectGrabbed": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ApproachObject",
                                "Name": "ApproachObject"
                            }
                        ]
                    },
                    {
                        "Type": "Selector",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Sequence",
                                "Decorators": [],
                                "Nodes": [
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "TakeObject",
                                        "Name": "TakeObject"
                                    },
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "ProcessObject",
                                        "Name": "ProcessObject"
                                    }
                                ]
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ScanAreaForObject",
                                "Name": "ScanAreaForObject"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO ApproachObject\n\t\t\tEND\n\tELSE\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\tDO TakeObject\n\t\t\t\tDO ProcessObject\n\t\t\tEND\n\t\t\tDO ScanAreaForObject\n\t\tEND\n\tEND\n"

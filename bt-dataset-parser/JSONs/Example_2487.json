{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Robot navigate to the nearby object, take and check it, do task, and move to destination. Scan area and move randomly otherwise. list of available nodes: <Action ID = ScanAreaForObject    /> <Action ID = RandomMovement    /> <Action ID = MoveToObject    /> <Action ID = MoveToDestination    /> <Action ID = TakeObject    /> <Condition ID = CanTakeObject    /> <Condition ID = IsObjectNearby    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = DoTask    />",
    "BT": {
        "Blackboard": [
            {
                "CanTakeObject": "Boolean"
            },
            {
                "IsObjectNearby": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectNearby?": "IsObjectNearby"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToObject",
                    "Name": "MoveToObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "CanTakeObject?": "CanTakeObject"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "DoTask",
                    "Name": "DoTask"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToDestination",
                    "Name": "MoveToDestination"
                }
            ]
        }
    }
}
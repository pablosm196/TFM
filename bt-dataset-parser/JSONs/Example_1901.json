{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object approachable, retrieve it; if visible, then approach; finally scan the area.     list of available nodes: <Action ID = RetrieveObject    /> <Action ID = ApproachObject    /> <Condition ID = IsObjectVisible    /> <Sequence>     <Condition ID = IsObjectApproached    />     <Action ID = RetrieveObject    />     <SubTree ID = ProcessObjectProperties    /> </Sequence> <Action ID = ScanAreaForObject    /> <SubTree ID = ProcessObjectProperties    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectApproached?": "IsObjectApproached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "RetrieveObject",
                            "Name": "RetrieveObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObjectProperties",
                            "Name": "ProcessObjectProperties"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObject",
                    "Name": "ScanAreaForObject"
                }
            ]
        }
    }
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object visible, approach and grab it. Check properties and do task. Return home. If not, scan area. list of available nodes: <Action ID = ApproachObject    /> <Action ID = GrabObject    /> <Action ID = MoveToHomePosition    />  <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectReached    />  <SubTree ID = CheckObjectProperties    /> <SubTree ID = DoSpecificTask    />   <Action ID = ScanAreaForObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectReached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectReached?": "IsObjectReached"
                        }
                    ],
                    "Nodes": [],
                    "Task": "GrabObject",
                    "Name": "GrabObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "DoSpecificTask",
                    "Name": "DoSpecificTask"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToHomePosition",
                    "Name": "MoveToHomePosition"
                }
            ]
        }
    }
}
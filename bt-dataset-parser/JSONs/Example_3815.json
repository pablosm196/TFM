{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Approach visible object, take it, check properties, move or execute task. list of available nodes: <Action ID = NavigateToObjectLocation    /> <Action ID = GrabObject    /> <SubTree ID = CheckObjectProperties    /> <Condition ID = IsObjectVisible    /> <Condition ID = NeedToMoveObject    /> <Action ID = MoveObject    /> <Action ID = DropObject    /> <Action ID = DoSomeSpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "NeedToMoveObject": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "NavigateToObjectLocation",
                            "Name": "NavigateToObjectLocation"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Selector",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Sequence",
                                    "Decorators": [],
                                    "Nodes": [
                                        {
                                            "Type": "Task",
                                            "Decorators": [
                                                {
                                                    "NeedToMoveObject?": "NeedToMoveObject"
                                                }
                                            ],
                                            "Nodes": [],
                                            "Task": "MoveObject",
                                            "Name": "MoveObject"
                                        },
                                        {
                                            "Type": "Task",
                                            "Decorators": [],
                                            "Nodes": [],
                                            "Task": "DropObject",
                                            "Name": "DropObject"
                                        }
                                    ]
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "DoSomeSpecificTask",
                                    "Name": "DoSomeSpecificTask"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find and grab object, if visible approach and execute task, else scan area and move on.     list of available nodes: <Action ID = ApproachObject    /> <Action ID = MoveToObjectDropOffPoint    /> <Action ID = ReleaseObject    /> <Action ID = ScanAreaForObject    /> <Action ID = PerformAlternativeTask    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectGrabbed    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectGrabbed": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectGrabbed?": "IsObjectGrabbed"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObjectDropOffPoint",
                            "Name": "MoveToObjectDropOffPoint"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ReleaseObject",
                            "Name": "ReleaseObject"
                        }
                    ]
                }
            ]
        }
    }
}
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectHeavy?": "IsObjectHeavy"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "CallForHelp",
                                    "Name": "CallForHelp"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ReturnObject",
                            "Name": "ReturnObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToNewLocation",
                    "Name": "MoveToNewLocation"
                }
            ]
        }
    }

{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If object visible and detected then approach, grab and check it. Move to designated location and do task or scan surroundings. list of available nodes: <Action ID = ApproachObject    /> <Action ID = GrabAndCheckObject    /> <Action ID = MoveToLocation    /> <Action ID = SpecificTask    /> <Action ID = ScanSurroundings    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectVisible?": "IsObjectVisible"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "ApproachObject",
                                "Name": "ApproachObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "GrabAndCheckObject",
                                "Name": "GrabAndCheckObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "MoveToLocation",
                                "Name": "MoveToLocation"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "SpecificTask",
                                "Name": "SpecificTask"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ScanSurroundings",
                        "Name": "ScanSurroundings"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO GrabAndCheckObject\n\t\t\tDO MoveToLocation\n\t\t\tDO SpecificTask\n\t\tEND\n\t\tDO ScanSurroundings\n\tEND\n"
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Approach object, pick it up or inspect it. Then complete specific task and return to starting point. list of available nodes: <Action ID = ApproachObject    /> <Action ID = InspectObjectProperties    /> <Action ID = PickObject    /> <Action ID = MoveBackToStartingPoint    /> <SubTree ID = DoSpecificTask    /> <Condition ID = IsObjectPicked    /> <Condition ID = IsObjectVisible    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectPicked": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectPicked?": "IsObjectPicked"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "InspectObjectProperties",
                                    "Name": "InspectObjectProperties"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PickObject",
                            "Name": "PickObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "DoSpecificTask",
                    "Name": "DoSpecificTask"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveBackToStartingPoint",
                    "Name": "MoveBackToStartingPoint"
                }
            ]
        }
    }
}
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectPicked? THEN\n\t\t\t\t\tDO InspectObjectProperties\n\t\t\tEND\n\t\t\tDO PickObject\n\t\tEND\n\t\tDO DoSpecificTask\n\t\tDO MoveBackToStartingPoint\n\tEND\n"

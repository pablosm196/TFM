    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF ObjectDetected? THEN\n\t\t\t\tDO MoveTowardsObject\n\t\tELSE\n\t\t\t\tIF ObjectWithinRange? THEN\n\t\t\t\tDO PickUpObject\n\t\tELSE\n\t\t\tDO ProcessObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF NoObjectDetected? THEN\n\t\t\t\tDO ScanArea\n\t\tEND\n\tEND\n"

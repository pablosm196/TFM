{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object near, pick up, inspect and carry it, then move to task area and perform task. If area clear, scan and move to next.     list of available nodes: <Action ID = PickUpObject    /> <Action ID = CarryObject    /> <Action ID = MoveToTaskArea    /> <Action ID = ScanForObjects    /> <Action ID = MoveToNextArea    /> <Action ID = InspectObject    /> <SubTree ID = PerformTask    /> <Condition ID = IsObjectNear    /> <Condition ID = IsAreaClear    />",
    "BT": {
        "Blackboard": [
            {
                "IsAreaClear": "Boolean"
            },
            {
                "IsObjectNear": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectNear?": "IsObjectNear"
                                }
                            ],
                            "Nodes": [],
                            "Task": "PickUpObject",
                            "Name": "PickUpObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "InspectObject",
                            "Name": "InspectObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CarryObject",
                            "Name": "CarryObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToTaskArea",
                            "Name": "MoveToTaskArea"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PerformTask",
                            "Name": "PerformTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsAreaClear?": "IsAreaClear"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ScanForObjects",
                            "Name": "ScanForObjects"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToNextArea",
                            "Name": "MoveToNextArea"
                        }
                    ]
                }
            ]
        }
    }
}
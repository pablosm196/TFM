                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "CheckObjectTemperature",
                                "Name": "CheckObjectTemperature"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "SpecificTask",
                                "Name": "SpecificTask"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectFound? THEN\n\t\t\tDO MoveToObject\n\tELSE\n\t\tDO TakeObject\n\t\t\tIF IsObjectHeavy? THEN\n\t\t\tDO MoveToDestination\n\tELSE\n\t\tSELECTOR\n\t\t\tDO CheckObjectTemperature\n\t\t\tDO SpecificTask\n\t\tEND\n\tEND\n"

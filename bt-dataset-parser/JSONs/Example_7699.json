{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Mobile Robot Task: If object seen, approach, grab, check properties, move to destination; else, scan area. list of available nodes: <Action ID = ApproachObject    /> <Action ID = GrabObject    />  <Action ID = CheckObjectProperties    />  <Action ID = MoveToDestination    />  <Action ID = ScanAreaForObject    />  <SubTree ID = ApproachObjectAndGrab    />  <SubTree ID = CheckObjectProperties    />  <SubTree ID = MoveToDestination    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObjectAndGrab",
                            "Name": "ApproachObjectAndGrab"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanAreaForObject",
                            "Name": "ScanAreaForObject"
                        }
                    ]
                }
            ]
        }
    }
}
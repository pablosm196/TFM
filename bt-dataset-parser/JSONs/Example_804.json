{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is found, approach and grab it. Then inspect it and complete specific task. list of available nodes: <Action ID = SearchForObject    /> <Condition ID = ObjectInReach    /> <Action ID = GrabObject    /> <Action ID = ApproachToObject    /> <Action ID = InspectObject    /> <SubTree ID = SpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "ObjectInReach": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SearchForObject",
                    "Name": "SearchForObject"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "ObjectInReach?": "ObjectInReach"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "GrabObject",
                                    "Name": "GrabObject"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ApproachToObject",
                            "Name": "ApproachToObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "InspectObject",
                    "Name": "InspectObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SpecificTask",
                    "Name": "SpecificTask"
                }
            ]
        }
    }
}
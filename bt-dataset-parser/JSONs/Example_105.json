{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find object, move to it, take it, if heavy then put down gently, else do a specific task. list of available nodes: <Action ID = FindObject    /> <Action ID = MoveToObject    /> <Action ID = TakeObject    /> <Fallback>     <Sequence>         <Condition ID = IsObjectHeavy    />         <Action ID = PutObjectDown    />     </Sequence>     <Sequence>         <Condition ID = IsObjectBreaking    />         <Action ID = HandleObjectGently    />     </Sequence> </Fallback> <SubTree ID = DoSpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectBreaking": "Boolean"
            },
            {
                "IsObjectHeavy": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "FindObject",
                    "Name": "FindObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToObject",
                    "Name": "MoveToObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "TakeObject",
                    "Name": "TakeObject"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectHeavy?": "IsObjectHeavy"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "PutObjectDown",
                                    "Name": "PutObjectDown"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectBreaking?": "IsObjectBreaking"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "HandleObjectGently",
                                    "Name": "HandleObjectGently"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "DoSpecificTask",
                    "Name": "DoSpecificTask"
                }
            ]
        }
    }

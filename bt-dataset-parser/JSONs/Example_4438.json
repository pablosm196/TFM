{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, move to it, inspect properties, grab it, do task; else search or scan. list of available nodes: <Action ID = MoveToObject    /> <Action ID = GrabObject    /> <Condition ID = IsObjectFar    /> <Condition ID = IsObjectLost    /> <Condition ID = IsObjectVisible    /> <Action ID = SearchForObject    /> <Action ID = ScanArea    /> <Action ID = InspectObjectProperties    /> <SubTree ID = SpecificTask    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectFar": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectFar?": "IsObjectFar"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "MoveToObject",
                                "Name": "MoveToObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "InspectObjectProperties",
                                "Name": "InspectObjectProperties"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "GrabObject",
                        "Name": "GrabObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "SpecificTask",
                        "Name": "SpecificTask"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectFar? THEN\n\t\t\t\t\tDO MoveToObject\n\t\t\tELSE\n\t\t\t\tDO InspectObjectProperties\n\t\t\tEND\n\tELSE\n\t\tDO GrabObject\n\t\tDO SpecificTask\n\tEND\n"
}
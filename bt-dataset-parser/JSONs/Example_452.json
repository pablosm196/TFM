{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object nearby, then move and grab, check properties. Else move randomly or scan. list of available nodes: <Condition ID = IsObjectNearby    /> <Action ID = MoveToObject    /> <Action ID = GrabObject    /> <SubTree ID = CheckObjectProperties    /> <Condition ID = IsPathClear    /> <Action ID = MoveToRandomLocation    /> <Action ID = ScanForObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectNearby": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectNearby?": "IsObjectNearby"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToObject",
                    "Name": "MoveToObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "GrabObject",
                    "Name": "GrabObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                }
            ]
        }
    }
}
    "code": "\tSEQUENCE\n\t\tDO FindObject\n\t\tDO ApproachObject\n\t\tDO CheckObjectProperties\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectGrabbable? THEN\n\t\t\t\t\tDO GrabObject\n\t\t\tELSE\n\t\t\t\tDO SpecificTask\n\t\t\tEND\n\t\t\tDO ScanArea\n\t\tEND\n\t\tDO MoveToDestination\n\tEND\n"

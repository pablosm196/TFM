            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectApproached?": "IsObjectApproached"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "PickObject",
                                "Name": "PickObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "InspectObject",
                                "Name": "InspectObject"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectVisible?": "IsObjectVisible"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "ApproachObject",
                                "Name": "ApproachObject"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ScanAreaForObject",
                        "Name": "ScanAreaForObject"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\tDO PickObject\n\t\tELSE\n\t\t\tDO InspectObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tEND\n\t\tDO ScanAreaForObject\n\tEND\n"

{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If object detected, grab it and inspect properties. Move object to storage. Scan/wander. list of available nodes: <Action ID = IsObjectWithinReach    /> <Action ID = GrabObject    /> <Action ID = InspectObjectProperties    /> <Action ID = MoveToStorageLocation    /> <Action ID = PlaceObjectInStorage    /> <Action ID = ScanAreaForObject    /> <Action ID = WanderAround    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectWithinReach": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [
                            {
                                "IsObjectDetected?": "IsObjectDetected"
                            }
                        ],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectWithinReach?": "IsObjectWithinReach"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "GrabObject",
                                "Name": "GrabObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "InspectObjectProperties",
                                "Name": "InspectObjectProperties"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "MoveToStorageLocation",
                        "Name": "MoveToStorageLocation"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "PlaceObjectInStorage",
                        "Name": "PlaceObjectInStorage"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectDetected? THEN\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectWithinReach? THEN\n\t\t\t\t\tDO GrabObject\n\t\t\tELSE\n\t\t\t\tDO InspectObjectProperties\n\t\t\tEND\n\tELSE\n\t\tDO MoveToStorageLocation\n\t\tDO PlaceObjectInStorage\n\tEND\n"
}
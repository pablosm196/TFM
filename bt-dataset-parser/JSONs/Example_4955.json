                                {
                                    "Type": "Sequence",
                                    "Decorators": [],
                                    "Nodes": [
                                        {
                                            "Type": "Task",
                                            "Decorators": [
                                                {
                                                    "IsObjectVisible?": "IsObjectVisible"
                                                }
                                            ],
                                            "Nodes": [],
                                            "Task": "ApproachObject",
                                            "Name": "ApproachObject"
                                        }
                                    ]
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "RotateAndScanArea",
                                    "Name": "RotateAndScanArea"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToStartPosition",
                    "Name": "MoveToStartPosition"
                }
            ]
        }
    }

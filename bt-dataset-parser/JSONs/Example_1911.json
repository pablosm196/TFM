{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object visible: Approach object. Then check object properties, take object and act upon it. If object not visible, then scan area. list of available nodes: <Condition ID = IsObjectVisible    />  <Action ID = ApproachObject    />  <Action ID = CheckObjectProperties    />  <Action ID = TakeObject    />  <SubTree ID = DoSomethingWithObject    />  <Action ID = ScanForObjects    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "DoSomethingWithObject",
                            "Name": "DoSomethingWithObject"
                        }
                    ]
                }
            ]
        }
    }
}
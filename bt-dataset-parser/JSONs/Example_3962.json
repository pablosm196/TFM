{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find, move to, take and process an object in that order when one is found or scan the area. list of available nodes: <Action ID = MoveToFoundObject    /> <Action ID = MoveToDestination    /> <Action ID = GrabObject    /> <Action ID = ScanAreaForObjects    /> <Condition ID = IsObjectFound    /> <Condition ID = IsObjectHeld    /> <SubTree ID = ProcessObjectTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectHeld": "Boolean"
            },
            {
                "IsObjectFound": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectFound?": "IsObjectFound"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToFoundObject",
                            "Name": "MoveToFoundObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectHeld?": "IsObjectHeld"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObjectTask",
                            "Name": "ProcessObjectTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObjects",
                    "Name": "ScanAreaForObjects"
                }
            ]
        }
    }
}
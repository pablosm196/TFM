{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object found, approach, take and move to destination, check attributes, perform task, stop or scan. list of available nodes: <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <Action ID = MoveToDestination    /> <Condition ID = IsDestinationReached    /> <SubTree ID = ProcessObjectAttributes    /> <Action ID = SpecificTask    /> <Action ID = ScanArea    /> <Action ID = StopRobot    /> <Condition ID = IsObjectFound    />",
    "BT": {
        "Blackboard": [
            {
                "IsDestinationReached": "Boolean"
            },
            {
                "IsObjectFound": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectFound?": "IsObjectFound"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsDestinationReached?": "IsDestinationReached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ProcessObjectAttributes",
                            "Name": "ProcessObjectAttributes"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanArea",
                    "Name": "ScanArea"
                }
            ]
        }
    }
}
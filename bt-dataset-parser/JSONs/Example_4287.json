                                "Decorators": [
                                    {
                                        "CanTakeObject?": "CanTakeObject"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "TakeObject",
                                "Name": "TakeObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],

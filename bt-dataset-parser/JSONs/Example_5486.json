                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObstacleInPath?": "IsObstacleInPath"
                                }
                            ],
                            "Nodes": [],
                            "Task": "AvoidObstacle",

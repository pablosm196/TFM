{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. 1. Scan area 2. If object visible, then move towards object and grab object. 3. If holding object, then check object properties and perform task. list of available nodes: <Action ID = MoveTowardsObject    /> <Action ID = GrabObject    /> <Action ID = CheckObjectProperties    /> <Action ID = ScanArea    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsHoldingObject    /> <SubTree ID = PerformTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsHoldingObject": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveTowardsObject",
                            "Name": "MoveTowardsObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsHoldingObject?": "IsHoldingObject"
                                }
                            ],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PerformTask",
                            "Name": "PerformTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanArea",
                    "Name": "ScanArea"
                }
            ]
        }
    }
}
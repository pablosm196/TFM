{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find and approach object, pickup if within range and matching props, transport and perform task. Scan area if failed. list of available nodes: <Action ID = ApproachTarget    /> <Action ID = PerformTask    /> <Action ID = PickupTarget    /> <Action ID = TransportTarget    /> <Action ID = ScanArea    /> <Condition ID = IsTargetVisible    /> <Condition ID = IsTargetWithinRange    /> <SubTree ID = CheckTargetProperties    />",
    "BT": {
        "Blackboard": [
            {
                "IsTargetWithinRange": "Boolean"
            },
            {
                "IsTargetVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsTargetVisible?": "IsTargetVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachTarget",
                    "Name": "ApproachTarget"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTargetWithinRange?": "IsTargetWithinRange"
                                }
                            ],
                            "Nodes": [],
                            "Task": "PickupTarget",
                            "Name": "PickupTarget"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckTargetProperties",
                            "Name": "CheckTargetProperties"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "TransportTarget",
                    "Name": "TransportTarget"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "PerformTask",
                    "Name": "PerformTask"
                }
            ]
        }
    }
}
{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, approach it, grasp it, move it, complete specific task if heavy, scan area if not. list of available nodes: <Action ID = ApproachObject    /> <Action ID = GraspObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectHeavy    /> <Action ID = MoveObjectToDestination    /> <SubTree ID = SpecificTask    /> <Action ID = ScanAreaForObject    /> <SubTree ID = RandomMovement    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectHeavy": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ApproachObject",
                                "Name": "ApproachObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "GraspObject",
                                "Name": "GraspObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectHeavy?": "IsObjectHeavy"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "MoveObjectToDestination",
                                "Name": "MoveObjectToDestination"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "SpecificTask",
                                "Name": "SpecificTask"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO ApproachObject\n\t\t\t\tDO GraspObject\n\t\t\t\t\tIF IsObjectHeavy? THEN\n\t\t\t\t\tDO MoveObjectToDestination\n\t\t\tELSE\n\t\t\t\tDO SpecificTask\n\t\t\tEND\n\tEND\n"
}
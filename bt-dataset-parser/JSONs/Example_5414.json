{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object detected, move to it. If small, take it. If big, check properties. Finally, execute specific task. list of available nodes: <Action ID = MoveToObject    /> <Action ID = TakeObject    /> <Action ID = CheckObjectProperties    /> <Action ID = SpecificTask    /> <Condition ID = IsObjectDetected    /> <Condition ID = IsObjectSmall    /> <Condition ID = IsObjectBig    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectSmall": "Boolean"
            },
            {
                "IsObjectBig": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectDetected?": "IsObjectDetected"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToObject",
                    "Name": "MoveToObject"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectSmall?": "IsObjectSmall"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "TakeObject",
                                    "Name": "TakeObject"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectBig?": "IsObjectBig"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "CheckObjectProperties",
                                    "Name": "CheckObjectProperties"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SpecificTask",
                    "Name": "SpecificTask"
                }
            ]
        }
    }
}
                                    {
                                        "Type": "Task",
                                        "Decorators": [
                                            {
                                                "IsObjectApproached?": "IsObjectApproached"
                                            }
                                        ],
                                        "Nodes": [],
                                        "Task": "TakeObject",
                                        "Name": "TakeObject"
                                    }
                                ]
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ApproachObject",
                                "Name": "ApproachObject"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "CheckObjectProperties",
                                "Name": "CheckObjectProperties"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "SpecificTask",
                                "Name": "SpecificTask"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "MoveToDestination",
                        "Name": "MoveToDestination"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSELECTOR\n\t\t\t\tSEQUENCE\n\t\t\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\t\t\tDO TakeObject\n\t\t\t\tEND\n\t\t\t\tDO ApproachObject\n\t\t\tEND\n\tELSE\n\t\tSEQUENCE\n\t\t\tDO CheckObjectProperties\n\t\t\tDO SpecificTask\n\t\tEND\n\t\tDO MoveToDestination\n\tEND\n"
}
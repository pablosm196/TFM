                                "Task": "SpecificTaskSubtree",
                                "Name": "SpecificTaskSubtree"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ScanAreaForObject",
                        "Name": "ScanAreaForObject"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO MoveToPosition\n\t\t\t\tDO GrabObject\n\t\t\t\tDO CheckObjectProperties\n\t\t\t\tDO SpecificTaskSubtree\n\t\t\tEND\n\tELSE\n\t\tDO ScanAreaForObject\n\tEND\n"

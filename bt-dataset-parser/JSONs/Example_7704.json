                        "Task": "TaskSubTree",
                        "Name": "TaskSubTree"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\t\tIF IsObjectApproached? THEN\n\t\t\tDO GrabObject\n\tELSE\n\t\tDO CheckObjectProps\n\t\tDO MoveToDestination\n\t\tDO TaskSubTree\n\tEND\n"

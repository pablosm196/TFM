{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object found, then approach it, take it, check properties, perform task or roam. list of available nodes: <Action ID = FindObject    /> <Action ID = ApproachObject    /> <Condition ID = IsObjectWithinReach    /> <Action ID = TakeObject    /> <Action ID = CheckObjectProperties    /> <SubTree ID = SpecificTask    /> <Action ID = ScanArea    /> <Action ID = Move    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectWithinReach": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "FindObject",
                    "Name": "FindObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {

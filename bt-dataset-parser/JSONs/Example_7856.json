{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object detected, approach it, take it, check properties, do task. Else, explore area, move. list of available nodes: <Action ID = ApproachObject    /> <Condition ID = IsObjectDetected    /> <Action ID = TakeObject    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = DoSpecificTask    /> <Condition ID = IsAreaExplored    /> <Action ID = MoveToNewArea    />",
    "BT": {
        "Blackboard": [
            {
                "IsAreaExplored": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectDetected?": "IsObjectDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "DoSpecificTask",
                            "Name": "DoSpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsAreaExplored?": "IsAreaExplored"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToNewArea",
                            "Name": "MoveToNewArea"
                        }
                    ]
                }
            ]
        }
    }
}
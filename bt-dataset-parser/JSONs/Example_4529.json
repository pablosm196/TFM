    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectDetected? THEN\n\t\t\t\tDO MoveToObject\n\t\tELSE\n\t\t\tDO TakeObject\n\t\t\tDO CheckObjectProperties\n\t\t\tDO DoSpecificTask\n\t\tEND\n\t\tDO ScanArea\n\t\tDO MoveRandomly\n\tEND\n"

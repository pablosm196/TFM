                            "Decorators": [
                                {
                                    "IsNewObjectFound?": "IsNewObjectFound"
                                }
                            ],
                            "Nodes": [],
                            "Task": "FindGrabAndTask",
                            "Name": "FindGrabAndTask"
                        }
                    ]
                }

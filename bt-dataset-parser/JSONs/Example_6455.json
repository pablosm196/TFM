                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectSize",
                    "Name": "CheckObjectSize"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "MoveToZoneOne",
                                    "Name": "MoveToZoneOne"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "PlaceObjectInZoneOne",
                                    "Name": "PlaceObjectInZoneOne"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "MoveToZoneTwo",
                                    "Name": "MoveToZoneTwo"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "PlaceObjectInZoneTwo",
                                    "Name": "PlaceObjectInZoneTwo"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "MoveToZoneThree",
                                    "Name": "MoveToZoneThree"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "PlaceObjectInZoneThree",
                                    "Name": "PlaceObjectInZoneThree"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }
}
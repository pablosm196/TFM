                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ScanAreaForObject",
                        "Name": "ScanAreaForObject"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectInSight? THEN\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectWithinReach? THEN\n\t\t\t\t\tDO AcquireObject\n\t\t\tELSE\n\t\t\t\tDO ProcessObject\n\t\t\tEND\n\tELSE\n\t\tDO MoveToLastKnownObjectLocation\n\t\tDO ScanAreaForObject\n\tEND\n"

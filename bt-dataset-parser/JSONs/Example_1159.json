{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If target is in sight, pick it up and process it, otherwise move to target while avoiding obstacles. list of available nodes: <Action ID = PickUpObject    /> <SubTree ID = ProcessObject    /> <Condition ID = IsTargetInSight    /> <Action ID = MoveToTarget    /> <Condition ID = IsTargetVisible    /> <Action ID = ScanEnvironment    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsTargetVisible": "Boolean"
            },
            {
                "IsTargetInSight": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsTargetInSight?": "IsTargetInSight"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "PickUpObject",
                                "Name": "PickUpObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ProcessObject",
                                "Name": "ProcessObject"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "MoveToTarget",
                                "Name": "MoveToTarget"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ScanEnvironment",
                        "Name": "ScanEnvironment"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsTargetInSight? THEN\n\t\t\t\tDO PickUpObject\n\t\tELSE\n\t\t\tDO ProcessObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\tDO MoveToTarget\n\t\tEND\n\t\tDO ScanEnvironment\n\tEND\n"

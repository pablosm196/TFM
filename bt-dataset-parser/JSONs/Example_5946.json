{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find object, approach and take it. If grabbed, inspect it or do task with it. If not, scan or move randomly.     list of available nodes: <Action ID = MoveToObject    /> <Action ID = InspectObject    /> <Action ID = ReleaseObject    /> <Condition ID = IsObjectClose    /> <Condition ID = IsObjectGrabbed    /> <Action ID = DoTask    /> <Action ID = ScanForObject    /> <Action ID = RandomMovement    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectClose": "Boolean"
            },
            {
                "IsObjectGrabbed": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectClose?": "IsObjectClose"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToObject",
                    "Name": "MoveToObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectGrabbed?": "IsObjectGrabbed"
                                }
                            ],
                            "Nodes": [],
                            "Task": "InspectObject",
                            "Name": "InspectObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "DoTask",
                            "Name": "DoTask"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ReleaseObject",
                            "Name": "ReleaseObject"
                        }
                    ]
                }
            ]
        }
    }
}
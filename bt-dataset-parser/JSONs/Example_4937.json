                            "Name": "CheckTargetWeight"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessTarget",
                            "Name": "ProcessTarget"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ReleaseTarget",
                            "Name": "ReleaseTarget"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTargetVisible?": "IsTargetVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToTarget",
                            "Name": "MoveToTarget"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ExploreArea",
                    "Name": "ExploreArea"
                }
            ]
        }

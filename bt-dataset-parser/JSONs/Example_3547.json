{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is visible: approach, take, process. Else: scan, move. list of available nodes: <Action ID = ScanArea    /> <Action ID = MoveToRandomPosition    /> <Action ID = IsObjectVisible    /> <Action ID = TakeObject    /> <Action ID = ApproachObject    /> <SubTree ID = ProcessObject    /> <Condition ID = CanMoveToRandomPosition    />",
    "BT": {
        "Blackboard": [
            {
                "CanMoveToRandomPosition": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObject",
                            "Name": "ProcessObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanArea",
                            "Name": "ScanArea"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "CanMoveToRandomPosition?": "CanMoveToRandomPosition"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToRandomPosition",
                            "Name": "MoveToRandomPosition"
                        }
                    ]
                }
            ]
        }
    }
}
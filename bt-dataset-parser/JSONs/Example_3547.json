    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO TakeObject\n\t\t\tDO ProcessObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\tDO ScanArea\n\t\t\t\tIF CanMoveToRandomPosition? THEN\n\t\t\t\tDO MoveToRandomPosition\n\t\tEND\n\tEND\n"

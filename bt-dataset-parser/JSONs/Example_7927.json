    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\tDO TakeObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO MoveTowardsObject\n\t\tEND\n\t\tDO ScanAreaForObjects\n\t\tDO ProcessObjectProperties\n\t\tDO DoSpecificTask\n\tEND\n"

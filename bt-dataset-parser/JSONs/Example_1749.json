{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is close, move to it, pick it up, check properties. Else, if task is available, approach task and do it. list of available nodes: <Action ID = MoveToObject    /> <Action ID = PickObject    /> <Action ID = ApproachTask    /> <Action ID = WanderAround    /> <Action ID = CheckObjectProperties    /> <Condition ID = IsObjectAround    /> <Condition ID = IsObjectPickable    /> <Condition ID = IsTaskAvailable    /> <SubTree ID = DoTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectAround": "Boolean"
            },
            {
                "IsObjectPickable": "Boolean"
            },
            {
                "IsTaskAvailable": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectAround?": "IsObjectAround"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectPickable?": "IsObjectPickable"
                                }
                            ],
                            "Nodes": [],
                            "Task": "PickObject",
                            "Name": "PickObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTaskAvailable?": "IsTaskAvailable"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachTask",
                            "Name": "ApproachTask"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "DoTask",
                            "Name": "DoTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "WanderAround",
                    "Name": "WanderAround"
                }
            ]
        }
    }
}
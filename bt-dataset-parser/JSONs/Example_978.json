{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object is visible, move and pick it up. Then process its properties. Move to target location if set. Scan area.     list of available nodes: <Action ID = MoveToObject    /> <Action ID = PickUpObject    /> <SubTree ID = ProcessObjectProperties    /> <Condition ID = IsObjectVisible    /> <Action ID = MoveToTargetLocation    /> <Condition ID = IsTargetLocationSet    /> <Action ID = ScanArea    />",
    "BT": {
        "Blackboard": [
            {
                "IsTargetLocationSet": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PickUpObject",
                            "Name": "PickUpObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObjectProperties",
                            "Name": "ProcessObjectProperties"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTargetLocationSet?": "IsTargetLocationSet"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToTargetLocation",
                            "Name": "MoveToTargetLocation"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanArea",
                    "Name": "ScanArea"
                }
            ]
        }
    }
}
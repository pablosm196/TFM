    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO MoveToObject\n\t\tELSE\n\t\t\tDO PickUpObject\n\t\t\tDO ProcessObjectProperties\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsTargetLocationSet? THEN\n\t\t\t\tDO MoveToTargetLocation\n\t\tEND\n\t\tDO ScanArea\n\tEND\n"

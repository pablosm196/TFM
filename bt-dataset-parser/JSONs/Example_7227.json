                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectIdentified?": "IsObjectIdentified"
                                }
                            ],
                            "Nodes": [],

                        "Nodes": [],
                        "Task": "MoveToDestination",
                        "Name": "MoveToDestination"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectFound? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO ProcessObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsDestinationReached? THEN\n\t\t\t\tDO DropObject\n\t\tEND\n\t\tDO MoveToDestination\n\tEND\n"

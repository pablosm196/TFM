    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO TakeObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectMoving? THEN\n\t\t\t\tDO FollowObject\n\t\tEND\n\t\tDO ScanAreaForObjects\n\tEND\n"

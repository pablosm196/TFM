{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object visible, approach and take it. If object moving, follow. Scan area for objects. list of available nodes: <Action ID = ApproachObject    /> <Action ID = FollowObject    /> <Action ID = ScanAreaForObjects    /> <Action ID = TakeObject    /> <SubTree ID = MobileRobotTask    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectMoving    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectMoving": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectMoving?": "IsObjectMoving"
                                }
                            ],
                            "Nodes": [],
                            "Task": "FollowObject",
                            "Name": "FollowObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObjects",
                    "Name": "ScanAreaForObjects"
                }
            ]
        }
    }
}
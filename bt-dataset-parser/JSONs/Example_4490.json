                    "Name": "MoveToTargetLocation"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectWeight",
                    "Name": "CheckObjectWeight"
                },
                {
                    "Type": "Task",

    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\tDO SearchForObject\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tSEQUENCE\n\t\t\t\t\t\tIF IsObjectWithinReach? THEN\n\t\t\t\t\t\tDO GrabObject\n\t\t\t\tELSE\n\t\t\t\t\tDO ProcessObject\n\t\t\t\tEND\n\t\tELSE\n\t\t\tDO MoveToObject\n\t\tEND\n\t\tDO ScanArea\n\tEND\n"

                            "Nodes": [],
                            "Task": "CheckObjectPropertiesTask",
                            "Name": "CheckObjectPropertiesTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObjects",
                    "Name": "ScanAreaForObjects"
                }
            ]
        }
    }

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, move towards it, take it, complete task and scan area for more objects. list of available nodes: <Condition ID = IsObjectVisible    /> <Sequence>     <Action ID = MoveTowardsObject    />     <SubTree ID = TaskOnObject>         <Action ID = TakeObject    />         <Condition ID = IsObjectHeavy    />         <Action ID = CallForHelp    />     </SubTree>     <Action ID = ScanAreaForObjects    /> </Sequence>",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectHeavy": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveTowardsObject",
                            "Name": "MoveTowardsObject"
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "TakeObject",
                                    "Name": "TakeObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectHeavy?": "IsObjectHeavy"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "CallForHelp",
                                    "Name": "CallForHelp"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TaskOnObject",
                            "Name": "TaskOnObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObjects",
                    "Name": "ScanAreaForObjects"
                }
            ]
        }
    }
}
{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes.     Find and grab object. Approach, take, and check it. If not found, scan area or move.     list of available nodes: <Action ID = MoveToNextLocation    /> <Action ID = ScanAreaForObject    /> <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <SubTree ID = CheckObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectApproached    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [],
                        "Task": "ApproachObject",
                        "Name": "ApproachObject"
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectApproached?": "IsObjectApproached"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "TakeObject",
                                "Name": "TakeObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "CheckObject",
                                "Name": "CheckObject"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO CheckObject\n\t\tEND\n\tEND\n"
}
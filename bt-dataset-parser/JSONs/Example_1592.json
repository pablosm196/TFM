{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is in front, take it, move, check properties, perform specific task, otherwise explore or wait. list of available nodes: <Action ID = ExploreArea    /> <Action ID = ChargeBattery    /> <Action ID = TakeObject    /> <Action ID = PutObjectDown    /> <Action ID = WaitForTask    /> <Action ID = CheckObjectProperties    /> <Action ID = MoveToDestination    /> <Action ID = MoveToObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectApproached    /> <Condition ID = isObjectHeavy    /> <SubTree ID = SpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "isObjectHeavy": "Boolean"
            },
            {
                "IsObjectApproached": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectApproached?": "IsObjectApproached"
                        }
                    ],
                    "Nodes": [],
                    "Task": "TakeObject",
                    "Name": "TakeObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToDestination",
                    "Name": "MoveToDestination"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "isObjectHeavy?": "isObjectHeavy"
                        }
                    ],
                    "Nodes": [],
                    "Task": "PutObjectDown",
                    "Name": "PutObjectDown"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SpecificTask",
                    "Name": "SpecificTask"
                }
            ]
        }
    }
}
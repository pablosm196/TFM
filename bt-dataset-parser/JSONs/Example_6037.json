    "code": "\tSEQUENCE\n\t\t\tIF IsObjectDetected? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO MoveToLocation\n\t\t\t\tDO GrabObject\n\t\t\t\tDO CheckObjectWeight\n\t\t\t\tDO MoveToDestination\n\t\t\t\tDO SpecificTask\n\t\t\tEND\n\tEND\n"

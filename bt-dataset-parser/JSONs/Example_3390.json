{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is in range, move to it. Then take it, check properties and do specific task. Finally, scan area for objects. list of available nodes: <Action ID = MoveToTheObject    /> <Action ID = TakeObject    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = DoSpecificTask    /> <Action ID = ScanAreaForObjects    /> <Condition ID = isObjectInRange    /> <Condition ID = isObjectGrabbed    />",
    "BT": {
        "Blackboard": [
            {
                "isObjectGrabbed": "Boolean"
            },
            {
                "isObjectInRange": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "isObjectInRange?": "isObjectInRange"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToTheObject",
                            "Name": "MoveToTheObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "isObjectGrabbed?": "isObjectGrabbed"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "DoSpecificTask",
                            "Name": "DoSpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObjects",
                    "Name": "ScanAreaForObjects"
                }
            ]
        }
    }
}
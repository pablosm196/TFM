{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If battery is good, then detect and inspect object, in order to pick and process it or explore. list of available nodes: <Action ID = ApproachObject    /> <SubTree ID = ProcessObject    /> <Condition ID = CheckBatteryLevel    /> <Condition ID = IsObjectDetected    /> <Action ID = PickUpObject    /> <Action ID = ExploreSurroundings    />",
    "BT": {
        "Blackboard": [
            {
                "CheckBatteryLevel": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Selector",
                    "Decorators": [
                        {
                            "CheckBatteryLevel?": "CheckBatteryLevel"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectDetected?": "IsObjectDetected"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "ApproachObject",
                                    "Name": "ApproachObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "PickUpObject",
                                    "Name": "PickUpObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "ProcessObject",
                                    "Name": "ProcessObject"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "ExploreSurroundings",
                                    "Name": "ExploreSurroundings"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }
}
    "code": "\tSEQUENCE\n\t\t\tIF CheckBatteryLevel? THEN\n\t\t\tSELECTOR\n\t\t\t\tSEQUENCE\n\t\t\t\t\t\tIF IsObjectDetected? THEN\n\t\t\t\t\t\tDO ApproachObject\n\t\t\t\tELSE\n\t\t\t\t\tDO PickUpObject\n\t\t\t\t\tDO ProcessObject\n\t\t\t\tEND\n\t\t\t\tSEQUENCE\n\t\t\t\t\tDO ExploreSurroundings\n\t\t\t\tEND\n\t\t\tEND\n\tEND\n"

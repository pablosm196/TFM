{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find, move to, grab, and check object. If dark, check temperature; if light, check color; if big, check weight. Finally, do some task. list of available nodes: <Action ID = FindObject    /> <Action ID = MoveToObject    /> <Action ID = GrabObject    /> <Action ID = CheckObjectWeight    /> <Action ID = CheckObjectColor    /> <Action ID = CheckObjectTemperature    /> <Action ID = DoSomeTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectLight": "Boolean"
            },
            {
                "IsObjectDark": "Boolean"
            },
            {
                "IsObjectBig": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "FindObject",
                    "Name": "FindObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToObject",
                    "Name": "MoveToObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "GrabObject",
                    "Name": "GrabObject"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectBig?": "IsObjectBig"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "CheckObjectWeight",
                                    "Name": "CheckObjectWeight"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectLight?": "IsObjectLight"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "CheckObjectColor",
                                    "Name": "CheckObjectColor"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectDark?": "IsObjectDark"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "CheckObjectTemperature",
                                    "Name": "CheckObjectTemperature"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "DoSomeTask",
                            "Name": "DoSomeTask"
                        }
                    ]
                }
            ]
        }
    }
}
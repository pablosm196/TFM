    "code": "\tSEQUENCE\n\t\tDO FindObject\n\t\tDO MoveToObject\n\t\tDO GrabObject\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectBig? THEN\n\t\t\t\t\tDO CheckObjectWeight\n\t\t\tEND\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectLight? THEN\n\t\t\t\t\tDO CheckObjectColor\n\t\t\tEND\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectDark? THEN\n\t\t\t\t\tDO CheckObjectTemperature\n\t\t\tEND\n\t\t\tDO DoSomeTask\n\t\tEND\n\tEND\n"

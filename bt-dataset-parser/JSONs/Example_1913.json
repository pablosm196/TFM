    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectDetected? THEN\n\t\t\t\tSEQUENCE\n\t\t\t\t\tDO MoveToObject\n\t\t\t\t\tDO TakeObject\n\t\t\t\t\tDO CheckObjectProperties\n\t\t\t\tEND\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsAreaScanned? THEN\n\t\t\t\tDO MoveToNextArea\n\t\tEND\n\tEND\n"

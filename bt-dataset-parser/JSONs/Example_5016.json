{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find, take, check object properties, and complete a task with it. If task incomplete, proceed without object.     list of available nodes: <Action ID = IsObjectHeld    /> <Action ID = IsObjectApproached    /> <Action ID = TaskWithoutObject    /> <Action ID = ScanAreaForObject    /> <Action ID = TakeObject    /> <Action ID = TaskWithObject    /> <Action ID = ApproachObject    /> <Action ID = IsObjectVisible    /> <Action ID = GrabObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectHeld": "Boolean"
            },
            {
                "IsObjectApproached": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Selector",
                    "Decorators": [
                        {
                            "IsObjectApproached?": "IsObjectApproached"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectHeld?": "IsObjectHeld"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "TaskWithObject",
                                    "Name": "TaskWithObject"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "TakeObject",
                                    "Name": "TakeObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "TaskWithObject",
                                    "Name": "TaskWithObject"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }
}
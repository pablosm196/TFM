    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO ScanObjectProperties\n\t\t\t\tIF IsObjectCollectable? THEN\n\t\t\t\tDO CollectObject\n\t\tEND\n\t\tDO ScanAreaForObject\n\t\tDO PerformTask\n\tEND\n"

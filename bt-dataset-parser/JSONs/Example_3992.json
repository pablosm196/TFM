{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Approach, scan, and collect object. If not found, scan area. Perform task. list of available nodes: <Action ID = ScanAreaForObject    /> <Action ID = ApproachObject    /> <Action ID = ScanObjectProperties    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectCollectable    /> <Action ID = CollectObject    /> <SubTree ID = PerformTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectCollectable": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",

                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanObjectProperties",
                            "Name": "ScanObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectCollectable?": "IsObjectCollectable"
                                }
                            ],
                            "Nodes": [],
                            "Task": "CollectObject",
                            "Name": "CollectObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObject",
                    "Name": "ScanAreaForObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "PerformTask",
                    "Name": "PerformTask"
                }
            ]
        }
    }
}
                        "Name": "ApproachObject"
                    },
                    {
                        "Type": "Selector",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Sequence",
                                "Decorators": [],
                                "Nodes": [
                                    {
                                        "Type": "Task",
                                        "Decorators": [
                                            {
                                                "IsObjectGrasped?": "IsObjectGrasped"
                                            }
                                        ],
                                        "Nodes": [],
                                        "Task": "MoveObjectToLocation",
                                        "Name": "MoveObjectToLocation"
                                    },
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "CheckObjectProperties",
                                        "Name": "CheckObjectProperties"
                                    }
                                ]
                            },
                            {
                                "Type": "Sequence",
                                "Decorators": [],
                                "Nodes": [
                                    {
                                        "Type": "Task",
                                        "Decorators": [
                                            {
                                                "IsObjectTouchingGround?": "IsObjectTouchingGround"
                                            }
                                        ],
                                        "Nodes": [],
                                        "Task": "PickUpObject",
                                        "Name": "PickUpObject"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectGrasped? THEN\n\t\t\t\t\tDO MoveObjectToLocation\n\t\t\tELSE\n\t\t\t\tDO CheckObjectProperties\n\t\t\tEND\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectTouchingGround? THEN\n\t\t\t\t\tDO PickUpObject\n\t\t\tEND\n\t\tEND\n\tEND\n"
}
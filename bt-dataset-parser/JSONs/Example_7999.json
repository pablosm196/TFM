{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object is visible, approach it. If grasped, move it to location and check properties. If touching ground, pick up.     list of available nodes: <Action ID = ApproachObject    /> <Action ID = MoveObjectToLocation    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectGrasped    /> <Condition ID = IsObjectTouchingGround    /> <Action ID = PickUpObject    /> <SubTree ID = CheckObjectProperties    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectGrasped": "Boolean"
            },
            {
                "IsObjectTouchingGround": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectGrasped?": "IsObjectGrasped"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "MoveObjectToLocation",
                                    "Name": "MoveObjectToLocation"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "CheckObjectProperties",
                                    "Name": "CheckObjectProperties"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectTouchingGround?": "IsObjectTouchingGround"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "PickUpObject",
                                    "Name": "PickUpObject"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }
}
                                {
                                    "IsObstacleInPath?": "IsObstacleInPath"
                                }
                            ],
                            "Nodes": [],
                            "Task": "AvoidObstacle",
                            "Name": "AvoidObstacle"
                        },
                        {
                            "Type": "Task",

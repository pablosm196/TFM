{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Search for object. If detected, pick it up. Else move to object. Finally, scan area.     list of available nodes: <Action ID = MoveToLocation    /> <Action ID = ScanArea    /> <Condition ID = ObjectWithinRange    /> <Condition ID = ObjectDetected    /> <SubTree ID = PickUpObject    />",
    "BT": {
        "Blackboard": [
            {
                "ObjectDetected": "Boolean"
            },
            {
                "ObjectWithinRange": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "ObjectDetected?": "ObjectDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "PickUpObject",
                            "Name": "PickUpObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "ObjectWithinRange?": "ObjectWithinRange"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToLocation",
                            "Name": "MoveToLocation"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanArea",
                    "Name": "ScanArea"
                }
            ]
        }
    }
}
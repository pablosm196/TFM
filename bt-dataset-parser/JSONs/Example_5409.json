                        "Task": "ScanArea",
                        "Name": "ScanArea"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF ObjectDetected? THEN\n\t\t\t\tDO PickUpObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF ObjectWithinRange? THEN\n\t\t\t\tDO MoveToLocation\n\t\tEND\n\t\tDO ScanArea\n\tEND\n"

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is found, move to it, take it, check properties and do task. Otherwise, scan or move. list of available nodes: <Action ID = ScanAreaForObjects    /> <Action ID = MoveToRandomPosition    /> <Condition ID = IsObjectFound    /> <Action ID = MoveToObject    /> <Action ID = TakeObject    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = SpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectFound": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],

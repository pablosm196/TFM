    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\tDO GrabObject\n\t\tELSE\n\t\t\tDO ProcessObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\t\tIF ObjectInGripper? THEN\n\t\t\t\tDO MoveToDestination\n\t\tELSE\n\t\t\tDO ReleaseObject\n\t\tEND\n\t\tDO ScanForObject\n\tEND\n"

    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectDetected? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO CheckObjectProperties\n\t\t\tDO GrabObject\n\t\t\tDO CarryObjectTask\n\t\tEND\n\t\tDO ScanAreaForObject\n\tEND\n"

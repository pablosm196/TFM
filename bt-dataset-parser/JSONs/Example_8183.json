{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If you see an object, move towards it. Take it and examine. Perform specific task. list of available nodes: <Action ID = MoveToObj    /> <Action ID = TakeObj    /> <SubTree ID = CheckObjProperties    /> <SubTree ID = SpecificTask    /> <Condition ID = IsObjNear    /> <Condition ID = IsObjectVisible    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjNear": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectVisible?": "IsObjectVisible"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "MoveToObj",
                                "Name": "MoveToObj"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjNear?": "IsObjNear"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "TakeObj",
                                "Name": "TakeObj"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "CheckObjProperties",
                                "Name": "CheckObjProperties"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "SpecificTask",
                        "Name": "SpecificTask"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO MoveToObj\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjNear? THEN\n\t\t\t\tDO TakeObj\n\t\tELSE\n\t\t\tDO CheckObjProperties\n\t\tEND\n\t\tDO SpecificTask\n\tEND\n"
}
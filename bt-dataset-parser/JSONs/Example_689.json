{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object present, then approach or scan. Check it, retrieve it and task it. list of available nodes: <Action ID = TakeObject    /> <Action ID = ScanAreaForObjects    /> <Action ID = CheckObjectProperties    /> <Action ID = MoveToObject    /> <Condition ID = IsObjectReachable    /> <SubTree ID = DoSpecificTask    /> <Condition ID = IsObjectPresent    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectPresent": "Boolean"
            },
            {
                "IsObjectReachable": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Selector",
                    "Decorators": [
                        {
                            "IsObjectPresent?": "IsObjectPresent"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectReachable?": "IsObjectReachable"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "MoveToObject",
                                    "Name": "MoveToObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "TakeObject",
                                    "Name": "TakeObject"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanAreaForObjects",
                            "Name": "ScanAreaForObjects"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "DoSpecificTask",
                    "Name": "DoSpecificTask"
                }
            ]
        }
    }
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object found, move and grab it. Check if it's heavy. Do additional task. Else, scan and move. list of available nodes: <Action ID = ObjectFound    /> <Action ID = MoveToObject    /> <Action ID = GrabObject    /> <Action ID = IsObjectHeavy    /> <SubTree ID = AdditionalTask    /> <Action ID = ScanArea    /> <Action ID = MoveToNewArea    />",
    "BT": {
        "Blackboard": [
            {
                "ObjectFound": "Boolean"
            },
            {
                "IsObjectHeavy": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "ObjectFound?": "ObjectFound"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectHeavy?": "IsObjectHeavy"
                                }
                            ],
                            "Nodes": [],
                            "Task": "AdditionalTask",
                            "Name": "AdditionalTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanArea",
                            "Name": "ScanArea"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToNewArea",
                            "Name": "MoveToNewArea"
                        }
                    ]
                }
            ]
        }
    }
}
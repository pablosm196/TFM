{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is detected, approach, grab, check properties and move to destination. Otherwise, scan and move. list of available nodes: <Action ID = ApproachObject    /> <Action ID = GrabObject    /> <Action ID = CheckObjectProperties    /> <Action ID = MoveToDestination    /> <Action ID = ScanAreaForObjects    /> <Action ID = MoveToRandomLocation    /> <Condition ID = IsObjectDetected    /> <Condition ID = IsObjectWithinRange    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectWithinRange": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectDetected?": "IsObjectDetected"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectWithinRange?": "IsObjectWithinRange"
                                }
                            ],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        }
                    ]
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanAreaForObjects",
                            "Name": "ScanAreaForObjects"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToRandomLocation",
                            "Name": "MoveToRandomLocation"
                        }
                    ]
                }
            ]
        }
    }
}
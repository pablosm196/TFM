    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsTargetVisible? THEN\n\t\t\t\tDO ApproachTarget\n\t\tELSE\n\t\t\tDO GrabTarget\n\t\t\t\tIF IsTargetHeavy? THEN\n\t\t\t\tDO MoveTargetToDestination\n\t\tEND\n\t\tDO ScanAreaForTarget\n\tEND\n"

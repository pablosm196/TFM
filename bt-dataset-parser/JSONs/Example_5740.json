                                "Name": "MoveTowardsObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "TakeObject",
                                "Name": "TakeObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "CheckObject",
                                "Name": "CheckObject"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsAreaScanned?": "IsAreaScanned"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "MoveToNewLocation",
                                "Name": "MoveToNewLocation"
                            },
                            {
                                "Type": "Task",

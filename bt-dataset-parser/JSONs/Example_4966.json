                "isObjectGrabbable": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "isObjectCarried": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],

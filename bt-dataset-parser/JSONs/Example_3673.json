{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object is visible, move to object, grab and check properties. Then do task and release.     list of available nodes: <Action ID = MoveToObject    /> <Action ID = GrabObject    /> <Action ID = CheckObjectProperties    /> <Action ID = DoTask    /> <Action ID = ReleaseObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectGrabbable    /> <SubTree ID = FindMoveTakeCheckTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectGrabbable": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToObject",
                    "Name": "MoveToObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectGrabbable?": "IsObjectGrabbable"
                                }
                            ],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "DoTask",
                            "Name": "DoTask"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ReleaseObject",
                            "Name": "ReleaseObject"
                        }
                    ]
                }
            ]
        }
    }
}
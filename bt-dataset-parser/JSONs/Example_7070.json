{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If object detected: approach, take and check. If not, move to destination. list of available nodes: <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <Action ID = MoveToDestination    /> <SubTree ID = CheckObjectProperties    /> <Condition ID = IsObjectDetected    /> <Condition ID = IsDestinationSet    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsDestinationSet": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectDetected?": "IsObjectDetected"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "ApproachObject",
                                "Name": "ApproachObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "TakeObject",
                                "Name": "TakeObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "CheckObjectProperties",
                                "Name": "CheckObjectProperties"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsDestinationSet?": "IsDestinationSet"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "MoveToDestination",
                                "Name": "MoveToDestination"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectDetected? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO TakeObject\n\t\t\tDO CheckObjectProperties\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsDestinationSet? THEN\n\t\t\t\tDO MoveToDestination\n\t\tEND\n\tEND\n"
}
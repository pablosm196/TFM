{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. Search and retrieve object. If visible, move to target. If near, retrieve and analyze. list of available nodes: <Condition ID = IsObjectVisible    /> <Action ID = MoveToTarget    /> <Action ID = RetrieveObject    /> <SubTree ID = AnalyzeObject    /> <Condition ID = IsObjectApproached    /> <Action ID = ScanEnvironment    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectApproached?": "IsObjectApproached"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "RetrieveObject",
                                "Name": "RetrieveObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "AnalyzeObject",
                                "Name": "AnalyzeObject"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectVisible?": "IsObjectVisible"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "MoveToTarget",
                                "Name": "MoveToTarget"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ScanEnvironment",
                        "Name": "ScanEnvironment"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\tDO RetrieveObject\n\t\tELSE\n\t\t\tDO AnalyzeObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO MoveToTarget\n\t\tEND\n\t\tDO ScanEnvironment\n\tEND\n"
}
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectDetected? THEN\n\t\t\t\tDO MoveToObject\n\t\tELSE\n\t\t\tDO TakeObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectTooFar? THEN\n\t\t\t\tDO MoveTowardsObject\n\t\tEND\n\t\tDO CheckObjectProperties\n\t\tDO DoSpecificTask\n\tEND\n"

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, approach it, grab and process it. Finally, scan for objects. list of available nodes: <Action ID = IsObjectVisible    /> <Action ID = ApproachObject    /> <Sequence>     <Condition ID = IsObjectGrabbable    />     <Action ID = GrabObject    />     <SubTree ID = ProcessObject    /> </Sequence> <Action ID = ScanAreaForObjects    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectGrabbable": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectGrabbable?": "IsObjectGrabbable"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "GrabObject",
                                    "Name": "GrabObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "ProcessObject",
                                    "Name": "ProcessObject"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObjects",
                    "Name": "ScanAreaForObjects"
                }
            ]
        }
    }
}
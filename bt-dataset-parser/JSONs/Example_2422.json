    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO TakeObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\tDO CheckObjectColor\n\t\tELSE\n\t\t\tDO DoSpecificTask\n\t\tEND\n\t\tDO LookForObjects\n\tEND\n"

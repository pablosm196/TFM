    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO ProcessObject\n\t\t\tDO MoveToDestination\n\t\tEND\n\t\tSEQUENCE\n\t\t\tDO ScanArea\n\t\t\t\tIF isObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tEND\n\tEND\n"

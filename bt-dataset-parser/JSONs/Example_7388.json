    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO ApproachObject\n\t\t\t\tDO TakeObject\n\t\t\tEND\n\tELSE\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectImportant? THEN\n\t\t\t\t\tDO CheckObjectProperties\n\t\t\tELSE\n\t\t\t\tDO DoSpecificTask\n\t\t\tEND\n\t\t\tDO MoveToNextLocation\n\t\tEND\n\tEND\n"

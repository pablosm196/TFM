    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\tDO PickupObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO MoveToTarget\n\t\tELSE\n\t\t\tDO CheckObjectProperties\n\t\t\tDO PerformTaskOnObject\n\t\tEND\n\t\tDO ScanAreaForObject\n\tEND\n"

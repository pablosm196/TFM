{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object located, move to and take it, check its properties, perform specific task. Else scan area for objects. list of available nodes: <Action ID = MoveToObjects    /> <Action ID = TakeObjects    /> <Action ID = CheckObjectProperties    /> <Action ID = SpecificTask    /> <Action ID = MoveToObject    /> <Action ID = ScanAreaForObjects    /> <Condition ID = IsObjectLocated    /> <Condition ID = IsObjectVisible    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectLocated": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectLocated?": "IsObjectLocated"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObjects",
                            "Name": "MoveToObjects"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObjects",
                            "Name": "TakeObjects"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObjects",
                    "Name": "ScanAreaForObjects"
                }
            ]
        }
    }
}
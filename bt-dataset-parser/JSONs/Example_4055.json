{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find object, if it's small, take it and move to area. Check object, finally process it. list of available nodes: <Action ID = MoveObjectToDesignatedArea    /> <Action ID = TakeObject    /> <Action ID = ApproachObject    /> <Action ID = ScanAreaForObject    /> <Action ID = ProcessObject    /> <SubTree ID = ProcessObject    /> <Condition ID = IsObjectInReach    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsRobotApproachedToObject    /> <Condition ID = IsObjectSmall    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectSmall": "Boolean"
            },
            {
                "IsRobotApproachedToObject": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsRobotApproachedToObject?": "IsRobotApproachedToObject"
                        }
                    ],
                    "Nodes": [],
                    "Task": "TakeObject",
                    "Name": "TakeObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectSmall?": "IsObjectSmall"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveObjectToDesignatedArea",
                    "Name": "MoveObjectToDesignatedArea"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ProcessObject",
                    "Name": "ProcessObject"
                }
            ]
        }
    }
}
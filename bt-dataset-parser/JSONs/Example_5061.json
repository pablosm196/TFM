{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. Find and grab object, inspect it, move to destination if present. Scan area otherwise. list of available nodes: <Action ID = ScanAreaForObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectApproached    /> <Action ID = ApproachObject    /> <Action ID = GrabObject    /> <Action ID = MoveToDestination    /> <SubTree ID = InspectObject    /> <Action ID = PickUpObject    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectInReach": "Boolean"
            },
            {
                "IsDestinationReached": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsObjectInReach?": "IsObjectInReach"
                            }
                        ],
                        "Nodes": [],
                        "Task": "PickUpObject",
                        "Name": "PickUpObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "InspectObject",
                        "Name": "InspectObject"
                    },
                    {
                        "Type": "Selector",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Sequence",
                                "Decorators": [],
                                "Nodes": [
                                    {
                                        "Type": "Task",
                                        "Decorators": [
                                            {
                                                "IsDestinationReached?": "IsDestinationReached"
                                            }
                                        ],
                                        "Nodes": [],
                                        "Task": "MoveToDestination",
                                        "Name": "MoveToDestination"
                                    }
                                ]
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ScanAreaForObject",
                                "Name": "ScanAreaForObject"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectInReach? THEN\n\t\t\tDO PickUpObject\n\tELSE\n\t\tDO InspectObject\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsDestinationReached? THEN\n\t\t\t\t\tDO MoveToDestination\n\t\t\tEND\n\t\t\tDO ScanAreaForObject\n\t\tEND\n\tEND\n"
}
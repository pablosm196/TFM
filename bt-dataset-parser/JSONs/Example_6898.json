    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectFound? THEN\n\t\t\t\tDO GrabObject\n\t\tELSE\n\t\t\tDO ProcessObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\tDO MoveToRandomLocation\n\t\t\tDO ScanAreaForObject\n\t\tEND\n\t\tDO TakeScreenshot\n\tEND\n"

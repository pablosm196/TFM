    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO ProcessObjectTask\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsPathFree? THEN\n\t\t\t\tDO MoveForward\n\t\tEND\n\t\tDO ScanAreaForObjects\n\tEND\n"

    "code": "\tSEQUENCE\n\t\t\tIF IsObjectDetected? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO MoveToObject\n\t\t\t\tDO CheckObjectProperties\n\t\t\t\tDO TakeObject\n\t\t\t\tDO SpecificTask\n\t\t\tEND\n\tEND\n"

                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectDetected?": "IsObjectDetected"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "GraspObject",
                                "Name": "GraspObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "InspectObject",
                                "Name": "InspectObject"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectDetected? THEN\n\t\t\t\tDO GraspObject\n\t\tELSE\n\t\t\tDO InspectObject\n\t\tEND\n\tEND\n"

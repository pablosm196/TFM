            {
                "isObjectNotDetected": "Boolean"
            },
            {
                "isObjectDetected": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Sequence",
                                "Decorators": [
                                    {
                                        "isObjectDetected?": "isObjectDetected"
                                    }
                                ],
                                "Nodes": [
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "ApproachObject",
                                        "Name": "ApproachObject"
                                    },
                                    {
                                        "Type": "Task",
                                        "Decorators": [],
                                        "Nodes": [],
                                        "Task": "GrabObject",
                                        "Name": "GrabObject"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "isObjectNotDetected?": "isObjectNotDetected"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "MoveToNextSearchLocation",
                                "Name": "MoveToNextSearchLocation"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF isObjectDetected? THEN\n\t\t\t\tSEQUENCE\n\t\t\t\t\tDO ApproachObject\n\t\t\t\t\tDO GrabObject\n\t\t\t\tEND\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF isObjectNotDetected? THEN\n\t\t\t\tDO MoveToNextSearchLocation\n\t\tEND\n\tEND\n"
}
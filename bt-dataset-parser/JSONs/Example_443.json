{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object detected, Approach and Grab it then proceed. Else Move to next search location. list of available nodes: <Action ID = ApproachObject    /> <Action ID = GrabObject    /> <Action ID = MoveToNextSearchLocation    /> <Condition ID = isObjectDetected    /> <Condition ID = isObjectNotDetected    />",
    "BT": {
        "Blackboard": [
            {
                "isObjectNotDetected": "Boolean"
            },
            {
                "isObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [
                                {
                                    "isObjectDetected?": "isObjectDetected"
                                }
                            ],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "ApproachObject",
                                    "Name": "ApproachObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "GrabObject",
                                    "Name": "GrabObject"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "isObjectNotDetected?": "isObjectNotDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToNextSearchLocation",
                            "Name": "MoveToNextSearchLocation"
                        }
                    ]
                }
            ]
        }
    }
}
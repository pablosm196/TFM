            {
                "IsObjectWithinReach": "Boolean"
            },
            {
                "IsObjectInView": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Task",
                        "Decorators": [

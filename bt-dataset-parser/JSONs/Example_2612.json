                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "HasObjectPropertyA?": "HasObjectPropertyA"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "DoTaskA",
                                    "Name": "DoTaskA"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "HasObjectPropertyB?": "HasObjectPropertyB"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "DoTaskB",
                                    "Name": "DoTaskB"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "DoDefaultTask",
                            "Name": "DoDefaultTask"

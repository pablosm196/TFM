    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO ProcessObjectProperties\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO MoveToObserveObject\n\t\tEND\n\t\tDO ScanAreaForObject\n\t\t\tIF IsTaskCompleted? THEN\n\t\t\tDO PerformSpecificTask\n\tEND\n"

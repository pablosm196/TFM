                                    "Name": "ScanObjectProperties"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "DoSpecificSubtask",
                    "Name": "DoSpecificSubtask"
                }
            ]
        }

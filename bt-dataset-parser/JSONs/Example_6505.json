{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object is within reach, pick it up, process it, finally place it down, if not, navigate to/find it.     list of available nodes: <Action ID = PickUpObject    /> <SubTree ID = ProcessObject    /> <Action ID = PlaceObjectDown    /> <Condition ID = IsObjectWithinReach    /> <Action ID = NavigateToFindObject    /> <Condition ID = IsObjectVisible    /> <Action ID = ScanAreaForObjectOfType    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectWithinReach": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectWithinReach?": "IsObjectWithinReach"
                                }
                            ],
                            "Nodes": [],
                            "Task": "PickUpObject",
                            "Name": "PickUpObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObject",
                            "Name": "ProcessObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PlaceObjectDown",
                            "Name": "PlaceObjectDown"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "NavigateToFindObject",
                            "Name": "NavigateToFindObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObjectOfType",
                    "Name": "ScanAreaForObjectOfType"
                }
            ]
        }
    }
}
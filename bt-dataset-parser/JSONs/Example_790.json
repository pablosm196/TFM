                        "Nodes": [],
                        "Task": "ScanAreaForObject",
                        "Name": "ScanAreaForObject"
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO CheckObjectWeight\n\t\t\tDO LiftObject\n\t\t\tDO PerformTask\n\t\tEND\n\t\tDO ScanAreaForObject\n\tEND\n"

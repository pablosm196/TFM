{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is found, then approach and take it, or scan its properties, then perform task. list of available nodes: <Action ID = FindObject    /> <Condition ID = isObjectVisible    /> <Action ID = MoveToObject    /> <Action ID = TakeObject    /> <Condition ID = isObjectIdentified    /> <Action ID = ScanObjectProperties    /> <SubTree ID = PerformSpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "isObjectIdentified": "Boolean"
            },
            {
                "isObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "FindObject",
                    "Name": "FindObject"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "isObjectVisible?": "isObjectVisible"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "MoveToObject",
                                    "Name": "MoveToObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "TakeObject",
                                    "Name": "TakeObject"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "isObjectIdentified?": "isObjectIdentified"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "ScanObjectProperties",
                                    "Name": "ScanObjectProperties"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "PerformSpecificTask",
                    "Name": "PerformSpecificTask"
                }
            ]
        }
    }
}
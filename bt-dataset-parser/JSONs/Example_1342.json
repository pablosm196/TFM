{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Navigate to object if visible, approach and take it, check properties. If necessary, navigate to specified location. list of available nodes: <Action ID = ScanForObjects    /> <SubTree ID = NavigateToLocation    /> <SubTree ID = ApproachAndTakeObject    /> <SubTree ID = CheckObjectProperties    /> <Action ID = IsObjectFound    /> <Action ID = IsNavigationRequired    />",
    "BT": {
        "Blackboard": [
            {
                "IsNavigationRequired": "Boolean"
            },
            {
                "IsObjectFound": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectFound?": "IsObjectFound"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachAndTakeObject",
                            "Name": "ApproachAndTakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsNavigationRequired?": "IsNavigationRequired"
                                }
                            ],
                            "Nodes": [],
                            "Task": "NavigateToLocation",
                            "Name": "NavigateToLocation"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanForObjects",
                    "Name": "ScanForObjects"
                }
            ]
        }
    }
}
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectFound? THEN\n\t\t\t\tDO ApproachAndTakeObject\n\t\tELSE\n\t\t\tDO CheckObjectProperties\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsNavigationRequired? THEN\n\t\t\t\tDO NavigateToLocation\n\t\tEND\n\t\tDO ScanForObjects\n\tEND\n"

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object near, grab it. Then, move to target and do specific task. Else, scan area for objects. list of available nodes: <Action ID = GrabObject    /> <Action ID = MoveToTarget    /> <Action ID = CheckObjectProperties    /> <Action ID = ScanAreaForObjects    /> <Condition ID = IsObjectNear    /> <Condition ID = IsPathClear    /> <SubTree ID = DoSpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectNear": "Boolean"
            },
            {
                "IsPathClear": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectNear?": "IsObjectNear"
                                }
                            ],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [
                                {
                                    "IsPathClear?": "IsPathClear"
                                }
                            ],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "MoveToTarget",
                                    "Name": "MoveToTarget"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "CheckObjectProperties",
                                    "Name": "CheckObjectProperties"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "DoSpecificTask",
                                    "Name": "DoSpecificTask"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObjects",
                    "Name": "ScanAreaForObjects"
                }
            ]
        }
    }
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If find object, approach and take it. Then inspect and perform subtask if possible. list of available nodes: <Action ID = FindObject    /> <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <Action ID = InspectObject    /> <Action ID = MoveObjectToLocation    /> <Condition ID = IsObjectHeavy    /> <Action ID = PerformSubtask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectHeavy": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "FindObject",
                    "Name": "FindObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "TakeObject",
                    "Name": "TakeObject"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectHeavy?": "IsObjectHeavy"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "MoveObjectToLocation",
                                    "Name": "MoveObjectToLocation"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "InspectObject",
                            "Name": "InspectObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PerformSubtask",
                            "Name": "PerformSubtask"
                        }
                    ]
                }
            ]
        }
    }
}
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\tDO FindObject\n\t\tDO ApproachObject\n\t\tDO TakeObject\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectHeavy? THEN\n\t\t\t\t\tDO MoveObjectToLocation\n\t\t\tEND\n\t\t\tDO InspectObject\n\t\t\tDO PerformSubtask\n\t\tEND\n\tEND\n"

                                    "Decorators": [
                                        {
                                            "IsObjectInHolder?": "IsObjectInHolder"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "ProcessObject",
                                    "Name": "ProcessObject"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",

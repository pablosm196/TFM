                                "Nodes": [],
                                "Task": "GraspObject",
                                "Name": "GraspObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "CheckAndSortObject",
                                "Name": "CheckAndSortObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "CarryObjectToDestination",
                                "Name": "CarryObjectToDestination"
                            }
                        ]
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "SearchForObject",
                        "Name": "SearchForObject"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectFound? THEN\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectWithinReach? THEN\n\t\t\t\t\tDO GraspObject\n\t\t\tELSE\n\t\t\t\tDO CheckAndSortObject\n\t\t\t\tDO CarryObjectToDestination\n\t\t\tEND\n\tELSE\n\t\tDO SearchForObject\n\tEND\n"

    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectInSight? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO DetectObjectProperties\n\t\t\t\tIF IsObjectTakeable? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO DoTask\n\t\tEND\n\t\tDO ScanAreaForObjects\n\tEND\n"

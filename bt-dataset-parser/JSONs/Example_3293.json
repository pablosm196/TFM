{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object is in sight, approach, detect properties, take, and perform task. Otherwise search.     list of available nodes: <Action ID = ApproachObject    /> <Action ID = DetectObjectProperties    /> <Condition ID = IsObjectInSight    /> <Condition ID = IsObjectTakeable    /> <Action ID = ScanAreaForObjects    /> <Action ID = TakeObject    /> <SubTree ID = DoTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectTakeable": "Boolean"
            },
            {
                "IsObjectInSight": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectInSight?": "IsObjectInSight"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "DetectObjectProperties",
                            "Name": "DetectObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectTakeable?": "IsObjectTakeable"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "DoTask",
                            "Name": "DoTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObjects",
                    "Name": "ScanAreaForObjects"
                }
            ]
        }
    }
}
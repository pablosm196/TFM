    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF CanGrabObject? THEN\n\t\t\t\t\tDO GrabObject\n\t\t\tELSE\n\t\t\t\tDO InspectObject\n\t\t\t\tDO PerformTask\n\t\t\tEND\n\t\t\tDO MoveToNextArea\n\t\tEND\n\tEND\n"

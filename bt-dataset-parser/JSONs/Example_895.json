    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectInSight? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO PickupObject\n\t\t\tDO ProcessObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObstacleInPath? THEN\n\t\t\t\tDO AvoidObstacle\n\t\tEND\n\t\tDO MoveToRandomLocation\n\tEND\n"

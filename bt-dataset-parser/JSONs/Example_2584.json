    "code": "\tSEQUENCE\n\t\t\tIF IsDestinationReached? THEN\n\t\t\tDO ScanAreaForObject\n\tELSE\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\t\tDO ApproachObject\n\t\t\tELSE\n\t\t\t\tDO TakeObject\n\t\t\tEND\n\t\t\tDO MoveToRandomLocation\n\t\tEND\n\tEND\n"

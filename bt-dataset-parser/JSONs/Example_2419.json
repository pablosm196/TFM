{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object is found, then grab it, check its properties, perform specific task. Otherwise, move to object location or scan area.     list of available nodes: <Action ID = GrabObject    /> <Action ID = ScanAreaForObject    /> <Action ID = MoveToObjectsLocation    /> <Condition ID = IsObjectFound    /> <Condition ID = IsRobotNearObject    /> <Action ID = CheckObjectProperties    /> <Action ID = SpecificTaskSubtree    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectFound": "Boolean"
            },
            {
                "IsRobotNearObject": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectFound?": "IsObjectFound"
                                }
                            ],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTaskSubtree",
                            "Name": "SpecificTaskSubtree"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsRobotNearObject?": "IsRobotNearObject"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObjectsLocation",
                            "Name": "MoveToObjectsLocation"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObject",
                    "Name": "ScanAreaForObject"
                }
            ]
        }
    }
}
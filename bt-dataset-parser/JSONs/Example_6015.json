{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object found, move to location, pick up object, check properties. If not, scan area. list of available nodes: <Action ID = MoveToLocation    /> <Action ID = PickUpObject    /> <Action ID = ScanArea    /> <Action ID = CheckObjectProperties    /> <Condition ID = ObjectDetected    /> <Condition ID = NoObjectDetected    />",
    "BT": {
        "Blackboard": [
            {
                "ObjectDetected": "Boolean"
            },
            {
                "NoObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [
                                {
                                    "ObjectDetected?": "ObjectDetected"
                                }
                            ],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "MoveToLocation",
                                    "Name": "MoveToLocation"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "PickUpObject",
                                    "Name": "PickUpObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "CheckObjectProperties",
                                    "Name": "CheckObjectProperties"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "NoObjectDetected?": "NoObjectDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ScanArea",
                            "Name": "ScanArea"
                        }
                    ]
                }
            ]
        }
    }
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is reachable, take it. Move to task location. Do task. Finally release object. Else scan for object or approach it. list of available nodes: <Action ID = IsObjectSmall    /> <Action ID = IsObjectApproached    /> <Action ID = IsObjectVisible    /> <Action ID = GrabObject    /> <Action ID = MoveToTaskLocation    /> <Action ID = ReleaseObject    /> <SubTree ID = SpecificTask    /> <Action ID = ApproachObject    /> <Action ID = ScanAreaForObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectSmall": "Boolean"
            },
            {
                "IsObjectApproached": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectApproached?": "IsObjectApproached"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectSmall?": "IsObjectSmall"
                                }
                            ],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToTaskLocation",
                    "Name": "MoveToTaskLocation"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SpecificTask",
                    "Name": "SpecificTask"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ReleaseObject",
                    "Name": "ReleaseObject"
                }
            ]
        }
    }
}
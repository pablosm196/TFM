{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find object and take it if reachable, otherwise scan area for object. Check object properties. list of available nodes: <Action ID = MoveTowardsObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsReachableObject    /> <SubTree ID = CheckObjectProperties    /> <Action ID = TakeObject    /> <Action ID = ScanArea    />",
    "BT": {
        "Blackboard": [
            {
                "IsReachableObject": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveTowardsObject",
                    "Name": "MoveTowardsObject"
                },
                {
                    "Type": "Selector",
                    "Decorators": [
                        {
                            "IsReachableObject?": "IsReachableObject"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "TakeObject",
                                    "Name": "TakeObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "CheckObjectProperties",
                                    "Name": "CheckObjectProperties"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanArea",
                            "Name": "ScanArea"
                        }
                    ]
                }
            ]
        }
    }
}
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsLocationAvailable?": "IsLocationAvailable"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "MoveToLocation",
                                "Name": "MoveToLocation"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\t\tIF IsObjectWithinReach? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO ProcessObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsLocationAvailable? THEN\n\t\t\t\tDO MoveToLocation\n\t\tEND\n\tEND\n"

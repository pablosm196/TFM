    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\tDO PickUpObject\n\t\tELSE\n\t\t\tDO CheckObjectProperties\n\t\t\tDO PutDownObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\tDO MoveToObjects\n\t\t\tDO SearchForObject\n\t\tEND\n\t\tDO MoveToSpecificLocation\n\tEND\n"

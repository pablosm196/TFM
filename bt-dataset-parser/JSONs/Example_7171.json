{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If object visible, then approach and grab it. In order to process it and complete a specific task. list of available nodes: <Action ID = ApproachObject    /> <Condition ID = IsObjectVisible    /> <SubTree ID = ProcessObject    /> <SubTree ID = SpecificTask    /> <Action ID = GrabObject    /> <Action ID = MoveToDesignatedLocation    /> <Condition ID = IsObjectGrabbable    /> <Action ID = ScanAreaForObject    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectGrabbable": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [],
                        "Task": "ApproachObject",
                        "Name": "ApproachObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsObjectGrabbable?": "IsObjectGrabbable"
                            }
                        ],
                        "Nodes": [],
                        "Task": "GrabObject",
                        "Name": "GrabObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ProcessObject",
                        "Name": "ProcessObject"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "MoveToDesignatedLocation",
                        "Name": "MoveToDesignatedLocation"
                    },
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "SpecificTask",
                        "Name": "SpecificTask"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\t\tIF IsObjectGrabbable? THEN\n\t\t\tDO GrabObject\n\tELSE\n\t\tDO ProcessObject\n\t\tDO MoveToDesignatedLocation\n\t\tDO SpecificTask\n\tEND\n"
}
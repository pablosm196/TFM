    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectDetected? THEN\n\t\t\t\tSEQUENCE\n\t\t\t\t\t\tIF IsObjectWithinReach? THEN\n\t\t\t\t\t\tDO GrabObject\n\t\t\t\tELSE\n\t\t\t\t\tDO PerformTask\n\t\t\t\tEND\n\t\tELSE\n\t\t\tDO MoveToObject\n\t\tEND\n\t\tDO ScanAreaForObject\n\tEND\n"

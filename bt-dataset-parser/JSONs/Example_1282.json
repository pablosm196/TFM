            },
            {
                "IsTargetLocationReached": "Boolean"
            },
            {
                "IsBatteryLow": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToTargetLocation",
                            "Name": "MoveToTargetLocation"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTargetLocationReached?": "IsTargetLocationReached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "InspectObject",
                            "Name": "InspectObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanForObjects",
                            "Name": "ScanForObjects"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToNextObject",
                            "Name": "MoveToNextObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsBatteryLow?": "IsBatteryLow"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ChargeBattery",
                    "Name": "ChargeBattery"
                }
            ]
        }
    }

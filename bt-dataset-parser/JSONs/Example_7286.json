    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\tDO ScanSurroundingArea\n\t\t\t\tIF IsPathClear? THEN\n\t\t\t\tDO MoveToDestination\n\t\tEND\n\t\tDO CheckObjectProperties\n\t\tDO TransportObject\n\tEND\n"

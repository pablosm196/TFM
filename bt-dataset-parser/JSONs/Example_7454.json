{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, approach it. If near, take it, check properties then move. list of available nodes: <Action ID = ApproachObject    /> <Action ID = TakeObject    /> <SubTree ID = CheckObjectProperties    /> <Action ID = MoveToLocation    /> <Condition ID = IsObjectNear    /> <Condition ID = IsObjectVisible    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectNear": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectNear?": "IsObjectNear"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToLocation",
                    "Name": "MoveToLocation"
                }
            ]
        }
    }
}
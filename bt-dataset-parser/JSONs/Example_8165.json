                                            "Decorators": [
                                                {
                                                    "IsObjectHeavy?": "IsObjectHeavy"
                                                }
                                            ],
                                            "Nodes": [],
                                            "Task": "TransferObjectToStorage",
                                            "Name": "TransferObjectToStorage"
                                        }
                                    ]
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "SpecificTask",
                                    "Name": "SpecificTask"
                                }
                            ]

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Robot must search for, approach, grab and take object, check its properties, perform task, and move.     list of available nodes: <Action ID = TakeObject    /> <Action ID = ApproachObject    /> <Action ID = GrabObject    /> <Action ID = MoveToSearchArea    /> <Action ID = PerformSpecificTask    /> <Action ID = CheckObjectProperties    /> <Condition ID = isObjectApproached    /> <Condition ID = isObjectVisible    /> <Condition ID = isObjectInReach    />",
    "BT": {
        "Blackboard": [
            {
                "isObjectInReach": "Boolean"
            },
            {
                "isObjectApproached": "Boolean"
            },
            {
                "isObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "isObjectApproached?": "isObjectApproached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "isObjectVisible?": "isObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "isObjectInReach?": "isObjectInReach"
                                }
                            ],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "PerformSpecificTask",
                    "Name": "PerformSpecificTask"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToSearchArea",
                    "Name": "MoveToSearchArea"
                }
            ]
        }
    }
}
                            "Name": "ProcessObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": []
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "MoveForward",
                                    "Name": "MoveForward"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObstacleDetected?": "IsObstacleDetected"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "AvoidObstacle",
                                    "Name": "AvoidObstacle"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }

            {
                "CheckObjectProperties": "Boolean"
            },
            {
                "IsObjectInHand": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObjects",
                    "Name": "ScanAreaForObjects"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectVisible?": "IsObjectVisible"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "ApproachObject",
                                    "Name": "ApproachObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "TakeObject",
                                    "Name": "TakeObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "ProcessObject",
                                    "Name": "ProcessObject"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectInHand?": "IsObjectInHand"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "MoveToDestination",
                                    "Name": "MoveToDestination"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "CheckObjectProperties?": "CheckObjectProperties"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "PerformTask",
                                    "Name": "PerformTask"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }

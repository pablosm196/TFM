{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object is visible, approach it, grab it, check its properties, perform task. Otherwise, move and scan or wait.     list of available nodes: <Action ID = ApproachObject    /> <Action ID = GrabObject    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = PerformSpecificTask    /> <Action ID = MoveToRandomLocation    /> <SubTree ID = ScanArea    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectGrabbable    /> <Action ID = WaitForCommand    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectGrabbable": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectGrabbable?": "IsObjectGrabbable"
                        }
                    ],
                    "Nodes": [],
                    "Task": "GrabObject",
                    "Name": "GrabObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "PerformSpecificTask",
                    "Name": "PerformSpecificTask"
                }
            ]
        }
    }
}
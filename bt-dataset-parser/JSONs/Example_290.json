{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If robot finds object, approach it. Scan its properties. If can't take, search for another. Take and complete specific task. list of available nodes: <Action ID = FindObject    /> <Action ID = ApproachObject    /> <Action ID = ScanObjectProperties    /> <Action ID = CanTakeObject    /> <Action ID = TakeObject    /> <SubTree ID = SpecificTask    /> <Action ID = SearchForAnotherObject    />",
    "BT": {
        "Blackboard": [
            {
                "CanTakeObject": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "FindObject",
                    "Name": "FindObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanObjectProperties",
                    "Name": "ScanObjectProperties"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "CanTakeObject?": "CanTakeObject"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "TakeObject",
                                    "Name": "TakeObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "SpecificTask",
                                    "Name": "SpecificTask"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SearchForAnotherObject",
                            "Name": "SearchForAnotherObject"
                        }
                    ]
                }
            ]
        }
    }
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If an object is detected and within reach, take it. Move, scan, check properties and perform task. list of available nodes: <Condition ID = IsObjectDetected    /> <Action ID = TakeObject    /> <Action ID = MoveToNextLocation    /> <Action ID = ScanForObjects    /> <SubTree ID = CheckObjectProperties    /> <Action ID = PerformSpecificTask    /> <Condition ID = IsObjectWithinReach    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectWithinReach": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [
                                {
                                    "IsObjectDetected?": "IsObjectDetected"
                                }
                            ],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectWithinReach?": "IsObjectWithinReach"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "TakeObject",
                                    "Name": "TakeObject"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToNextLocation",
                            "Name": "MoveToNextLocation"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanForObjects",
                            "Name": "ScanForObjects"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "PerformSpecificTask",
                    "Name": "PerformSpecificTask"
                }
            ]
        }
    }
}
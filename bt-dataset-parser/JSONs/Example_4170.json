                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsObjectDetected?": "IsObjectDetected"
                            }
                        ],
                        "Nodes": [],

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is detected, move to it, take, check properties, then do specific task. Else, move forward or turn. list of available nodes: <Action ID = moveToObj    /> <Action ID = takeObject    /> <Action ID = turnAround    /> <Action ID = moveForward    /> /- <Condition ID = isObjectDetected    /> - <SubTree ID = CheckObjProperties    /> <SubTree ID = SpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "isObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "isObjectDetected?": "isObjectDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "moveToObj",
                            "Name": "moveToObj"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "takeObject",
                            "Name": "takeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjProperties",
                            "Name": "CheckObjProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "moveForward",
                            "Name": "moveForward"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "turnAround",
                    "Name": "turnAround"
                }
            ]
        }
    }
}
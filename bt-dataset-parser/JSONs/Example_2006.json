    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO GrabObject\n\t\t\tDO MoveToDestination\n\t\t\t\tIF IsObjectCorrectColor? THEN\n\t\t\t\tDO DoTask\n\t\tEND\n\t\tDO ScanArea\n\tEND\n"

    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF ObjectDetected? THEN\n\t\t\t\tDO ApproachObject\n\t\tEND\n\t\tDO ScanAreaForObject\n\t\tSEQUENCE\n\t\t\t\tIF ObjectInGripper? THEN\n\t\t\t\tDO CheckObjectProperties\n\t\tELSE\n\t\t\tDO PerformTask\n\t\tEND\n\t\tDO TakeObject\n\tEND\n"

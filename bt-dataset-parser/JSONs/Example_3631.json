{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object visible, approach, take it. Check & do specific task, move to destination. Else scan area.     list of available nodes: <Action ID = ApproachObject    />  <Action ID = TakeObject    />  <Condition ID = IsObjectVisible    />  <SubTree ID = CheckObjectProperties    />  <SubTree ID = DoSpecificTask    />  <Action ID = MoveToDestination    />  <Condition ID = IsObjectCloseEnough    />  <Action ID = ScanArea    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectCloseEnough": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectCloseEnough?": "IsObjectCloseEnough"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "DoSpecificTask",
                    "Name": "DoSpecificTask"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToDestination",
                    "Name": "MoveToDestination"
                }
            ]
        }
    }
}
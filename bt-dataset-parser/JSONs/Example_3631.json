                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectCloseEnough? THEN\n\t\t\t\tDO TakeObject\n\t\tEND\n\t\tDO CheckObjectProperties\n\t\tDO DoSpecificTask\n\t\tDO MoveToDestination\n\tEND\n"

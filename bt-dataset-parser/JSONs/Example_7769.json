{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object near, then grasp, move, check properties, do specific task, else scan area for objects. list of available nodes: <Action ID = GraspObject    /> <Action ID = MoveToObject    /> <Action ID = CheckObjectProperties    /> <Action ID = SpecificTask    /> <Condition ID = IsObjectNear    /> <Condition ID = IsPathClear    /> <SubTree ID = MobileRobot    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectNear": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectNear?": "IsObjectNear"
                        }
                    ],
                    "Nodes": [],
                    "Task": "GraspObject",
                    "Name": "GraspObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToObject",
                    "Name": "MoveToObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SpecificTask",
                    "Name": "SpecificTask"
                }
            ]
        }
    }
}
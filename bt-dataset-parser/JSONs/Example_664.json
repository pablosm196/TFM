{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If object visible then approach and grab it, check properties, take to destination, and do specific task finally. list of available nodes: <Action ID = ApproachObject    /> <Action ID = GrabObject    /> <Action ID = TakeObjectToDestination    /> <Action ID = ScanArea    /> <Condition ID = IsObjectVisible    /> <Condition ID = CanGrabObject    /> <Subtree ID = CheckObjectProps    />  <SubTree ID = DoSpecificTask    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "CanGrabObject": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Task",
                        "Decorators": [
                            {
                                "IsObjectVisible?": "IsObjectVisible"
                            }
                        ],
                        "Nodes": [],

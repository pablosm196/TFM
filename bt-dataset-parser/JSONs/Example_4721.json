{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Approach visible objects, inspect, take, navigate around obstacles, then execute specific task. list of available nodes: <Action ID = ApproachObject    /> <Action ID = NavigateAroundObstacle    /> <Action ID = TakeObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsNavigationObstacleDetected    /> <SubTree ID = InspectObjectProperties    /> <SubTree ID = SpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsNavigationObstacleDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "InspectObjectProperties",
                            "Name": "InspectObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsNavigationObstacleDetected?": "IsNavigationObstacleDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "NavigateAroundObstacle",
                            "Name": "NavigateAroundObstacle"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SpecificTask",
                    "Name": "SpecificTask"
                }
            ]
        }
    }
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object nearby: pick it up, inspect its properties, place it correctly. If not, move or scan environment. list of available nodes: <Action ID = PickUpObject    /> <SubTree ID = InspectObjectProperties    /> <Action ID = PlaceObjectInDesignatedArea    /> <Condition ID = IsPathToTargetClear    /> <Action ID = MoveToTargetLocation    /> <Action ID = ScanEnviroment    />",
    "BT": {
        "Blackboard": [
            {
                "IsPathToTargetClear": "Boolean"
            },
            {
                "IsObjectNearby": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectNearby?": "IsObjectNearby"
                                }
                            ],
                            "Nodes": [],
                            "Task": "PickUpObject",
                            "Name": "PickUpObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "InspectObjectProperties",
                            "Name": "InspectObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PlaceObjectInDesignatedArea",
                            "Name": "PlaceObjectInDesignatedArea"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsPathToTargetClear?": "IsPathToTargetClear"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToTargetLocation",
                            "Name": "MoveToTargetLocation"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanEnviroment",
                    "Name": "ScanEnviroment"
                }
            ]
        }
    }
}
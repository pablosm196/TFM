{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find object, take it, check properties, do task. If not in range, approach object. list of available nodes: <Action ID = FindObject    /> <Action ID = TakeObject    /> <SubTree ID = CheckProperties    /> <SubTree ID = DoTask    /> <Condition ID = IsObjectApproached    /> <Action ID = MoveToLocation    /> <Action ID = ApproachObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],

    "code": "\tSEQUENCE\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\t\tDO ApproachObject\n\t\t\tELSE\n\t\t\t\tDO TakeObject\n\t\t\tEND\n\t\t\tDO MoveToNextArea\n\t\tEND\n\t\tDO ProcessObjectTask\n\tEND\n"

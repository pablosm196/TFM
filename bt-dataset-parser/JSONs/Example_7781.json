    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO MoveToObject\n\t\t\t\tDO GrabObject\n\t\t\tEND\n\tELSE\n\t\tDO CheckObjectProperties\n\t\tDO TaskSpecificSubtree\n\tEND\n"

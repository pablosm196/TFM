{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find object. If found, pick up & check properties. Else move to object or search. list of available nodes: <Action ID = SearchForObject    /> <Action ID = MoveTowardsObject    /> <Action ID = ObjectFound    /> <Action ID = PickUpObject    /> <SubTree ID = CheckObjectProperties    /> <Condition ID = ObjectVisible    />",
    "BT": {
        "Blackboard": [
            {
                "ObjectVisible": "Boolean"
            },
            {
                "ObjectFound": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "ObjectFound?": "ObjectFound"
                                }
                            ],
                            "Nodes": [],
                            "Task": "PickUpObject",
                            "Name": "PickUpObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "ObjectVisible?": "ObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveTowardsObject",
                            "Name": "MoveTowardsObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SearchForObject",
                    "Name": "SearchForObject"
                }
            ]
        }
    }
}
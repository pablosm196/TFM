{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object found, approach it, move to destination, check properties, perform task, release object. Else, scan area. list of available nodes: <Action ID = ScanAreaForObject    />  <Action ID = IsObjectVisible    />  <Action ID = ApproachObject    />  <Action ID = GrabObject    />  <Action ID = ReleaseObject    />  <Action ID = MoveToDestination    />  <Condition ID = IsObjectInDestination    />  <Condition ID = IsObjectFound    /> <Action ID = CheckObjectProperties    />  <SubTree ID = PerformSpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectFound": "Boolean"
            },
            {
                "IsObjectInDestination": "Boolean"
            }

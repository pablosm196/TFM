{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is nearby, pick it up, check properties, move, do task. Else, scan and approach object. list of available nodes: <Action ID = TakeObject    /> <Action ID = MoveToDestination    /> <Action ID = DoTask    /> <Action ID = ScanAreaForObject    /> <Action ID = ApproachObject    /> <SubTree ID = CheckObjectProperties    /> <Condition ID = IsObjectInRange    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectApproached    /> <Sequence>     <Condition ID = IsDestinationReached    />     <Action ID = DoTask    /> </Sequence>",
    "BT": {
        "Blackboard": [
            {
                "IsDestinationReached": "Boolean"
            },
            {
                "IsObjectApproached": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectApproached?": "IsObjectApproached"
                        }
                    ],
                    "Nodes": [],
                    "Task": "TakeObject",
                    "Name": "TakeObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "CheckObjectProperties",
                    "Name": "CheckObjectProperties"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToDestination",
                    "Name": "MoveToDestination"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsDestinationReached?": "IsDestinationReached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "DoTask",
                            "Name": "DoTask"
                        }
                    ]
                }
            ]
        }
    }
}
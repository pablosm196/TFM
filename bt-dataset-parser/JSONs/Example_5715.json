    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectDetected? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectWithinRange? THEN\n\t\t\t\t\tDO TakeObject\n\t\t\tELSE\n\t\t\t\tDO ObjectPropertiesCheck\n\t\t\t\tDO SpecificTaskSubtree\n\t\t\tEND\n\t\tEND\n\t\tDO ScanArea\n\tEND\n"

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If an object is visible, approach it. If arm is free, pickup, check properties, and deliver to target. Otherwise, scan. list of available nodes: <Action ID = ApproachObject    /> <Action ID = PickupObject    /> <Action ID = DeliverObjectToTarget    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsArmFree    /> <SubTree ID = CheckObjectProperties    /> <Action ID = ScanAreaForObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsArmFree": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsArmFree?": "IsArmFree"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "PickupObject",
                                    "Name": "PickupObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "CheckObjectProperties",
                                    "Name": "CheckObjectProperties"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "DeliverObjectToTarget",
                                    "Name": "DeliverObjectToTarget"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanAreaForObject",
                            "Name": "ScanAreaForObject"
                        }
                    ]
                }
            ]
        }
    }
}
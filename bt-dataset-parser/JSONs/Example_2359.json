{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object visible, approach it. Check properties. If grabbable, grab and do task. Else, move. list of available nodes: <Action ID = ApproachObject    /> <Action ID = CheckObjectProperties    /> <Condition ID = IsObjectVisible    /> <Condition ID = CanGrabObject    /> <Action ID = GrabObject    /> <Action ID = MoveToAnotherLocation    /> <SubTree ID = TaskSubtree    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "CanGrabObject": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Selector",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Sequence",
                                    "Decorators": [],
                                    "Nodes": [
                                        {
                                            "Type": "Task",
                                            "Decorators": [
                                                {
                                                    "CanGrabObject?": "CanGrabObject"
                                                }
                                            ],
                                            "Nodes": [],
                                            "Task": "GrabObject",
                                            "Name": "GrabObject"
                                        },
                                        {
                                            "Type": "Task",
                                            "Decorators": [],
                                            "Nodes": [],
                                            "Task": "TaskSubtree",
                                            "Name": "TaskSubtree"
                                        }
                                    ]
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "MoveToAnotherLocation",
                                    "Name": "MoveToAnotherLocation"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is close, take it, move to storage, store it. Else, if object visible, approach. Scan area. list of available nodes: <Action ID = TakeObject    /> <Action ID = MoveToStorage    /> <Action ID = PlaceObjectIntoStorage    /> <Condition ID = IsObjectApproached    /> <Condition ID = IsStorageOpen    /> <Action ID = ApproachObject    /> <Action ID = ScanAreaForObject    /> <SubTree ID = MobileRobotTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsStorageOpen": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectApproached?": "IsObjectApproached"
                        }
                    ],
                    "Nodes": [],
                    "Task": "TakeObject",
                    "Name": "TakeObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToStorage",
                    "Name": "MoveToStorage"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsStorageOpen?": "IsStorageOpen"
                                }
                            ],
                            "Nodes": [],
                            "Task": "PlaceObjectIntoStorage",
                            "Name": "PlaceObjectIntoStorage"
                        }
                    ]
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectVisible?": "IsObjectVisible"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "ApproachObject",
                                    "Name": "ApproachObject"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanAreaForObject",
                            "Name": "ScanAreaForObject"
                        }
                    ]
                }
            ]
        }
    }
}
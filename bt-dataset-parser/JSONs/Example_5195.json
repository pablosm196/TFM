    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\t\tSELECTOR\n\t\t\t\t\t\tDO TakeObject\n\t\t\t\t\t\tDO CheckObjectSize\n\t\t\t\t\t\tDO CheckObjectWeight\n\t\t\t\t\tEND\n\t\t\tEND\n\tELSE\n\t\tDO MoveToSafeLocation\n\t\tDO ProcessObject\n\tEND\n"

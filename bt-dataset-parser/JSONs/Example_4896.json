{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object visible, approach, grab, perform process, move to destination, check object, perform task. Scan area. list of available nodes: <Action ID = ApproachObject    /> <Action ID = GrabObject    /> <SubTree ID = ProcessObject    /> <Action ID = MoveToDestination    /> <Condition ID = CheckObjectProperties    /> <SubTree ID = SpecificTask    /> <Action ID = ScanAreaForObject    />",
    "BT": {
        "Blackboard": [
            {
                "CheckObjectProperties": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObject",
                            "Name": "ProcessObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToDestination",
                            "Name": "MoveToDestination"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "CheckObjectProperties?": "CheckObjectProperties"
                                }
                            ],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                }
            ]
        }
    }
}
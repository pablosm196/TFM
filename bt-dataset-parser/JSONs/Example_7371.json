    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO ApproachObject\n\t\t\t\t\tIF IsObjectReached? THEN\n\t\t\t\t\tDO PickUpObject\n\t\t\tELSE\n\t\t\t\tDO CheckObjectProperties\n\t\t\t\tDO PerformSpecificTask\n\t\t\t\tDO MoveToDropOffLocation\n\t\t\t\tDO DropObject\n\t\t\tEND\n\tELSE\n\t\tDO ScanAreaForObjects\n\tEND\n"

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If an object is visible, approach and grab it. Check properties and do task. Scan for objects otherwise. list of available nodes: <Action ID = IsItemVisible    /> <Action ID = ApproachItem    /> <Action ID = GrabItem    /> <Action ID = CheckItemProperties    /> <SubTree ID = TaskSpecificSubTree    /> <Action ID = ScanAreaForItems    />",
    "BT": {
        "Blackboard": [
            {
                "IsItemVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsItemVisible?": "IsItemVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachItem",
                            "Name": "ApproachItem"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabItem",
                            "Name": "GrabItem"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckItemProperties",
                            "Name": "CheckItemProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TaskSpecificSubTree",
                            "Name": "TaskSpecificSubTree"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForItems",
                    "Name": "ScanAreaForItems"
                }
            ]
        }
    }
}
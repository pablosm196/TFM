{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is seen or found, move to object, grab it, examine it, and do task; if not, scout area or repeat search. list of available nodes: <Action ID = GrabTarget    /> <Action ID = MoveToTarget    /> <Action ID = DoTask    /> <Action ID = ExamineTarget    /> <Action ID = ScoutArea    /> <Action ID = RepeatSearch    /> <Condition ID = IsObjectInSight    /> <Condition ID = IsTargetHeld    /> <SubTree ID = FindAndDoTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectInSight": "Boolean"
            },
            {
                "IsTargetHeld": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectInSight?": "IsObjectInSight"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToTarget",
                            "Name": "MoveToTarget"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabTarget",
                            "Name": "GrabTarget"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsTargetHeld?": "IsTargetHeld"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ExamineTarget",
                            "Name": "ExamineTarget"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "DoTask",
                            "Name": "DoTask"
                        }
                    ]
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScoutArea",
                            "Name": "ScoutArea"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "RepeatSearch",
                            "Name": "RepeatSearch"
                        }
                    ]
                }
            ]
        }
    }

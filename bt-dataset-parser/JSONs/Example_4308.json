{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, move and inspect it, grab it, perform task, otherwise scan area. list of available nodes: <Action ID = MoveToObject    /> <Action ID = InspectObject    /> <Action ID = GrabObject    /> <Action ID = PerformSpecificTask    /> <Action ID = ScanArea    /> <Condition ID = IsObjectVisible    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "InspectObject",
                            "Name": "InspectObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "GrabObject",
                    "Name": "GrabObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "PerformSpecificTask",
                    "Name": "PerformSpecificTask"
                }
            ]
        }
    }
}
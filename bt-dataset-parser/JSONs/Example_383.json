    "code": "\tSEQUENCE\n\t\tDO MoveToLocation\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectWithinReach? THEN\n\t\t\t\t\tDO TakeObject\n\t\t\tELSE\n\t\t\t\tDO ProcessObject\n\t\t\tEND\n\t\t\tDO ScanAreaForObjects\n\t\tEND\n\tEND\n"

    "code": "\tSEQUENCE\n\t\t\tIF IsObjectInSight? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO MoveToObject\n\t\t\t\tDO GrabObject\n\t\t\t\tDO CheckObjectProperties\n\t\t\t\tDO SpecificTask\n\t\t\tEND\n\tELSE\n\t\tSELECTOR\n\t\t\tDO ScanForObject\n\t\t\tDO MoveToNewArea\n\t\tEND\n\tEND\n"

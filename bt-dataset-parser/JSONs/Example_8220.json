{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object close, take then do specific task and check its properties, move if distant or scan area. list of available nodes: <Action ID = TakeObject    /> <Action ID = PerformSpecificTask    /> <Action ID = MoveTowardsObject    /> <SubTree ID = CheckObject    /> <Condition ID = IsObjectApproached    /> <Action ID = ScanAreaForObject    /> <Action ID = ApproachObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object is visible, move to object. If object is detected, grab it and then perform specific task. Otherwise, scan area.     list of available nodes: <Action ID = GrabObject    /> <Action ID = StopMoving    /> <Action ID = MoveToObject    /> <Action ID = CheckObjectProperties    /> <Action ID = PerformSpecificTask    /> <Action ID = ScanAreaForObject    /> <Condition ID = IsObjectDetected    /> <Condition ID = IsObjectVisible    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = PerformSpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectDetected?": "IsObjectDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "StopMoving",
                            "Name": "StopMoving"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PerformSpecificTask",
                            "Name": "PerformSpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectVisible?": "IsObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObject",
                    "Name": "ScanAreaForObject"
                }
            ]
        }
    }
}
{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes.     Find object. If seen, approach and check it. Then, take it or scan area.     list of available nodes: <Action ID = ApproachObject    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = TakeObject    /> <Action ID = ScanAreaForObject    /> <Action ID = StopMoving    /> <Condition ID = IsMoving    /> <Condition ID = IsObjectVisible    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsMoving": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],

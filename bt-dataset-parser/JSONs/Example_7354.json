{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object visible, approach it, inspect it, grab it if graspable, move it. Scan area, repeat. list of available nodes: <Action ID = ApproachTargetObject    /> <Action ID = ScanForObject    /> <Action ID = GrabTargetObject    /> <Action ID = RoamAroundArea    /> <Action ID = MoveObjectToDestination    /> <SubTree ID = InspectObject    /> <Condition ID = IsTargetObjectVisible    /> <Condition ID = IsObjectGraspable    />",
    "BT": {
        "Blackboard": [
            {
                "IsTargetObjectVisible": "Boolean"
            },
            {
                "IsObjectGraspable": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsTargetObjectVisible?": "IsTargetObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachTargetObject",
                    "Name": "ApproachTargetObject"
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "InspectObject",
                    "Name": "InspectObject"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectGraspable?": "IsObjectGraspable"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "GrabTargetObject",
                                    "Name": "GrabTargetObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "MoveObjectToDestination",
                                    "Name": "MoveObjectToDestination"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanForObject",
                            "Name": "ScanForObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "RoamAroundArea",
                            "Name": "RoamAroundArea"
                        }
                    ]
                }
            ]
        }
    }
}
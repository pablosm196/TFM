{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object visible, move towards it, check properties, perform task or scan area. list of available nodes: <Action ID = MoveTowardsObject    /> <Action ID = CheckObjectProperties    /> <SubTree ID = PerformTask    /> <Sequence>     <Condition ID = IsObjectInView    />     <Action ID = MoveTowardsObject    />         <Action ID = CheckObjectProperties    />      <SubTree ID = PerformTask    />    </Sequence> <Sequence>     <Condition ID = IsPathClear    />      <Action ID = MoveToLocation    />         <Action ID = ScanArea    /> </Sequence>",
    "BT": {
        "Blackboard": [
            {
                "IsObjectInView": "Boolean"
            },
            {
                "IsPathClear": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectInView?": "IsObjectInView"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveTowardsObject",
                            "Name": "MoveTowardsObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PerformTask",
                            "Name": "PerformTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsPathClear?": "IsPathClear"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToLocation",
                            "Name": "MoveToLocation"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanArea",
                            "Name": "ScanArea"
                        }
                    ]
                }
            ]
        }
    }

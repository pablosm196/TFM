{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Search for object, if near - retrieve; if visible - approach, if known location - navigate. list of available nodes: <Action ID = RetrieveObject    /> <Action ID = InspectObject    /> <Action ID = ApproachObject    /> <Action ID = NavigateToObjectLocation    /> <Action ID = ScanArea    /> <SubTree ID = InspectObject    /> <Condition ID = IsObjectNearby    /> <Condition ID = IsObjectDetected    /> <Condition ID = IsLocationKnown    />",
    "BT": {
        "Blackboard": [
            {
                "IsLocationKnown": "Boolean"
            },
            {
                "IsObjectNearby": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectNearby?": "IsObjectNearby"
                                }
                            ],
                            "Nodes": [],
                            "Task": "RetrieveObject",
                            "Name": "RetrieveObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "InspectObject",
                            "Name": "InspectObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectDetected?": "IsObjectDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsLocationKnown?": "IsLocationKnown"
                                }
                            ],
                            "Nodes": [],
                            "Task": "NavigateToObjectLocation",
                            "Name": "NavigateToObjectLocation"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanArea",
                    "Name": "ScanArea"
                }
            ]
        }
    }
}
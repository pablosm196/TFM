                "IsObjectTakeable": "Boolean"
            },
            {
                "IsAnyObjectVisible": "Boolean"
            },
            {
                "IsObjectNearby": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [
                                {
                                    "IsObjectNearby?": "IsObjectNearby"
                                }
                            ],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "MoveToObject",
                                    "Name": "MoveToObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectTakeable?": "IsObjectTakeable"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "TakeObject",
                                    "Name": "TakeObject"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "ProcessObjectTasks",
                                    "Name": "ProcessObjectTasks"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "PutObjectBack",
                                    "Name": "PutObjectBack"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanForObjects",
                            "Name": "ScanForObjects"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsAnyObjectVisible?": "IsAnyObjectVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToVisibleObject",
                            "Name": "MoveToVisibleObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObjects",
                    "Name": "ScanAreaForObjects"
                }
            ]
        }
    }

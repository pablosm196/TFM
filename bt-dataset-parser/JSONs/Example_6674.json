    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO ProcessObjectTask\n\t\tEND\n\t\tSEQUENCE\n\t\t\tDO MoveToLocation\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ScanObjectProperties\n\t\tEND\n\t\tDO ScanArea\n\tEND\n"

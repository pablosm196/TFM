{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, approach, grab it and inspect it. Finally, process it. If not, scan and reposition. list of available nodes: <Action ID = GrabAndInspectObject    /> <Action ID = ProcessObject    /> <Action ID = ApproachObject    /> <Action ID = RepositionForBetterView    /> <Action ID = AdjustOrientation    /> <Action ID = ScanSurroundings    /> <Condition ID = IsObjectInSight    /> <Condition ID = IsObjectDetected    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectInSight": "Boolean"
            },
            {
                "IsObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectInSight?": "IsObjectInSight"
                                }
                            ],
                            "Nodes": [],
                            "Task": "AdjustOrientation",
                            "Name": "AdjustOrientation"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ApproachObject",
                            "Name": "ApproachObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabAndInspectObject",
                            "Name": "GrabAndInspectObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObject",
                            "Name": "ProcessObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanSurroundings",
                            "Name": "ScanSurroundings"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "RepositionForBetterView",
                    "Name": "RepositionForBetterView"
                }
            ]
        }
    }
}
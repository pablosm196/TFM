{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object found, take it to drop off, check properties, do specific task; else, move to find object. list of available nodes: <Action ID = TakeObject    /> <Action ID = MoveToDropOff    /> <Action ID = DropObject    /> <SubTree ID = CheckObjectProperties    /> <SubTree ID = SpecificTask    /> <Condition ID = IsObjectFound    /> <Condition ID = IsPathClear    /> <Action ID = MoveToFindObject    /> <Action ID = ScanAreaForObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectFound": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],

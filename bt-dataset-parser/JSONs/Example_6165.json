{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes.     If object is visible, approach it. Then, if close,  check properties, do task and take object. If not, scan.     list of available nodes: <Condition ID = IsObjectApproached    /> <Action ID = CheckObjectProperties    /> <SubTree ID = DoTask    /> <Action ID = TakeObject    /> <Condition ID = IsObjectVisible    /> <Action ID = ApproachObject    /> <Action ID = ScanAreaForObject    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],

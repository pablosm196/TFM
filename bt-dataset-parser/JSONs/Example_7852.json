    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectWithinReach? THEN\n\t\t\t\t\tDO GrabObject\n\t\t\tEND\n\t\t\tDO CheckObjectProperties\n\t\t\tDO RetrieveObject\n\t\tEND\n\t\tDO WanderAround\n\tEND\n"

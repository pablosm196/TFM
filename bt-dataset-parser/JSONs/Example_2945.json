{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If object is located, approach it, take it, check properties, do specific task. If not, scan area or move. list of available nodes: <Action ID = ApproachObject    /> <Condition ID = isObjectLocated    /> <Action ID = CheckObjectProperties    /> <Action ID = TakeObject    /> <Action ID = ScanAreaForObject    /> <Action ID = MoveToNewLocation    /> <SubTree ID = SpecificTask    />\"",
    "BT": {
        "Blackboard": [
            {
                "isObjectLocated": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [
                            {
                                "isObjectLocated?": "isObjectLocated"
                            }
                        ],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ApproachObject",
                                "Name": "ApproachObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "TakeObject",
                                "Name": "TakeObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "CheckObjectProperties",
                                "Name": "CheckObjectProperties"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "SpecificTask",
                                "Name": "SpecificTask"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF isObjectLocated? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO ApproachObject\n\t\t\t\tDO TakeObject\n\t\t\t\tDO CheckObjectProperties\n\t\t\t\tDO SpecificTask\n\t\t\tEND\n\tEND\n"
}
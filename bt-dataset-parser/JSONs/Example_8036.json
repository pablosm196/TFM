{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Approach, grab and process object if nearby, scan and move to search area if far. list of available nodes: <Action ID = MoveToObject    /> <Action ID = PickUpObject    /> <Action ID = ScanForObject    /> <Action ID = MoveToSearchArea    />  <SubTree ID = MobileRobotTask    /> <Condition ID = IsObjectNear    /> <Condition ID = IsObjectFar    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectFar": "Boolean"
            },
            {
                "IsObjectNear": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectNear?": "IsObjectNear"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PickUpObject",
                            "Name": "PickUpObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectFar?": "IsObjectFar"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ScanForObject",
                            "Name": "ScanForObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToSearchArea",
                            "Name": "MoveToSearchArea"
                        }
                    ]
                }
            ]
        }
    }
}
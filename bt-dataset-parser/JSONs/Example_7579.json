{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find object. If found, handle it. Otherwise, navigate to location. If clear, go there. list of available nodes: <Action ID = IsObjectFound    /> <Action ID = ObjectHandlingTask    /> <Action ID = IsPathClear    /> <Action ID = NavigateToLocation    /> <Action ID = HasReachedDestination    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectFound": "Boolean"
            },
            {
                "HasReachedDestination": "Boolean"
            },
            {
                "IsPathClear": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectFound?": "IsObjectFound"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ObjectHandlingTask",
                            "Name": "ObjectHandlingTask"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsPathClear?": "IsPathClear"
                                }
                            ],
                            "Nodes": [],
                            "Task": "NavigateToLocation",
                            "Name": "NavigateToLocation"
                        }
                    ]
                }
            ]
        }
    }
}
                                {
                                    "IsObjectValid?": "IsObjectValid"
                                }
                            ],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "PerformTaskWithObject",
                            "Name": "PerformTaskWithObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SearchForObject",
                            "Name": "SearchForObject"
                        }
                    ]
                }
            ]
        }
    }
}
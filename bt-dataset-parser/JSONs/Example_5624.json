    "code": "\tSEQUENCE\n\t\tDO ScanAreaForObjects\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\t\tDO ApproachObject\n\t\t\tELSE\n\t\t\t\tDO TakeObject\n\t\t\t\tDO CheckObjectProperties\n\t\t\t\tDO SpecificTask\n\t\t\tEND\n\t\t\tDO MoveToNextArea\n\t\tEND\n\tEND\n"

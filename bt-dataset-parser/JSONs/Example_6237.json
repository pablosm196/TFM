{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, move to it, take it, check weight, move to area, get task. Else, scan or wander. list of available nodes: <Condition ID = IsObjectVisible    /> <Condition ID = isObjectHeavy    /> <Action ID = MoveToObject    /> <Action ID = TakeObject    /> <Action ID = MoveToDesignatedArea    /> <Action ID = ScanAreaForObject    /> <Action ID = WanderAround    /> <SubTree ID = ProcessObjectTask    />",
    "BT": {
        "Blackboard": [
            {
                "isObjectHeavy": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "isObjectHeavy?": "isObjectHeavy"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToDesignatedArea",
                            "Name": "MoveToDesignatedArea"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ProcessObjectTask",
                            "Name": "ProcessObjectTask"
                        }
                    ]
                }
            ]
        }
    }
}
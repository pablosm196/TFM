                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO GrabObject\n\t\t\tDO CheckObjectProperties\n\t\t\tDO BringObjectToLocation\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsPathBlocked? THEN\n\t\t\t\tDO FindNewPath\n\t\tEND\n\t\tDO ScanAreaForObjects\n\tEND\n"

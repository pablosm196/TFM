                                "Nodes": [],
                                "Task": "CheckObjectProperties",
                                "Name": "CheckObjectProperties"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "BringObjectToLocation",
                                "Name": "BringObjectToLocation"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",

{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object detected, then move to the object, take it, check properties, perform a task, and release. If not, then scan area.     list of available nodes: <Condition ID = isObjectDetected    /> <Action ID = ReleaseObject    /> <SubTree ID = SpecificTask    /> <Sequence>     <Action ID = TakeObject    />     <Action ID = MoveToTheObject    />     <Action ID = CheckObjectProperties    /> </Sequence> <Action ID = ScanArea    /> <Sequence>     <Condition ID = NoObjectDetected    />     <Action ID = ScanArea    /> </Sequence>",
    "BT": {
        "Blackboard": [
            {
                "isObjectDetected": "Boolean"
            },
            {
                "NoObjectDetected": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "isObjectDetected?": "isObjectDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToTheObject",
                            "Name": "MoveToTheObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ReleaseObject",
                            "Name": "ReleaseObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "NoObjectDetected?": "NoObjectDetected"
                                }
                            ],
                            "Nodes": [],
                            "Task": "ScanArea",
                            "Name": "ScanArea"
                        }
                    ]
                }
            ]
        }
    }
}
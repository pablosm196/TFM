{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     Find and grab object, assessing its properties. Move towards it if in view. Scan throughout.     list of available nodes: <Action ID = TakeObject    /> <Action ID = MoveTowardsObject    /> <Condition ID = IsObjectInView    /> <Action ID = ScanAreaForObject    /> <Action ID = AssessObject    /> <Condition ID = IsObjectApproached    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectInView": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectApproached?": "IsObjectApproached"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "AssessObject",
                            "Name": "AssessObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "IsObjectInView?": "IsObjectInView"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveTowardsObject",
                            "Name": "MoveTowardsObject"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObject",
                    "Name": "ScanAreaForObject"
                }
            ]
        }
    }
}
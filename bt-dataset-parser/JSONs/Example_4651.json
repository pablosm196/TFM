    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO PickUpObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectIdentified? THEN\n\t\t\t\tDO CheckObjectProperties\n\t\tELSE\n\t\t\tDO PerformTask\n\t\tEND\n\t\tDO SearchForObject\n\tEND\n"

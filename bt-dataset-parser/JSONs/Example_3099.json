                        "Name": "PerformTask"
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tDO ApproachObject\n\tELSE\n\t\tDO TakeObject\n\t\tDO CheckObjectProperties\n\t\tDO PerformTask\n\tEND\n"

{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes. If a task is visible, approach it, complete it, or move to its location. list of available nodes: <Action ID = ScanAreaForTask    /> <Action ID = ApproachTask    /> <Action ID = MoveToTaskLocation    /> <Condition ID = IsTaskApproached    /> <Condition ID = IsTaskVisible    /> <SubTree ID = CompleteTask    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsTaskApproached": "Boolean"
            },
            {
                "IsTaskVisible": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Sequence",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Task",
                        "Decorators": [],
                        "Nodes": [],
                        "Task": "ScanAreaForTask",
                        "Name": "ScanAreaForTask"
                    },
                    {
                        "Type": "Selector",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Sequence",
                                "Decorators": [],
                                "Nodes": [
                                    {
                                        "Type": "Task",
                                        "Decorators": [
                                            {
                                                "IsTaskApproached?": "IsTaskApproached"
                                            }
                                        ],
                                        "Nodes": [],
                                        "Task": "CompleteTask",
                                        "Name": "CompleteTask"
                                    }
                                ]
                            },
                            {
                                "Type": "Sequence",
                                "Decorators": [],
                                "Nodes": [
                                    {
                                        "Type": "Task",
                                        "Decorators": [
                                            {
                                                "IsTaskVisible?": "IsTaskVisible"
                                            }
                                        ],
                                        "Nodes": [],
                                        "Task": "ApproachTask",
                                        "Name": "ApproachTask"
                                    }
                                ]
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "MoveToTaskLocation",
                                "Name": "MoveToTaskLocation"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSEQUENCE\n\t\tDO ScanAreaForTask\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsTaskApproached? THEN\n\t\t\t\t\tDO CompleteTask\n\t\t\tEND\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsTaskVisible? THEN\n\t\t\t\t\tDO ApproachTask\n\t\t\tEND\n\t\t\tDO MoveToTaskLocation\n\t\tEND\n\tEND\n"
}
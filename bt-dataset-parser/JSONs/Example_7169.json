{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find and approach visible object, take it, check properties, complete task, or process. list of available nodes: <Action ID = IsObjectVisible    /> <Action ID = ApproachObject    /> <Action ID = IsObjectWithinReach    /> <Action ID = TakeObject    /> <Action ID = ProcessObject    /> <Action ID = IsTaskComplete    />",
    "BT": {
        "Blackboard": [
            {
                "IsTaskComplete": "Boolean"
            },
            {
                "IsObjectWithinReach": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectVisible?": "IsObjectVisible"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "ApproachObject",
                                    "Name": "ApproachObject"
                                }
                            ]
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectWithinReach?": "IsObjectWithinReach"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "TakeObject",
                                    "Name": "TakeObject"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ProcessObject",
                    "Name": "ProcessObject"
                }
            ]
        }
    }
}
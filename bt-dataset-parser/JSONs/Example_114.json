    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectApproached? THEN\n\t\t\t\tDO TakeObject\n\t\tELSE\n\t\t\tDO ProcessObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tSELECTOR\n\t\t\t\t\tSEQUENCE\n\t\t\t\t\t\t\tIF IsPathClear? THEN\n\t\t\t\t\t\t\tDO MoveToObject\n\t\t\t\t\tEND\n\t\t\t\t\tDO ScanForObject\n\t\t\t\tEND\n\t\tEND\n\t\tDO CompleteTask\n\tEND\n"

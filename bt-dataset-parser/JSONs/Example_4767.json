{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, move to object, take it and perform task. Finally, move to destination. Or scan area. list of available nodes: <Condition ID = IsObjectVisible    /> <Condition ID = CanTakeObject    /> <SubTree ID = SpecificTask    /> <SubTree ID = CheckObjectProperties    /> <Action ID = TakeObject    /> <Action ID = MoveToTheObject    /> <Action ID = MoveToDestination    /> <Action ID = ScanArea    />",
    "BT": {
        "Blackboard": [
            {
                "CanTakeObject": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "MoveToTheObject",
                    "Name": "MoveToTheObject"
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "CanTakeObject?": "CanTakeObject"
                                }
                            ],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToDestination",
                    "Name": "MoveToDestination"
                }
            ]
        }
    }
}
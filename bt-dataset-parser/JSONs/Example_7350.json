                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "CheckObjectWeight",
                                    "Name": "CheckObjectWeight"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "ObjectSpecificTask",
                                    "Name": "ObjectSpecificTask"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "MoveToNextPosition",
                    "Name": "MoveToNextPosition"
                }
            ]
        }
    }
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object visible, Move, take, check properties, do specific task. If not, scan area. list of available nodes: <Action ID = MoveToObject    /> <Action ID = TakeObject    /> <Action ID = ScanArea    /> <Action ID = CheckObject    /> <SubTree ID = SpecificTask    /> <Condition ID = IsObjectVisible    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObject",
                            "Name": "CheckObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "SpecificTask",
                            "Name": "SpecificTask"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanArea",
                    "Name": "ScanArea"
                }
            ]
        }
    }
}
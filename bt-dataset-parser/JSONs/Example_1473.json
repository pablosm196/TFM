                                    {
                                        "IsAreaSafe?": "IsAreaSafe"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "MoveToLocation",
                                "Name": "MoveToLocation"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectFound? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO TakeObject\n\t\t\tDO ProcessObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsAreaSafe? THEN\n\t\t\t\tDO MoveToLocation\n\t\tEND\n\tEND\n"

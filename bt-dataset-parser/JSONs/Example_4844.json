    "code": "\tSEQUENCE\n\t\t\tIF IsObjectVisible? THEN\n\t\t\tSEQUENCE\n\t\t\t\tDO MoveToObject\n\t\t\t\tDO CheckObjectProperties\n\t\t\t\tDO DoTask\n\t\t\t\tDO TakeObject\n\t\t\tEND\n\tELSE\n\t\tSELECTOR\n\t\t\tDO ScanArea\n\t\t\tDO WanderAround\n\t\tEND\n\tEND\n"

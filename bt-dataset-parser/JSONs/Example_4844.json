{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is visible, move to it, check properties, do task, take it; else scan, wander. list of available nodes: <Action ID = MoveToObject    /> <Action ID = CheckObjectProperties    /> <SubTree ID = DoTask    /> <Action ID = TakeObject    /> <Condition ID = IsObjectVisible    /> <Action ID = ScanArea    /> <Action ID = WanderAround    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "MoveToObject",
                            "Name": "MoveToObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectProperties",
                            "Name": "CheckObjectProperties"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "DoTask",
                            "Name": "DoTask"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        }
                    ]
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanArea",
                            "Name": "ScanArea"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "WanderAround",
                            "Name": "WanderAround"
                        }
                    ]
                }
            ]
        }
    }
}
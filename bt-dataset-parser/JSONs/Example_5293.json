    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectFound? THEN\n\t\t\t\tDO PickUpObject\n\t\tELSE\n\t\t\tDO CheckObjectProperties\n\t\t\tDO MoveObjectToLocation\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsAtLocation? THEN\n\t\t\t\tDO ScanForObjects\n\t\tEND\n\t\tDO MoveToNewLocation\n\tEND\n"

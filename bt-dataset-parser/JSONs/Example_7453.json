{
    "prompt": "\"Write a behavior tree for the robot to execute the command using only available nodes.     If object is visible, approach it, if in range, pick up, process it. If lost, rotate for search.     list of available nodes: <Action ID = ApproachObject    /> <Action ID = PickUpObject    /> <Condition ID = IsObjectVisible    /> <Condition ID = IsObjectInRange    /> <Condition ID = IsObjectLost    /> <Action ID = RotateForSearch    /> <Action ID = ProcessObject    />\"",
    "BT": {
        "Blackboard": [
            {
                "IsObjectVisible": "Boolean"
            },
            {
                "IsObjectLost": "Boolean"
            },
            {
                "IsObjectInRange": "Boolean"
            }
        ],
        "Root": {
            "Node": {
                "Type": "Selector",
                "Decorators": [],
                "Nodes": [
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectVisible?": "IsObjectVisible"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "ApproachObject",
                                "Name": "ApproachObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectInRange?": "IsObjectInRange"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "PickUpObject",
                                "Name": "PickUpObject"
                            },
                            {
                                "Type": "Task",
                                "Decorators": [],
                                "Nodes": [],
                                "Task": "ProcessObject",
                                "Name": "ProcessObject"
                            }
                        ]
                    },
                    {
                        "Type": "Sequence",
                        "Decorators": [],
                        "Nodes": [
                            {
                                "Type": "Task",
                                "Decorators": [
                                    {
                                        "IsObjectLost?": "IsObjectLost"
                                    }
                                ],
                                "Nodes": [],
                                "Task": "RotateForSearch",
                                "Name": "RotateForSearch"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectVisible? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\t\tIF IsObjectInRange? THEN\n\t\t\t\tDO PickUpObject\n\t\tELSE\n\t\t\tDO ProcessObject\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectLost? THEN\n\t\t\t\tDO RotateForSearch\n\t\tEND\n\tEND\n"
}
{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. Find and retrieve visible object. If unreachable then take, check, move and place it. list of available nodes: <Action ID = ApproachObject    /> <Condition ID = IsObjectVisible    />  <Condition ID = IsObjectReached    /> <Action ID = MoveToEndLocation    /> <Action ID = TakeObject    />  <Action ID = CheckObjectWeight    />  <Sequence>  <SubTree ID = FindAndRetrieveObject    />  </Sequence>  <Action ID = PlaceObject    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectReached": "Boolean"
            },
            {
                "IsObjectVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectVisible?": "IsObjectVisible"
                        }
                    ],
                    "Nodes": [],
                    "Task": "ApproachObject",
                    "Name": "ApproachObject"
                },
                {
                    "Type": "Selector",
                    "Decorators": [
                        {
                            "IsObjectReached?": "IsObjectReached"
                        }
                    ],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "TakeObject",
                            "Name": "TakeObject"
                        },
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "CheckObjectWeight",
                                    "Name": "CheckObjectWeight"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "MoveToEndLocation",
                                    "Name": "MoveToEndLocation"
                                },
                                {
                                    "Type": "Task",
                                    "Decorators": [],
                                    "Nodes": [],
                                    "Task": "PlaceObject",
                                    "Name": "PlaceObject"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }
}
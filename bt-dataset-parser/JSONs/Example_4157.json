    "code": "\tSEQUENCE\n\t\tDO ScanArea\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectNearby? THEN\n\t\t\t\t\tDO ApproachObject\n\t\t\tELSE\n\t\t\t\tSEQUENCE\n\t\t\t\t\t\tIF IsObjectHeld? THEN\n\t\t\t\t\t\tDO ProcessObject\n\t\t\t\tEND\n\t\t\tEND\n\t\t\tDO MoveToNextArea\n\t\tEND\n\tEND\n"

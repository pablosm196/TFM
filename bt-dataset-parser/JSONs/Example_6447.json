{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes.     If object visible, move to object, take object, check object ID. Else, scan area.     list of available nodes: <Action ID = MoveTowardsObject    /> <Action ID = GrabObject    /> <SubTree ID = CheckObjectID    /> <Action ID = ScanAreaForObject    /> <Condition ID = ObjectIsVisible    />",
    "BT": {
        "Blackboard": [
            {
                "ObjectIsVisible": "Boolean"
            }
        ],
        "Node": {
            "Type": "Selector",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",
                            "Decorators": [
                                {
                                    "ObjectIsVisible?": "ObjectIsVisible"
                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveTowardsObject",
                            "Name": "MoveTowardsObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "GrabObject",
                            "Name": "GrabObject"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "CheckObjectID",
                            "Name": "CheckObjectID"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "ScanAreaForObject",
                    "Name": "ScanAreaForObject"
                }
            ]
        }
    }
}
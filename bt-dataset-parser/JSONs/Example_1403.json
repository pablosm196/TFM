{
    "prompt": "Write a behavior tree for the robot to execute the command using only available nodes. If object is approached, pick up; if lightweight move it to location, then scan properties, and do specific task. list of available nodes: <Action ID = PickUpObject    /> <Action ID = MoveObjectToDesignatedLocation    /> <Action ID = ScanObjectProperties    /> <Condition ID = IsObjectLightweight    /> <Condition ID = IsObjectApproached    /> <SubTree ID = SpecificTask    />",
    "BT": {
        "Blackboard": [
            {
                "IsObjectApproached": "Boolean"
            },
            {
                "IsObjectLightweight": "Boolean"
            }
        ],
        "Node": {
            "Type": "Sequence",
            "Decorators": [],
            "Nodes": [
                {
                    "Type": "Task",
                    "Decorators": [
                        {
                            "IsObjectApproached?": "IsObjectApproached"
                        }
                    ],
                    "Nodes": [],
                    "Task": "PickUpObject",
                    "Name": "PickUpObject"
                },
                {
                    "Type": "Selector",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Sequence",
                            "Decorators": [],
                            "Nodes": [
                                {
                                    "Type": "Task",
                                    "Decorators": [
                                        {
                                            "IsObjectLightweight?": "IsObjectLightweight"
                                        }
                                    ],
                                    "Nodes": [],
                                    "Task": "MoveObjectToDesignatedLocation",
                                    "Name": "MoveObjectToDesignatedLocation"
                                }
                            ]
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "ScanObjectProperties",
                            "Name": "ScanObjectProperties"
                        }
                    ]
                },
                {
                    "Type": "Task",
                    "Decorators": [],
                    "Nodes": [],
                    "Task": "SpecificTask",
                    "Name": "SpecificTask"
                }
            ]
        }
    }
}
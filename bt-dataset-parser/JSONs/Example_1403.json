    "code": "\tSEQUENCE\n\t\t\tIF IsObjectApproached? THEN\n\t\t\tDO PickUpObject\n\tELSE\n\t\tSELECTOR\n\t\t\tSEQUENCE\n\t\t\t\t\tIF IsObjectLightweight? THEN\n\t\t\t\t\tDO MoveObjectToDesignatedLocation\n\t\t\tEND\n\t\t\tDO ScanObjectProperties\n\t\tEND\n\t\tDO SpecificTask\n\tEND\n"

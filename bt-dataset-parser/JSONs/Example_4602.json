                                }
                            ],
                            "Nodes": [],
                            "Task": "MoveToStorage",
                            "Name": "MoveToStorage"
                        },
                        {
                            "Type": "Task",
                            "Decorators": [],
                            "Nodes": [],
                            "Task": "StoreObject",
                            "Name": "StoreObject"
                        }
                    ]
                },
                {
                    "Type": "Sequence",
                    "Decorators": [],
                    "Nodes": [
                        {
                            "Type": "Task",

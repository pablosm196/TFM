    "code": "\tSELECTOR\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectFound? THEN\n\t\t\t\tDO ApproachObject\n\t\tELSE\n\t\t\tDO GrabObject\n\t\t\tDO CheckObjectProperties\n\t\tEND\n\t\tSEQUENCE\n\t\t\t\tIF IsObjectLost? THEN\n\t\t\t\tDO ScanAreaForObject\n\t\tEND\n\t\tDO MoveToNewLocation\n\t\tDO SpecificTask\n\tEND\n"
